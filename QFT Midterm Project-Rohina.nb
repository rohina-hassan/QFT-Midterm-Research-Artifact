In[110]:=",ExpressionUUID->"38b23d04-c525-3d47-bf2c-38fb9e75f1ec"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{"B", "(", 
     SuperscriptBox["P", "2"], ")"}], "\[LongEqual]", 
    RowBox[{
     TemplateBox[{"Integrate"},
      "InactiveHead",
      BaseStyle->"InactiveTraditional",
      SyntaxForm->"Symbol",
      Tooltip->"Inactive[Integrate]"], "[", 
     RowBox[{
      RowBox[{"bubbleIntegrand", "(", 
       RowBox[{"k", ",", "P"}], ")"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        SuperscriptBox["\[DoubleStruckCapitalR]", "d"]}], "}"}]}], "]"}]}],
   HoldForm], TraditionalForm]], "Output",
 CellChangeTimes->{4.004154175734314*^9, 4.004161307873001*^9, 
  4.0041720853300247`*^9, 4.004181171145199*^9, 4.004182597058365*^9, 
  4.0041893729779167`*^9, 4.00419883696636*^9, 4.004200838271843*^9, 
  4.004201396213047*^9, 4.004242284840233*^9, 4.0042459709340343`*^9, 
  4.0042467677815*^9, 4.0042509711304016`*^9, 4.004291975419344*^9, 
  4.0042994157671146`*^9},
 CellLabel->
  "Out[116]//TraditionalForm=",ExpressionUUID->"1ccdfa9b-188b-3240-b92c-\
a4da0b17b842"],

Cell[BoxData[
 FormBox["\<\"Zero-momentum bubble integral:\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.004154175734314*^9, 4.004161307847864*^9, 
  4.004172085306679*^9, 4.004181171145199*^9, 4.0041825970536633`*^9, 
  4.004189372972801*^9, 4.00419883696636*^9, 4.0042008382667065`*^9, 
  4.0042013962031612`*^9, 4.004242284840233*^9, 4.0042459709340343`*^9, 
