Cell[TextData[{
 StyleBox["Computational note:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.43137254901960786`, 0.43137254901960786`, 0.43137254901960786`]],
 StyleBox["\nThe derivation in this subsection is based entirely on scaling \
arguments and algebraic relations; it does not require numerical integration \
or perturbative evaluation of Feynman diagrams. Accordingly, Mathematica is \
used only to simplify the symbolic expressions for the scaling dimensions ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalDelta]", "\[Phi]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"922f4133-f755-e640-b9be-514ddb2d7c43"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalDelta]", 
        StyleBox["h", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta_h", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6372771a-b511-6f42-a652-e805bbe088e6"],
 StyleBox[", verify the relation ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", "\[Phi]"], "+", 
         SubscriptBox["\[CapitalDelta]", 
          StyleBox["h", "TI"]], "\[LongEqual]", 
         StyleBox["d", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta_\\phi+\\Delta_h=d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c3d3a4bd-b869-0f4a-956f-1665ec6dc6cc"],
 StyleBox[", and confirm the resulting expression for the critical-isotherm \
exponent ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"be9cb36f-4b17-7d4f-b816-1b3026c7af8d"],
 StyleBox[". These checks establish the internal algebraic consistency of the \
scaling argument; they do not constitute an independent numerical or physical \
verification of the scaling hypothesis itself.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004299989796423*^9, 
  4.0043000430074253`*^9}},ExpressionUUID->"180810b2-49c8-ee44-8965-\
3d70086a8919"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["2.3.2 Critical-Isotherm Exponent",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.5254901960784314, 0.3843137254901961, 
   0.49019607843137253`]]], "Subsubsection",
 CellChangeTimes->{{4.00429897212763*^9, 
  4.004298985637884*^9}},ExpressionUUID->"c7b6ff17-5790-f145-855e-\
6769ba9a1a9d"],

Cell[TextData[{
 StyleBox["Having established the generic scaling relation for the \
critical-isotherm exponent in Section 2.3.1,",
  FontSize->13],
 StyleBox[" ",
  FontSize->11],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["d", "TI"], ",", "\[Eta]"}], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], "+", "2", "-", "\[Eta]"}], 
          RowBox[{
            StyleBox["d", "TI"], "-", "2", "+", "\[Eta]"}]], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta(d,\\eta)=\\frac{d+2-\\eta}{d-2+\\eta},", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"a5fffa33-695d-8f46-9cb9-b7bc0d19699c"],
 StyleBox[" we now evaluate it using the two-loop result for the anomalous \
dimension obtained in Section 2.2. We work in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d=4-\\epsilon", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c5415b30-3a91-c942-a2ac-d1d23e0ff11e"],
 StyleBox[" dimensions and use ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", 
         FractionBox[
          SuperscriptBox["\[Epsilon]", "2"], "54"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "3"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\eta=\\frac{\\epsilon^2}{54}+O(\\epsilon^3).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"480e0115-47b6-df41-92d5-39c4fd39c47f"],
 StyleBox[" Substituting these expressions into the scaling relation gives:\n\
\n                                                                            \
                                                          ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         RowBox[{"(", "\[Epsilon]", ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"6", "-", "\[Epsilon]", "-", 
            SuperscriptBox["\[Epsilon]", "2"], "/", "54"}], 
          RowBox[{"2", "-", "\[Epsilon]", "+", 
            SuperscriptBox["\[Epsilon]", "2"], "/", "54"}]], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "3"], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta(\\epsilon)\n=\\frac{6-\\epsilon-\\epsilon^2/54}\n\
{2-\\epsilon+\\epsilon^2/54}\n+O(\\epsilon^3),", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4accfbe3-193a-2647-8f59-e411bf06e553"],
 StyleBox["                                                                   \
                                 (A-99)\n\nwhere the expression on the right \
is understood perturbatively, with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6be11cb4-13bd-af4f-b38e-73460f2e0d45"],
 StyleBox[" known only through ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox["\[Epsilon]", "2"], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(\\epsilon^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ffb25ae8-e203-a044-b41d-47a6723f6042"],
 StyleBox[". Expanding the ratio about ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9d6d574c-91d8-9848-9173-03e192098159"],
 StyleBox[" and retaining terms through ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox["\[Epsilon]", "2"], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(\\epsilon^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0cfc8224-f6b7-ec4c-acab-4e332d5e92f2"],
 StyleBox[", we obtain:\n\n                                                   \
                                                                              \
        ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", "\[LongEqual]", "3", "+", "\[Epsilon]", "+", 
         FractionBox["25", "54"], 
         SuperscriptBox["\[Epsilon]", "2"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "3"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta=3+\\epsilon+\\frac{25}{54}\\epsilon^2\n+O(\\epsilon^3).", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2d7e78ef-9143-9f4e-8ab9-18bf99d267f8"],
 StyleBox["                                                                   \
                                   (A-100)\n\nThis can be checked by hand. At \
",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\eta=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a6ce153b-eeb3-a147-a99b-23cf3700ec14"],
 StyleBox[" the ratio gives ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"3", "+", "\[Epsilon]", "+", 
         FractionBox[
          SuperscriptBox["\[Epsilon]", "2"], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "3+\\epsilon+\\frac{\\epsilon^2}{2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"00ef1782-e909-db4e-a333-87501ee279c8"],
 StyleBox[", and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[PartialD]", "\[Delta]", "/", "\[PartialD]", "\[Eta]", 
         "\[LongEqual]", "-2"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\partial\\delta/\\partial\\eta=-2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1d40df20-1dda-6b49-a80c-d0789ee23a37"],
 StyleBox[" at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7c10de08-08ae-f94b-a23e-df05d9d63857"],
 StyleBox[", so ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", "\[LongEqual]", "3", "+", "\[Epsilon]", "+", 
         FractionBox[
          SuperscriptBox["\[Epsilon]", "2"], "2"], "-", "2", "\[Eta]", "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta=3+\\epsilon+\\frac{\\epsilon^2}{2}-2\\eta+O(\\epsilon^3)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6033461c-24f1-f64d-b5f6-e94e310ea876"],
 StyleBox[", and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "2"], "-", 
         FractionBox["2", "54"], "\[LongEqual]", 
         FractionBox["25", "54"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac12-\\frac{2}{54}=\\frac{25}{54}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"e70940f6-3f26-6c4a-8f0f-bcea2dc05d60"],
 StyleBox[".",
  FontSize->11],
 StyleBox["\n\nTo obtain the three-dimensional prediction, we set ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"af6b8ddd-99c8-2240-b0e0-ccd4741bf18f"],
 StyleBox[" in the truncated expansion, corresponding to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "d=3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2c2ad7a9-9407-ea40-bcec-b78355bd8057"],
 StyleBox[":\n\n                                                              \
                                                                  ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Delta]", 
          RowBox[{
            StyleBox["d", "TI"], "\[LongEqual]", "3"}], 
          RowBox[{"(", "two-loop", ")"}]], "\[LongEqual]", "4", "+", 
         FractionBox["25", "54"], "\[LongEqual]", 
         FractionBox["241", "54"], "\[TildeTilde]", "4.463."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta_{d=3}^{(\\text{two-loop})}\n=4+\\frac{25}{54}\n=\\frac{241}{54}\
\n\\approx4.463.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6e872f29-ea55-7a49-993e-9fc415f58585"],
 StyleBox["                                                                   \
                      (A-101)\n\nThis is the direct two-loop ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3be32de7-b018-1846-8d12-8fdb30cd0e2b"],
 StyleBox["-expansion prediction. Since the perturbative expansion is \
constructed around four dimensions, evaluating it at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3b394171-63f7-5545-b07a-893712c16b07"],
 StyleBox[" constitutes an extrapolation to three dimensions rather than an \
exact result. The value depends on how the series is truncated: inserting ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"08f980b7-88df-a641-b331-8e680b9a9a08"],
 StyleBox[" into the unexpanded ratio gives ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"269", "/", "55", "\[TildeTilde]", "4.891"}], TraditionalForm],
      "errors" -> {}, "input" -> "269/55\\approx4.891", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2605e193-f970-4646-ac44-8ae110fbeb6e"],
 StyleBox[", instead of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"241", "/", "54", "\[TildeTilde]", "4.463"}], TraditionalForm],
      "errors" -> {}, "input" -> "241/54\\approx4.463", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a6604ade-d009-3346-bfe0-b79fbcef0da6"],
 StyleBox[". This is why we expand through ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox["\[Epsilon]", "2"], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(\\epsilon^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"44d18d57-cd4a-d049-b395-38a510e8d2f1"],
 StyleBox[" first, as the assignment prescribes.\n\nIn Section 2.3.4, we \
compare this prediction with the conformal-bootstrap estimate and the \
experimental critical-isotherm exponent obtained from water.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0043001051760597`*^9, 4.004300110426119*^9}, {
  4.0043006534996605`*^9, 4.004300670838749*^9}, {4.0043007666493683`*^9, 
  4.0043008840360107`*^9}, {4.0043009460450516`*^9, 4.0043010357945404`*^9}, {
  4.0043010660153446`*^9, 
  4.004301222009508*^9}},ExpressionUUID->"a3ffe363-930e-494c-a986-\
6668026eeebe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "1."}]}], " ", "Generic", " ", "scaling", " ", "relation", 
     " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
       "genuinely", " ", "symbolic", " ", "in", " ", "dim", " ", "and", " ", 
        "anomEta"}], ")"}], "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"deltaGeneric", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dim", "+", "2", "-", "anomEta"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"dim", "-", "2", "+", "anomEta"}], ")"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Critical-isotherm exponent in generic dimension and \
generic eta:\>\"", "]"}], ";"}], "\n", "deltaGeneric", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "2."}]}], " ", "Link", " ", "to", " ", "the", " ", 
      "two"}], "-", 
     RowBox[{
     "loop", " ", "result", " ", "of", " ", "Section", " ", "2.2", ".4", " ", 
      "and", " ", "to", " ", "dimensional", " ", 
      RowBox[{"regularization", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"etaTwoLoop", "=", "eta"}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"from", " ", "2.2", ".4"}], ",", 
     RowBox[{"equals", " ", 
      RowBox[{
       RowBox[{"e", "^", "2"}], "/", "54"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"dimensionDR", "=", 
     RowBox[{"4", "-", "e"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "3."}]}], " ", "Substitute", " ", "d"}], "=", 
     RowBox[{"4", "-", 
      RowBox[{"e", " ", "and", " ", "eta", 
       RowBox[{
        RowBox[{"(", "e", ")"}], "--"}]}], "-"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"deltaExactEpsilon", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaGeneric", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dim", "->", "dimensionDR"}], ",", 
         RowBox[{"anomEta", "->", "etaTwoLoop"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Scaling expression after substituting d = 4 - e and \
eta:\>\"", "]"}], ";"}], "\n", "deltaExactEpsilon", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "4."}]}], " ", "Expand", " ", "through", " ", "O", 
      RowBox[{"(", 
       RowBox[{"e", "^", "2"}], ")"}], " ", "before", " ", "setting", " ", 
      "e"}], "=", 
     RowBox[{
      RowBox[{"1", "--"}], "-"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"deltaSeries", "=", 
     RowBox[{"Series", "[", 
      RowBox[{"deltaExactEpsilon", ",", 
       RowBox[{"{", 
        RowBox[{"e", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaExpansion", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Normal", "[", "deltaSeries", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaExpected", "=", 
     RowBox[{"3", "+", "e", "+", 
      RowBox[{"25", " ", 
       RowBox[{
        RowBox[{"e", "^", "2"}], "/", "54"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaExpansionCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaExpansion", "-", "deltaExpected"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Critical-isotherm exponent through O(e^2):\>\"", "]"}],
     ";"}], "\n", "deltaExpansion", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "5."}]}], " ", "Perturbative", " ", "coefficients", " ", 
      "and", " ", "independent", " ", "checks", " ", "of", " ", "the", " ", 
      RowBox[{"expansion", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"deltaCoefficients", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{"SeriesCoefficient", "[", 
         RowBox[{"deltaExactEpsilon", ",", 
          RowBox[{"{", 
           RowBox[{"e", ",", "0", ",", "n"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Perturbative coefficients {delta_0, delta_1, delta_2}:\
\>\"", "]"}], ";"}], "\n", "deltaCoefficients", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Decomposition", ":", "delta"}], "=", 
      RowBox[{
       RowBox[{"delta", 
        RowBox[{"(", 
         RowBox[{"eta", "=", "0"}], ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"d", " ", 
           RowBox[{"delta", "/", "d"}], " ", "eta", " ", "at", " ", "eta"}], "=",
           "0"}], ")"}], "*", "eta"}]}]}], ",", 
     RowBox[{"through", " ", "O", 
      RowBox[{"(", 
       RowBox[{"e", "^", "2"}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"deltaEtaZero", "=", 
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"deltaGeneric", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"dim", "->", 
            RowBox[{"4", "-", "e"}]}], ",", 
           RowBox[{"anomEta", "->", "0"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"e", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"etaDerivative", "=", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"deltaGeneric", ",", "anomEta"}], "]"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"dim", "->", 
           RowBox[{"4", "-", "e"}]}], ",", 
          RowBox[{"anomEta", "->", "0"}]}], "}"}]}], ",", 
       RowBox[{"e", "->", "0"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"decompositionCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaExpansion", "-", 
       RowBox[{"(", 
        RowBox[{"deltaEtaZero", "+", 
         RowBox[{"etaDerivative", " ", "etaTwoLoop"}]}], ")"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<delta at eta = 0 through O(e^2) (expected: 3 + e + \
e^2/2):\>\"", "]"}], ";"}], "\n", "deltaEtaZero", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<d delta / d eta at eta = 0, e -> 0 (expected: -2):\>\"",
      "]"}], ";"}], "\n", "etaDerivative", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"The", " ", "cubic", " ", "remainder", " ", "must", " ", "be", " ", 
      RowBox[{"finite", ".", "It"}], " ", "is", " ", "NOT", " ", "the", " ", 
      "true", " ", 
      RowBox[{"e", "^", "3"}], " ", "coefficient"}], ",", 
     RowBox[{
     "because", " ", "eta", " ", "is", " ", "known", " ", "only", " ", 
      "through", " ", 
      RowBox[{"e", "^", "2."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"cubicRemainder", "=", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"deltaExactEpsilon", "-", "deltaExpansion"}], ")"}], "/", 
        RowBox[{"e", "^", "3"}]}], ",", 
       RowBox[{"e", "->", "0"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Cubic remainder of the truncated input (expected: \
2/9):\>\"", "]"}], ";"}], "\n", "cubicRemainder", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "6."}]}], " ", "Evaluate", " ", "in", " ", "d"}], "=", 
      "3"}], ",", 
     RowBox[{
      RowBox[{"and", " ", "show", " ", "the", " ", "sensitivity", " ", "to", " ", 
       RowBox[{"truncation", "--"}]}], "-"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"deltaThreeDimensional", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaExpansion", "/.", " ", 
       RowBox[{"e", "->", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaThreeDimensionalNumerical", "=", 
     RowBox[{"N", "[", 
      RowBox[{"deltaThreeDimensional", ",", "8"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaUnexpandedAtOne", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaExactEpsilon", "/.", " ", 
       RowBox[{"e", "->", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Three-dimensional two-loop prediction (expand first, \
then e = 1):\>\"", "]"}], ";"}], "\n", "deltaThreeDimensional", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Numerical three-dimensional prediction:\>\"", "]"}], 
    ";"}], "\n", "deltaThreeDimensionalNumerical", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Unexpanded ratio at e = 1 (truncation sensitivity, \
expected: 269/55 = 4.8909):\>\"", "]"}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{"deltaUnexpandedAtOne", ",", 
     RowBox[{"N", "[", 
      RowBox[{"deltaUnexpandedAtOne", ",", "8"}], "]"}]}], "}"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "7."}]}], " ", "Final", " ", "consistency", " ", 
      RowBox[{"checks", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"deltaChecks", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"etaTwoLoop", "-", 
          RowBox[{
           RowBox[{"e", "^", "2"}], "/", "54"}]}], "]"}], "==", "0"}], ",", 
       RowBox[{"deltaExpansionCheck", "==", "0"}], ",", 
       RowBox[{"decompositionCheck", "==", "0"}], ",", 
       RowBox[{"deltaCoefficients", "==", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1", ",", 
          RowBox[{"25", "/", "54"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"cubicRemainder", "-", 
          RowBox[{"2", "/", "9"}]}], "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"deltaThreeDimensional", "-", 
          RowBox[{"241", "/", "54"}]}], "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"dimensionDR", "/.", " ", 
            RowBox[{"e", "->", "1"}]}], ")"}], "-", "3"}], "]"}], "==", "0"}],
        ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"deltaUnexpandedAtOne", "-", 
          RowBox[{"269", "/", "55"}]}], "]"}], "==", "0"}]}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Final consistency checks (expected: eight True \
values):\>\"", "]"}], ";"}], "\n", "deltaChecks"}]}]], "Input",
