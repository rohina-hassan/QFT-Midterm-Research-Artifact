Cell[CellGroupData[{

Cell[TextData[StyleBox["2.3.4 Critical Scattering and Comparison with \
Reference Values",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.5254901960784314, 0.3843137254901961, 
   0.49019607843137253`]]], "Subsubsection",
 CellChangeTimes->{{4.004299023797783*^9, 
  4.004299032457676*^9}},ExpressionUUID->"daac1e93-107b-2c4c-81b7-\
344d06c51540"],

Cell[TextData[{
 StyleBox["The anomalous dimension ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4ebc5050-a4c4-774b-b26b-4390e173b880"],
 StyleBox[" also determines the momentum dependence of the two-point \
correlation function at criticality. In the scaling regime, the critical \
propagator behaves as \n\n                                                    \
                                                                              \
      ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["G", "TI"], 
         RowBox[{"(", 
           StyleBox["q", "TI"], ")"}], "\[Proportional]", 
         SuperscriptBox[
          StyleBox["q", "TI"], 
          RowBox[{"-2", "+", "\[Eta]"}]], "\[LongEqual]", 
         FractionBox["1", 
          SuperscriptBox[
           StyleBox["q", "TI"], 
           RowBox[{"2", "-", "\[Eta]"}]]], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "G(q)\\propto q^{-2+\\eta}\n=\\frac{1}{q^{2-\\eta}},", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0408d5e0-9752-2a4a-a512-640aa1c11774"],
 StyleBox["                                                                   \
                                                      (A-105)\n\nwhere ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], "\[LongEqual]", "|", 
         StyleBox["q", FontSlant -> "Bold"], "|"}], TraditionalForm], 
     "errors" -> {}, "input" -> "q=|\\mathbf q|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e50cb6b4-0ac1-9644-b41b-3ee28d62ba2e"],
 StyleBox[" is the magnitude of the wave vector. Since the static structure \
factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], "(", 
         StyleBox["q", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "S(q)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2d56b0ad-ede9-564f-8e2a-e06ff1cbc29d"],
 StyleBox[" is proportional to the Fourier transform of the connected \
two-point correlation function, it follows that:\n\n                          \
                                                                              \
                                        ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], 
         RowBox[{"(", 
           StyleBox["q", "TI"], ")"}], "\[Proportional]", 
         SuperscriptBox[
          StyleBox["q", "TI"], 
          RowBox[{"-", "(", 
            RowBox[{"2", "-", "\[Eta]"}], ")"}]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "S(q)\\propto q^{-(2-\\eta)}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b6d882ed-e44c-2a4e-8ef1-09303133c105"],
 StyleBox["\n\nThis power law holds in the critical scattering regime ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Xi]", "-1"], "\[LessLess]", 
         StyleBox["q", "TI"], "\[LessLess]", 
         SuperscriptBox[
          StyleBox["a", "TI"], "-1"], ","}], TraditionalForm], "errors" -> {},
      "input" -> "\\xi^{-1}\\ll q\\ll a^{-1},", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3c87b320-54d7-5e4c-956d-e9cbf9a50182"],
 StyleBox[" where ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Xi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\xi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4329e5c1-e49f-d846-8570-3f54d87c2ab3"],
 StyleBox[" is the correlation length and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3b782754-3aa8-c543-9d19-16b281a78e53"],
 StyleBox[" is a microscopic length scale. Thus the predicted log-log slope \
of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], "(", 
         StyleBox["q", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "S(q)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1eb07bd6-4a84-404f-bd5e-5c12b8065afc"],
 StyleBox[" is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", "(", 
         RowBox[{"2", "-", "\[Eta]"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "-(2-\\eta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"04b83dd0-ce6f-c640-8006-f90c7017da5c"],
 StyleBox[". At ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a867c026-8c79-e94f-846b-ddc3177f5805"],
 StyleBox[" this is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-107", "/", "54", "\[TildeTilde]", "-1.981"}], 
       TraditionalForm], "errors" -> {}, "input" -> "-107/54\\approx-1.981", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"13f0f3a7-7dc9-224a-b0a2-82a2e502d3f5"],
 StyleBox[".\n\nTo assess our predictions in three dimensions, we now compare \
the two-loop ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cf794b09-a027-154f-8a21-3d327ded9bba"],
 StyleBox["-expansion results for ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2b56f314-c37a-6044-860d-f4faaf4a0519"],
 StyleBox[" and  with independent reference values. For the \
conformal-bootstrap comparison, we use the scaling dimension of the leading \
scalar operator, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", "\[Sigma]"], "\[LongEqual]", 
         "0.518148806", 
         RowBox[{"(", "24", ")"}], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Delta_\\sigma=0.518148806(24),", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"17b65985-dfab-1544-bf4f-39c33645f931"],
 StyleBox[" and the three-dimensional scaling relations:\n\n                  \
                                                                              \
                                 ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Eta]", 
          StyleBox["B", FontSlant -> "Plain"]], "\[LongEqual]", "2", 
         SubscriptBox["\[CapitalDelta]", "\[Sigma]"], "-", "1", ",    ", 
         SubscriptBox["\[Delta]", 
          StyleBox["B", FontSlant -> "Plain"]], "\[LongEqual]", 
         FractionBox["3", 
          SubscriptBox["\[CapitalDelta]", "\[Sigma]"]], "-", "1."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta_{\\mathrm{B}}=2\\Delta_\\sigma-1,\n\\qquad\n\
\\delta_{\\mathrm{B}}=\\frac{3}{\\Delta_\\sigma}-1.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7daf79e9-8aec-f447-bf18-3bc83795b960"],
 StyleBox["                                                                   \
                                         (A-106)\n\nThese relations give the \
corresponding conformal-bootstrap reference estimates. The relation ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]", 
          StyleBox["B", "TI"]], "\[LongEqual]", "3", "/", 
         SubscriptBox["\[CapitalDelta]", "\[Sigma]"], "-", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta_B=3/\\Delta_\\sigma-1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"66676c35-81b1-bc4b-ad0d-8168e4d90e3f"],
 StyleBox[" is the scaling relation of Section 2.3.1 evaluated at d=3 with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", "\[Phi]"], "\[LongEqual]", 
