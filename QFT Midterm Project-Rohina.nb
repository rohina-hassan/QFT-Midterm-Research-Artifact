Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Define"}]}], " ", "the", " ", "expansion", " ", 
     RowBox[{"assumptions", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"laurentAssumptions", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"muR", ">", "0"}], ",", 
       RowBox[{"m2", ">", "0"}], ",", 
       RowBox[{"P2", ">=", "0"}], ",", 
       RowBox[{"e", ">", "0"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Laurent"}]}], " ", "expansion", " ", "of", " ", "the", " ",
       "tadpole", " ", 
      RowBox[{"integral", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Expand", " ", "the", " ", "exact", " ", "DR", " ", "tadpole", " ", 
      "around", " ", "e"}], "=", 
     RowBox[{"0.", " ", "The", " ", "pole", " ", "appears", " ", "as", " ", 
      RowBox[{"1", "/", 
       RowBox[{"e", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tadpoleLaurentSeries", "=", 
     RowBox[{"Assuming", "[", 
      RowBox[{"laurentAssumptions", ",", 
       RowBox[{
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"TDR", "[", "m2", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"e", ",", "0", ",", "0"}], "}"}]}], "]"}], "//", 
        "FullSimplify"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Laurent"}]}], " ", "expansion", " ", "of", " ", "the", " ",
       "bubble", " ", 
      RowBox[{"integral", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Use", " ", "the", " ", "Feynman"}], "-", 
      RowBox[{"parameter", " ", 
       RowBox[{"representation", ":", 
        RowBox[{"BDR", 
         RowBox[{"(", 
          RowBox[{"P2", ",", "m2"}], ")"}]}]}]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"muR", "^", "e"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"4", " ", "Pi"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"d", "/", "2"}], ")"}]}]}], " ", 
      RowBox[{"Gamma", "[", 
       RowBox[{"2", "-", 
        RowBox[{"d", "/", "2"}]}], "]"}], " ", 
      RowBox[{"Integral", "[", 
       RowBox[{"dx", ",", "0", ",", "1"}], "]"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m2", "+", 
         RowBox[{"x", 
          RowBox[{"(", 
           RowBox[{"1", "-", "x"}], ")"}], "P2"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"d", "/", "2"}], "-", "2"}], ")"}]}], " ", "Expand", " ", 
      "the", " ", "complete", " ", "integrand", " ", "before", " ", 
      "integrating", " ", "over", " ", 
      RowBox[{"x", ".", "This"}], " ", "retains", " ", "the", " ", "finite", " ",
       "contribution", " ", "generated", " ", "by", " ", "the", " ", 
      RowBox[{"pole", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bubbleLaurentIntegrand", "=", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"muR", "^", "e"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"4", " ", "Pi"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"d", "/", "2"}], ")"}]}]}], "*", 
        RowBox[{"Gamma", "[", 
         RowBox[{"2", "-", 
          RowBox[{"d", "/", "2"}]}], "]"}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m2", "+", 
           RowBox[{"x", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "x"}], ")"}], " ", "P2"}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"d", "/", "2"}], "-", "2"}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"e", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Integrate", " ", "the", " ", "Laurent"}], "-", 
     RowBox[{
     "expanded", " ", "expression", " ", "over", " ", "the", " ", "Feynman", " ", 
      RowBox[{"parameter", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bubbleLaurentSeries", "=", 
     RowBox[{"Assuming", "[", 
      RowBox[{"laurentAssumptions", ",", 
       RowBox[{
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{"Normal", "[", "bubbleLaurentIntegrand", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}], "//", 
        "FullSimplify"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Display"}]}], " ", "the", " ", "bubble", " ", "Laurent", 
      " ", "expansion", " ", "in", " ", "separated", " ", 
      RowBox[{"form", "--"}]}], "-"}], "*)"}], 
   RowBox[{
    RowBox[{"bubbleLaurentCanonical", "=", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"Expand", "[", 
        RowBox[{"Normal", "[", "bubbleLaurentSeries", "]"}], "]"}], ",", "e", 
       ",", "FullSimplify"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Zero"}]}], "-", 
     RowBox[{"momentum", " ", "bubble", " ", 
      RowBox[{"expansion", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"At", " ", "P2"}], "=", "0"}], ",", 
     RowBox[{
      RowBox[{"the", " ", "Feynman"}], "-", 
      RowBox[{"parameter", " ", "integral", " ", "is", " ", 
       RowBox[{"trivial", "."}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"zeroMomentumBubbleLaurentSeries", "=", 
     RowBox[{"Assuming", "[", 
      RowBox[{"laurentAssumptions", ",", 
       RowBox[{
        RowBox[{"Series", "[", 
         RowBox[{"zeroMomentumBubbleDRExact", ",", 
          RowBox[{"{", 
           RowBox[{"e", ",", "0", ",", "0"}], "}"}]}], "]"}], "//", 
        "FullSimplify"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Extract"}]}], " ", "the", " ", "ultraviolet", " ", 
      "pole", " ", 
      RowBox[{"terms", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"The", " ", "coefficients", " ", "of", " ", 
     RowBox[{"1", "/", "e"}], " ", "identify", " ", "the", " ", "UV", " ", 
     RowBox[{"divergences", "."}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"tadpolePole", "=", 
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{
        RowBox[{"Normal", "[", "tadpoleLaurentSeries", "]"}], ",", "e", ",", 
        RowBox[{"-", "1"}]}], "]"}], "//", "FullSimplify"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"bubblePole", "=", 
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"bubbleLaurentSeries", ",", "e", ",", 
        RowBox[{"-", "1"}]}], "]"}], "//", "FullSimplify"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"zeroMomentumBubblePole", "=", 
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{
        RowBox[{"Normal", "[", "zeroMomentumBubbleLaurentSeries", "]"}], ",", 
        "e", ",", 
        RowBox[{"-", "1"}]}], "]"}], "//", "FullSimplify"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Display"}]}], " ", "the", " ", "Laurent", " ", 
      RowBox[{"expansions", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Tadpole Laurent expansion:\>\"", "]"}], ";"}], 
   "\n", 
   RowBox[{"tadpoleLaurentSeries", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Bubble Laurent expansion:\>\"", "]"}], ";"}], "\n", 
   RowBox[{"bubbleLaurentSeries", "//", "TraditionalForm"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Bubble Laurent expansion (separated pole and finite \
terms):\>\"", "]"}], ";"}], "\n", 
   RowBox[{"TraditionalForm", "[", "bubbleLaurentCanonical", "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Zero-momentum bubble Laurent expansion:\>\"", "]"}], 
