          RowBox[{"Pi", "^", "2"}], " ", "m2"}], ")"}]}], " ", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"x", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "x"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "//", 
      "FullSimplify"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Zero-momentum slope (dimensional regularization):\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{"TraditionalForm", "[", "deltaBDRSlope", "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Step", " ", "7"}], ":", 
       RowBox[{"zero", "-", 
        RowBox[{
        "momentum", " ", "slope", " ", "with", " ", "the", " ", "sharp", " ", 
         RowBox[{"cutoff", ".", "Differentiate"}], " ", "the", " ", 
         "subtracted", " ", "integrand", " ", "at", " ", "P2"}]}]}], "=", 
      "0"}], ";", 
     RowBox[{"the", " ", "radial", " ", "integral", " ", "is", " ", 
      RowBox[{"convergent", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"deltaBCutoffSlope", "[", 
      RowBox[{
       RowBox[{"Lambda_", "?", "NumericQ"}], ",", 
       RowBox[{"ms_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "ms"}], " ", 
        RowBox[{
         RowBox[{"k", "^", "3"}], "/", 
         RowBox[{"(", 
          RowBox[{"8", " ", 
           RowBox[{"Pi", "^", "2"}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"k", "^", "2"}], "+", "ms"}], ")"}], "^", "4"}]}], 
          ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "Lambda"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "30"}], ",", 
       RowBox[{"AccuracyGoal", "->", "12"}], ",", 
       RowBox[{"PrecisionGoal", "->", "12"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"deltaBCutoffSlopeLimitExact", "=", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "m2"}], " ", 
         RowBox[{
          RowBox[{"k", "^", "3"}], "/", 
          RowBox[{"(", 
           RowBox[{"8", " ", 
            RowBox[{"Pi", "^", "2"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"k", "^", "2"}], "+", "m2"}], ")"}], "^", "4"}]}], 
           ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "Infinity"}], "}"}], ",", 
        RowBox[{"Assumptions", "->", 
         RowBox[{"m2", ">", "0"}]}]}], "]"}], "//", "FullSimplify"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Zero-momentum slope (sharp-cutoff limit):\>\"", "]"}], 
    ";"}], "\n", 
