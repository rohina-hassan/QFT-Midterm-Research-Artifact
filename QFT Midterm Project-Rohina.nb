Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Copying", " ", "the", " ", "supplied", " ", "FeynArts", " ", "model", " ",
     "files", " ", "into", " ", "the", " ", "FeynArts", " ", "Models", " ", 
    "directory", " ", "so", " ", "that", " ", "FeynArts", " ", "can", " ", 
    "locate", " ", 
    RowBox[{"them", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Scan", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"file", ",", 
        RowBox[{"CopyFile", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"phi4ExampleDirectory", ",", "file"}], "}"}], "]"}], ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"modelDirectory", ",", "file"}], "}"}], "]"}], ",", 
          RowBox[{"OverwriteTarget", "->", "True"}]}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Phi4.mod\>\"", ",", "\"\<Phi4.gen\>\"", 
        ",", "\"\<Phi4.pars\>\""}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{"FileNames", "[", 
    RowBox[{"\"\<Phi4.*\>\"", ",", "modelDirectory"}], "]"}]}]}]], "Input",
