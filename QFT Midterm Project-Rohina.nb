Cell[CellGroupData[{

Cell[TextData[StyleBox["2.3.3 Connection to the Critical Isotherm of Water",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.5254901960784314, 0.3843137254901961, 
   0.49019607843137253`]]], "Subsubsection",
 CellChangeTimes->{{4.004298995878111*^9, 
  4.0042990073280697`*^9}},ExpressionUUID->"754be4cb-4199-114c-9c89-\
4fcf18740e7d"],

Cell[TextData[{
 StyleBox["The critical-isotherm exponent ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"68c9507d-b9b7-1945-b5c9-5b0532d0bcf1"],
 StyleBox[" also characterizes the equation of state of a fluid near its \
critical point. To connect our field-theoretic result with the experimentally \
observable behavior of water, we identify the order parameter with the \
deviation of the mass density from its critical value and the conjugate \
external field with the deviation of the pressure from its critical value:\n\n\
                                                                              \
                                                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[Proportional]", "\[CapitalDelta]\[Rho]", 
         ",    ", 
         StyleBox["h", "TI"], "\[Proportional]", 
         StyleBox["P", "TI"], "-", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["c", "TI"]], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "M\\propto\\Delta\\rho,\\qquad h\\propto P-P_c,", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2d59965f-0680-9842-9c36-a12b30392c30"],
 StyleBox["                                                                   \
                                            (A-102)\n\nwhere ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]\[Rho]", "\[LongEqual]", "\[Rho]", "-", 
         SubscriptBox["\[Rho]", 
          StyleBox["c", "TI"]], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Delta\\rho=\\rho-\\rho_c,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6c216515-29b4-d84c-b9f2-1109c1a4d6c3"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Rho]", 
        StyleBox["c", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho_c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7bb61004-ac61-454d-b520-0cbafa61a520"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["c", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "P_c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f4fc335d-291a-9847-b9ac-4efe5b06cd93"],
 StyleBox[" denote the critical density and critical pressure, respectively. \
These identifications express the correspondence between the scalar order \
parameter and the density deviation, and between the external source and the \
thermodynamic field conjugate to the order parameter. They represent a \
mapping between the field theory and the fluid near criticality, rather than \
an exact microscopic equivalence.\nThe identification can be motivated as \
follows: In the lattice-gas picture of a fluid, the Ising spin corresponds to \
the site occupation, so ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[Proportional]", "\[Rho]", "-", 
         SubscriptBox["\[Rho]", 
          StyleBox["c", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M\\propto\\rho-\\rho_c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"81d8ff97-0b8e-b34d-b605-78e198196a71"],
 StyleBox[", and the magnetic field corresponds to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Mu]", "-", 
         SubscriptBox["\[Mu]", 
          StyleBox["c", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu-\\mu_c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"bf3651ff-4f94-8045-91de-3e20d64df2fc"],
 StyleBox[". Along an isotherm the Gibbs\[Dash]Duhem relation gives ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], 
         StyleBox["P", "TI"], "\[LongEqual]", "\[Rho]", "\[DifferentialD]", 
         "\[Mu]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "dP=\\rho\\,d\\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a1d26b38-b35c-2644-ae0d-6c1ed6fcf10a"],
 StyleBox[", so ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "-", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["c", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Rho]", 
          StyleBox["c", "TI"]], 
         RowBox[{"(", 
           RowBox[{"\[Mu]", "-", 
             SubscriptBox["\[Mu]", 
              StyleBox["c", "TI"]]}], ")"}], "+", "\[Integral]", 
         "\[CapitalDelta]\[Rho]", "\[DifferentialD]", "\[Mu]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "P-P_c=\\rho_c(\\mu-\\mu_c)+\\int\\Delta\\rho\\,d\\mu", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"537e1a43-b7af-d646-85d3-4d7ab0b5efff"],
 StyleBox[", and the second term is higher order in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       TemplateBox[{
         RowBox[{"\[CapitalDelta]\[Rho]"}]}, "Abs"], TraditionalForm], 
     "errors" -> {}, "input" -> "|\\Delta\\rho|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6626ae13-8632-5c45-8e7d-df7830333396"],
 StyleBox[". Hence ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], "\[Proportional]", 
         StyleBox["P", "TI"], "-", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["c", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "h\\propto P-P_c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"910f56b5-1acc-7b43-9755-63dbeb125cbf"],
 StyleBox[" to leading order, and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "-", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["c", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "P-P_c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cfafd740-5761-064e-8bdf-e0beacd62831"],
 StyleBox[" has the sign of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Rho]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1aaacdf7-8eeb-f14d-acdf-f9f186341325"],
 StyleBox[". Real fluids lack an exact ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[Rule]", "-", "\[Rho]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\rho\\to-\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"27d74270-481f-a943-8f04-90ed238f781b"],
 StyleBox[" symmetry, and the resulting field mixing produces only subleading \
corrections. This is a physical argument, not a derivation from the field \
theory.\n\nAlong the critical isotherm, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["c", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "T=T_c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f5bed67a-b897-d44d-aa0c-112e5a40cbc1"],
 StyleBox[", the scaling relation ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[Proportional]", 
         SuperscriptBox[
          StyleBox["h", "TI"], 
          RowBox[{"1", "/", "\[Delta]"}]]}], TraditionalForm], "errors" -> {},
      "input" -> "M\\propto h^{1/\\delta}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"014ea24a-d6c3-3549-8ab4-24b0581c3502"],
 StyleBox[", or equivalently ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], "\[Proportional]", 
         RowBox[{
           StyleBox["s", "TI"], 
           StyleBox["g", "TI"], 
           StyleBox["n", "TI"]}], 
         RowBox[{"(", 
           StyleBox["M", "TI"], ")"}], "|", 
         StyleBox["M", "TI"], 
         SuperscriptBox["|", "\[Delta]"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "h\\propto\\operatorname{sgn}(M)|M|^\\delta", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2cb6cbcc-f4b6-814b-ada8-74faf040cfcd"],
 StyleBox[", therefore translates into the equation of state:\n\n             \
                                                                              \
                                ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["P", "TI"], "-", 
            SubscriptBox[
             StyleBox["P", "TI"], 
             StyleBox["c", "TI"]]}], 
          SubscriptBox[
           StyleBox["P", "TI"], 
           StyleBox["c", "TI"]]], "\[LongEqual]", 
         StyleBox["A", "TI"], " ", 
         RowBox[{
           StyleBox["s", "TI"], 
           StyleBox["g", "TI"], 
           StyleBox["n", "TI"]}], 
         RowBox[{"(", "\[CapitalDelta]\[Rho]", ")"}], 
         SuperscriptBox[
          TemplateBox[{
            RowBox[{
              FractionBox["\[CapitalDelta]\[Rho]", 
               SubscriptBox["\[Rho]", 
                StyleBox["c", "TI"]]]}]}, "Abs"], "\[Delta]"], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{P-P_c}{P_c}\n=\nA\\,\\operatorname{sgn}(\\Delta\\rho)\n\
\\left|\\frac{\\Delta\\rho}{\\rho_c}\\right|^\\delta,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e498dec3-9d4a-9545-bc88-d3489b75a7d8"],
 StyleBox["                                                                   \
                                (A-103)\n\nvalid at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["c", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "T=T_c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"041b9bb9-4bec-ea40-82b4-9ae56b749e9f"],
 StyleBox[" for ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", "\[CapitalDelta]\[Rho]", "|", "/", 
         SubscriptBox["\[Rho]", 
          StyleBox["c", "TI"]], "\[LessLess]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "|\\Delta\\rho|/\\rho_c\\ll1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1a781218-e006-7d4a-9a77-b6fac30d7f37"],
 StyleBox[", where ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["C", "TI"], "field"], " ", 
            SubsuperscriptBox[
             StyleBox["C", "TI"], "order", "\[Delta]"], " ", 
            SubsuperscriptBox["\[Rho]", 
             StyleBox["c", "TI"], "\[Delta]"]}], 
          RowBox[{
            SubscriptBox[
             StyleBox["C", "TI"], "source"], " ", 
            SubscriptBox[
             StyleBox["P", "TI"], 
             StyleBox["c", "TI"]]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "A=\\frac{C_{\\rm field}\\,C_{\\rm \
order}^{\\delta}\\,\\rho_c^{\\delta}}{C_{\\rm source}\\,P_c}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"aa486dd8-10b0-da49-8cfd-8e0f2c7b1a96"],
 StyleBox[" is a dimensionless, nonuniversal amplitude fixed by the \
normalizations of the two proportionalities, while ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"43bc80d1-f9a1-fa4c-b6bb-2d3f6118598e"],
 StyleBox[" is universal. The sign factor ensures that the pressure deviation \
changes sign with the density deviation, consistently describing both \
branches of the critical isotherm.\n\nUsing the two-loop ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"753527bd-c103-884a-aea2-6feca2d5ef0c"],
 StyleBox["-expansion evaluated at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e8b5f911-204c-484e-847c-b41642765158"],
 StyleBox[", we obtained:\n\n                                                 \
                                                                              \
 ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]", "theory"], "\[LongEqual]", 
         FractionBox["241", "54"], "\[TildeTilde]", "4.463."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta_{\\text{theory}}=\\frac{241}{54}\\approx4.463.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2f97dc1c-a9d8-ac43-b278-18bc584a504d"],
 StyleBox["                                                                   \
                                         (A-104)\n\nFor comparison, the \
experimental critical-isotherm fit for water reported by Straub gives ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]", "water"], "\[TildeTilde]", "4.324."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta_{\\text{water}}\\approx4.324.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"db3f28cc-3407-d545-9d3a-7f237b47fbe0"],
 " ",
 StyleBox["The difference reflects the truncation of the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ccc65dd5-3f17-b346-9d9f-9d6ef394d52a"],
 StyleBox["-expansion at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b7b6a9fb-87b3-6449-bf14-47dab09ad62e"],
 StyleBox[". It should not be read as a validation of the calculation: the \
liquid-gas critical point belongs to the three-dimensional Ising class, whose \
accurate ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f7a2f5c7-a9cc-714e-9f98-ffe632473e07"],
 StyleBox[" is the bootstrap value compared in Section 2.3.4, and the value \
4.324 is an external fit that I take as given by the assignment.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{
  4.0043012570146523`*^9, {4.004301299270109*^9, 4.004301448757124*^9}, {
   4.0043015424639416`*^9, 4.0043015968742294`*^9}, {4.004302027873434*^9, 
   4.0043023625132256`*^9}},ExpressionUUID->"d7653231-faed-b247-b255-\
82547bc4dd31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "1."}]}], " ", "Field"}], "-", 
    RowBox[{
    "theory", " ", "isotherm", " ", "and", " ", "the", " ", "two", " ", 
     "mappings", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"symbolic", " ", "statements"}], ")"}], "--"}]}], "-"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"criticalIsothermRelation", "=", 
     RowBox[{"h", "==", 
      RowBox[{"Cfield", " ", 
       RowBox[{"Sign", "[", "M", "]"}], " ", 
       RowBox[{
        RowBox[{"Abs", "[", "M", "]"}], "^", "delta"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"orderParameterMapping", "=", 
     RowBox[{"M", "==", 
      RowBox[{"Corder", " ", 
       RowBox[{"(", 
        RowBox[{"rho", "-", "rhoC"}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"externalFieldMapping", "=", 
     RowBox[{"h", "==", 
      RowBox[{"Csource", " ", 
       RowBox[{"(", 
        RowBox[{"P", "-", "Pc"}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Field-theory critical isotherm:\>\"", "]"}], 
    ";"}], "\n", "criticalIsothermRelation", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Order-parameter mapping:\>\"", "]"}], ";"}], "\n",
    "orderParameterMapping", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<External-field mapping:\>\"", "]"}], ";"}], "\n",
    "externalFieldMapping", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "2."}]}], " ", "Derive", " ", "the", " ", "fluid", " ", 
      "equation", " ", "of", " ", "state", " ", "from", " ", "the", " ", 
      RowBox[{"mappings", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"assum", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Corder", ">", "0"}], ",", 
       RowBox[{"Csource", ">", "0"}], ",", 
       RowBox[{"Cfield", ">", "0"}], ",", 
       RowBox[{"rhoC", ">", "0"}], ",", 
       RowBox[{"Pc", ">", "0"}], ",", 
       RowBox[{"delta", ">", "0"}], ",", 
       RowBox[{"u", ">", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Solve", " ", "h"}], "=", 
      RowBox[{
       RowBox[{"Csource", " ", 
        RowBox[{"(", 
         RowBox[{"P", "-", "Pc"}], ")"}]}], "=", 
       RowBox[{"Cfield", " ", 
        RowBox[{"Sign", "[", "M", "]"}], " ", 
        RowBox[{
         RowBox[{"Abs", "[", "M", "]"}], "^", "delta"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"with", " ", "M"}], "=", 
      RowBox[{"Corder", " ", 
       RowBox[{"(", 
        RowBox[{"rho", "-", "rhoC"}], ")"}]}]}], ",", 
     RowBox[{"for", " ", "P"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pressureFromMapping", "[", "dr_", "]"}], ":=", 
     RowBox[{"Pc", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Cfield", "/", "Csource"}], ")"}], " ", 
       RowBox[{"Sign", "[", 
        RowBox[{"Corder", " ", "dr"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Corder", " ", "dr"}], "]"}], "^", "delta"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Target", " ", 
      RowBox[{"form", ":", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"P", "-", "Pc"}], ")"}], "/", "Pc"}]}]}], "=", 
     RowBox[{"A", " ", 
      RowBox[{"Sign", "[", "drho", "]"}], " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"drho", "/", "rhoC"}], "]"}], "^", "delta"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Aderived", "=", 
     RowBox[{"Cfield", " ", 
      RowBox[{"Corder", "^", "delta"}], " ", 
      RowBox[{
       RowBox[{"rhoC", "^", "delta"}], "/", 
       RowBox[{"(", 
        RowBox[{"Csource", " ", "Pc"}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"eosTarget", "[", "dr_", "]"}], ":=", 
     RowBox[{"Pc", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Aderived", " ", 
         RowBox[{"Sign", "[", "dr", "]"}], " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"dr", "/", "rhoC"}], "]"}], "^", "delta"}]}]}], ")"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"eosCheck", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"PowerExpand", "[", 
           RowBox[{
            RowBox[{"pressureFromMapping", "[", "u", "]"}], "-", 
            RowBox[{"eosTarget", "[", "u", "]"}]}], "]"}], ",", "assum"}], 
         "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"PowerExpand", "[", 
           RowBox[{
            RowBox[{"pressureFromMapping", "[", 
             RowBox[{"-", "u"}], "]"}], "-", 
            RowBox[{"eosTarget", "[", 
             RowBox[{"-", "u"}], "]"}]}], "]"}], ",", "assum"}], "]"}], "==", 
        "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Numerical", " ", "cross"}], "-", 
     RowBox[{
     "check", " ", "on", " ", "both", " ", "branches", " ", "of", " ", "the", 
      " ", "isotherm"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"numericSubs", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cfield", "->", "1.3"}], ",", 
       RowBox[{"Corder", "->", "0.7"}], ",", 
       RowBox[{"Csource", "->", "2.1"}], ",", 
       RowBox[{"rhoC", "->", "322."}], ",", 
       RowBox[{"Pc", "->", "22.06"}], ",", 
       RowBox[{"delta", "->", 
        RowBox[{"241", "/", "54"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eosNumericCheck", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"pressureFromMapping", "[", "dr", "]"}], "-", 
             RowBox[{"eosTarget", "[", "dr", "]"}]}], ")"}], "/.", " ", 
           "numericSubs"}], "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"dr", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "30."}], ",", 
            RowBox[{"-", "5."}], ",", "5.", ",", "30."}], "}"}]}], "}"}]}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Nonuniversal amplitude A in terms of the mapping \
constants:\>\"", "]"}], ";"}], "\n", "Aderived", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Equation-of-state derivation check on both branches \
(expected: {True, True}):\>\"", "]"}], ";"}], "\n", "eosCheck", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Numerical cross-check (expected: True):\>\"", "]"}], 
    ";"}], "\n", "eosNumericCheck", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Critical-isotherm equation of state for water:\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"P", "-", "Pc"}], ")"}], "/", "Pc"}], "==", 
    RowBox[{"A", " ", 
     RowBox[{"Sign", "[", 
      RowBox[{"rho", "-", "rhoC"}], "]"}], " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"rho", "-", "rhoC"}], ")"}], "/", "rhoC"}], "]"}], "^", 
      "delta"}]}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "3."}]}], " ", "Two"}], "-", 
      RowBox[{"loop", " ", "theoretical", " ", "prediction"}]}], ",", 
     RowBox[{
      RowBox[{"linked", " ", "to", " ", "Section", " ", "2.3", 
       RowBox[{".2", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"deltaTheory", "=", "deltaThreeDimensional"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaTheoryNumerical", "=", 
     RowBox[{"N", "[", 
      RowBox[{"deltaTheory", ",", "8"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Two-loop theoretical prediction for delta:\>\"", "]"}],
     ";"}], "\n", "deltaTheory", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Numerical theoretical prediction:\>\"", "]"}], 
    ";"}], "\n", "deltaTheoryNumerical", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "4."}]}], " ", "External", " ", "reference", " ", "value",
       " ", 
      RowBox[{"(", 
       RowBox[{"Straub", " ", "fit"}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"an", " ", "input", " ", "to", " ", "the", " ", "comparison", " ", 
       RowBox[{"only", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"deltaWaterExperimental", "=", 
     RowBox[{"4324", "/", "1000"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Experimental critical-isotherm exponent for water \
(external input):\>\"", "]"}], ";"}], "\n", 
   RowBox[{"N", "[", 
    RowBox[{"deltaWaterExperimental", ",", "4"}], "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "5."}]}], " ", "Compare", " ", "theory", " ", "and", " ", 
      "the", " ", "water", " ", 
      RowBox[{"fit", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"deltaAbsoluteDifference", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"deltaTheory", "-", "deltaWaterExperimental"}], "]"}], ",", 
       "8"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaRelativeDifference", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"100", " ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"deltaTheory", "-", "deltaWaterExperimental"}], "]"}], "/", 
         "deltaWaterExperimental"}]}], ",", "6"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Absolute difference:\>\"", "]"}], ";"}], "\n", 
   "deltaAbsoluteDifference", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Relative difference (percent):\>\"", "]"}], 
    ";"}], "\n", "deltaRelativeDifference", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "6."}]}], " ", "Final", " ", "consistency", " ", 
      RowBox[{"checks", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"waterIsothermChecks", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"And", "@@", "eosCheck"}], ",", "eosNumericCheck", ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"deltaTheory", "-", 
          RowBox[{"(", 
           RowBox[{"3", "+", "1", "+", 
            RowBox[{"25", "/", "54"}]}], ")"}]}], "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"deltaRelativeDifference", "-", "3.21376"}], "]"}], "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "4"}]}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Final consistency checks (expected: {True, True, True, \
True}):\>\"", "]"}], ";"}], "\n", "waterIsothermChecks"}]}]], "Input",
