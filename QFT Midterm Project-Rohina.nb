  FontSize->13,ExpressionUUID->"c07f17b8-fd6f-454b-8c07-08aeec3b2b3b"],
 StyleBox[", and the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
