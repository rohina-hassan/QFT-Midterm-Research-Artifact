 CellLabel->"In[8]:=",ExpressionUUID->"4501a5df-a4ee-4d46-a6f2-74c813713b0c"],

Cell["Successfully patched FeynArts.", "Print",
 CellChangeTimes->{4.003899466330263*^9, 4.00390623115559*^9, 
  4.003909590302393*^9, 4.003915063569063*^9, 4.0039162816708355`*^9, 
  4.0039167990831947`*^9, 4.003917335127783*^9, 4.00400052854426*^9, 
  4.004005333247139*^9, 4.0040054781038876`*^9, 4.004005748864992*^9, 
  4.0040092161501617`*^9, 4.004154071240679*^9, 4.0041595006539097`*^9, 
  4.0041596597422314`*^9, 4.0041597085076847`*^9, 4.0041599214956856`*^9, 
  4.0041611923187065`*^9, 4.004162189839445*^9, 4.0041628177475224`*^9, 
  4.0041688454710903`*^9, 4.004181048925049*^9, 4.0041824871075687`*^9, 
  4.0041892800664387`*^9, 4.004198743334423*^9, 4.0042006385537243`*^9, 
  4.00420091733333*^9, 4.004201197374195*^9, 4.004242226859806*^9, 
  4.004245865735964*^9, 4.004246523292856*^9, 4.004250882854786*^9, 
  4.004291746211399*^9, 4.004291869325329*^9, 4.004299327880129*^9},
 CellLabel->
  "During evaluation of \
In[8]:=",ExpressionUUID->"c78883cb-7bab-6740-b89c-8fa681351e82"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Specifying", " ", "the", " ", "classes", " ", "model", " ", "and", " ", 
     "generic", " ", "model", " ", "used", " ", "for", " ", "Feynman"}], "-", 
    RowBox[{"diagram", " ", 
     RowBox[{"generation", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"phi4ModelOptions", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"InsertionLevel", "->", 
       RowBox[{"{", "Particles", "}"}]}], ",", 
      RowBox[{"Model", "->", "\"\<Phi4\>\""}], ",", 
      RowBox[{"GenericModel", "->", "\"\<Phi4\>\""}]}], "}"}]}], 
   ";"}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
