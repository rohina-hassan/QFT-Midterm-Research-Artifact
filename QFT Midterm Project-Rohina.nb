Cell[CellGroupData[{

Cell[TextData[StyleBox["1.3.3 Regulator Independence and Finite Differences",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.0038163461960506`*^9, 4.003816346196539*^9}, 
   4.0038163777208233`*^9, 4.004012132637287*^9, 
   4.00417599562619*^9},ExpressionUUID->"cda76805-0818-ad47-b747-\
081d0a5ec197"],

Cell[TextData[{
 StyleBox["Having determined the counterterms required to absorb the \
ultraviolet divergences, we now examine the regulator independence of the \
finite momentum-dependent contribution to the one-loop four-point function. \
We focus on the difference between the bubble integral at nonzero external \
momentum and its zero-momentum value, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ")"}], "\[LongEqual]", 
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ")"}], "-", 
         StyleBox["B", "TI"], 
         RowBox[{"(", "0", ")"}], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Delta B(P^2)=B(P^2)-B(0).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"385e0516-5bd1-e841-bf26-ab14a19789bf"],
 StyleBox["\nAlthough the individual bubble integrals are ultraviolet \
divergent, their difference is finite because the momentum-independent \
divergence cancels upon subtraction. We evaluate ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta B(P^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"20443ff8-a75b-a547-846c-66fbd6a94c03"],
 StyleBox[" independently using a sharp momentum cutoff ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalLambda]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c54851ed-0ddd-1a45-9a62-0d3a55ad68f2"],
 StyleBox[" and dimensional regularization with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d=4-\\epsilon", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"fb0c1ee8-93b7-6444-8345-fa7f6e11aa9c"],
 StyleBox[". For the cutoff calculation, we first construct the convergent \
difference using the same loop-momentum routing in both integrals and take \
the limit ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalLambda]", "\[Rule]", "\[Infinity]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\Lambda\\to\\infty", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2ee98fbc-5f72-334a-9ab1-6b1f4c790b2b"],
 StyleBox[" before performing any loop-momentum shift. In dimensional \
regularization, we obtain the corresponding finite expression by taking the \
limit ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[Rule]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon\\to0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d192712c-c8e2-0041-9f6e-dc3864ccbe0f"],
 StyleBox[". (A-51)\n\nWe then compare the resulting expressions in both \
schemes, including their derivatives at zero external momentum:\n\n           \
                                                                              \
                                               ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{
          FractionBox[
           RowBox[{
             StyleBox["d", "TI"], " ", "\[CapitalDelta]", 
             StyleBox["B", "TI"], 
             RowBox[{"(", 
               SuperscriptBox[
                StyleBox["P", "TI"], "2"], ")"}]}], 
           RowBox[{
             StyleBox["d", "TI"], 
             SuperscriptBox[
              StyleBox["P", "TI"], "2"]}]], "\[VerticalSeparator]"}], 
        RowBox[{
          SuperscriptBox[
           StyleBox["P", "TI"], "2"], "\[LongEqual]", "0"}]], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\left.\\frac{d\\,\\Delta B(P^2)}{dP^2}\\right|_{P^2=0}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"382c3e7a-c347-3d4a-b5ee-4fc50cdca5e2"],
 StyleBox["\n\n",
  FontSize->13],
 StyleBox["Results in the two regularization schemes:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\[LineSeparator]In dimensional regularization, the \
momentum-independent UV pole cancels upon subtracting the zero-momentum \
bubble from the finite-momentum bubble. Taking the limit ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[Rule]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon\\to0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"bf9cc012-cb63-b542-aaec-e7d58cd5cc58"],
 StyleBox[", the resulting finite difference is:\n\n                          \
                                     ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         SubscriptBox[
          StyleBox["B", "TI"], 
          RowBox[{
            StyleBox["m", "TI"], 
            StyleBox["D", "TI"], 
            StyleBox["R", "TI"]}]], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ")"}], "\[LongEqual]", "-", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         SubsuperscriptBox["\[Integral]", "0", "1"], 
         StyleBox["d", "TI"], 
         StyleBox["x", "TI"], " ", "ln", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             FractionBox[
              RowBox[{
                StyleBox["x", "TI"], 
                RowBox[{"(", 
                  RowBox[{"1", "-", 
                    StyleBox["x", "TI"]}], ")"}], 
                SuperscriptBox[
                 StyleBox["P", "TI"], "2"]}], 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]]}], ")"}], "\n"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Delta B_{\\r m DR}(P^2)\n=-\\frac{1}{16\\pi^2}\n\\int_0^1 dx\\,\n\\ln\
\\left(1+\\frac{x(1-x)P^2}{m^2} \\right)\\\\[2mm]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f8637517-a693-fb46-9ff1-b89446e0a065"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LongEqual]", "-", 
         FractionBox["1", 
          RowBox[{"8", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{
             SqrtBox[
              RowBox[{"1", "+", 
                FractionBox[
                 RowBox[{"4", 
                   SuperscriptBox[
                    StyleBox["m", "TI"], "2"]}], 
                 SuperscriptBox[
                  StyleBox["P", "TI"], "2"]]}]], " ", 
             SuperscriptBox["sinh", "-1"], 
             RowBox[{"(", 
               FractionBox[
                SqrtBox[
                 SuperscriptBox[
                  StyleBox["P", "TI"], "2"]], 
                RowBox[{"2", 
                  StyleBox["m", "TI"]}]], ")"}], "-", "1"}], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "=-\\frac{1}{8\\pi^2}\n\\left[\n\\sqrt{1+\\frac{4m^2}{P^2}}\\,\n\
\\sinh^{-1}\\left(\\frac{\\sqrt{P^2}}{2m} \\right)-1\n \\right]", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3ea123c2-8db9-2540-8d6d-a9ff6e8b6894"],
 StyleBox["                                                  (A-52)",
  FontSize->13],
 StyleBox["\nFor the sharp momentum cutoff, the subtraction must be performed \
before integration, with both bubble integrals evaluated over the same \
original momentum domain. Performing the angular integration over ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["S", "TI"], "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "S^3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "38439406-6e1f-da43-94bf-dca4428fb08a"],
 StyleBox[" without shifting the loop momentum gives:\n\n                     \
                                                                 ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         SubscriptBox[
          StyleBox["B", "TI"], "\[CapitalLambda]"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ")"}], "\[LongEqual]", 
         SubsuperscriptBox["\[Integral]", "0", "\[CapitalLambda]"], 
         StyleBox["d", "TI"], 
         StyleBox["k", "TI"], " ", 
         FractionBox[
          RowBox[{"-", 
            SuperscriptBox[
             StyleBox["k", "TI"], "3"], 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"], 
            SuperscriptBox[
             StyleBox["P", "TI"], "2"]}], 
          RowBox[{"2", 
            SuperscriptBox["\[Pi]", "2"], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 SuperscriptBox[
                  StyleBox["k", "TI"], "2"], "+", 
                 SuperscriptBox[
                  StyleBox["m", "TI"], "2"]}], ")"}], "2"], 
            RowBox[{"(", 
              RowBox[{
                SuperscriptBox[
                 StyleBox["k", "TI"], "2"], "+", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"], "-", 
                SuperscriptBox[
                 StyleBox["P", "TI"], "2"], "+", 
                StyleBox["R", "TI"]}], ")"}], 
            RowBox[{"(", 
              RowBox[{
                SuperscriptBox[
                 StyleBox["k", "TI"], "2"], "+", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"], "+", 
                SuperscriptBox[
                 StyleBox["P", "TI"], "2"], "+", 
                StyleBox["R", "TI"]}], ")"}]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Delta B_\\Lambda(P^2)\n=\n\\int_0^\\Lambda dk\\,\n\\frac{-k^3m^2P^2}\n\
{2\\pi^2(k^2+m^2)^2\n(k^2+m^2-P^2+R)\n(k^2+m^2+P^2+R)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"eaea58fd-d9d6-5b4f-8253-9a82ec267688"],
 StyleBox["                                                                   \
   (A-53)",
  FontSize->13],
 StyleBox["\n\nwhere ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 SuperscriptBox[
                  StyleBox["k", "TI"], "2"], "+", 
                 SuperscriptBox[
                  StyleBox["m", "TI"], "2"], "+", 
                 SuperscriptBox[
                  StyleBox["P", "TI"], "2"]}], ")"}], "2"], "-", "4", 
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], 
            SuperscriptBox[
             StyleBox["P", "TI"], "2"]}]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "R=\\sqrt{(k^2+m^2+P^2)^2-4k^2P^2}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4fad49de-8027-5a44-b5eb-1b6b2d60758f"],
 " ",
 StyleBox["The subtracted radial integrand is UV convergent, so the limit ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalLambda]", "\[Rule]", "\[Infinity]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\Lambda\\to\\infty", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7fded106-0214-e545-9602-4caf76a75e13"],
 StyleBox[" ",
  FontSize->13],
 StyleBox["exists. Moreover, the regulator-removed sharp-cutoff result agrees \
with the dimensional-regularization result, demonstrating the regulator \
independence of the finite bubble difference.\nFinally, expanding the finite \
difference around \\(P^2=0\\) yields the same zero-momentum slope in both \
schemes:\n\n                                                                  \
                                                        ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{
            FractionBox[
             RowBox[{
               StyleBox["d", "TI"], " ", "\[CapitalDelta]", 
               StyleBox["B", "TI"], 
               RowBox[{"(", 
                 SuperscriptBox[
                  StyleBox["P", "TI"], "2"], ")"}]}], 
             RowBox[{
               StyleBox["d", "TI"], 
               SuperscriptBox[
                StyleBox["P", "TI"], "2"]}]], "\[VerticalSeparator]"}], 
          RowBox[{
            SuperscriptBox[
             StyleBox["P", "TI"], "2"], "\[LongEqual]", "0"}]], 
         "\[LongEqual]", "-", 
         FractionBox["1", 
          RowBox[{"96", 
            SuperscriptBox["\[Pi]", "2"], 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\left.\n\\frac{d\\,\\Delta B(P^2)}{dP^2}\n \\right|_{P^2=0}\n\
=-\\frac{1}{96\\pi^2m^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"85873803-414a-2146-8330-2dc4ff6ae2da"],
 StyleBox["                                                                   \
                                              (A-54)",
  FontSize->13],
 StyleBox["\n\nAgreement between these results demonstrates that the finite \
momentum dependence of the one-loop bubble contribution is independent of the \
regularization scheme. This provides an explicit consistency check of the \
renormalization procedure: the counterterms absorb the regulator-dependent \
divergences, while the finite momentum-dependent contribution to the \
four-point function remains unchanged.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004179847266287*^9, 4.0041799731470375`*^9}, {
   4.004180015527504*^9, 4.0041800299964695`*^9}, 4.0042515833724613`*^9, {
   4.0042516170150166`*^9, 4.0042516892860985`*^9}, {4.004251753900488*^9, 
   4.004251963958723*^9}, {4.0042528692750034`*^9, 4.0042528694176006`*^9}, {
   4.004252956888851*^9, 
   4.0042529621196785`*^9}},ExpressionUUID->"315cfe06-0eb5-da46-b485-\
e006c47ca55c"],

