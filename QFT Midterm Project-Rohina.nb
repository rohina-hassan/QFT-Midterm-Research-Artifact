           RowBox[{"Flatten", "[", 
            RowBox[{"{", "twoPointPaVeReadable", "}"}], "]"}]}], "]"}], "/.", 
         " ", "faToProject"}], ")"}], "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "twoPointOneLoopCorrection"}], ")"}], "/.", " ", 
         "euclideanToPaVe"}], ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
