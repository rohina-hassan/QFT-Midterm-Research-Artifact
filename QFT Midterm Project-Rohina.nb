Cell[TextData[{
 StyleBox["Note on the numerical comparison:",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.36470588235294116`, 0.36470588235294116`, 0.36470588235294116`]],
 "\n",
 StyleBox["The bootstrap input ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", "\[Sigma]"], "\[LongEqual]", 
         "0.518148806", 
         RowBox[{"(", "24", ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Delta_\\sigma=0.518148806(24)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"853d4aa3-7c11-c94b-b957-2e73c6403f00"],
 StyleBox[" is entered as an exact rational, so all quoted digits are \
genuine. It gives ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Eta]", 
          StyleBox["B", "TI"]], "\[LongEqual]", "2", 
         SubscriptBox["\[CapitalDelta]", "\[Sigma]"], "-", "1", 
         "\[LongEqual]", "0.036297612"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\eta_B=2\\Delta_\\sigma-1=0.036297612", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"dea6d7fc-fa30-9948-ba9c-f0f5473ed89e"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]", 
          StyleBox["B", "TI"]], "\[LongEqual]", "3", "/", 
         SubscriptBox["\[CapitalDelta]", "\[Sigma]"], "-", "1", 
         "\[LongEqual]", "4.789842542"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta_B=3/\\Delta_\\sigma-1=4.789842542", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"084101d6-5ce5-b741-9770-73558e880202"],
 StyleBox[", with propagated uncertainties of about ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"4.8", "\[Cross]", 
         SuperscriptBox["10", "-8"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "4.8\\times10^{-8}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"615e256a-2cd1-f041-b4e2-33ef26216a5e"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2.7", "\[Cross]", 
         SuperscriptBox["10", "-7"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "2.7\\times10^{-7}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6bc617fa-072d-0846-b400-bbb8ffc2a457"],
 StyleBox[". These are negligible compared with the gaps to our predictions, \
so the differences below are not caused by the bootstrap error. As a \
consistency check, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Delta]", 
        StyleBox["B", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta_B", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cba73895-8b0f-c04a-b4a0-ffb6b46dcff2"],
 StyleBox[" equals the scaling relation of Section 2.3.1 evaluated at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "d=3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ac3d4de6-157e-2846-a139-f2131adeb669"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", 
         SubscriptBox["\[Eta]", 
          StyleBox["B", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta=\\eta_B", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4060a117-a788-9443-aec4-0ea2c251b25a"],
 StyleBox[", and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", "\[Sigma]"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox["\[Eta]", 
              StyleBox["B", "TI"]]}], ")"}], "/", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta_\\sigma=(1+\\eta_B)/2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9cd4f23c-65f0-b145-bc7a-56fd54feb101"],
 StyleBox[" is the scaling dimension ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalDelta]", "\[Phi]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"54162124-2739-a04c-9723-bdb21e6d41d0"],
 StyleBox[" of Section 2.3.1.\n\nThe two-loop predictions at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0a69ee92-8790-644a-92f2-2997e025e2a1"],
 StyleBox[" are ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[Eta]", "\[LongEqual]", "1", "/", "54", "\[TildeTilde]", 
         "0.01852"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta=1/54\\approx0.01852", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e5cab7d2-4243-7949-a321-2c28fd6259bf"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[Delta]", "\[LongEqual]", "241", "/", "54", "\[TildeTilde]", 
         "4.4630"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta=241/54\\approx4.4630", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0e348e0c-9cc0-484c-ab88-d6ccb6c34ac2"],
 StyleBox[". Relative to the bootstrap values they differ by 49.0% for ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"abb4f177-2332-b94e-9206-69d1a4f584ee"],
 StyleBox[" and 6.82% for ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"dd4ca16c-8124-6645-9a71-52309a90a151"],
 StyleBox[", and the predicted scattering slope is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         RowBox[{"(", 
           RowBox[{"2", "-", "\[Eta]"}], ")"}], "\[LongEqual]", "-107", "/", 
         "54", "\[TildeTilde]", "-1.981"}], TraditionalForm], "errors" -> {}, 
     "input" -> "-(2-\\eta)=-107/54\\approx-1.981", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f8381eed-bdc0-2f4d-ad5d-3c675cd06a25"],
 StyleBox[", compared with -1.964 from the bootstrap. The large relative \
error in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7bd9e7f2-3cfc-be4f-9a14-da4e7ded64de"],
 StyleBox[" is expected, since ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7f57b347-a448-a344-8d0b-da2dd2bf7144"],
 StyleBox[" first appears at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox["\[Epsilon]", "2"], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(\\epsilon^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8c1d54c0-5b5c-0543-ab49-2f71e983bc13"],
 StyleBox[" with a small coefficient, so the neglected higher-order terms are \
of comparable size at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b364d341-10c8-4e4f-b028-ed99b08ab688"],
 StyleBox[". The ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1f5562a6-8793-564b-80d7-35fcce57cece"],
 StyleBox["-expansion is asymptotic, and these gaps reflect the truncation at \
$O(\\epsilon^2)$ rather than an error in the derivation.\n\nThe difference \
from the water fit, 3.21%, is smaller than the difference from the bootstrap \
value. This should not be read as a validation of the calculation. The \
liquid-gas critical point of water lies in the three-dimensional Ising \
universality class, so the bootstrap value is the accurate universal \
benchmark, while the water value ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]", "water"], "\[LongEqual]", "4.324"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta_{\\rm water}=4.324", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8ef5b321-0833-b044-8dc6-7fe930efad2f"],
 StyleBox[" is an external fit used only for comparison. The proximity of our \
truncated result to it is partly accidental.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004301748849043*^9, 
  4.0043019694015865`*^9}},ExpressionUUID->"a89e90d0-0cab-6e4a-8811-\
e621fd9972b1"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Section 2.3\[LongDash]Verification Summary",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.7725490196078432, 0.6862745098039216, 
   0.7490196078431373]]], "Subsubsection",
 CellChangeTimes->{{4.0042989022625656`*^9, 
  4.0042989054180584`*^9}},ExpressionUUID->"2ca2a6f4-1f28-ef48-a7c5-\
449a7e9b2080"],

Cell[TextData[{
 StyleBox["Question:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox["\nHow can the critical-isotherm exponent be derived from the \
scaling dimensions of the field and its conjugate source, and how do the \
resulting predictions for ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c5d8271e-392d-6243-82b4-8de7a9e1eb81"],
 StyleBox[", ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3656c312-4a48-aa49-87bc-60b503fa8258"],
 StyleBox[", and the critical scattering exponent compare with the water-fit \
and conformal-bootstrap reference values?\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
-----------------------------------------------",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox["  ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["                                         \n",
  FontSize->13],
 StyleBox["Derivation:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox["\nSections 2.3.1 to 2.3.4.\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
-----------------------------------------------  ",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" \n",
  FontSize->13],
 StyleBox["Check:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox["\nThe scaling relation ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["d", "TI"], "+", "2", "-", "\[Eta]"}], ")"}], "/", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["d", "TI"], "-", "2", "+", "\[Eta]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta=(d+2-\\eta)/(d-2+\\eta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2cf5acb0-471c-a34e-9098-61bb91039cd1"],
 StyleBox[" is verified, and its ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f3cd8f32-a8f9-9543-bedf-b560ee0f4e05"],
 StyleBox["-expansion gives ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", "\[LongEqual]", "3", "+", "\[Epsilon]", "+", 
         FractionBox["25", "54"], 
         SuperscriptBox["\[Epsilon]", "2"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta=3+\\epsilon+\\frac{25}{54}\\epsilon^2+O(\\epsilon^3)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f9a92cea-3fb4-ea46-a1b2-258e7c7bfa10"],
 StyleBox[", yielding the three-dimensional \nprediction ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[Delta]", "\[LongEqual]", "241", "/", "54", "\[TildeTilde]", 
         "4.463"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta=241/54\\approx4.463", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"280fe522-31d7-6f48-81ed-d591be1e638f"],
 StyleBox[".",
  FontSize->13],
 StyleBox[" The scattering exponent ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2", "-", "\[Eta]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "2-\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a79e374c-6d34-c942-a395-33fe61e85933"],
 StyleBox[" ",
  FontSize->13],
 StyleBox["follows from the critical two-point function. The comparison table \
consistently distinguishes the perturbative predictions from the external \
water-fit and conformal-bootstrap reference values.\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------------------------- ",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" \n",
  FontSize->13],
 StyleBox["Anchor IDs:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox["\nA-95 to A-107.\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------------------------- ",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" \n",
  FontSize->13],
 StyleBox["Status:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" ",
