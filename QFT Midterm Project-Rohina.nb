  FontSize->13,ExpressionUUID->"8a554e99-7988-a54a-a0d4-c198bbb18188"],
 StyleBox[" term of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\gamma_\\phi", "state" -> "Boxes"|>,
