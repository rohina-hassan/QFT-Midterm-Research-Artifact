Cell[TextData[{
 StyleBox["Computational Note :Sharp-Cutoff Integration (A-55)",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nThe sharp-cutoff calculation initially presented a computational \
challenge because direct symbolic integration of the momentum-dependent \
bubble integral was time-consuming. We addressed this by first forming the \
convergent difference ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], "\[CapitalLambda]"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ")"}], "-", 
         SubscriptBox[
          StyleBox["B", "TI"], "\[CapitalLambda]"], 
         RowBox[{"(", "0", ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "B_\\Lambda(P^2)-B_\\Lambda(0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"74516c72-03f5-0d45-987b-826bea1f5cbb"],
 StyleBox[", analytically performing the angular integration, and then \
numerically evaluating the remaining radial integral. We verified convergence \
as ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalLambda]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d68a442d-7b90-d24b-b1f1-bd307097f144"],
 StyleBox[" increased and obtained agreement with the \
dimensional-regularization result.\nThis procedure also follows the explicit \
warning in the guideline: first form the convergent difference, then take the \
limit ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalLambda]", "\[Rule]", "\[Infinity]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\Lambda\\to\\infty", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9d0de902-d288-dd44-af92-b7556b9f36c8"],
 StyleBox[" before shifting loop momentum. Since the subtraction was \
performed using the same loop-momentum routing and integration domain, no \
momentum shift was required at finite cutoff.\n\
------------------------------------------------------------------------------\
------------------------------------------------------------------------------\
------------------------------------------------",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0041835656129704`*^9, 4.0041835699831657`*^9}, {
  4.004183623452572*^9, 4.004183672201767*^9}, {4.004253086088888*^9, 
  4.004253088768978*^9}},ExpressionUUID->"af43f865-2bbf-c643-a668-\
f1b985f295b5"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Section 1.3\[LongDash]Verification Summary",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.6509803921568628, 0.7137254901960784, 
   0.7686274509803922]]], "Subsubsection",
 CellChangeTimes->{4.004252034217802*^9, 
  4.004264512211668*^9},ExpressionUUID->"81679e3f-bc44-cd4e-8d44-\
4592ffd91cb7"],

Cell[TextData[{
 StyleBox["Question:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nWhich counterterms enforce the three renormalization conditions, \
and is the finite bubble difference ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta B(P^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d87276dc-dfc4-0143-af4e-2a1f5eff247b"],
 StyleBox[" regulator independent?\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------------  ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["                                         \n",
  FontSize->13],
 StyleBox["Derivation:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nSections 1.3.1\[Dash]1.3.3.\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------------",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\n",
  FontSize->13],
 StyleBox["Check:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nThe renormalization conditions return {0,0,0} in both \
regularization schemes; the sharp-cutoff and DR results for ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]", 
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta B(P^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8370b02e-a91b-0c46-a3ae-59b01bc986f6"],
 StyleBox[" agree after \nregulator removal; and their zero-momentum slopes \
agree exactly.\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------------",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\n",
  FontSize->13],
 StyleBox["Anchor IDs:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nA-41 to A-55.\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------------",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\n",
  FontSize->13],
 StyleBox["Status:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nChecked!",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0042520624575996`*^9, 
  4.0042522047662315`*^9}},ExpressionUUID->"6824a688-6c6e-2c46-a9b3-\
be0e9e221619"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.4 Beta Function and Fixed Point",
 FontFamily->"Arial",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.19607843137254902`, 0.49411764705882355`, 
   0.4392156862745098]]], "Subsection",
 CellChangeTimes->{{4.0038163976554165`*^9, 
  4.0038164036254044`*^9}},ExpressionUUID->"aa0ec070-140b-994e-ac78-\
3ee147bb6cbd"],

Cell[TextData[{
 StyleBox["In this section, we determine the renormalization group (RG) \
properties of the scalar ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Phi]", "4"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\phi^4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0fb94001-49d5-c346-801e-d0507851d9b3"],
 StyleBox[" theory. Our primary objective is to investigate how the theory \
behaves under changes in the renormalization scale ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Mu]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9d3ebfd9-b6c8-c64a-b2a0-f56dcbbe80ec"],
 StyleBox[" and to locate the nontrivial fixed point that characterizes the \
critical behavior of the system.\n\nWe begin in 1.4.1 by implementing the \
Minimal Subtraction (MS) scheme, where counterterms are defined specifically \
to cancel the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Epsilon]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/\\varepsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"86aa622e-a41d-9041-9de4-53ad6d246a7f"],
 StyleBox[" poles observed in our Laurent expansions. In 1.4.2, we derive the \
one-loop beta function ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Beta]", 
        StyleBox["g", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta_g", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0174c721-a1ab-ec44-8fbb-5cf9519db9ce"],
 StyleBox[", which describes the scale dependence of the dimensionless \
coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c0c90a64-efe0-ba46-aed3-29ea5d82e9e8"],
 StyleBox[". Following this, we analyze the RG flow in 1.4.3 to identify the \
nontrivial fixed point ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["g", "TI"], "*"], TraditionalForm], "errors" -> {}, "input" -> 
     "g_*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a7241c3f-ce55-634a-aba1-2e20852ab852"],
 StyleBox[" where the theory becomes scale-invariant, providing the \
foundation for our later analysis of critical exponents. Finally, in 1.4.4, \
we determine the field anomalous dimension ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\gamma_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e50bb1eb-5648-9a40-92c3-83f7e4aff781"],
 StyleBox[" at one-loop order; although the field counterterm vanishes at \
this order, the formal derivation is essential to understand the scaling of \
the field and its anomalous dimension ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2f580031-c46c-de4e-bf11-3add468813db"],
 StyleBox[".\n\nThis analytical pipeline completes the one-loop \
renormalization program and prepares the necessary parameters for the \
critical phenomena calculations in Part 2.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004184075240034*^9, 
  4.004184195621353*^9}},ExpressionUUID->"8ef39a4b-f061-314b-ae5a-\
aadde78edf54"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.4.1 Minimal Subtraction and the MS Scheme",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.003816411160969*^9, 4.003816411160969*^9}, 
   4.003816442595337*^9, 4.003817703603754*^9, {4.0041840383717594`*^9, 
   4.0041840388812084`*^9}},ExpressionUUID->"47965468-b856-7d47-986d-\
fa6e12297282"],

Cell[TextData[{
 StyleBox["In this subsection, we implement the Minimal Subtraction (MS) \
scheme by extracting the ultraviolet-divergent ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Epsilon]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/\\varepsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"272808f0-8912-7949-92eb-1d5d9818a40b"],
 StyleBox[" poles from the one-loop counterterms derived in Section 1.3.2. In \
the MS scheme, counterterms are defined to cancel only the pole \
contributions; finite terms are not included. This distinguishes MS from the \
modified Minimal Subtraction ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["MS", FontSlant -> "Plain"], "_"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\overline{\\mathrm{MS}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"24a18e30-6f35-f749-84f8-d9e5e6705ece"],
 StyleBox[" scheme, which additionally absorbs the constants involving the \
Euler\[Dash]Mascheroni constant ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", 
        StyleBox["E", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma_E", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5f46da7d-03c4-2448-a376-4a9b8aee65ae"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"ln", "(", 
         RowBox[{"4", "\[Pi]"}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\ln(4\\pi)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5f89b35f-a224-1641-9866-2e4c57cb04f8"],
 StyleBox[".\n\nWe work with the rescaled coupling g = \
\[Lambda]/(16\[Pi]\.b2). The bare rescaled coupling g\:2080 = \
\[Lambda]\:2080/(16\[Pi]\.b2) is related to the renormalized one by ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "0"], "\[LongEqual]", 
         SubsuperscriptBox["\[Mu]", 
          StyleBox["R", "TI"], "\[Epsilon]"], 
         SubscriptBox[
          StyleBox["Z", "TI"], 
          StyleBox["g", "TI"]], 
         StyleBox["g", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "g_0 = \\mu_R^{\\epsilon} Z_g g", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"22aeeac8-e4df-764b-8018-3804f87ca805"],
 StyleBox[", with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Z", "TI"], 
          StyleBox["g", "TI"]], "\[LongEqual]", "1", "+", 
         FractionBox[
          RowBox[{"\[Delta]", 
            StyleBox["g", "TI"]}], 
          StyleBox["g", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "Z_g = 1 + \\frac{\\delta g}{g}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"6da07ad6-7875-8146-a60f-eaa3a1fc9e61"],
 StyleBox[". In MS, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         StyleBox["g", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta g", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"72327617-e060-3045-8133-1e5b98949fc7"],
 StyleBox[" is the pole part of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox["\[Delta]\[Lambda]", 
        RowBox[{"16", 
          SuperscriptBox["\[Pi]", "2"]}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\frac{\\delta \\lambda}{16 \\pi^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"bddc790b-b844-6748-87ce-43fa43830dc2"],
 StyleBox[", with \[Delta]\[Lambda] from 1.3.2. Since \[Delta]\[Lambda] = 3\
\[Lambda]\.b2/(16\[Pi]\.b2\[CurlyEpsilon]) + finite, we get \[Delta]g = \
3g\.b2/\[CurlyEpsilon], so ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Z", "TI"], 
          StyleBox["g", "TI"]], "\[LongEqual]", "1", "+", 
         FractionBox[
          RowBox[{"3", 
            StyleBox["g", "TI"]}], "\[Epsilon]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "Z_g = 1 + \\frac{3g}{\\epsilon}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3050e699-8767-e142-aeab-b3b9692b28be"],
 StyleBox[". (A-56)\n\nAt one-loop order, the mass and coupling counterterms \
are obtained by retaining only the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Epsilon]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/\\varepsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b5b5e5a7-0c49-0a44-a030-69ebf988f00c"],
 StyleBox[" pole contributions from our dimensionally regularized results. \
The field-strength counterterm vanishes at this order, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\delta Z_\\phi=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2c13cdc5-4a37-a847-9f02-25759bf91b95"],
 StyleBox[". These MS counterterms provide the pole structure needed to \
determine the renormalization-group equations. In the next subsection, we use \
the scale independence of the bare coupling to derive the beta function ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Beta]", 
        StyleBox["g", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta_g", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4090024a-662d-f640-86ae-6cb4fc254b42"],
 StyleBox[", which governs the evolution of the renormalized coupling with \
the renormalization scale ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Mu]", 
        StyleBox["R", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu_R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4689b34d-d7ba-3c4e-97d0-6a0127bebc52"],
 StyleBox[".\n\n",
  FontSize->13],
 StyleBox["MS counterterms: ",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["The one-loop MS counterterms, expressed in terms of the normalized \
coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[LongEqual]", "\[Lambda]", "/", 
         RowBox[{"(", 
           RowBox[{"16", 
             SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "g=\\lambda/(16\\pi^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1d017856-e981-1a45-89d7-2ce2d0b5c74e"],
 StyleBox[", are:\n\n                                                         \
                                                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubsuperscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["MS", FontSlant -> "Plain"], "2"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["g", "TI"], 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}], "\[Epsilon]"], ",    ", "\[Delta]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["MS", FontSlant -> "Plain"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"3", 
            SuperscriptBox[
             StyleBox["g", "TI"], "2"]}], "\[Epsilon]"], ",    ", "\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], 
          RowBox[{"\[Phi]", ",", 
            StyleBox["MS", FontSlant -> "Plain"]}]], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta m_ {\\mathrm{MS}}^2=\\frac{g m^2}{\\epsilon},\n\\qquad\n\\delta \
g_{\\mathrm{MS}}=\\frac{3g^2}{\\epsilon},\n\\qquad\n\\delta \
Z_{\\phi,\\mathrm{MS}}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b3a15d88-d357-724f-b710-13a850adbed6"],
 StyleBox["                                                                   \
                            (A-57)",
  FontSize->13],
 StyleBox["\n\n",
  FontSize->13],
 StyleBox["MS versus the renormalization conditions of Section 1.3: ",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["The counterterms obtained in Section 1.3.2 enforce the finite \
renormalization conditions\n\n                                                \
                                                            ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], ",    ", 
         SubscriptBox[
          RowBox[{
            FractionBox[
             RowBox[{"\[PartialD]", 
               SuperscriptBox["\[CapitalGamma]", 
                RowBox[{"(", "2", ")"}]]}], 
             RowBox[{"\[PartialD]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "2"]}]], "\[VerticalSeparator]"}], 
          RowBox[{
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], "\[LongEqual]", "0"}]], 
         "\[LongEqual]", "1", ",    ", 
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "4", ")"}]], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", "\[Lambda]", "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^{(2)}(0)=m^2,\\qquad\n\
\\left.\\frac{\\partial\\Gamma^{(2)}}{\\partial p^2} \\right|_{p^2=0}=1,\n\
\\qquad\n\\Gamma^{(4)}(0)=\\lambda.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"87f756d4-28d3-7a41-be54-523ab758820c"],
 "\n                                                                          \
                                ",
 StyleBox["\nConsequently, these counterterms contain both divergent and \
finite contributions. For example, the dimensional-regularization coupling \
counterterm is\[LineSeparator]\n                                              \
                                                        ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]\[Lambda]", 
          StyleBox["DR", FontSlant -> "Plain"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"3", 
            SuperscriptBox["\[Lambda]", "2"]}], 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"], "\[Epsilon]"}]], "-", 
         FractionBox[
          RowBox[{"3", 
            SuperscriptBox["\[Lambda]", "2"]}], 
          RowBox[{"32", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{"ln", 
             FractionBox[
              SuperscriptBox[
               StyleBox["m", "TI"], "2"], 
              SubsuperscriptBox["\[Mu]", 
               StyleBox["R", "TI"], "2"]], "+", 
             SubscriptBox["\[Gamma]", 
              StyleBox["E", "TI"]], "-", "ln", 
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta\\lambda_{\\mathrm{DR}}\n=\n\
\\frac{3\\lambda^2}{16\\pi^2\\epsilon}\n-\\frac{3\\lambda^2}{32\\pi^2}\n\
\\left[\n\\ln\\frac{m^2}{\\mu_R^2}\n+\\gamma_E-\\ln(4\\pi)\n \\right]\n\
+O(\\epsilon).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7a84e81e-3b24-3247-a08e-ec13ce1ee042"],
 StyleBox["\n\nIn contrast, the minimal-subtraction scheme removes only the \
divergent pole: ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]\[Lambda]", 
          StyleBox["MS", FontSlant -> "Plain"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"3", 
            SuperscriptBox["\[Lambda]", "2"]}], 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"], "\[Epsilon]"}]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"], " ", "3", 
            SuperscriptBox[
             StyleBox["g", "TI"], "2"]}], "\[Epsilon]"], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta\\lambda_{\\mathrm{MS}}\n=\\frac{3\\lambda^2}{16\\pi^2\\epsilon}\
\n=\\frac{16\\pi^2\\,3g^2}{\\epsilon}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->10,ExpressionUUID->"4f114851-a6c6-ac4b-8dd3-ec4b87810319"],
 " ",
 StyleBox["Thus, unlike the finite renormalization conditions of Section 1.3, \
the MS counterterms do not impose a normalization condition on the four-point \
function at zero external momentum. In particular, the MS coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "(", 
         SubscriptBox["\[Mu]", 
          StyleBox["R", "TI"]], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "g(\\mu_R)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7213b04b-a352-e342-badd-a41e6949322b"],
 StyleBox[" is a running parameter defined at the renormalization scale ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Mu]", 
        StyleBox["R", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu_R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7ddbb959-3e8c-bf4e-9303-d247ee32e8ae"],
 StyleBox[", rather than the value of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{"(", "4", ")"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^{(4)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a851a458-bb9f-fb40-8f35-ffd348e25305"],
 StyleBox[" ",
  FontSize->13],
 StyleBox["at zero momentum. The two prescriptions are related by a finite \
renormalization, but yield the same universal one-loop coefficient of the \
beta function ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], "\[LongEqual]", "-", "\[Epsilon]", 
         StyleBox["g", "TI"], "+", "3", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\beta_g=-\\epsilon g+3g^2+O (g^3).", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3e3896da-d073-b548-bd0c-3d3f9a481689"],
 " ",
 StyleBox["In four dimensions, this becomes ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], "\[LongEqual]", "3", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\beta_g=3g^2+O(g^3).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2278ed0d-6ccd-134a-8fd3-b4578f64a520"],
 StyleBox["\n\n",
  FontSize->13],
 StyleBox["Computational convention:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nFeynCalc uses ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], "\[LongEqual]", "4", "-", "2", 
         SubscriptBox["\[Epsilon]", 
          RowBox[{
            StyleBox["F", "TI"], 
            StyleBox["C", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "D=4-2\\varepsilon_{FC}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6570c10f-63c6-2149-b7b5-81bb0b2393e0"],
 StyleBox[", whereas this project uses ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d=4-\\varepsilon", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f4c39a54-7896-e243-aa07-fed4cc990ff1"],
 StyleBox[". Therefore, expressions imported from FeynCalc must be converted \
using ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "2", 
         SubscriptBox["\[Epsilon]", 
          RowBox[{
            StyleBox["F", "TI"], 
            StyleBox["C", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\varepsilon=2\\varepsilon_{FC}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"36886cbd-509b-de4a-8be2-8dd98d8c9178"],
 StyleBox[" before being combined with the project\[CloseCurlyQuote]s \
dimensional-regularization results.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0041846153106785`*^9, 4.004184855565588*^9}, {
   4.004184923650545*^9, 4.00418492716086*^9}, {4.0041995289650993`*^9, 
   4.004199549765362*^9}, {4.0041995997953606`*^9, 4.0041996028251*^9}, {
   4.0041996486150684`*^9, 4.004199650165163*^9}, {4.004199704975172*^9, 
   4.0041997331351547`*^9}, {4.0042554849961643`*^9, 4.004255542809841*^9}, {
   4.004255583895767*^9, 4.004255915524311*^9}, {4.004257486291546*^9, 
