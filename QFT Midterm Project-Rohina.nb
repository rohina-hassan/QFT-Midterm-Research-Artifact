   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0d1757aa-1448-ea40-b7ed-32d720db0a96"],
 StyleBox[" tests the equation-of-state scaling derived in Sections 2.3.1\
\[Dash]2.3.3. These comparisons therefore provide complementary checks of the \
critical behavior obtained from the perturbative calculation.",
  FontSize->13]
}], "Text",
