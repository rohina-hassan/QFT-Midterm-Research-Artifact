Cell[CellGroupData[{

Cell[TextData[StyleBox["2.2.2 Field-Strength Renormalization",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.5254901960784314, 0.3843137254901961, 
   0.49019607843137253`]]], "Subsubsection",
 CellChangeTimes->{{4.0042952778539467`*^9, 
  4.0042952908826866`*^9}},ExpressionUUID->"806ab896-918a-aa4e-925b-\
8a925bb1d63e"],

Cell[TextData[{
 StyleBox["The momentum-dependent ultraviolet divergence obtained from the \
sunset diagram in Section 2.2.1 requires a field-strength counterterm. To \
determine this counterterm, we introduce the field renormalization constant ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Z", "TI"], "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "Z_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8de3c934-7d90-9142-b95b-15e9fd544bb9"],
 StyleBox[", relating the bare and renormalized fields through\n\n            \
                                                                              \
                                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Phi]", "0"], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["Z", "TI"], "\[Phi]", 
          RowBox[{"1", "/", "2"}]], "\[Phi]", ",    ", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", "1", "+", 
         "\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\phi_0=Z_\\phi^{1/2}\\phi,\n\\qquad\nZ_\\phi=1+\\delta Z_\\phi.", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"55134dd1-00e9-ed4c-9782-2eba6438de93"],
 StyleBox["                                                                   \
                                   (A-85)\n\nThe corresponding contribution \
to the inverse propagator is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta Z_\\phi p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"dc87aacb-02c7-e94a-998f-a6fc558e92e2"],
 StyleBox[". Since the one-loop tadpole is independent of the external \
momentum, it does not contribute to field-strength renormalization. At \
two-loop order, the sunset diagram generates the momentum-dependent pole:\n\n \
                                                                              \
                                               ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          StyleBox["sunset", FontSlant -> "Plain"], 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["p", "TI"], "2"], ")"}], 
         SubscriptBox["|", 
          StyleBox["pole", FontSlant -> "Plain"]], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           StyleBox["g", "TI"], "2"], 
          RowBox[{"12", "\[Epsilon]"}]], 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\Gamma_{\\mathrm{sunset}}^{(2)}(p^2)\\big|_{\\mathrm{pole}}\n\
=\\frac{g^2}{12\\epsilon}p^2,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4520e51c-3e3a-bc44-b660-e091d6d355ab"],
 StyleBox["\n\nwhere ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[LongEqual]", "\[Lambda]", "/", 
         RowBox[{"(", 
           RowBox[{"16", 
             SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "g=\\lambda/(16\\pi^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b5366f28-5c45-2741-baa0-a69b352e9fea"],
 StyleBox[" is the normalized coupling defined in Part 1. Minimal subtraction \
requires the field-strength counterterm to cancel this divergence. Thus, \
writing",
  FontSize->13],
 StyleBox[" ",
  FontSize->11],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", 
         FractionBox[
          SubsuperscriptBox[
           StyleBox["z", "TI"], "\[Phi]", 
           RowBox[{"(", "2", ")"}]], "\[Epsilon]"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta Z_\\phi\n=\\frac{z_\\phi^{(2)}}{\\epsilon}+O(g^3),", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"9657453f-2bc1-a24e-8b16-55cb41f210d8"],
 StyleBox[" we obtain:\n\n                                                    \
                                                       ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", "-", 
         FractionBox[
          SuperscriptBox[
           StyleBox["g", "TI"], "2"], 
          RowBox[{"12", "\[Epsilon]"}]], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}], ",    ", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", "1", "-", 
         FractionBox[
          SuperscriptBox[
           StyleBox["g", "TI"], "2"], 
          RowBox[{"12", "\[Epsilon]"}]], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta Z_\\phi=-\\frac{g^2}{12\\epsilon}+O(g^3),\n\\qquad\n\
Z_\\phi=1-\\frac{g^2}{12\\epsilon}+O(g^3)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0e6ed94c-8d4e-b145-a7cd-5ea7820ab66c"],
 StyleBox["                                                                   \
                   (A-87)\n\nThe negative sign is essential: the counterterm \
enters the inverse propagator with a positive contribution ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta Z_\\phi p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"333280a5-7ec9-7e4b-972f-475134cebee2"],
 StyleBox[", and must therefore cancel the positive sunset pole. The only \
other two-loop topology is the tadpole with a ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]\[Lambda]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9a13d5dd-d5c0-6a48-9e05-73b8a7771d72"],
 StyleBox[" counterterm inserted on the bubble. It has no dependence on the \
external momentum p, so it can renormalize only the mass and cannot touch the \
",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cb274aa0-8375-c74b-a199-2a0e18bbb993"],
 StyleBox[" pole. Independently, at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "m=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d2dcb9ca-8b8c-094d-b2f8-746e14c6e1fa"],
 StyleBox[" it is a scaleless integral, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Proportional]", 
         SuperscriptBox[
          StyleBox["m", "TI"], 
          RowBox[{"2", "-", "\[Epsilon]"}]], "\[CapitalGamma]", 
         RowBox[{"(", 
           RowBox[{"-1", "+", "\[Epsilon]", "/", "2"}], ")"}], "\[Rule]", 
         "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\propto m^{2-\\epsilon}\\Gamma(-1+\\epsilon/2)\\to0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cad053a0-39c2-ed49-8fcc-3fff56b7c7a6"],
 StyleBox[", so it vanishes identically in dimensional regularization. (A-86)\
\n\nHaving determined ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Z", "TI"], "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "Z_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4da38cc3-bf36-5b4b-adb2-329100925de1"],
 StyleBox[", we can now calculate the field anomalous dimension. It is \
defined at fixed bare parameters by\n\n                                       \
                                                                              \
                    ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Gamma]", "\[Phi]"], 
         RowBox[{"(", 
           StyleBox["g", "TI"], ")"}], "\[LongEqual]", 
         FractionBox["1", "2"], 
         SubscriptBox["\[Mu]", 
          StyleBox["R", "TI"]], 
         FractionBox[
          StyleBox["d", "TI"], 
          RowBox[{
            StyleBox["d", "TI"], 
            SubscriptBox["\[Mu]", 
             StyleBox["R", "TI"]]}]], "ln", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\gamma_\\phi(g)\n=\\frac{1}{2}\\mu_R\\frac{d}{d\\mu_R}\\ln Z_\\phi", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"23e30177-63ad-934d-89ca-ef7895bda04b"],
 StyleBox["\n\nThe derivative must be evaluated using the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d=4-\\epsilon", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"da3677e1-d910-ef4d-82b3-5fccf5ddd540"],
 StyleBox[" beta function, including its canonical ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", "\[Epsilon]", 
         StyleBox["g", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "-\\epsilon g", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5e875f4f-0cfe-6244-b5f0-236850f5484a"],
 StyleBox[" contribution. We will use this relation in the next subsection to \
obtain the two-loop anomalous dimension and evaluate it at the \
Wilson\[Dash]Fisher fixed point.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004296226011444*^9, 4.0042963779510612`*^9}, {
  4.0042966685906525`*^9, 4.0042967364404087`*^9}, {4.004296770481184*^9, 
  4.0042969278304462`*^9}},ExpressionUUID->"292b1635-2aab-b247-a083-\
234084d0a7e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Conventions", ":", "d"}], "=", 
     RowBox[{"4", "-", "e"}]}], ",", 
    RowBox[{"g", "=", 
     RowBox[{"lam", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"16", " ", 
         RowBox[{"Pi", "^", "2"}]}], ")"}], "."}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Step"}]}], " ", "1"}], ":", 
    RowBox[{"one", "-", 
     RowBox[{"loop", " ", "field"}], "-", 
     RowBox[{"strength", " ", 
      RowBox[{"counterterm", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"The", " ", "one"}], "-", 
    RowBox[{"loop", " ", "tadpole", " ", "is", " ", "momentum", " ", 
     RowBox[{"independent", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"deltaZPhi1", "=", "0"}], ";"}], "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "2"}], ":", 
     RowBox[{
      RowBox[{"extract", " ", "the", " ", "two"}], "-", 
      RowBox[{
      "loop", " ", "sunset", " ", "pole", " ", "in", " ", "terms", " ", "of", 
       " ", 
       RowBox[{"g", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sunsetFieldStrengthPole", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"sunsetInversePropagatorPoleInG", "/", "p2"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"sunsetExpectedFieldStrengthPole", "=", 
     RowBox[{
      RowBox[{"g", "^", "2"}], "/", "12"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"sunsetFieldStrengthPoleCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
      "sunsetFieldStrengthPole", "-", "sunsetExpectedFieldStrengthPole"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "3"}], ":", 
     RowBox[{
      RowBox[{"determine", " ", "the", " ", "MS", " ", "field"}], "-", 
      RowBox[{"strength", " ", 
       RowBox[{"counterterm", "--"}]}], "-"}]}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "counterterm", " ", "must", " ", "cancel", " ", "the", " ", 
     RowBox[{
      RowBox[{"p", "^", "2"}], "/", "e"}], " ", 
     RowBox[{"pole", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"deltaZPhi2", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"-", "sunsetFieldStrengthPole"}], "/", "e"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"deltaZPhiMS", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaZPhi1", "+", "deltaZPhi2"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ZphiMS", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"1", "+", "deltaZPhiMS"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pureMSCheck", "=", 
     RowBox[{"FreeQ", "[", 
      RowBox[{"deltaZPhiMS", ",", 
       RowBox[{"EulerGamma", "|", 
        RowBox[{"Log", "[", "_", "]"}], "|", "Pi"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "4"}], ":", 
     RowBox[{
      RowBox[{
      "verify", " ", "cancellation", " ", "of", " ", "the", " ", "momentum"}],
       "-", 
      RowBox[{"dependent", " ", 
       RowBox[{"pole", "--"}]}], "-"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sunsetPoleContribution", "=", 
     RowBox[{"sunsetInversePropagatorPoleInG", "/", "e"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fieldStrengthCountertermContribution", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaZPhiMS", "*", "p2"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"totalMomentumDependentPole", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
      "sunsetPoleContribution", "+", "fieldStrengthCountertermContribution"}],
       "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fieldStrengthCancellationCheck", "=", 
     RowBox[{"FullSimplify", "[", "totalMomentumDependentPole", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "5"}], ":", 
     RowBox[{
      RowBox[{
      "verify", " ", "the", " ", "absence", " ", "of", " ", "a", " ", "one"}],
       "-", 
      RowBox[{"loop", " ", 
       RowBox[{"contribution", "--"}]}], "-"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"oneLoopFieldStrengthCheck", "=", 
     RowBox[{"FullSimplify", "[", "deltaZPhi1", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "6"}], ":", 
     RowBox[{
      RowBox[{"verify", " ", "that", " ", "the", " ", "four"}], "-", 
      RowBox[{
      "point", " ", "subdivergence", " ", "does", " ", "not", " ", 
       "contribute", " ", "to", " ", "field"}], "-", 
      RowBox[{"strength", " ", 
       RowBox[{"renormalization", "--"}]}], "-"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "6"}], ":", 
     RowBox[{"four", "-", 
      RowBox[{"point", " ", "subdivergence", " ", 
       RowBox[{"insertion", "--"}]}], "-"}]}], "*)"}], 
   RowBox[{
    RowBox[{"subdivergenceP2Dependence", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"D", "[", 
       RowBox[{"counterterm2PtContribution", ",", "p2"}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"scalelessTadpole", "=", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"m", "^", 
         RowBox[{"(", 
          RowBox[{"2", "-", "e"}], ")"}]}], " ", 
        RowBox[{"Gamma", "[", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"e", "/", "2"}]}], "]"}]}], ",", 
       RowBox[{"m", "->", "0"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"0", "<", "e", "<", "2"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fourPointSubdivergenceCheck", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"subdivergenceP2Dependence", "==", "0"}], ",", 
       RowBox[{"scalelessTadpole", "==", "0"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "7"}], ":", 
     RowBox[{
      RowBox[{"display", " ", "the", " ", 
       RowBox[{"results", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<One-loop field-strength counterterm:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"deltaZPhi1", "//", "TraditionalForm"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Two-loop sunset pole coefficient (in terms of g):\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{"sunsetFieldStrengthPole", "//", "TraditionalForm"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Two-loop MS field-strength counterterm:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"deltaZPhi2", "//", "TraditionalForm"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Total MS field-strength counterterm:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"deltaZPhiMS", "//", "TraditionalForm"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Field-strength renormalization constant Z_phi:\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{"ZphiMS", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Total momentum-dependent pole after counterterm \
insertion:\>\"", "]"}], ";"}], "\n", 
   RowBox[{"totalMomentumDependentPole", "//", "TraditionalForm"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Subdivergence insertion: p^2-independence and \
scalelessness (expected: {True, True}):\>\"", "]"}], ";"}], "\n", 
   "fourPointSubdivergenceCheck", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "8"}], ":", 
     RowBox[{
      RowBox[{"final", " ", "consistency", " ", 
       RowBox[{"checks", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fieldStrengthRenormalizationChecks", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sunsetFieldStrengthPoleCheck", "==", "0"}], ",", 
       RowBox[{"deltaZPhi1", "==", "0"}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"deltaZPhi2", "+", 
          RowBox[{
           RowBox[{"g", "^", "2"}], "/", 
           RowBox[{"(", 
            RowBox[{"12", " ", "e"}], ")"}]}]}], "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"ZphiMS", "-", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"g", "^", "2"}], "/", 
             RowBox[{"(", 
              RowBox[{"12", " ", "e"}], ")"}]}]}], ")"}]}], "]"}], "==", 
        "0"}], ",", 
       RowBox[{"fieldStrengthCancellationCheck", "==", "0"}], ",", 
       RowBox[{"And", "@@", "fourPointSubdivergenceCheck"}]}], "}"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Final field-strength renormalization checks (expected: \
all True):\>\"", "]"}], ";"}], "\n", 
   "fieldStrengthRenormalizationChecks"}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{4.0042963994212875`*^9, 4.0042964516721783`*^9}, 
   4.004296482302908*^9, {4.0042965612349243`*^9, 4.0042965640315495`*^9}, {
   4.004296597410593*^9, 4.004296598403507*^9}, {4.0042996385666943`*^9, 
   4.0042996395267735`*^9}},
 Background->GrayLevel[0.753],
