Cell["\<\
------------------------------------------------------------------------------\
------------------------------------------------------------------------------\
--------------------\
\>", "Text",
 CellChangeTimes->{{4.0041777462442036`*^9, 
  4.004177753374031*^9}},ExpressionUUID->"b3742087-4264-2647-bc39-\
8f0632a97b0a"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.3.2 Derivation of Counterterms",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.0038163394858665`*^9, 4.0038163394858665`*^9}, 
   4.0038163699958344`*^9, 4.0040120178629894`*^9, {4.0041586195788994`*^9, 
   4.0041586207057095`*^9}, 
   4.0041759811661854`*^9},ExpressionUUID->"d6fc9ef8-6724-9745-9bfe-\
1971a028bfeb"],

Cell[TextData[{
 StyleBox["Having established the renormalization conditions in Section \
1.3.1, we now derive the explicit expressions for the mass counterterm ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta m^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"48b34f81-d1c0-ce4d-92de-0a0aa6b2d84e"],
 StyleBox[", the field-strength counterterm ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta Z_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b9c3f96c-4fc2-c742-ade5-f6430b6ae8dd"],
 StyleBox[", and the coupling counterterm ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]\[Lambda]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"24c6833e-b27e-9f46-bddf-241cb8eeed27"],
 StyleBox[". These counterterms are determined by solving the system of \
equations obtained by imposing the three renormalization conditions on the \
one-loop 1PI functions:\n\n                                                   \
                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", "0", ")"}], "-", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Gamma^{(2)}(0)-m^2=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"952e3815-7bdc-2f4d-804d-696fa1215c48"],
 StyleBox["                                    ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{
            FractionBox[
             RowBox[{"\[PartialD]", 
               SuperscriptBox["\[CapitalGamma]", 
                RowBox[{"(", "2", ")"}]], 
               RowBox[{"(", 
                 SuperscriptBox[
                  StyleBox["p", "TI"], "2"], ")"}]}], 
             RowBox[{"\[PartialD]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "2"]}]], "\[VerticalSeparator]"}], 
          RowBox[{
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], "\[LongEqual]", "0"}]], "-", "1", 
         "\[LongEqual]", "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\left.\n\\frac{\\partial\\Gamma^{(2)}(p^2)}\n{\\partial \
p^2}\\right|_{p^2=0}-1=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d0735cc5-5233-6e45-8fc2-1a1aa8a90be9"],
 StyleBox["                                      ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "4", ")"}]], 
         RowBox[{"(", "0", ")"}], "-", "\[Lambda]", "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^{(4)}(0)-\\lambda=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1ce7725a-a346-3247-8c54-31de365c6807"],
 StyleBox["\n\nSubstituting the expressions for the two-point and four-point \
functions into this system gives the general counterterms in terms of the \
regularized tadpole and bubble integrals: (A-45 , A-46, A-47)\n\n",
  FontSize->13],
 StyleBox["Sharp momentum-cutoff regularization: ",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\n\n                                                               \
    ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubsuperscriptBox[
          StyleBox["m", "TI"], "\[CapitalLambda]", "2"], "\[LongEqual]", "-", 
         FractionBox["\[Lambda]", 
          RowBox[{"32", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{
             SuperscriptBox["\[CapitalLambda]", "2"], "-", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"], "ln", 
             RowBox[{"(", 
               FractionBox[
                RowBox[{
                  SuperscriptBox["\[CapitalLambda]", "2"], "+", 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]], ")"}]}], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta m_\\Lambda^2\n=-\\frac{\\lambda}{32\\pi^2}\n\\left[\n\
\\Lambda^2-m^2\\ln\\left(\\frac{\\Lambda^2+m^2}{m^2} \\right)\n \\right]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"46b83b06-5a87-104b-a5ef-29f20eeefb48"],
 StyleBox["  ,                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]\[Lambda]", "\[CapitalLambda]"], 
         "\[LongEqual]", 
         FractionBox[
          RowBox[{"3", 
            SuperscriptBox["\[Lambda]", "2"]}], 
          RowBox[{"32", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{"ln", 
             RowBox[{"(", 
               FractionBox[
                RowBox[{
                  SuperscriptBox["\[CapitalLambda]", "2"], "+", 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]], ")"}], "-", "1", "+", 
             FractionBox[
              SuperscriptBox[
               StyleBox["m", "TI"], "2"], 
              RowBox[{
                SuperscriptBox["\[CapitalLambda]", "2"], "+", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]}]]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta\\lambda_\\Lambda\n=\\frac{3\\lambda^2}{32\\pi^2}\n\\left[\n\\ln\
\\left(\\frac{\\Lambda^2+m^2}{m^2} \\right)\n-1+\\frac{m^2}{\\Lambda^2+m^2}\n \
\\right]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4b03b822-ec13-b143-8397-e2995fb92cda"],
 "                                               ",
 StyleBox["(A-48)",
  FontSize->13],
 StyleBox["\n\nDimensional regularization (UV poles and finite parts):\n\n    \
                       ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubsuperscriptBox[
          StyleBox["m", "TI"], 
          RowBox[{
            StyleBox["m", "TI"], 
            StyleBox["D", "TI"], 
            StyleBox["R", "TI"]}], "2"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[Lambda]", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}], 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"], "\[Epsilon]"}]], "-", 
         FractionBox[
          RowBox[{"\[Lambda]", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}], 
          RowBox[{"32", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{"ln", 
             RowBox[{"(", 
               FractionBox[
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"], 
                SubsuperscriptBox["\[Mu]", 
                 StyleBox["R", "TI"], "2"]], ")"}], "+", 
             SubscriptBox["\[Gamma]", 
              StyleBox["E", "TI"]], "-", "1", "-", "ln", 
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta m_ {\\r m DR}^2\n=\\frac{\\lambda m^2}{16\\pi^2\\epsilon}\n\
-\\frac{\\lambda m^2}{32\\pi^2}\n\\left[\n\\ln\\left(\\frac{m^2}{\\mu_R^2} \
\\right)\n+\\gamma_E-1-\\ln(4\\pi)\n \\right]\n+O(\\epsilon),", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d786f454-74ae-e741-8bf8-92da384a0d8a"],
 StyleBox["                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]\[Lambda]", 
          RowBox[{
            StyleBox["m", "TI"], 
            StyleBox["D", "TI"], 
            StyleBox["R", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"3", 
            SuperscriptBox["\[Lambda]", "2"]}], 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"], "\[Epsilon]"}]], "-", 
         FractionBox[
          RowBox[{"3", 
            SuperscriptBox["\[Lambda]", "2"]}], 
          RowBox[{"32", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{"ln", 
             RowBox[{"(", 
               FractionBox[
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"], 
                SubsuperscriptBox["\[Mu]", 
                 StyleBox["R", "TI"], "2"]], ")"}], "+", 
             SubscriptBox["\[Gamma]", 
              StyleBox["E", "TI"]], "-", "ln", 
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\delta\\lambda_{\\r m DR}\n=\\frac{3\\lambda^2}{16\\pi^2\\epsilon}\n\
-\\frac{3\\lambda^2}{32\\pi^2}\n\\left[\n\\ln\\left(\\frac{m^2}{\\mu_R^2} \
\\right)\n+\\gamma_E-\\ln(4\\pi)\n \\right]\n+O(\\epsilon)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cefe0b78-61f9-d94b-9e0d-c8bec22d0917"],
 "             ",
 StyleBox["(A-49)",
  FontSize->13],
 StyleBox["\n\nHere, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalLambda]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2308ae98-6190-5845-8066-14ddebebdbb8"],
 StyleBox[" is the sharp momentum cutoff, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Mu]", 
        StyleBox["R", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu_R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"886459e4-574b-9147-a96a-6e1c4beba8bb"],
 StyleBox[" is the DR renormalization scale, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "4", "-", 
         StyleBox["d", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\epsilon=4-d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"83e3e762-eb71-5c41-a5a2-0f1b11e4d70b"],
 StyleBox[", and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", 
        StyleBox["E", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma_E", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "24e8c54c-6446-b44e-a1bb-49785e71205c"],
 StyleBox[" is the Euler\[Dash]Mascheroni constant. The DR expressions retain \
the UV-divergent pole and the finite contribution through ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox["\[Epsilon]", "0"], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(\\epsilon^0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1778ddd4-bab5-aa41-87f8-adeeb94fd5fd"],
 StyleBox[".",
  FontSize->13],
 StyleBox["\n\nThe vanishing field-strength counterterm follows from the \
absence of external-momentum dependence in the one-loop tadpole contribution.\
\nWe evaluate these expressions independently in the two regularization \
schemes. For sharp momentum-cutoff regularization, we substitute the \
cutoff-dependent integrals ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "\[CapitalLambda]"], "(", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "T_\\Lambda(m^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d30c0af1-e7de-5c48-a747-cf7e837a3664"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], "\[CapitalLambda]"], "(", 
         RowBox[{"0", ",", 
           SuperscriptBox[
            StyleBox["m", "TI"], "2"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "B_\\Lambda(0,m^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f061702b-0778-354b-975d-c677106b70c3"],
 StyleBox[" obtained in Section 1.2.2. For dimensional regularization, we use \
",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], "(", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "T_{\\mathrm{DR}}(m^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"47502c3d-6718-704b-8d3e-3b20306e5ce3"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], "(", 
         RowBox[{"0", ",", 
           SuperscriptBox[
            StyleBox["m", "TI"], "2"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "B_{\\mathrm{DR}}(0,m^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3f4629eb-597e-e34e-bab2-49d241db15c0"],
 StyleBox[", including their Laurent expansions derived in Section 1.2.4.\nIn \
both schemes, the counterterms absorb the ultraviolet divergences of the \
one-loop two-point and four-point functions. Although their explicit \
expressions depend on the regulator, they are fixed by the same \
renormalization conditions. These are the finite zero-momentum subtractions. \
The MS counterterms of 1.4.1 keep only their 1/\[CurlyEpsilon] pole parts.\n \
We will use these results in the next subsection to investigate regulator \
independence through the finite momentum-dependent difference ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           StyleBox["P", "TI"], ")"}], "-", 
         StyleBox["B", "TI"], 
         RowBox[{"(", "0", ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "B(P)-B(0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"54f6426e-5e9e-c542-a258-4ee41bf110aa"],
 StyleBox[" and its derivative at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["P", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "P^2=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9bac2dad-a7e4-8240-9a0b-ee4c6b9cdbbf"],
 StyleBox[".",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0041778803238964`*^9, 4.004177957444193*^9}, {
  4.0041779912749577`*^9, 4.004178112703676*^9}, {4.00417819111364*^9, 
  4.0041782261334953`*^9}, {4.0041782911634674`*^9, 4.0041783615654774`*^9}, {
  4.0041787647955933`*^9, 4.004178777897957*^9}, {4.004249589242365*^9, 
  4.004249599161991*^9}, {4.004251146069874*^9, 4.004251240455982*^9}, {
  4.0042512854567776`*^9, 4.004251471023203*^9}, {4.0042525280676727`*^9, 
  4.004252536183281*^9}, {4.0042526476948967`*^9, 
  4.0042526889921513`*^9}},ExpressionUUID->"87fb5146-c1c1-ea41-9758-\
f98c4912aa6e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"General", " ", "solution", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"A", "-", "45"}], ",", 
         RowBox[{"A", "-", "46"}], ",", 
         RowBox[{"A", "-", "47"}]}], ")"}], " ", "comes", " ", "from", " ", 
       "1.3", ".1"}], ":", "dZm2Final"}], "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"lam", "/", "2"}], ")"}]}], " ", "Treg"}]}], ",", 
    RowBox[{"dZphiFinal", "=", "0"}], ",", 
    RowBox[{"dLamFinal", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", " ", 
        RowBox[{
         RowBox[{"lam", "^", "2"}], "/", "2"}]}], ")"}], " ", 
      RowBox[{"Breg", "[", "0", "]"}]}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", 
    RowBox[{"sharp", "-", 
     RowBox[{"cutoff", " ", "counterterms", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"A", "-", "48"}], ")"}], "."}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"dZm2Cutoff", "[", "Lambda_", "]"}], ":=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"lam", "/", "2"}], ")"}]}], " ", 
       RowBox[{"(", 
        RowBox[{"tadpoleCutoff", "/.", " ", 
         RowBox[{"cutoff", "->", "Lambda"}]}], ")"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dZphiCutoff", "[", "Lambda_", "]"}], ":=", "dZphiFinal"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dLamCutoff", "[", "Lambda_", "]"}], ":=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"3", " ", 
         RowBox[{
          RowBox[{"lam", "^", "2"}], "/", "2"}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"zeroMomentumBubbleCutoff", "/.", " ", 
         RowBox[{"cutoff", "->", "Lambda"}]}], ")"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "2"}], ":", 
     RowBox[{"DR", " ", "counterterms", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"A", "-", "49"}], ")"}], "."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dZm2DR", "[", "eps_", "]"}], ":=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"lam", "/", "2"}], ")"}]}], " ", 
         RowBox[{"TDR", "[", "m2", "]"}]}], ")"}], "/.", " ", 
       RowBox[{"e", "->", "eps"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dZphiDR", "[", "eps_", "]"}], ":=", "dZphiFinal"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
