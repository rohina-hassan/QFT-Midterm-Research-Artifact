Cell[TextData[{
 StyleBox["Physics interpretation:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nFor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "<", "\[Epsilon]", "\[LessLess]", "1"}], TraditionalForm],
      "errors" -> {}, "input" -> "0<\\epsilon\\ll1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"bd478fab-25cc-d74f-85ae-309d54befdd2"],
 StyleBox[", the one-loop beta function has two fixed points: the Gaussian \
fixed point ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "*"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "g_*=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7adc58df-2597-3d4d-8c15-0602bb2721b0"],
 StyleBox[" and the nontrivial Wilson--Fisher fixed point ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "*"], "\[LongEqual]", "\[Epsilon]", "/", "3"}],
        TraditionalForm], "errors" -> {}, "input" -> "g_*=\\epsilon/3", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"dbbff81a-c223-094c-8f5b-40c90fade2f8"],
 StyleBox[". Their stability is determined by the eigenvalue ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Beta]", "\[Prime]"], "(", 
         SubscriptBox[
          StyleBox["g", "TI"], "*"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\beta'(g_*)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"18276023-759f-f046-a1ec-cff149a1735d"],
 StyleBox[" of the linearized RG flow. At the Gaussian fixed point, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Beta]", "\[Prime]"], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", "-", "\[Epsilon]", "<", 
         "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta'(0)=-\\epsilon<0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"42739ba4-29fb-0d48-8a3d-4216f2f9ea5e"],
 StyleBox[", indicating UV attraction and IR repulsion along the coupling \
direction. Thus, a perturbation of the coupling is IR-relevant. At the \
Wilson--Fisher fixed point, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Beta]", "\[Prime]"], 
         RowBox[{"(", 
           RowBox[{"\[Epsilon]", "/", "3"}], ")"}], "\[LongEqual]", "+", 
         "\[Epsilon]", ">", "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta'(\\epsilon/3)=+\\epsilon>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5d7d3230-8888-ac4e-b943-c97fe2abbc2c"],
 StyleBox[", indicating IR attraction and UV repulsion; the coupling \
perturbation is therefore IR-irrelevant. In the four-dimensional limit ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[Rule]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon\\to0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a01260f6-b8d3-a14f-bdd8-92fb835dbf4d"],
 StyleBox[", the two fixed points coalesce at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "*"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "g_*=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"55135f6c-d04e-7242-846e-f23e75cab5ef"],
 StyleBox[". The resulting beta function, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], "\[LongEqual]", "3", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\beta_g=3g^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"767f0a41-db7a-5c4e-9ba1-b8bb9e3d4990"],
 StyleBox[", has a double root at the Gaussian fixed point, which is the only \
distinct fixed point at this order.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0042566434870167`*^9, 
  4.0042567413713245`*^9}},ExpressionUUID->"f90c731a-2f5f-9749-a594-\
ce7d89a8a441"],

Cell["\<\
------------------------------------------------------------------------------\
------------------------------------------------------------------------------\
--------------------\
\>", "Text",
 CellChangeTimes->{{4.0041911891378803`*^9, 
  4.0041911960386467`*^9}},ExpressionUUID->"b7f8c11d-8278-6542-80f6-\
c676fd907bf7"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.4.3 Nontrivial Fixed Point",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.003816426657757*^9, 4.0038164559410076`*^9}, 
   4.004012547015524*^9},ExpressionUUID->"c6fd8a88-b53f-b842-92a7-\
bbd06e4407f5"],

Cell[TextData[{
 StyleBox["In this subsection, we identify the fixed points of the \
renormalization-group (RG) flow by analyzing the zeros of the one-loop beta \
function derived in Section 1.4.2. A fixed point is a value of the coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["g", "TI"], "*"], TraditionalForm], "errors" -> {}, "input" -> 
     "g_*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"62ebe474-1a06-9040-946f-b9b6a44abf25"],
 StyleBox[" at which ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["g", "TI"], "*"], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\beta_g(g_*)=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"acf5361d-d994-6149-95c5-caaa25648616"],
 StyleBox[", so that the coupling remains invariant under RG evolution. In ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d=4-\\epsilon", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a862bae5-0739-d844-a46a-a1b0fa7a7972"],
 StyleBox[" dimensions, the beta function contains a classical scaling \
contribution proportional to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", "\[Epsilon]", 
         StyleBox["g", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "-\\epsilon g", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"aed61458-a0ed-2f40-914d-421dbe7f00b0"],
 StyleBox[" and a quantum correction proportional to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["g", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "g^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6a743a2d-17e7-c146-bfd8-836a8ac6fcd2"],
 StyleBox[". Setting it to zero gives:\n\n                                    \
                                                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], 
         RowBox[{"(", 
           StyleBox["g", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           RowBox[{"3", 
             StyleBox["g", "TI"], "-", "\[Epsilon]"}], ")"}], "\[LongEqual]", 
         "0  ", "\[DoubleLongRightArrow]  ", 
         SubsuperscriptBox[
          StyleBox["g", "TI"], "*", 
          RowBox[{"(", 
            StyleBox["G", "TI"], ")"}]], "\[LongEqual]", "0", ",    ", 
         SubsuperscriptBox[
          StyleBox["g", "TI"], "*", 
          RowBox[{"(", 
            RowBox[{
              StyleBox["W", "TI"], 
              StyleBox["F", "TI"]}], ")"}]], "\[LongEqual]", 
         FractionBox["\[Epsilon]", "3"], ",    ", 
         SubscriptBox["\[Lambda]", "*"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"], "\[Epsilon]"}], "3"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta_g(g)=g(3g-\\epsilon)=0\n\\quad\\Longrightarrow\\quad\n\
g_*^{(G)}=0,\\qquad\ng_*^{(WF)}=\\frac{\\epsilon}{3},\n\\qquad\n\
\\lambda_*=\\frac{16\\pi^2\\epsilon}{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d7e649fa-40ce-a144-a8d4-eaf2e04ff866"],
 StyleBox["                                                                   \
    (A-62)\n\nThe first solution is the Gaussian fixed point, corresponding \
to a noninteracting theory, while the second is the nontrivial \
Wilson\[Dash]Fisher fixed point, which describes the interacting critical \
behavior for d<4. To determine their stability, we linearize the RG flow \
around each fixed point. The corresponding stability coefficients are:\n\n    \
                                                                              \
                          ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Beta]", 
          StyleBox["g", "TI"], "\[Prime]"], 
         RowBox[{"(", 
           StyleBox["g", "TI"], ")"}], "\[LongEqual]", "6", 
         StyleBox["g", "TI"], "-", "\[Epsilon]", ",    ", 
         SubsuperscriptBox["\[Beta]", 
          StyleBox["g", "TI"], "\[Prime]"], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", "-", "\[Epsilon]", ",    ", 
         SubsuperscriptBox["\[Beta]", 
          StyleBox["g", "TI"], "\[Prime]"], 
         RowBox[{"(", 
           SubsuperscriptBox[
            StyleBox["g", "TI"], "*", 
            RowBox[{"(", 
              RowBox[{
                StyleBox["W", "TI"], 
                StyleBox["F", "TI"]}], ")"}]], ")"}], "\[LongEqual]", "+", 
         "\[Epsilon]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta_g'(g)=6g-\\epsilon,\n\\qquad\n\\beta_g'(0)=-\\epsilon,\n\\qquad\n\
\\beta_g'\\left(g_*^{(WF)} \\right)=+\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9f159e1a-e4b9-9d40-a2dd-183a05c644f2"],
 StyleBox["                                                                   \
                    (A-63)\n\nFor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "<", "\[Epsilon]", "\[LessLess]", "1"}], TraditionalForm],
      "errors" -> {}, "input" -> "0<\\epsilon\\ll1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"03ea5763-09cc-694a-bfc5-27d0d2278a95"],
 StyleBox[", the Wilson\[Dash]Fisher fixed point is infrared-attractive, \
whereas the Gaussian fixed point is infrared-repulsive along the coupling \
direction. Indeed, for the flow parameter ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["t", "TI"], "\[LongEqual]", "ln", 
         SubscriptBox["\[Mu]", 
          StyleBox["R", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "t=\\ln\\mu_R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8da79aa7-7e41-034f-94d1-31cee1e9af27"],
 StyleBox[", a positive stability coefficient means that deviations from the \
fixed point decrease as ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Mu]", 
        StyleBox["R", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu_R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a6d6b829-2ce9-b54f-be2d-872802eccb5f"],
 StyleBox[" decreases, while a negative coefficient implies the opposite. \
Thus, the coupling perturbation is IR-irrelevant at the Wilson\[Dash]Fisher \
fixed point and IR-relevant at the Gaussian fixed point.\n\nIn exactly four \
dimensions, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f4c09c83-2586-bb4f-a41b-d4ed70737382"],
 StyleBox[", the two fixed points merge at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "*"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "g_*=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"130b1007-6736-6045-885a-89801972db8b"],
 StyleBox[", leaving ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], 
         RowBox[{"(", 
           StyleBox["g", "TI"], ")"}], "\[LongEqual]", "3", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\beta_g(g)=3g^2,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"fcecf558-9cee-f643-b16e-33516a5a883e"],
 StyleBox[" which has a double Gaussian root and no nontrivial perturbative \
fixed point. For positive coupling, the four-dimensional theory is marginally \
irrelevant toward the infrared: the coupling approaches zero logarithmically \
as the renormalization scale decreases. The Wilson\[Dash]Fisher fixed-point \
coupling and its stability properties provide the starting point for \
calculating the critical exponents in Part 2.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004191275355215*^9, 4.0041914384615383`*^9}, {
  4.00419149332399*^9, 4.00419149582502*^9}, {4.004256899418476*^9, 
