           SuperscriptBox["\[Epsilon]", "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "g_*=\\frac{\\epsilon}{3}+\\frac{17\\epsilon^2}{81}+O(\\epsilon^3)", 
