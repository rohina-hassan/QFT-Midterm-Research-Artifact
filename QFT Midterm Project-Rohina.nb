  "Out[724]//TraditionalForm=",ExpressionUUID->"e4277348-5a7e-4a4b-9c91-\
4afa43febac5"],

Cell[BoxData[
 FormBox["\<\"Coefficients of g, g^2, g^3 (expected: 0, 1/12, -1/(4e)):\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004297423649502*^9, 4.004299647866892*^9},
 CellLabel->
  "During evaluation of \
