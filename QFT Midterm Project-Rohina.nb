Cell[CellGroupData[{

Cell[TextData[StyleBox["1.4.4 Field Anomalous Dimension at One Loop",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.003816436955721*^9, 4.0038164606455975`*^9}, 
   4.004183975404394*^9},ExpressionUUID->"e115181e-5922-3a46-baef-\
32f5f8c1542e"],

Cell[TextData[{
 StyleBox["In this subsection, we derive the anomalous dimension of the \
scalar field, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\gamma_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4501aad2-8c2d-8243-a41d-2d8de939fb28"],
 StyleBox[", at one-loop order. The field-strength renormalization constant ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Z", "TI"], "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "Z_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"bb44dd18-1aef-fc44-abb0-8af7d837a0c0"],
 StyleBox[" relates the bare and renormalized fields and accounts for the \
scale dependence of their normalization. The anomalous dimension is defined \
as\n\n                                                                        \
                                          ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Gamma]", "\[Phi]"], 
         RowBox[{"(", 
           StyleBox["g", "TI"], ")"}], "\[Congruent]", 
         FractionBox["1", "2"], 
         SubscriptBox[
          RowBox[{
            RowBox[{
              SubscriptBox["\[Mu]", 
               StyleBox["R", "TI"]], 
              FractionBox[
               StyleBox["d", "TI"], 
               RowBox[{
                 StyleBox["d", "TI"], 
                 SubscriptBox["\[Mu]", 
                  StyleBox["R", "TI"]]}]], "ln", 
              SubscriptBox[
               StyleBox["Z", "TI"], "\[Phi]"]}], "\[VerticalSeparator]"}], 
          "bare parameters"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma_\\phi(g)\\equiv\n\
\\frac{1}{2}\\left.\\mu_R\\frac{d}{d\\mu_R}\\ln Z_\\phi\\right|_{\\text{bare \
parameters}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"216d3e23-aea7-e64a-badf-db275a811049"],
 StyleBox["                                                                   \
                         (A-64)\n\nAt one-loop order, the two-point function \
receives a tadpole contribution to the self-energy. Since this diagram is \
independent of the external momentum ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ed112fa0-eb3b-6d46-ae9f-10912cf0cd0d"],
 StyleBox[", it does not contribute to the field-strength renormalization. As \
established in Sections 1.3.1 and 1.3.2, the field-strength counterterm \
therefore vanishes, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\delta Z_\\phi=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"30f69591-35dc-0b4e-9cbe-da38403d8b7d"],
 StyleBox[", giving ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "Z_\\phi=1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2f5b0365-d2fa-de4d-a4f5-4d59eb4ad662"],
 StyleBox[" at this order. Consequently, the one-loop field anomalous \
dimension is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Gamma]", "\[Phi]", 
          RowBox[{"(", "1", ")"}]], "\[LongEqual]", "0."}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\gamma_\\phi^{(1)}=0.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cd7f04da-70c7-8645-ae68-db0b2f27981f"],
 "\n",
 StyleBox["The tadpole is momentum independent, so the one-loop two-point \
function has the form ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["p", "TI"], "2"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "+", 
         StyleBox["const", FontSlant -> "Plain"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Gamma^{(2)}(p^2)=p^2+\\mathrm{const}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c888d321-c2ad-9241-9813-fd7158916f6c"],
 StyleBox[". It therefore shifts only the mass parameter, which is tuned to \
criticality, without changing the coefficient of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"bd7b84ab-f084-454a-9ea1-929b471319bb"],
 StyleBox[". Consequently, it cannot modify the scaling of the critical \
propagator, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["G", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[Proportional]", 
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], ")"}], 
          RowBox[{"-1", "+", "\[Eta]", "/", "2"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "G(p)\\propto(p^2)^{-1+\\eta/2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9ac383a4-dbcd-ab4c-a7ea-0055027cd3d0"],
 StyleBox[". Thus, at one-loop order, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\delta Z_\\phi=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"117744dd-f6da-b645-aeac-7fe0e2493121"],
 StyleBox[", ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Gamma]", "\[Phi]", 
          RowBox[{"(", "1", ")"}]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\gamma_\\phi^{(1)}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ee31f140-2ca3-df46-9bb7-d411325619fc"],
 StyleBox[", and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Eta]", 
          RowBox[{"(", "1", ")"}]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\eta^{(1)}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"42da4219-9b58-a543-a7d0-1cbaaf19deb4"],
 StyleBox[". (A-65, A-66)",
  FontSize->13],
 StyleBox["\n\nAlthough the one-loop anomalous dimension vanishes, this \
result does not imply that the field anomalous dimension is identically zero. \
In scalar ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Phi]", "4"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\phi^4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d2cfadad-26bc-1948-96ed-5faeb785243d"],
 StyleBox[" theory, the first nonvanishing contribution arises at two-loop \
order. Thus, at one-loop order, the scaling dimension of the field retains \
its canonical value, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["d", "TI"], "\[Phi]"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], "-", "2"}], "2"], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "d_\\phi=\\frac{d-2}{2}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"e1804693-d6a2-c84d-b179-e1a9bbe9f3b3"],
 StyleBox[" ",
  FontSize->11],
 StyleBox["This result completes the one-loop renormalization-group analysis \
and provides the foundation for the calculation of critical exponents, \
particularly the anomalous-dimension exponent ",
