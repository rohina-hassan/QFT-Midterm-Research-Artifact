Cell[CellGroupData[{

Cell[TextData[StyleBox["1.4.2 Derivation of the Beta Function",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.003816419765867*^9, 4.0038164481633453`*^9}, 
   4.004012516303282*^9},ExpressionUUID->"f43f3d1e-85df-244c-9b56-\
8c2f31341f3b"],

Cell[TextData[{
 StyleBox["In this subsection, we derive the one-loop beta function governing \
the renormalization-group evolution of the dimensionless coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3ed6f12f-a3a8-be48-83af-9d9b8d27b955"],
 StyleBox[". We begin with the relation between the bare coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Lambda]", "0"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\lambda_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5d5b1187-975c-6846-ad18-1d8b9109a892"],
 StyleBox[" and the renormalized coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"674477e9-f4ea-504d-afb9-15fc48859cb4"],
 StyleBox[", established in Section 1.4.1: \n\n                               \
                                                                              \
        ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "0"], "\[LongEqual]", 
         FractionBox[
          SubscriptBox["\[Lambda]", "0"], 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], "\[LongEqual]", 
         SubsuperscriptBox["\[Mu]", 
          StyleBox["R", "TI"], "\[Epsilon]"], 
         SubscriptBox[
          StyleBox["Z", "TI"], 
          StyleBox["g", "TI"]], 
         StyleBox["g", "TI"], ",    ", 
         SubscriptBox[
          StyleBox["Z", "TI"], 
          StyleBox["g", "TI"]], "\[LongEqual]", "1", "+", 
         FractionBox[
          RowBox[{"3", 
            StyleBox["g", "TI"]}], "\[Epsilon]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "g_0 = \\frac{\\lambda_0}{16\\pi^2}\n= \\mu_R^\\epsilon Z_g g,\n\\qquad\n\
Z_g = 1 + \\frac{3g}{\\epsilon}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"fcebbd69-6772-6341-9704-d29100761713"],
 StyleBox["    ",
  FontSize->13],
 StyleBox["                                                                   \
                             (A-58)\n\nThe central physical principle is that \
the bare coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Lambda]", "0"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\lambda_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"518e9867-0eb9-d749-8265-f0704f3d264e"],
 StyleBox[" is independent of the arbitrary renormalization scale ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Mu]", 
        StyleBox["R", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu_R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9e777f93-1222-6945-b384-236fc9b7c12e"],
 StyleBox[". Applying the operator ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          StyleBox["R", "TI"]], "\[DifferentialD]", "/", 
         StyleBox["d", "TI"], 
         SubscriptBox["\[Mu]", 
          StyleBox["R", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu_R\\,d/d\\mu_R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"490371ea-ff99-3444-b55b-0182bd9726fe"],
 StyleBox[" to this relation while holding ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Lambda]", "0"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\lambda_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d98731c0-ffcb-5147-af13-96726d294d19"],
 StyleBox[" fixed yields the renormalization-group equation for ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5f7e0818-6321-c346-a581-c9342afe9b62"],
 StyleBox[". We define the beta function as\n\n                               \
                                                                              \
                         ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], 
         RowBox[{"(", 
           StyleBox["g", "TI"], ")"}], "\[Congruent]", 
         SubscriptBox[
          RowBox[{
            RowBox[{
              SubscriptBox["\[Mu]", 
               StyleBox["R", "TI"]], 
              FractionBox[
               RowBox[{
                 StyleBox["d", "TI"], 
                 StyleBox["g", "TI"]}], 
               RowBox[{
                 StyleBox["d", "TI"], 
                 SubscriptBox["\[Mu]", 
                  StyleBox["R", "TI"]]}]]}], "\[VerticalSeparator]"}], 
          SubscriptBox["\[Lambda]", "0"]]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\beta_g(g)\\equiv\n\
\\left.\\mu_R\\frac{dg}{d\\mu_R}\\right|_{\\lambda_0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6a72c25d-aca8-2747-9447-e9897892b3b2"],
 StyleBox["                                                                   \
                                                    (A-59)\n\nUsing the \
one-loop expression for ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Z", "TI"], 
        StyleBox["g", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "Z_g", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6fc4eb58-b2bf-1140-b9f1-87b24155aa86"],
 StyleBox[" and consistently retaining terms through one-loop order, we \
derive ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Beta]", 
        StyleBox["g", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta_g", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a8e702b0-5895-d845-8579-335c27780b3d"],
 StyleBox[" in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d=4-\\varepsilon", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8ae5eca8-547a-1740-a3c0-382e470f1654"],
 StyleBox[" dimensions. The resulting expression contains a classical scaling \
contribution, arising from the engineering dimension of the coupling, and a \
quantum correction generated by the ultraviolet divergence of the one-loop \
four-point function. Taking the four-dimensional limit, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[Rule]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\varepsilon\\to0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f9d38df5-91b0-264b-82c2-c60895a02bbc"],
 StyleBox[", gives the beta function of the renormalized theory in four \
dimensions. This result determines the scale dependence of the coupling and \
provides the basis for analyzing the renormalization-group flow and \
identifying fixed points in the following subsection.\nDifferentiating ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"ln", 
         SubscriptBox[
          StyleBox["g", "TI"], "0"], "\[LongEqual]", "\[Epsilon]", "ln", 
         SubscriptBox["\[Mu]", 
          StyleBox["R", "TI"]], "+", "ln", 
         SubscriptBox[
          StyleBox["Z", "TI"], 
          StyleBox["g", "TI"]], "+", "ln", 
         StyleBox["g", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\ln g_ 0\n=\\epsilon\\ln\\mu_R+\\ln Z_g+\\ln g", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"bf3671c5-80b9-9844-a259-c1d449639767"],
 " ",
 StyleBox["with respect to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"ln", 
         SubscriptBox["\[Mu]", 
          StyleBox["R", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\ln\\mu_R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"417b1381-3702-9646-a717-2df2f6b1aa63"],
 StyleBox[" at fixed bare coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["g", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "g_ 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bba14370-6eba-aa4d-89f6-86e2a9a15df0"],
 StyleBox[", and defining  ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Mu]", 
          StyleBox["R", "TI"]], "\[DifferentialD]", 
         StyleBox["g", "TI"], "/", 
         StyleBox["d", "TI"], 
         SubscriptBox["\[Mu]", 
          StyleBox["R", "TI"]], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\beta_g=\\mu_R\\,dg/d\\mu_R,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c2b98423-5544-8f48-aaa1-85b7daa90bcc"],
 StyleBox[" we obtain:\n\n                                                    \
                                                                              \
",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "\[LongEqual]", "\[Epsilon]", "+", 
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             FractionBox["1", 
              StyleBox["g", "TI"]], "+", 
             FractionBox[
              RowBox[{"\[PartialD]", "ln", 
                SubscriptBox[
                 StyleBox["Z", "TI"], 
                 StyleBox["g", "TI"]]}], 
              RowBox[{"\[PartialD]", 
                StyleBox["g", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "0=\\epsilon+\\beta_g\\left(\\frac{1}{g}\n+\\frac{\\partial\\ln \
Z_g}{\\partial g} \\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0db29aed-a555-f843-a9f6-94ca9f288f12"],
 "                                                                            \
                       ",
 StyleBox["(A-60)",
  FontSize->13],
 StyleBox["\n\nSubstituting the one-loop renormalization constant ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Z", "TI"], 
          StyleBox["g", "TI"]], "\[LongEqual]", "1", "+", "3", 
         StyleBox["g", "TI"], "/", "\[Epsilon]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "Z_g=1+3g/\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"eeef5d6f-90bb-794a-beb8-2b905d899368"],
 StyleBox[" ",
  FontSize->13],
 StyleBox["gives the algebraic solution\n\n                                   \
                                                                              \
                ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Beta]", 
          StyleBox["g", "TI"], 
          StyleBox["truncated", FontSlant -> "Plain"]], "\[LongEqual]", "-", 
         FractionBox[
          RowBox[{"\[Epsilon]", 
            StyleBox["g", "TI"], 
            RowBox[{"(", 
              RowBox[{"\[Epsilon]", "+", "3", 
                StyleBox["g", "TI"]}], ")"}]}], 
          RowBox[{"\[Epsilon]", "+", "6", 
            StyleBox["g", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\beta_g^{\\mathrm{truncated}}\n=-\\frac{\\epsilon \
g(\\epsilon+3g)}{\\epsilon+6g}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d2a4ebd2-843a-5e42-9d93-8dd48e875e89"],
 StyleBox["\n\nExpanding consistently through one-loop order in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ce4fea9-7d74-6043-b71a-86e6e1a3d39c"],
 StyleBox[", we find:\n\n                                                     \
                                                                     ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], "\[LongEqual]", "-", "\[Epsilon]", 
         StyleBox["g", "TI"], "+", "3", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\beta_g=-\\epsilon g+3g^2+O(g^3)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ec9b473a-3906-d54e-9490-a9fa231e6ae4"],
 StyleBox["                                                                   \
                                                    (A-61)",
  FontSize->13],
 StyleBox["\n\nThe terms of order ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["g", "TI"], "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "g^3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1a5dd59c-7aa9-d440-ab78-dec7c2ea9895"],
 StyleBox[" and higher generated by the algebraic solution are not controlled \
by the one-loop renormalization constant. They are artifacts of treating the \
truncated ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Z", "TI"], 
        StyleBox["g", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "Z_g", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"349c0d91-f1e8-a64f-abed-d90e1a55d75e"],
 StyleBox[" ",
  FontSize->13],
 StyleBox["as an exact expression and must therefore be discarded.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004190590084503*^9, 4.00419080851058*^9}, {
   4.0042560226019897`*^9, 4.0042560996741447`*^9}, {4.0042561990864735`*^9, 
   4.0042562462931194`*^9}, {4.004256287778263*^9, 4.0042565160934505`*^9}, {
   4.0042576602352924`*^9, 4.0042577044032917`*^9}, 4.0042577397486973`*^9, 
   4.0042577769388103`*^9},ExpressionUUID->"7ee1824b-17da-3042-a804-\
af22568174e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "1."}]}], " ", "Define", " ", "the", " ", "bare", " ", 
     RowBox[{"coupling", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"lambda_", "0"}], "=", 
    RowBox[{
     RowBox[{"muR", "^", "e"}], " ", "Zg", " ", "g"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"bareCoupling", "=", 
     RowBox[{
      RowBox[{"muR", "^", "e"}], "*", "ZgMS", "*", "g"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Bare coupling:\>\"", "]"}], ";"}], "\n", 
   "bareCoupling", "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "2."}]}], " ", "Define", " ", "the", " ", "beta", " ", 
      RowBox[{"function", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"beta_g", "=", 
     RowBox[{"muR", " ", 
      RowBox[{"(", 
       RowBox[{"dg", "/", "dmuR"}], ")"}], " ", "at", " ", "fixed", " ", 
      "bare", " ", "coupling"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Differentiate", " ", "the", " ", "logarithm", " ", "of", " ", "the", " ",
       "bare", " ", 
      RowBox[{"coupling", ":", "0"}]}], "=", 
     RowBox[{"e", "+", 
      RowBox[{"beta_g", "/", "g"}], "+", 
      RowBox[{"beta_g", " ", 
       RowBox[{"(", 
        RowBox[{"d", " ", 
         RowBox[{
          RowBox[{"Log", "[", "Zg", "]"}], "/", "dg"}]}], ")"}]}]}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"betaEquation", "=", 
     RowBox[{"e", "+", 
      RowBox[{"betaSym", "/", "g"}], "+", 
      RowBox[{"betaSym", " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Log", "[", "ZgMS", "]"}], ",", "g"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Renormalization-group equation:\>\"", "]"}], 
    ";"}], "\n", "betaEquation", "\[IndentingNewLine]", "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "3."}]}], " ", "Solve", " ", "for", " ", "the", " ", 
      "beta", " ", "function", " ", "in", " ", "d", " ", 
      RowBox[{"dimensions", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"betaDExact", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"betaSym", "/.", " ", 
       RowBox[{"First", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"betaEquation", "==", "0"}], ",", "betaSym"}], "]"}], 
        "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Beta function from the one-loop Zg expression:\>\"", 
     "]"}], ";"}], "\n", "betaDExact", "\n", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "4."}]}], " ", "Expand", " ", "consistently", " ", 
      "through", " ", "one"}], "-", 
     RowBox[{"loop", " ", 
      RowBox[{"order", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"betaD", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{"betaDExact", ",", 
         RowBox[{"{", 
          RowBox[{"g", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<One-loop beta function in d = 4 - e dimensions:\>\"", 
     "]"}], ";"}], "\n", "betaD", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "5."}]}], " ", "Take", " ", "the", " ", "four"}], "-", 
     RowBox[{"dimensional", " ", 
      RowBox[{"limit", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"beta4D", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Limit", "[", 
       RowBox[{"betaD", ",", 
        RowBox[{"e", "->", "0"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<One-loop beta function in four dimensions:\>\"", "]"}],
     ";"}], "\n", "beta4D", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"independent", " ", "MS", " ", 
      RowBox[{"check", ":", "g0"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"muR", "^", "e"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"g", "+", 
          RowBox[{"a1", 
           RowBox[{
            RowBox[{"(", "g", ")"}], "/", "e"}]}], "+"}], "..."}], ")"}]}], "=", 
      RowBox[{
       RowBox[{">", "beta"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "e"}], " ", "g"}], "+", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"g", " ", 
           RowBox[{"a1", "'"}]}], "-", "a1"}], ")"}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a1", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"ZgMS", "-", "1"}], ")"}], " ", "g", " ", "e"}], "]"}]}], 
    ";"}], "                ", 
   RowBox[{"(*", 
    RowBox[{"expected", " ", "3", " ", 
     RowBox[{"g", "^", "2"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"betaMSResidue", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "e"}], " ", "g"}], "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"g", " ", 
         RowBox[{"D", "[", 
          RowBox[{"a1", ",", "g"}], "]"}]}], "-", "a1"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"betaResidueCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"betaMSResidue", "-", "betaD"}], "]"}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"expected", " ", "0"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<MS residue formula vs series result (expected: 0):\>\"",
      "]"}], ";", "betaResidueCheck"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "6."}]}], " ", "Verify", " ", "the", " ", "expected", " ",
       "beta"}], "-", 
     RowBox[{"function", " ", 
      RowBox[{"coefficients", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expectedBetaD", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "e"}], " ", "g"}], "+", 
      RowBox[{"3", " ", 
       RowBox[{"g", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"expectedBeta4D", "=", 
     RowBox[{"3", " ", 
      RowBox[{"g", "^", "2"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"betaDCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"betaD", "-", "expectedBetaD"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beta4DCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"beta4D", "-", "expectedBeta4D"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<D-dimensional beta-function consistency check:\>\"", 
     "]"}], ";"}], "\n", "betaDCheck", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Four-dimensional beta-function consistency check:\>\"",
      "]"}], ";"}], "\n", "beta4DCheck"}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{4.0041909014770184`*^9, 4.0041909456901455`*^9}, {
   4.0041917720383186`*^9, 4.004191791779455*^9}, 4.0042000483196125`*^9, {
