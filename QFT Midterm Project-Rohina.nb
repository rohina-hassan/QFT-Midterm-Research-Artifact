Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "1."}]}], " ", "Define", " ", "the", " ", "one"}], "-", 
    RowBox[{"loop", " ", "beta", " ", 
     RowBox[{"function", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"betaG", "=", "betaD"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<One-loop beta function in d = 4 - e dimensions:\>\"", 
     "]"}], ";"}], "\n", "betaG", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "2."}]}], " ", "Solve", " ", "the", " ", "fixed"}], "-", 
     RowBox[{"point", " ", 
      RowBox[{"equation", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fixedPoints", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"g", "/.", " ", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"betaG", "==", "0"}], ",", "g"}], "]"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Fixed-point solutions:\>\"", "]"}], ";"}], "\n",
    "fixedPoints", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "3."}]}], " ", "Identify", " ", "the", " ", "Gaussian", " ",
       "and", " ", "nontrivial", " ", "fixed", " ", 
      RowBox[{"points", "--"}]}], "-"}], "*)"}], 
   RowBox[{
    RowBox[{"gaussianFixedPoint", "=", 
     RowBox[{"First", "@", 
      RowBox[{"Select", "[", 
       RowBox[{"fixedPoints", ",", "PossibleZeroQ"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"nontrivialFixedPoint", "=", 
     RowBox[{"FullSimplify", "@", 
      RowBox[{"First", "@", 
       RowBox[{"Select", "[", 
        RowBox[{"fixedPoints", ",", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"PossibleZeroQ", "[", "#", "]"}]}], "&"}]}], "]"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"lamStar", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"16", " ", 
       RowBox[{"Pi", "^", "2"}], " ", "nontrivialFixedPoint"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Gaussian fixed point:\>\"", "]"}], ";"}], "\n",
    "gaussianFixedPoint", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Nontrivial (Wilson-Fisher) fixed point:\>\"", "]"}], 
    ";"}], "\n", "nontrivialFixedPoint", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Nontrivial fixed point in terms of the original \
coupling lambda:\>\"", "]"}], ";"}], "\n", "lamStar", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "4."}]}], " ", "Verify", " ", "the", " ", "fixed"}], "-", 
     RowBox[{"point", " ", 
      RowBox[{"conditions", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gaussianCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"betaG", "/.", " ", 
       RowBox[{"g", "->", "gaussianFixedPoint"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nontrivialCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"betaG", "/.", " ", 
       RowBox[{"g", "->", "nontrivialFixedPoint"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Gaussian fixed-point check (expected: 0):\>\"", "]"}], 
    ";"}], "\n", "gaussianCheck", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Nontrivial fixed-point check (expected: 0):\>\"", 
     "]"}], ";"}], "\n", "nontrivialCheck", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "5."}]}], " ", "Analyze", " ", "the", " ", "stability", " ",
       "of", " ", "the", " ", "fixed", " ", 
      RowBox[{"points", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"betaDerivative", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"D", "[", 
       RowBox[{"betaG", ",", "g"}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gaussianStability", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"betaDerivative", "/.", " ", 
       RowBox[{"g", "->", "gaussianFixedPoint"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nontrivialStability", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"betaDerivative", "/.", " ", 
       RowBox[{"g", "->", "nontrivialFixedPoint"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Beta-function derivative:\>\"", "]"}], ";"}], "\n",
    "betaDerivative", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Gaussian fixed-point stability coefficient:\>\"", 
     "]"}], ";"}], "\n", "gaussianStability", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Nontrivial fixed-point stability coefficient:\>\"", 
     "]"}], ";"}], "\n", "nontrivialStability", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Classify"}]}], " ", "the", " ", "stability", " ", "of", " ",
       "the", " ", "fixed", " ", "points", " ", "for", " ", "e"}], ">", 
     RowBox[{
      RowBox[{"0", "--"}], "-"}]}], "*)"}], 
   RowBox[{
    RowBox[{"stabilityAssumptions", "=", 
     RowBox[{"e", ">", "0"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"gaussianStabilitySign", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"gaussianStability", "<", "0"}], ",", 
       RowBox[{"Assumptions", "->", "stabilityAssumptions"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"nontrivialStabilitySign", "=", 
