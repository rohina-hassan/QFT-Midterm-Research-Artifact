Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"faToProject", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"g", "->", "lam"}], ",", 
      RowBox[{"mphi", "->", 
       RowBox[{"Sqrt", "[", "m2", "]"}]}]}], "}"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Step", " ", "2"}], ":", 
     RowBox[{
     "perturbative", " ", "Euclidean", " ", "vertex", " ", "from", " ", "exp", 
      RowBox[{"(", 
       RowBox[{"-", "S_int"}], ")"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"A", "-", "03"}], ",", 
         RowBox[{"A", "-", "15"}]}], ")"}], ".", "v4"}], " ", "and", " ", 
      "v4tree", " ", "were", " ", "already", " ", "defined", " ", "in", " ", 
      "1.1", ".1"}]}], ";", 
    RowBox[{
    "repeated", " ", "here", " ", "so", " ", "that", " ", "this", " ", "cell",
      " ", "can", " ", "be", " ", "evaluated", " ", "on", " ", "its", " ", 
     RowBox[{"own", "."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v4", "=", 
   RowBox[{"-", "lam"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"v4tree", "=", "lam"}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Step", " ", "3"}], ":", 
       RowBox[{"epsilon", " ", "convention", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"A", "-", "14"}], ")"}], ".", "d"}]}]}], "=", 
      RowBox[{"4", "-", 
       RowBox[{"e", " ", "was", " ", "set", " ", "in", " ", "1.1", ".1"}]}]}],
      ";", 
     RowBox[{
      RowBox[{"FeynCalc", " ", "uses", " ", "D"}], "=", 
      RowBox[{"4", "-", 
       RowBox[{"2", " ", "epsFC"}]}]}]}], ",", 
    RowBox[{
     RowBox[{"hence", " ", "e"}], "=", 
     RowBox[{"2", " ", 
      RowBox[{"epsFC", "."}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eRule", "=", 
    RowBox[{"e", "->", 
     RowBox[{"2", " ", "epsFC"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Step", " ", "4"}], ":", 
     RowBox[{"channel", " ", "momenta"}]}], ",", 
    RowBox[{"all", " ", "incoming", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", "-", "07"}], ")"}], ".", "Ps2"}]}], ",", "Pt2", ",", 
    RowBox[{
    "Pu2", " ", "are", " ", "plain", " ", "symbols", " ", "for", " ", "the", " ",
      "Euclidean", " ", "invariants", " ", 
     RowBox[{"Ps", ".", "Ps"}]}], ",", 
    RowBox[{"Pt", ".", "Pt"}], ",", 
    RowBox[{
     RowBox[{"Pu", ".", "Pu"}], ";", 
     RowBox[{
     "they", " ", "are", " ", "not", " ", "expanded", " ", "in", " ", 
      "p1"}]}], ",", "...", ",", 
    RowBox[{"p4", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ps", "=", 
   RowBox[{"p1", "+", "p2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Pt", "=", 
   RowBox[{"p1", "+", "p3"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pu", "=", 
    RowBox[{"p1", "+", "p4"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Step", " ", "5"}], ":", 
     RowBox[{"Wick", " ", "dictionary", " ", "for", " ", "invariants", " ", 
      RowBox[{"(", 
       RowBox[{"A", "-", "13"}], ")"}]}], ":", "Mandelstam"}], "=", 
    RowBox[{
     RowBox[{"-", "Euclidean"}], " ", "invariant"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mandelstamToEuclidean", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s", "->", 
       RowBox[{"-", "Ps2"}]}], ",", 
      RowBox[{"t", "->", 
       RowBox[{"-", "Pt2"}]}], ",", 
      RowBox[{"u", "->", 
       RowBox[{"-", "Pu2"}]}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Step", " ", "6"}], ":", 
     RowBox[{"expected", " ", "PaVe"}]}], "<->", 
    RowBox[{"Euclidean", "-", 
     RowBox[{"integral", " ", "dictionary", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"A", "-", "16"}], ")"}], ".", "It"}], " ", "is", " ", 
      "tested", " ", "explicitly", " ", "in", " ", "1.1", 
      RowBox[{".7", "."}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"euclideanToPaVe", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"TDR", "[", "x_", "]"}], ":>", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"A0", "[", "x", "]"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"16", " ", 
          RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{"BDR", "[", 
        RowBox[{"P2_", ",", "x_"}], "]"}], ":>", 
       RowBox[{
        RowBox[{"B0", "[", 
         RowBox[{
          RowBox[{"-", "P2"}], ",", "x", ",", "x"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"16", " ", 
          RowBox[{"Pi", "^", "2"}]}], ")"}]}]}]}], "}"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "7"}], ":", 
    RowBox[{"display", " ", "the", " ", "dictionary"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<FeynArts -> project parameter map:\>\"", "]"}], 
  ";"}], "\n", "faToProject", "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Epsilon convention (FeynCalc D = 4 - 2 epsFC):\>\"", 
   "]"}], ";"}], "\n", "eRule", "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Euclidean vertex and tree vertex:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"v4", ",", "v4tree"}], "}"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Wick dictionary for the channel invariants:\>\"", "]"}], 
  ";"}], "\n", "mandelstamToEuclidean", "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Expected PaVe dictionary:\>\"", "]"}], 
  ";"}], "\n", "euclideanToPaVe"}], "Input",
 CellFrame->{{0, 0}, {0, 0}},
