 CellChangeTimes->{4.0042632423454075`*^9, 4.0042923967196846`*^9, 
  4.004292790556135*^9, 4.0042930577907715`*^9, 4.004299586506733*^9},
 CellLabel->
  "Out[558]=",ExpressionUUID->"41c43367-2d7a-a045-a4a7-fae8f0db0eaa"],

Cell[BoxData[
 FormBox["\<\"Two-loop dimensional-regularization measure:\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004263242341198*^9, 4.0042923967196846`*^9, 
  4.0042927905461826`*^9, 4.0042930577907715`*^9, 4.004299586506733*^9},
 CellLabel->
  "During evaluation of \
In[518]:=",ExpressionUUID->"baefd106-8836-3545-bb8b-0192b6cc5cd6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"2", " ", "\[Pi]"}], ")"}], 
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"4", "-", "e"}], ")"}]}]], " ", 
   SuperscriptBox["muR", 
    RowBox[{"2", " ", "e"}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0042632423454075`*^9, 4.0042923967196846`*^9, 
  4.004292790556135*^9, 4.0042930577907715`*^9, 4.004299586506733*^9},
 CellLabel->
  "Out[561]//TraditionalForm=",ExpressionUUID->"a7a69466-38be-c84a-ae2e-\
52b3d67705bd"],

Cell[BoxData[
 FormBox["\<\"Massless sunset integrand:\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.004263242341198*^9, 4.0042923967196846`*^9, 
  4.0042927905461826`*^9, 4.0042930577907715`*^9, 4.004299586506733*^9},
 CellLabel->
  "During evaluation of \
In[518]:=",ExpressionUUID->"d0f19501-47c4-5c44-8216-7fc4dafc18a8"],

Cell[BoxData[
 FormBox[
  FractionBox["1", 
   RowBox[{
    FormBox[
     SuperscriptBox[
      FormBox[
       FormBox["ell",
        TraditionalForm],
       TraditionalForm], "2"],
     TraditionalForm], " ", 
    FormBox[
     SuperscriptBox[
      FormBox[
       FormBox["k",
        TraditionalForm],
       TraditionalForm], "2"],
     TraditionalForm], " ", 
    FormBox[
     SuperscriptBox[
      RowBox[{
       FormBox["\<\"(\"\>",
        TraditionalForm], 
       FormBox[
        FormBox[
         RowBox[{
          FormBox["ell",
           TraditionalForm], "+", 
          FormBox["k",
           TraditionalForm], "+", 
          FormBox["p",
           TraditionalForm]}],
         TraditionalForm],
        TraditionalForm], 
       FormBox["\<\")\"\>",
        TraditionalForm]}], "2"],
     TraditionalForm]}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.0042632423454075`*^9, 4.0042923967196846`*^9, 
  4.004292790556135*^9, 4.0042930577907715`*^9, 4.004299586516987*^9},
 CellLabel->
  "Out[565]=",ExpressionUUID->"9a97217e-f886-2342-b33e-3d531875fd90"],

Cell[BoxData[
 FormBox["\<\"Sunset integrand including the two-loop measure:\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004263242341198*^9, 4.0042923967196846`*^9, 
  4.0042927905461826`*^9, 4.0042930577907715`*^9, 4.004299586516987*^9},
 CellLabel->
  "During evaluation of \
In[518]:=",ExpressionUUID->"d22158e3-ab5f-1f41-8afa-97c13a3f4cbb"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", " ", "\[Pi]"}], ")"}], 
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"4", "-", "e"}], ")"}]}]], " ", 
    SuperscriptBox["muR", 
     RowBox[{"2", " ", "e"}]]}], 
   RowBox[{
    FormBox[
     SuperscriptBox[
      FormBox[
       FormBox["ell",
        TraditionalForm],
       TraditionalForm], "2"],
     TraditionalForm], " ", 
    FormBox[
     SuperscriptBox[
      FormBox[
       FormBox["k",
        TraditionalForm],
       TraditionalForm], "2"],
     TraditionalForm], " ", 
    FormBox[
     SuperscriptBox[
      RowBox[{
       FormBox["\<\"(\"\>",
        TraditionalForm], 
       FormBox[
        FormBox[
         RowBox[{
          FormBox["ell",
           TraditionalForm], "+", 
          FormBox["k",
           TraditionalForm], "+", 
          FormBox["p",
           TraditionalForm]}],
         TraditionalForm],
        TraditionalForm], 
       FormBox["\<\")\"\>",
        TraditionalForm]}], "2"],
     TraditionalForm]}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.0042632423454075`*^9, 4.0042923967196846`*^9, 
  4.004292790556135*^9, 4.0042930577907715`*^9, 4.004299586516987*^9},
 CellLabel->
  "Out[567]=",ExpressionUUID->"9cbcdab4-3c2b-d844-aa68-c01d16b0505a"],

Cell[BoxData[
 FormBox["\<\"Final consistency checks (expected: all True):\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004263242341198*^9, 4.0042923967196846`*^9, 
  4.0042927905461826`*^9, 4.0042930577907715`*^9, 4.004299586516987*^9},
