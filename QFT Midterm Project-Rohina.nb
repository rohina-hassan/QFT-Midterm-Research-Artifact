  FontSize->13,ExpressionUUID->"d4ab32db-8d9a-ab46-8e4d-a00683490281"],
 StyleBox[".",
  FontSize->13],
 StyleBox[" The latter is independent of the external momentum, reflecting \
the fact that the ultraviolet divergence is local.\n\nThe momentum-dependent \
contribution is isolated within the finite Feynman-parameter integral. \
Consequently, the divergent structure of the bubble integral is identical \
across the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], ",", 
         StyleBox["t", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "s,t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"542f8453-e035-8c45-9f9a-92e3fda13b34"],
 StyleBox[" and ",
  FontSize->13],
