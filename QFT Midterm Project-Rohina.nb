In[674]:=",ExpressionUUID->"a2dcc7b1-730a-724c-b39e-2a9f4a1f892c"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   FractionBox[
    SuperscriptBox["g", "2"], 
    RowBox[{"12", " ", "e"}]]}], TraditionalForm]], "Output",
