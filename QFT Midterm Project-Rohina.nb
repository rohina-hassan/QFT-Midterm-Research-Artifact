      "input" -> 
     "\\Delta_F(q)=\\frac{i}{q^2-m_\\phi^2+i0},\\qquad \
V_{\\phi^4}=-i\\,g_{\\rm FA}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"76340b77-ad58-4546-8d48-2c1e9767af2d"],
 "                                                                            \
           ",
 StyleBox[" (A-18)",
  FontSize->13],
 StyleBox["\n\n",
  FontSize->13],
