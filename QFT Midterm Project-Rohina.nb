 CellLabel->
  "Out[722]//TraditionalForm=",ExpressionUUID->"ebb62d94-529e-f84f-b352-\
876cec23fb17"],

Cell[BoxData[
 FormBox["\<\"Two-loop coefficient:\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.004297423649502*^9, 4.004299647866892*^9},
 CellLabel->
  "During evaluation of \
In[707]:=",ExpressionUUID->"d504a8e5-a8c1-5b42-af1d-064b58335aef"],

