    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"21292e37-7530-c840-90dc-3185cd90c352"],
 StyleBox[" only at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
