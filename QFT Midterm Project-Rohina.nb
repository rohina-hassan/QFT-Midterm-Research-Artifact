  FontSize->13,ExpressionUUID->"85e8595d-2bb7-d74a-8a56-7811f45cc6e1"],
 StyleBox[" ",
  FontSize->13],
 StyleBox["and the momentum-dependent bubble ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], "(", 
