Cell[CellGroupData[{

Cell[TextData[StyleBox["1.1.7 Euclidean Matching of the One-Loop \
Contributions",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{
  4.004171627152979*^9},ExpressionUUID->"9eab9ccc-dd08-7b42-a1e5-\
e95ce94decce"],

Cell[TextData[{
 StyleBox["With the dictionary of 1.1.5, the Euclidean building blocks are \
the integrands  ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["dloop", FontSlant -> "Plain"], 
         RowBox[{"[", 
           StyleBox["k", "TI"], "]"}], " ", 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], ",    ", 
         StyleBox["dloop", FontSlant -> "Plain"], 
         RowBox[{"[", 
           StyleBox["k", "TI"], "]"}], " ", 
         FractionBox["1", 
          RowBox[{
            RowBox[{"(", 
              RowBox[{
                SuperscriptBox[
                 StyleBox["k", "TI"], "2"], "+", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]}], ")"}], "(", 
            RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["k", "TI"], "+", 
                   StyleBox["P", "TI"]}], ")"}], "2"], "+", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]}], ")"}]], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathrm{dloop}[k]\\,\\frac{1}{k^2+m^2},\\qquad \
\\mathrm{dloop}[k]\\,\\frac{1}{(k^2+m^2)\\big((k+P)^2+m^2\\big)},", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ad31996e-ade1-9047-abfb-85cdc0c30d6f"],
 " ",
 StyleBox["and the integrals ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], "DR"], TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\rm DR}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f6fed5c1-3de1-b941-acfc-00f7135c21cc"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], "DR"], "(", 
         SuperscriptBox[
          StyleBox["P", "TI"], "2"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "B_{\\rm DR}(P^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"621ecee4-2932-6442-a3dd-5237d7942f40"],
 StyleBox[" defined in 1.2. The three four-point channels use ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["s", "TI"]], ",", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["t", "TI"]], ",", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["u", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "P=P_s,P_t,P_u", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1d2fd475-f5de-c748-bce7-c63d369babfd"],
 StyleBox[" with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "P_s=p_1+p_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e685520d-3341-eb4b-bcee-f8397a2a3d5d"],
 StyleBox[", ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["t", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "P_t=p_1+p_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b517c28f-8ba4-9646-9bc2-1a9ef22263a2"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["u", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "P_u=p_1+p_4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4ecf97d5-2dd8-9f4f-889a-012009cd9071"],
 StyleBox[".\nWith ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["v", "TI"], "4"], "\[LongEqual]", "-", "\[Lambda]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "v_4=-\\lambda", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1816b0be-881d-3541-96d5-43c8e92b7a0d"],
 StyleBox[" and the symmetry factors of 1.1.2 to 1.1.4, the one-loop \
contributions to the 1PI functions are:\n\n                                   \
                                                                       ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{"1", "-loop"}], 
          RowBox[{"(", "2", ")"}]], "\[LongEqual]", 
         FractionBox["\[Lambda]", "2"], " ", 
         SubscriptBox[
          StyleBox["T", "TI"], "DR"], ",    ", 
         SubsuperscriptBox["\[CapitalGamma]", 
          RowBox[{"1", "-loop"}], 
          RowBox[{"(", "4", ")"}]], "\[LongEqual]", "-", 
         FractionBox[
          SuperscriptBox["\[Lambda]", "2"], "2"], 
         UnderscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", 
            StyleBox["s", "TI"], ",", 
            StyleBox["t", "TI"], ",", 
            StyleBox["u", "TI"]}], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["B", "TI"], "DR"], 
         RowBox[{"(", 
           SubsuperscriptBox[
            StyleBox["P", "TI"], 
            StyleBox["i", "TI"], "2"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Gamma^{(2)}_{1\\text{-loop}}=\\frac{\\lambda}{2}\\,T_{\\rm \
DR},\\qquad\n\
\\Gamma^{(4)}_{1\\text{-loop}}=-\\frac{\\lambda^2}{2}\\sum_{i=s,t,u}B_{\\rm \
DR}(P_i^2).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"60149694-2ebe-1343-848c-b367f36a4255"],
 StyleBox["\n\n",
  FontSize->13],
 StyleBox["Consistency check against 1.1.6:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\[LineSeparator] After the identification ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "FA"], "\[LongEqual]", "\[Lambda]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "g_{\\rm FA}=\\lambda", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"fd5e5e66-11a8-5d48-9152-66a90c996cce"],
 StyleBox[", the PaVe results of 1.1.6 must equal minus these contributions \
under the dictionary (A-24). The cells below test this. If a check fails, \
inspect the sign or factor of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8aecd280-cdcf-be48-a9dc-12239424d745"],
 StyleBox[" in 1.1.5 instead of adjusting the result to force a zero. (A-26)\n\
The explicit evaluation of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], "DR"], TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\rm DR}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4470ef8c-1a6a-9545-b7d6-b9faf88e0db5"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["B", "TI"], "DR"], TraditionalForm], "errors" -> {}, "input" -> 
     "B_{\\rm DR}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e2496f06-f466-a942-92e7-a9dce0177641"],
 StyleBox[" is done in 1.2.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004171839546007*^9, 4.004172004690157*^9}, {
  4.0041731863787556`*^9, 4.0041732029992313`*^9}, {4.0042036899452324`*^9, 
  4.004203690930027*^9}, {4.004203751692295*^9, 
  4.004203760641577*^9}},ExpressionUUID->"c321d7cf-6086-8044-ba73-\
cda0b3018e31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Step", " ", "0"}], ":", 
      RowBox[{
      "FeynArts", " ", "prints", " ", "its", " ", "quartic", " ", "coupling", 
       " ", "as", " ", "g", " ", 
       RowBox[{"(", 
        RowBox[{"not", " ", "gFA"}], ")"}], " ", "and", " ", "the", " ", 
       "mass", " ", "as", " ", 
       RowBox[{"mphi", ".", "Identification"}], " ", 
       RowBox[{"(", 
        RowBox[{"A", "-", "12"}], ")"}]}], ":", "g_FA"}], "=", "lam"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"mphi", "^", "2"}], "=", 
      RowBox[{
       RowBox[{"m2", ".", "TDR"}], " ", "and", " ", "BDR", " ", "must", " ", 
       "stay", " ", "inert", " ", "here"}]}], ";", 
     RowBox[{"they", " ", "are", " ", "defined", " ", "in", " ", "1.2", 
      RowBox[{".3", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"faToProject", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"g", "->", "lam"}], ",", 
       RowBox[{"mphi", "->", 
        RowBox[{"Sqrt", "[", "m2", "]"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"TDR", ",", "BDR"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Step", " ", "1"}], ":", 
      RowBox[{"Euclidean", " ", "integrands"}]}], ",", 
     RowBox[{"including", " ", "the", " ", "DR", " ", "measure", " ", 
      RowBox[{"(", 
       RowBox[{"inert", " ", "symbols"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"euclideanTadpoleIntegrand", "[", "k_", "]"}], ":=", 
     RowBox[{
      RowBox[{"dloop", "[", "k", "]"}], " ", 
      RowBox[{"Prop", "[", "k", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"euclideanBubbleIntegrand", "[", 
      RowBox[{"k_", ",", "P_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"dloop", "[", "k", "]"}], " ", 
      RowBox[{"Prop", "[", "k", "]"}], " ", 
      RowBox[{"Prop", "[", 
       RowBox[{"k", "+", "P"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Step", " ", "2"}], ":", 
      RowBox[{"scalar", " ", "integrals"}]}], ",", 
     RowBox[{"evaluated", " ", "in", " ", "1.2"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tadpoleDRIntegral", "=", 
     RowBox[{"TDR", "[", "m2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bubbleDRIntegral", "[", "P2_", "]"}], ":=", 
     RowBox[{"BDR", "[", 
      RowBox[{"P2", ",", "m2"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "3"}], ":", 
     RowBox[{"one", "-", 
      RowBox[{
      "loop", " ", "contributions", " ", "to", " ", "the", " ", "1", "PI", " ",
        "functions", " ", 
       RowBox[{"(", 
        RowBox[{"A", "-", "15"}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tadpoleEuclideanContribution", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"v4", "/", "2"}], ")"}]}], " ", "tadpoleDRIntegral"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bubbleEuclideanContribution", "[", "P2_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"v4", "^", "2"}], "/", "2"}], ")"}]}], " ", 
      RowBox[{"bubbleDRIntegral", "[", "P2", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"bubbleSChannel", "=", 
     RowBox[{"bubbleEuclideanContribution", "[", "Ps2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bubbleTChannel", "=", 
     RowBox[{"bubbleEuclideanContribution", "[", "Pt2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bubbleUChannel", "=", 
     RowBox[{"bubbleEuclideanContribution", "[", "Pu2", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "twoPointOneLoopCorrection", "=", "tadpoleEuclideanContribution"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"fourPointOneLoopCorrection", "=", 
     RowBox[{
     "bubbleSChannel", "+", "bubbleTChannel", "+", "bubbleUChannel"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "4"}], ":", 
     RowBox[{"explicit", "-", 
      RowBox[{"measure", " ", "form", " ", "of", " ", "the", " ", "four"}], "-", 
      RowBox[{"point", " ", "sum"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"euclideanBubbleKernel", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Prop", "[", "k", "]"}], " ", 
       RowBox[{"Prop", "[", 
        RowBox[{"k", "+", "Ps"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"Prop", "[", "k", "]"}], " ", 
       RowBox[{"Prop", "[", 
        RowBox[{"k", "+", "Pt"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"Prop", "[", "k", "]"}], " ", 
       RowBox[{"Prop", "[", 
        RowBox[{"k", "+", "Pu"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"euclideanBubbleTotalFactored", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"lam", "^", "2"}], "/", "2"}], ")"}]}], " ", 
      RowBox[{"dloop", "[", "k", "]"}], " ", "euclideanBubbleKernel"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"dloop", "[", "k", "]"}], " ", "stands", " ", "for", " ", 
      RowBox[{
       RowBox[{"muR", "^", "e"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi"}], ")"}], "^", "d"}]}], " ", 
      RowBox[{"d", "^", "d"}], " ", "k", " ", "with", " ", "d"}], "=", 
     RowBox[{"4", "-", "e"}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Step", " ", "5"}], ":", 
      RowBox[{
      "checks", " ", "against", " ", "the", " ", "FeynCalc", " ", 
       "amplitudes", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"expected", ":", "0"}], ")"}], ".", "Under"}], " ", "the", " ",
        "dictionary", " ", "of", " ", "1.1", ".5", 
       RowBox[{"(", "e", ")"}]}], ":", 
      RowBox[{"FeynCalc", " ", "amplitude"}]}], "=", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Euclidean", " ", "Gamma", " ", "contribution"}], ")"}], 
       "."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tadpoleCheck", "=", 
     RowBox[{"Simplify", "[", 
