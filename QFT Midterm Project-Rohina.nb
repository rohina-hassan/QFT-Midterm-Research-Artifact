Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Divergence", " ", 
    RowBox[{"structure", ":", 
     RowBox[{"cutoff", " ", "vs", " ", "DR", " ", 
      RowBox[{"(", 
       RowBox[{"A", "-", "41"}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"divAssume", "=", 
     RowBox[{"{", 
      RowBox[{"m2", ">", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tadpoleQuadCoeff", "=", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{"tadpoleExpansion", "/", 
        RowBox[{"\[CapitalLambda]", "^", "2"}]}], ",", 
       RowBox[{"\[CapitalLambda]", "->", "Infinity"}], ",", 
       RowBox[{"Assumptions", "->", "divAssume"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tadpoleLogCoeff", "=", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"tadpoleExpansion", "-", 
          RowBox[{"tadpoleQuadCoeff", " ", 
           RowBox[{"\[CapitalLambda]", "^", "2"}]}]}], ")"}], "/", 
        RowBox[{"Log", "[", "\[CapitalLambda]", "]"}]}], ",", 
       RowBox[{"\[CapitalLambda]", "->", "Infinity"}], ",", 
       RowBox[{"Assumptions", "->", "divAssume"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bubbleLogCoeff", "=", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{"zeroMomentumBubbleExpansion", "/", 
        RowBox[{"Log", "[", "\[CapitalLambda]", "]"}]}], ",", 
       RowBox[{"\[CapitalLambda]", "->", "Infinity"}], ",", 
       RowBox[{"Assumptions", "->", "divAssume"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<\>\"", ",", "\"\<Cutoff: \[CapitalLambda]\.b2 coeff\>\"",
          ",", "\"\<Cutoff: ln \[CapitalLambda] coeff\>\"", 
         ",", "\"\<DR: 1/e coeff\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<T\>\"", ",", "tadpoleQuadCoeff", ",", "tadpoleLogCoeff", 
         ",", "tadpolePole"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<B(0)\>\"", ",", "0", ",", "bubbleLogCoeff", ",", 
         "zeroMomentumBubblePole"}], "}"}]}], "}"}], ",", 
     RowBox[{"Frame", "->", "All"}]}], "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"logPoleMatch", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tadpoleLogCoeff", "-", "tadpolePole"}], ",", 
       RowBox[{"bubbleLogCoeff", "-", "zeroMomentumBubblePole"}]}], "}"}], 
     "]"}], "   ", 
    RowBox[{"(*", 
     RowBox[{"expected", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], "*)"}]}]}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{4.0042457220304985`*^9, 4.0042457366994*^9}},
 Background->GrayLevel[0.753],
 CellLabel->
  "In[190]:=",ExpressionUUID->"18a940b2-ee79-3c44-99aa-850ab396efcc"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"\"\>", "\<\"Cutoff: \[CapitalLambda]\.b2 coeff\"\>", "\<\"Cutoff: \
ln \[CapitalLambda] coeff\"\>", "\<\"DR: 1/e coeff\"\>"},
     {"\<\"T\"\>", 
      FractionBox["1", 
       RowBox[{"16", " ", 
        SuperscriptBox["\[Pi]", "2"]}]], 
      RowBox[{"-", 
       FractionBox["m2", 
        RowBox[{"8", " ", 
         SuperscriptBox["\[Pi]", "2"]}]]}], 
      RowBox[{"-", 
       FractionBox["m2", 
        RowBox[{"8", " ", 
         SuperscriptBox["\[Pi]", "2"]}]]}]},
     {"\<\"B(0)\"\>", "0", 
      FractionBox["1", 
       RowBox[{"8", " ", 
        SuperscriptBox["\[Pi]", "2"]}]], 
      FractionBox["1", 
       RowBox[{"8", " ", 
        SuperscriptBox["\[Pi]", "2"]}]]}
    },
    AutoDelete->False,
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"], TraditionalForm]], "Output",
 CellChangeTimes->{4.004248186465904*^9, 4.0042920567743397`*^9},
 CellLabel->
  "Out[194]=",ExpressionUUID->"952631cb-e433-1740-999e-e3296c6ffd18"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"0", ",", "0"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.004248186465904*^9, 4.0042920567743397`*^9},
