   FractionBox[
    RowBox[{"e", " ", "g", " ", 
     RowBox[{"(", 
      RowBox[{"e", "+", 
       RowBox[{"3", " ", "g"}]}], ")"}]}], 
    RowBox[{"e", "+", 
     RowBox[{"6", " ", "g"}]}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0041909501402626`*^9, 4.004191810070568*^9, 
