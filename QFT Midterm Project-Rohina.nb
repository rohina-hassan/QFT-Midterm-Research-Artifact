9fb98ae14ecb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"TDR", ",", "BDR", ",", "x", ",", "drAssumptions"}], "]"}], ";"}],
   "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", "Dimensional"}]}], "-", 
    RowBox[{"Regularization", " ", 
     RowBox[{"Assumptions", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"The", " ", "project", " ", "convention", " ", "is", " ", "d"}], "=", 
    RowBox[{"4", "-", 
     RowBox[{
      RowBox[{"e", ".", "Each"}], " ", "independent", " ", "loop", " ", 
      "carries", " ", "one", " ", "factor", " ", 
      RowBox[{
       RowBox[{"muR", "^", "e"}], "."}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"drAssumptions", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"muR", ">", "0"}], ",", 
      RowBox[{"m2", ">", "0"}], ",", 
      RowBox[{"P2", ">=", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Standard", " ", "dimensionally", " ", "regularized", " ", "integral"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"drMomentumIntegral", "[", 
     RowBox[{"alpha_", ",", "delta_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", " ", "Pi"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"d", "/", "2"}], ")"}]}]}], "*", 
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"alpha", "-", 
        RowBox[{"d", "/", "2"}]}], "]"}], "/", 
      RowBox[{"Gamma", "[", "alpha", "]"}]}], "*", 
     RowBox[{"delta", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"d", "/", "2"}], "-", "alpha"}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Dimensionally"}]}], " ", "Regularized", " ", "Tadpole", " ", 
     RowBox[{"Integral", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"TDR", 
     RowBox[{"(", "m2", ")"}]}], "=", 
    RowBox[{
     RowBox[{"muR", "^", "e"}], " ", 
     RowBox[{"Integral", "[", 
      RowBox[{
       RowBox[{"d", "^", "d"}], " ", 
       RowBox[{"k", "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", " ", "Pi"}], ")"}], "^", "d"}]}]}], "]"}], " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], "+", "m2"}], ")"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TDR", "[", "massSquared_", "]"}], ":=", 
    RowBox[{
     RowBox[{"muR", "^", "e"}], "*", 
     RowBox[{"drMomentumIntegral", "[", 
      RowBox[{"1", ",", "massSquared"}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tadpoleDRExact", "=", 
    RowBox[{"TDR", "[", "m2", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Dimensionally"}]}], " ", "Regularized", " ", "Bubble", " ", 
     RowBox[{"Integral", "--"}]}], "-"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Feynman", " ", 
      RowBox[{"parametrization", ":", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"A", " ", "B"}], ")"}]}]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Integral", "[", 
        RowBox[{"dx", ",", "0", ",", "1"}], "]"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", " ", "A"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "x"}], ")"}], " ", "B"}]}], ")"}], "^", "2"}]}],
       " ", "After", " ", "shifting", " ", "the", " ", "loop", " ", 
      "momentum"}]}], ",", 
    RowBox[{
     RowBox[{"the", " ", "denominator", " ", "becomes", " ", 
      RowBox[{"k", "^", "2"}]}], "+", "m2", "+", 
     RowBox[{"x", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "x"}], ")"}], " ", 
      RowBox[{"P2", "."}]}]}]}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"bubbleFeynmanParameterIntegrand", "[", 
     RowBox[{"x_", ",", "P2_", ",", "massSquared_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"massSquared", "+", 
       RowBox[{"x", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "x"}], ")"}], " ", "P2"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"d", "/", "2"}], "-", "2"}], ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BDR", "[", 
     RowBox[{"P2_", ",", "massSquared_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"muR", "^", "e"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", " ", "Pi"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"d", "/", "2"}], ")"}]}]}], "*", 
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "-", 
       RowBox[{"d", "/", "2"}]}], "]"}], "*", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"bubbleFeynmanParameterIntegrand", "[", 
        RowBox[{"x", ",", "P2", ",", "massSquared"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"muR", ">", "0"}], ",", 
          RowBox[{"massSquared", ">", "0"}], ",", 
          RowBox[{"P2", ">=", "0"}]}], "}"}]}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bubbleDRExact", "=", 
    RowBox[{"BDR", "[", 
     RowBox[{"P2", ",", "m2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", "Zero"}]}], "-", 
    RowBox[{"Momentum", " ", "Bubble", " ", 
     RowBox[{"Integral", "--"}]}], "-"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"At", " ", "P2"}], "=", "0"}], ",", 
    RowBox[{
     RowBox[{"the", " ", "Feynman"}], "-", 
     RowBox[{"parameter", " ", "integral", " ", "is", " ", 
      RowBox[{"trivial", "."}]}]}]}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zeroMomentumBubbleDRExact", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"muR", "^", "e"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", " ", "Pi"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"d", "/", "2"}], ")"}]}]}], "*", 
     RowBox[{"Gamma", "[", 
      RowBox[{"2", "-", 
       RowBox[{"d", "/", "2"}]}], "]"}], "*", 
     RowBox[{"m2", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"d", "/", "2"}], "-", "2"}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Display"}]}], " ", "the", " ", "Analytic", " ", "DR", " ", 
     RowBox[{"Expressions", "--"}]}], "-"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Dimensionally regularized tadpole integral:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"tadpoleDRExact", "//", "TraditionalForm"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Dimensionally regularized bubble integral:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"bubbleDRExact", "//", "TraditionalForm"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Zero-momentum bubble integral:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{"zeroMomentumBubbleDRExact", "//", "TraditionalForm"}]}], "Input",
