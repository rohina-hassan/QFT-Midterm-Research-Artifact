Cell[CellGroupData[{

Cell[TextData[StyleBox["2.1.4 Four-Point Subdivergences and the \
Momentum-Dependent Pole",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.5254901960784314, 0.3843137254901961, 
   0.49019607843137253`]]], "Subsubsection",
 CellChangeTimes->{
  4.0042593288953094`*^9},ExpressionUUID->"53f23482-91d1-c447-b6cb-\
4dcfb63d526f"],

Cell[TextData[{
 StyleBox["The two-loop sunset diagram contains logarithmically divergent \
four-point subgraphs. Each such subgraph is obtained by selecting two of the \
three internal propagators connecting the quartic vertices. The sunset \
contains three one-loop four-point subgraphs, one for each choice of two of \
its three internal lines. Each is a bubble whose four external legs are the \
two external lines of the diagram and the two ends of the third (spectator) \
line. Contracting it to a point leaves the spectator line closed on itself, \
i.e. a massless tadpole with a \[Delta]\[Lambda] vertex. The three choices \
are equivalent, and the single counterterm diagram with the full \[Delta]\
\[Lambda] (which already sums the three channels of \[CapitalGamma]\:207d\
\:2074\:207e) cancels all three subdivergences. (A-79)These subdivergences \
must be removed by inserting the corresponding coupling counterterm, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]\[Lambda]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2a65baae-e3bc-984e-92d6-387b6bf5ffd1"],
 StyleBox[", in accordance with the forest subtraction procedure.\n\nAfter \
replacing a divergent four-point subgraph by its local counterterm, the \
resulting two-point contribution has the structure of a massless one-loop \
tadpole:\n\n                                                                  \
                                                                        ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          StyleBox["ct", FontSlant -> "Plain"], 
          RowBox[{"(", "2", ")"}]], "\[Proportional]", "\[Delta]\[Lambda]", 
         "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          SuperscriptBox[
           StyleBox["k", "TI"], "2"]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Gamma_{\\mathrm{ct}}^{(2)}\n\\propto\n\\delta\\lambda\n\
\\int\\frac{d^dk}{(2\\pi)^d}\\frac{1}{k^2}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"bdaf8274-1f0a-a948-88dc-be1805d91daa"],
 "               ",
 StyleBox["\n\nThis integral contains no external momentum ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"27b5c357-64cb-084b-a13b-ec389ed70e54"],
 StyleBox[". In massless dimensional regularization, it is scaleless and \
therefore vanishes. The vanishing of the massless tadpole in DR means its UV \
and IR poles cancel. This does not affect the UV argument. The sunset has no \
IR divergence for p\.b2 > 0, and the absence of a 1/\[CurlyEpsilon]\.b2 pole \
in H confirms the cancellation. (A-80)\nMore generally, its momentum \
independence means that it cannot contribute to the coefficient of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a1775ad7-6386-984c-aa89-e99307498199"],
 StyleBox[", although mass renormalization must still be treated consistently \
when imposing the criticality condition. Thus, the four-point counterterm \
insertions cancel the subdivergences but do not modify the momentum-dependent \
ultraviolet pole of the sunset integral.\n\nUsing the result obtained in \
Section 2.1.3, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", "-", 
         FractionBox[
          SuperscriptBox[
           StyleBox["p", "TI"], "2"], 
          RowBox[{"2", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], "4"]}]], 
         FractionBox["1", "\[Epsilon]"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "0"], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "H(p)=\n-\\frac{p^2}{2(4\\pi)^4}\\frac{1}{\\epsilon}\n+O(\\epsilon^0),", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->10,ExpressionUUID->"fef72d79-5e8a-4a4a-a3a0-b05dded71441"],
 " ",
 StyleBox["we identify the coefficient of the momentum-dependent pole as:\n\n \
                                                                              \
                                                  ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{
            RowBox[{
              StyleBox["H", "TI"], "(", 
              StyleBox["p", "TI"], ")"}], "\[VerticalSeparator]"}], 
          RowBox[{
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], "/", "\[Epsilon]"}]], "\[LongEqual]", 
         "-", 
         FractionBox[
          SuperscriptBox[
           StyleBox["p", "TI"], "2"], 
          RowBox[{"2", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], "4"], "\[Epsilon]"}]], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\left.H(p)\\right|_{p^2/\\epsilon}\n\
=-\\frac{p^2}{2(4\\pi)^4\\epsilon}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"632fd246-5b03-9742-a5af-89b0f6b08678"],
 StyleBox["\n\nThis is the pole of the scalar sunset integral itself. The \
corresponding contribution to the two-point function must additionally \
include the sunset symmetry factor and the appropriate vertex factors, with \
signs fixed by the Euclidean Feynman-rule conventions established in Part 1. \
The absence of a ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b432002c-cb69-2b4a-981f-0d903de6be4e"],
 StyleBox["-dependent contribution from the four-point counterterm insertions \
ensures that this pole determines the two-loop field-strength \
renormalization.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004264978599064*^9, 4.0042651209123955`*^9}, 
   4.0042943990951366`*^9, {4.0042944528639717`*^9, 4.0042944549938297`*^9}, {
   4.0042947217233257`*^9, 4.0042947395633945`*^9}, {4.0042950244535294`*^9, 
   4.004295030274702*^9}},ExpressionUUID->"e4844759-76e6-3b44-a25a-\
a2d4a3a2bbc3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", 
    RowBox[{"momentum", "-", 
     RowBox[{
     "dependent", " ", "pole", " ", "of", " ", "the", " ", "sunset", " ", 
      "integral", " ", 
      RowBox[{"(", 
       RowBox[{"A", "-", "79"}], ")"}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"sunsetPolePart", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"SeriesCoefficient", "[", 
       RowBox[{"sunsetGammaDR", ",", 
        RowBox[{"{", 
         RowBox[{"e", ",", "0", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sunsetExpectedPole", "=", 
     RowBox[{
      RowBox[{"-", "p2"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", " ", "Pi"}], ")"}], "^", "4"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"polePartCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"sunsetPolePart", "-", "sunsetExpectedPole"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "2"}], ":", 
     RowBox[{"coefficient", " ", "of", " ", 
      RowBox[{
       RowBox[{"p", "^", "2"}], "/", "e"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sunsetP2PoleCoefficient", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"sunsetPolePart", "/", "p2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sunsetExpectedP2PoleCoefficient", "=", 
     RowBox[{
      RowBox[{"-", "1"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", " ", "Pi"}], ")"}], "^", "4"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p2PoleCoefficientCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
      "sunsetP2PoleCoefficient", "-", "sunsetExpectedP2PoleCoefficient"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "3"}], ":", 
     RowBox[{"no", " ", 
      RowBox[{"1", "/", 
       RowBox[{"e", "^", "2"}]}], " ", "pole"}], ":", 
     RowBox[{
     "consistent", " ", "with", " ", "the", " ", "vanishing", " ", 
      "counterterm", " ", "tadpole", " ", "below", " ", 
      RowBox[{"(", 
       RowBox[{"A", "-", "81"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sunsetDoublePoleCoefficient", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"SeriesCoefficient", "[", 
       RowBox[{"sunsetGammaDR", ",", 
        RowBox[{"{", 
         RowBox[{"e", ",", "0", ",", 
          RowBox[{"-", "2"}]}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Step", " ", "4"}], ":", 
      RowBox[{
       RowBox[{"the", " ", "four"}], "-", 
       RowBox[{
       "point", " ", "counterterm", " ", "insertion", " ", "is", " ", "a", " ",
         "massless", " ", "tadpole", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"A", "-", "80"}], ",", 
           RowBox[{"A", "-", "81"}]}], ")"}], ".", "Its"}], " ", "integrand", 
        " ", "has", " ", "no", " ", "p"}]}]}], ",", 
     RowBox[{
      RowBox[{
      "and", " ", "the", " ", "integral", " ", "is", " ", "the", " ", "m2"}], 
      "->", 
      RowBox[{
      "0", " ", "limit", " ", "of", " ", "the", " ", "exact", " ", "DR", " ", 
       "tadpole", " ", "of", " ", "1.2", ".3"}]}], ",", 
     RowBox[{
      RowBox[{"which", " ", "vanishes", " ", "for", " ", "0"}], "<", "e", "<", 
      RowBox[{"2", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"scaleless", " ", "integral"}], ")"}], "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"masslessTadpoleIntegrand", "=", 
     RowBox[{"1", "/", 
      RowBox[{"SPD", "[", 
       RowBox[{"k", ",", "k"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"counterterm2PtIsPIndependent", "=", 
     RowBox[{"FreeQ", "[", 
      RowBox[{"masslessTadpoleIntegrand", ",", "p"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"masslessTadpoleDR", "=", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{"TDR", "[", "m2", "]"}], ",", 
       RowBox[{"m2", "->", "0"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "<", "e", "<", "2"}], ",", 
          RowBox[{"muR", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"counterterm", "-", 
     RowBox[{"diagram", " ", "contribution", " ", 
      RowBox[{"(", 
       RowBox[{"delta", " ", 
        RowBox[{"lam", "/", "2"}]}], ")"}], " ", "x", " ", 
      RowBox[{"tadpole", ":", 
       RowBox[{
       "zero", " ", "for", " ", "any", " ", "delta", " ", "lam"}]}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"counterterm2PtContribution", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dLamMS", "/", "2"}], ")"}], " ", "masslessTadpoleDR"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Step", " ", "5"}], ":", 
      RowBox[{"two", "-", 
       RowBox[{
       "loop", " ", "sunset", " ", "contribution", " ", "to", " ", "the", " ",
         "Euclidean", " ", "Gamma2", " ", 
        RowBox[{"(", 
         RowBox[{"A", "-", "82"}], ")"}]}]}], ":", 
      RowBox[{
       RowBox[{"Gamma2", " ", "contains"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"lam", "^", "2"}], "/", "6"}], ")"}], " ", "H", 
        RowBox[{"(", "p", ")"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"from", " ", "the", " ", "vertex"}], "-", "lam"}], ",", 
     RowBox[{"the", " ", "symmetry", " ", "factor", " ", 
      RowBox[{"1", "/", "6"}]}], ",", 
     RowBox[{
      RowBox[{"and", " ", "Gamma"}], "=", 
      RowBox[{"tree", "-", "diagrams"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sunsetGamma2Contribution", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"lam", "^", "2"}], "/", "6"}], ")"}]}], " ", 
      "sunsetGammaDR"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sunsetGamma2Pole", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"SeriesCoefficient", "[", 
       RowBox[{"sunsetGamma2Contribution", ",", 
        RowBox[{"{", 
         RowBox[{"e", ",", "0", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sunsetGamma2PoleCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"sunsetGamma2Pole", "-", 
       RowBox[{
        RowBox[{"lam", "^", "2"}], " ", 
        RowBox[{"p2", "/", 
         RowBox[{"(", 
          RowBox[{"3072", " ", 
           RowBox[{"Pi", "^", "4"}]}], ")"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sunsetGamma2PoleInG", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"sunsetGamma2Pole", "/.", " ", 
       RowBox[{"lam", "->", 
        RowBox[{"16", " ", 
         RowBox[{"Pi", "^", "2"}], " ", "g"}]}]}], "]"}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"expected", " ", 
     RowBox[{"g", "^", "2"}], " ", 
     RowBox[{"p2", "/", "12"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "6"}], ":", 
     RowBox[{"collect", " ", "the", " ", "checks"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"subdivergenceChecks", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"polePartCheck", "==", "0"}], ",", 
       RowBox[{"p2PoleCoefficientCheck", "==", "0"}], ",", 
       RowBox[{"sunsetDoublePoleCoefficient", "==", "0"}], ",", 
       "counterterm2PtIsPIndependent", ",", 
       RowBox[{"masslessTadpoleDR", "==", "0"}], ",", 
       RowBox[{"counterterm2PtContribution", "==", "0"}], ",", 
       RowBox[{"sunsetGamma2PoleCheck", "==", "0"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Sunset pole:\>\"", "]"}], ";", 
    "sunsetPolePart"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Coefficient of p^2/epsilon:\>\"", "]"}], ";", 
    "sunsetP2PoleCoefficient"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Coefficient of 1/e^2 (expected: 0):\>\"", "]"}], ";", 
    "sunsetDoublePoleCoefficient"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Massless counterterm tadpole in DR (expected 0):\>\"", 
     "]"}], ";", "masslessTadpoleDR"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Counterterm-insertion contribution (expected 0):\>\"", 
     "]"}], ";", "counterterm2PtContribution"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Pole of the sunset contribution to Gamma2 (expected \
lam^2 p2/(3072 Pi^4)):\>\"", "]"}], ";"}], "\n", "sunsetGamma2Pole", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Same pole in terms of g (expected g^2 p2/12):\>\"", 
     "]"}], ";", "sunsetGamma2PoleInG"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Four-point subdivergence checks (expected: all \
True):\>\"", "]"}], ";"}], "\n", "subdivergenceChecks"}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{4.0042652816694965`*^9, 4.0042653029899426`*^9}, {
  4.004294296444271*^9, 4.004294300524029*^9}},
 Background->GrayLevel[0.753],
 CellLabel->
  "In[614]:=",ExpressionUUID->"959b1985-ece6-034c-b4ef-30aa961251c0"],

Cell[BoxData[
 FormBox["\<\"Sunset pole:\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.0042653105296497`*^9, 4.0042943234081135`*^9, 
  4.004299612278055*^9},
 CellLabel->
  "During evaluation of \
In[614]:=",ExpressionUUID->"dc7a6439-3b8c-1444-ae50-8c47b33c7409"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   FractionBox["p2", 
    RowBox[{"512", " ", 
     SuperscriptBox["\[Pi]", "4"]}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0042653105296497`*^9, 4.0042943234081135`*^9, 
  4.004299612283983*^9},
 CellLabel->
  "Out[630]=",ExpressionUUID->"f9617729-1564-4943-919d-10aaf87af2fd"],

Cell[BoxData[
 FormBox["\<\"Coefficient of p^2/epsilon:\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.0042653105296497`*^9, 4.0042943234081135`*^9, 
  4.004299612286518*^9},
 CellLabel->
