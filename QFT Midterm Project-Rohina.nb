  4.0042460427091255`*^9}},ExpressionUUID->"31b44876-878d-f54e-ba4d-\
eb5eaa8acc41"],

Cell[TextData[{
 StyleBox["Question:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nWhat are the tadpole integral ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["T", "TI"], TraditionalForm], "errors" -> {}, "input" -> "T", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"06f41931-a4c8-eb4a-900c-9b34cd4b6da4"],
 StyleBox[" and zero-momentum bubble ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "(", "0", ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "B(0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"98a26aa7-3258-fc40-adf6-4c734c43db78"],
 StyleBox[" in each regulator?   \n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------  ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["                                         \n",
  FontSize->13],
 StyleBox["Derivation:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nSections 1.2.2\[Dash]1.2.4.\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\n",
  FontSize->13],
 StyleBox["Check:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nAll four consistency checks evaluate to zero, and the \
logarithmic divergence in the cutoff regulator matches the pole in \n\
dimensional regularization.\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------",
