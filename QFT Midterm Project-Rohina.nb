In[119]:=",ExpressionUUID->"c1e92f42-096e-5c43-9cfa-0edc7d7ba9f2"],

Cell[BoxData[
 FormBox[
  FractionBox["m2", 
   RowBox[{"8", " ", 
    SuperscriptBox["\[Pi]", "2"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.0041557068738556`*^9, 4.004157251010729*^9, 
  4.0041723010099354`*^9, 4.0041812059847527`*^9, 4.0041826171548996`*^9, 
  4.004189385578245*^9, 4.004198849446417*^9, 4.0042008518434505`*^9, 
  4.0042014095625286`*^9, 4.004242294842739*^9, 4.004245984952713*^9, 
  4.0042467807008553`*^9, 4.004247239868677*^9, 4.0042476048556957`*^9, 
  4.004250982649393*^9, 4.004291995037422*^9, 4.00429942865707*^9},
 CellLabel->
  "Out[150]=",ExpressionUUID->"5a95e0aa-fb2b-d244-996a-bf8dc5d77263"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Exact cutoff results:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\n",
  FontSize->13,
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["Evaluating the radial integrals of (A-29) and (A-30) at P = 0 \
gives:\n\n                                                                   ",
  FontSize->13,
  FontColor->RGBColor[0., 0., 0.]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "\[CapitalLambda]"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["m", "TI"], "2"], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{
             SuperscriptBox["\[CapitalLambda]", "2"], "+", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"], 
             StyleBox["l", "TI"], 
             StyleBox["n", "TI"], 
             RowBox[{"(", 
               FractionBox[
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"], 
                RowBox[{
                  SuperscriptBox["\[CapitalLambda]", "2"], "+", 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]}]], ")"}]}], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\Lambda}(m^2) = \\frac{1}{16 \\pi^2} [\\Lambda^2 + m^2 \
ln(\\frac{m^2}{\\Lambda^2 + m^2})]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9e9cca4f-3c84-5d43-b15e-5ad6bb909fc2"],
 StyleBox[" ,            ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], "\[CapitalLambda]"], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["l", "TI"], 
             StyleBox["n", "TI"], 
             RowBox[{"(", 
               FractionBox[
                RowBox[{
                  SuperscriptBox["\[CapitalLambda]", "2"], "+", 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]], ")"}], "-", "1", "+", 
             FractionBox[
              SuperscriptBox[
               StyleBox["m", "TI"], "2"], 
              RowBox[{
                SuperscriptBox["\[CapitalLambda]", "2"], "+", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]}]]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "B_{\\Lambda}(0) = \\frac{1}{16 \\pi^2} \
[ln(\\frac{\\Lambda^2+m^2}{m^2})-1+\\frac{m^2}{\\Lambda^2 + m^2}]", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"dfbe09b5-1280-2349-bc22-767fe8ee68ce"],
 StyleBox["                                              (A-31)",
  FontSize->13],
 StyleBox["\n",
  FontSize->13,
  FontColor->RGBColor[0., 0., 0.]],
 StyleBox["\n",
  FontSize->13,
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["Large-cutoff expansions through \[CapitalLambda]\:207b\.b2:\n\n    \
                                                   ",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "\[CapitalLambda]"], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{
             SuperscriptBox["\[CapitalLambda]", "2"], "+", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"], 
             StyleBox["l", "TI"], 
             StyleBox["n", "TI"], 
             RowBox[{"(", 
               FractionBox[
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"], 
                RowBox[{
                  SuperscriptBox["\[CapitalLambda]", "2"], "+", 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]}]], ")"}], "-", 
             FractionBox[
              SuperscriptBox[
               StyleBox["m", "TI"], "4"], 
              SuperscriptBox["\[CapitalLambda]", "2"]]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[CapitalLambda]", "-4"], ")"}], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\Lambda} = \\frac{1}{16 \\pi^2} [\\Lambda^2 + m^2 \
ln(\\frac{m^2}{\\Lambda^2 + m^2})-\\frac{m^4}{\\Lambda^2}] + \
O(\\Lambda^{-4}),", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"92f4879f-f5f9-d74c-b978-a735e6a23ef1"],
 StyleBox["       ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], "\[CapitalLambda]"], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{"2", 
             StyleBox["l", "TI"], 
             StyleBox["n", "TI"], 
             RowBox[{"(", "\[CapitalLambda]", ")"}], "-", 
             StyleBox["l", "TI"], 
             StyleBox["n", "TI"], 
             RowBox[{"(", 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"], ")"}], "-", "1", "+", 
             FractionBox[
              RowBox[{"2", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]}], 
              SuperscriptBox["\[CapitalLambda]", "2"]]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[CapitalLambda]", "-4"], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "B_{\\Lambda}(0) = \\frac{1}{16\\pi^2} [2ln(\\Lambda) - ln(m^2)-1+ \
\\frac{2m^2}{\\Lambda^2}] + O(\\Lambda^{-4})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"59846c4a-4915-f244-9881-d39fe0864e78"],
 StyleBox["                        (A-32)",
  FontSize->13],
 StyleBox["\n",
  FontSize->13,
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\n",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["The tadpole has a quadratic divergence and a logarithmic one, \
while the zero-momentum bubble has only a logarithmic one.\n",
  FontSize->13,
  FontColor->RGBColor[0., 0., 0.]],
 StyleBox["\nComputational Note: Momentum-Dependent Bubble",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nMathematica could not evaluate the momentum-dependent bubble \
integral analytically for general ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["P", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "P^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4aa648cd-d805-ed44-82d9-c092a4c0745e"],
 StyleBox[". We therefore retain its radial integral representation and use a \
large-",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"57950fe5-0c47-8041-b33b-e3d5f0cc18b9"],
 StyleBox[" asymptotic expansion to extract its UV behavior. The expansion is \
integrated over ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["k", "TI"], "0"], "\[LessEqual]", 
         StyleBox["k", "TI"], "\[LessEqual]", "\[CapitalLambda]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "k_0\\leq k\\leq\\Lambda",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"addc06d3-21bf-d045-9bd1-e0f33d723bb3"],
 StyleBox[", with fixed ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["k", "TI"], "0"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "k_0>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f2cdc75f-d522-df41-99e0-0a0e9af486c0"],
 StyleBox[", rather than from ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "k=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"60830e91-f2e2-ab48-8040-17ee47caeb97"],
 StyleBox[", because it is valid only in the large-momentum region. \
Integrating it down to zero would incorrectly extend the asymptotic \
approximation into the low-momentum region and could introduce artificial \
infrared divergences. The contribution from ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "\[LessEqual]", 
         StyleBox["k", "TI"], "<", 
         SubscriptBox[
          StyleBox["k", "TI"], "0"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "0\\leq k<k_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1637d40f-8e9f-4347-8bba-942d77fc09a0"],
 StyleBox[" is therefore included in the undetermined finite part. This \
procedure identifies the logarithmic divergence and the leading \
cutoff-suppressed correction.",
  FontSize->13],
 "\n--------------------------------------------------------------------------\
------------------------------------------------------------------------------\
------------------------"
}], "Text",
 CellChangeTimes->{{4.0041563132710056`*^9, 4.0041563202413406`*^9}, {
  4.004157744119791*^9, 4.0041578151030846`*^9}, {4.0042428729002438`*^9, 
  4.0042428991843624`*^9}, {4.0042429335454025`*^9, 4.004242942321472*^9}, {
  4.004243020436014*^9, 4.0042430260379295`*^9}, {4.004243107530058*^9, 
  4.0042431732856503`*^9}, {4.0042432510647373`*^9, 4.004243260727705*^9}, {
  4.0042433353971405`*^9, 
  4.004243395786768*^9}},ExpressionUUID->"1a7b62ca-43fe-274c-ba38-\
0e5bf5de11d0"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.2.3 Dimensional Regularization Framework",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.0038162647355747`*^9, 4.003816269735735*^9}, 
   4.0039002340613747`*^9, {4.004156823554821*^9, 
   4.0041568239959736`*^9}},ExpressionUUID->"68efdab8-6842-584d-affe-\
b18e12934c24"],

Cell[TextData[{
 StyleBox["In this subsection, we evaluate the massive tadpole and bubble \
integrals using dimensional regularization (DR). By analytically continuing \
the spacetime dimension from ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm], 
     "errors" -> {}, "input" -> "d=4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"24766544-6079-9d42-9851-34b67e65d1dc"],
 StyleBox[" to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d=4-\\varepsilon", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ef5c0538-0788-fa48-b284-2c49c382a587"],
 StyleBox[", ultraviolet divergences are regularized and appear as poles in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\varepsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cb97172d-9c07-2a4f-af17-6aac47d35fe6"],
 StyleBox[".\nThe tadpole integral ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["T", "TI"], TraditionalForm], "errors" -> {}, "input" -> "T", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b5cf11a7-43b4-a644-9c1d-c9185d0e1a9f"],
 StyleBox[" and bubble integral ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "(", 
         StyleBox["P", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "B(P)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b1fd6eec-63a7-7d44-92a3-86be17fa8397"],
 StyleBox[" are defined as:\n\n                                               \
                                                                              \
         ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", 
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "T=\\mu^{\\epsilon} \\int\\frac{d^d k}{(2\\pi)^d}\\frac{1}{k^2+m^2}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d859ba62-37f6-9940-99de-5b760805b105"],
 StyleBox["                                                                   \
                                              (A-33)      \n,and\n            \
                                                                              \
                       ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           StyleBox["P", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            RowBox[{"(", 
              RowBox[{
                SuperscriptBox[
                 StyleBox["k", "TI"], "2"], "+", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]}], ")"}], "(", 
            RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["k", "TI"], "+", 
                   StyleBox["P", "TI"]}], ")"}], "2"], "+", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]}], ")"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "B(P)=\\mu^{\\epsilon}\\int\\frac{d^d k}{(2\\pi)^d}\n\
\\frac{1}{(k^2+m^2)((k+P)^2+m^2)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9056aa86-6575-c14c-9db9-071faa6e49cc"],
 StyleBox["                                                                   \
                             (A-34)\n\nwhere ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d = 4 - \\varepsilon", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6bf73b37-d38f-2d45-ab02-8ffc9c888906"],
 StyleBox[". The inclusion of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", "\[Epsilon]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mu^\\varepsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8a02097f-bae2-8a4e-986d-8f5375f9dd4b"],
 StyleBox[" ensures the dimensionless nature of the coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Lambda]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5d62f411-c079-f64d-95e8-3d74405332bf"],
 StyleBox[". These integrals are evaluated using standard identities \
expressed in terms of the Gamma function as detailed in the lecture note \
\[Section]12. Unlike the sharp cutoff scheme, DR preserves the translational \
invariance of the theory and maps ultraviolet divergences directly to the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Epsilon]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/\\varepsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"17e890c1-659e-ab43-a607-6e483f3da305"],
 StyleBox[" poles of the Gamma function.\n\n",
  FontSize->13],
 StyleBox["Dimensional Regularization Master Integral:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nIn dimensional regularization, the Euclidean momentum integral \
is evaluated using the standard master formula: ()\n\n                        \
                                                                              \
      ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               SuperscriptBox[
                StyleBox["k", "TI"], "2"], "+", "\[CapitalDelta]"}], ")"}], 
           "\[Alpha]"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{"\[Alpha]", "-", 
              StyleBox["d", "TI"], "/", "2"}], ")"}], 
          RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], 
             RowBox[{
               StyleBox["d", "TI"], "/", "2"}]], "\[CapitalGamma]", 
            RowBox[{"(", "\[Alpha]", ")"}]}]], 
         SuperscriptBox["\[CapitalDelta]", 
          RowBox[{
            StyleBox["d", "TI"], "/", "2", "-", "\[Alpha]"}]], ",    ", 
         "\[CapitalDelta]", ">", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\int\\frac{d^dk}{(2\\pi)^d}\\frac{1}{(k^2+\\Delta)^\\alpha}\n\
=\\frac{\\Gamma(\\alpha-d/2)}{(4\\pi)^{d/2}\\Gamma(\\alpha)}\n\
\\Delta^{d/2-\\alpha},\n\\qquad \\Delta>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5c67984d-aa46-4242-8919-675e29924c32"],
 StyleBox["                                                                   \
                      (A-35)",
  FontSize->13],
 StyleBox["\n\nFeynman parametrization. To evaluate the momentum-dependent \
bubble integral, we combine the two propagators using:\n\n                    \
                                                                              \
                          ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", 
          RowBox[{
            StyleBox["A", "TI"], 
            StyleBox["B", "TI"]}]], "\[LongEqual]", 
         SubsuperscriptBox["\[Integral]", "0", "1"], 
         StyleBox["d", "TI"], 
         StyleBox["x", "TI"], " ", 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"[", 
             RowBox[{
               StyleBox["x", "TI"], 
               StyleBox["A", "TI"], "+", 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   StyleBox["x", "TI"]}], ")"}], 
               StyleBox["B", "TI"]}], "]"}], "2"]], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{1}{AB}=\\int_0^1 dx\\,\\frac{1}{[xA+(1-x)B]^2},", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"191ede9a-2c09-4049-85de-40a86e6b0382"],
 StyleBox["\n\nwhere ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["k", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "A=k^2+m^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"15101380-8c6f-5f44-ae1c-26dd7376de7d"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["k", "TI"], "+", 
              StyleBox["P", "TI"]}], ")"}], "2"], "+", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "B=(k+P)^2+m^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7c94c7ad-5de9-9d47-9f2c-c16e0e71fa19"],
 StyleBox[".",
  FontSize->13],
 StyleBox[" Completing the square and shifting the loop momentum ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[Rule]", 
         StyleBox["k", "TI"], "-", 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["x", "TI"]}], ")"}], 
         StyleBox["P", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "k\\to k-(1-x)P", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c15ce545-ee21-464e-91a2-50f9b43fed7b"],
 StyleBox[" ",
  FontSize->13],
 StyleBox["gives a denominator of the form ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        RowBox[{"(", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SubscriptBox["\[CapitalDelta]", 
             StyleBox["x", "TI"]]}], ")"}], "2"], TraditionalForm], 
     "errors" -> {}, "input" -> "(k^2+\\Delta_x)^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"71fadfa1-cfae-c844-b3de-d321ced49f89"],
 StyleBox[", where ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", 
          StyleBox["x", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "+", 
         StyleBox["x", "TI"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["x", "TI"]}], ")"}], 
         SuperscriptBox[
          StyleBox["P", "TI"], "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Delta_x=m^2+x(1-x)P^2.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"114ff410-057b-cc44-b692-a8f44784cec5"],
 " ",
 StyleBox["Applying the DR master integral with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", "\[LongEqual]", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\alpha=2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f46a7f2f-c8f7-e14b-a555-e3157b056f46"],
 StyleBox[", we obtain:\n\n                                                   \
                                                           ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["P", "TI"], "2"], ",", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"]}], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubsuperscriptBox["\[Mu]", 
             StyleBox["R", "TI"], "\[Epsilon]"], "\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{"2", "-", 
                StyleBox["d", "TI"], "/", "2"}], ")"}]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]"}], ")"}], 
           RowBox[{
             StyleBox["d", "TI"], "/", "2"}]]], 
         SubsuperscriptBox["\[Integral]", "0", "1"], 
         StyleBox["d", "TI"], 
         StyleBox["x", "TI"], " ", 
         SuperscriptBox[
          RowBox[{"[", 
            RowBox[{
              SuperscriptBox[
               StyleBox["m", "TI"], "2"], "+", 
              StyleBox["x", "TI"], 
              RowBox[{"(", 
                RowBox[{"1", "-", 
                  StyleBox["x", "TI"]}], ")"}], 
              SuperscriptBox[
               StyleBox["P", "TI"], "2"]}], "]"}], 
          RowBox[{
            StyleBox["d", "TI"], "/", "2", "-", "2"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "B_{\\mathrm{DR}}(P^2,m^2)=\n\
\\frac{\\mu_R^\\epsilon\\Gamma(2-d/2)}{(4\\pi)^{d/2}}\n\\int_0^1 dx\\,\n\
\\left[m^2+x(1-x)P^2 \\right]^{d/2-2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"99a22b7c-14df-694e-9fd1-f58869a029b2"],
 StyleBox["                                                                   \
   (A-36)",
  FontSize->13],
 StyleBox["\n\nwhere ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d=4-\\epsilon", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8b26bc8d-1493-a04e-9847-a257ee3eae25"],
 StyleBox[".",
  FontSize->13],
 StyleBox[" The momentum shift is valid in dimensional regularization because \
the integration measure is translation invariant.\n\nThe resulting \
expressions for ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Epsilon]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/\\varepsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"71faf4a3-351a-f54f-a2bf-fa3f09083bb5"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "(", 
         StyleBox["P", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "B(P)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8f3055ed-f07c-cb47-8c64-9a1841a788b1"],
 StyleBox[" will be expanded around ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\varepsilon=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8049a986-0485-1342-81e6-88f0308697f7"],
 StyleBox[" in the following subsection to extract the logarithmic \
divergences and compare them with the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"ln", "\[CapitalLambda]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\ln \\Lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1d37eb83-207d-4442-b7d7-a19584d69d96"],
 StyleBox[" behavior observed in Section 1.2.2.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0041582055698605`*^9, 4.004158367026081*^9}, 
   4.004160775839979*^9, {4.00417254361973*^9, 4.0041727183219376`*^9}, {
   4.0042434956130295`*^9, 4.0042434986386585`*^9}, {4.0042438418925934`*^9, 
   4.004243877637827*^9}, {4.0042439241414185`*^9, 4.0042439571773777`*^9}, {
