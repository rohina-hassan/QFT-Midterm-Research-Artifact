         RowBox[{"(", 
           StyleBox["q", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          StyleBox["i", "TI"], 
          RowBox[{
            SuperscriptBox[
             StyleBox["q", "TI"], "2"], "-", 
