Cell[TextData[{
 StyleBox["Note on the coupling and conventions :",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox[" \nThe coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cfe4939a-b2c8-7946-aab7-a737159b4212"],
 StyleBox[" appearing in the converted amplitude is the quartic coupling \
parameter defined in the FeynArts model \[OpenCurlyDoubleQuote]",
  FontSize->13],
 StyleBox["Phi4 . mod",
  FontSize->13,
  FontSlant->"Italic"],
 StyleBox["\[CloseCurlyDoubleQuote]. It has not yet been identified with the \
dimensionless coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[LongEqual]", 
         FractionBox["\[Lambda]", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "g = \\frac{\\lambda}{16\\pi^2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c352f76f-4051-4d4d-8daf-8ccf1cf25649"],
 StyleBox[" introduced in the project . The correspondence between the \
FeynArts coupling and the analytical coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Lambda]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d2459db0-8a19-0946-b20b-a760214da3d6"],
 StyleBox[", including the normalization, will be established when matching \
the FeynArts amplitudes to the conventions of the analytical calculation . \
Furthermore, the converted expression is still in Minkowski - space form . \
The Wick rotation and the corresponding loop - measure conventions will be \
discussed separately in subsection 1.1.5 .\n\
------------------------------------------------------------------------------\
------------------------------------------------------------------------------\
------------------------------------------------",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.003909717741499*^9, 4.0039098146914215`*^9}, {
  4.0039098518618984`*^9, 4.0039098919513397`*^9}, {4.003910252420065*^9, 
  4.0039102619142857`*^9}},ExpressionUUID->"3406a163-ab27-b747-a153-\
789bad8c875b"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.1.3 Four-Point Function",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.003816091286003*^9, 4.0038161010958614`*^9}, 
   4.0038173396749287`*^9, {4.004159538523527*^9, 
   4.0041595393138504`*^9}},ExpressionUUID->"c0dfb382-c136-6347-a690-\
3b15fdfebcd5"],

Cell[TextData[{
 StyleBox["At one loop, the four-point 1PI function receives contributions \
from three distinct channels: the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], ",", 
         StyleBox["t", "TI"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "s,t,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"81d0f864-16ca-8943-9c73-6b27d811ec1d"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1763aab7-3eee-1b4c-9acc-5fd406038ffa"],
 StyleBox[" channels. Each contribution is represented by a bubble diagram \
consisting of two quartic interaction vertices connected by two internal \
propagators. These diagrams provide the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox["\[Lambda]", "2"], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(\\lambda^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2b65ec5c-cba5-f849-b5a9-25421acc4c13"],
 StyleBox[" correction to the four-point 1PI function.\n\n",
  FontSize->13],
 StyleBox["Momentum assignment: ",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nLet the four external momenta be ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["p", "TI"], "2"], ",", 
         SubscriptBox[
          StyleBox["p", "TI"], "3"], ",", 
         SubscriptBox[
          StyleBox["p", "TI"], "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "p_1,p_2,p_3,p_4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4b2fc418-73a2-8344-8887-4415d1e247d7"],
 StyleBox[", all taken to be incoming, so that momentum conservation requires \
",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "2"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "3"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "4"], "\[LongEqual]", "0."}], TraditionalForm],
      "errors" -> {}, "input" -> "p_1+p_2+p_3+p_4=0.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d6b8aefc-a07c-5e4c-be38-349667fb19a3"],
 StyleBox[" The three channels correspond to the following pairings of \
external legs:\n\n                       ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "-channel", ":  ", 
         RowBox[{"(", 
           RowBox[{"1", ",", "2"}], ")"}], "|", 
         RowBox[{"(", 
           RowBox[{"3", ",", "4"}], ")"}], ",", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "2"], ", ", 
         StyleBox["t", "TI"], "-channel", ":  ", 
         RowBox[{"(", 
           RowBox[{"1", ",", "3"}], ")"}], "|", 
         RowBox[{"(", 
           RowBox[{"2", ",", "4"}], ")"}], ",", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["t", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "3"], ", ", 
         StyleBox["u", "TI"], "-channel", ":  ", 
         RowBox[{"(", 
           RowBox[{"1", ",", "4"}], ")"}], "|", 
         RowBox[{"(", 
           RowBox[{"2", ",", "3"}], ")"}], ",", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["u", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "s\\text{-channel}:&\\quad (1,2)\\mid(3,4),\n& P_s&=p_1+p_2,\\\n\
t\\text{-channel}:&\\quad (1,3)\\mid(2,4),\n& P_t&=p_1+p_3,\\\n\
u\\text{-channel}:&\\quad (1,4)\\mid(2,3),\n& P_u&=p_1+p_4", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"45631fc1-0510-c444-a99e-ea8e9faeff16"],
 "         ",
 StyleBox["(A-11)\n\nIn each channel, the two internal propagators carry \
momenta k and k+P, where P denotes the total external momentum entering one \
of the two vertices. By momentum conservation, the total momentum entering \
the other vertex is -P. The three diagrams share the same topological \
structure, differing only in the external momentum flowing through the loop.\n\
\n",
  FontSize->13],
 StyleBox["Symmetry factor and interaction vertices: ",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nEach bubble diagram has a symmetry factor of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "2"}], TraditionalForm], "errors" -> {}, "input" -> 
     "1/2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a124e2ca-2d9f-ee4a-8c1c-3e567b819a7c"],
 StyleBox[", arising from the interchange symmetry of the two internal \
propagators.  The two quartic interaction vertices give a contribution \
proportional to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Lambda]", "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\lambda^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3c5290b9-c4d6-c641-a1e8-23de7998c9bd"],
 StyleBox[". Thus, the overall coefficient of each one-loop bubble \
contribution is  ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        SuperscriptBox["\[Lambda]", "2"], "2"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\frac{\\lambda^2}{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2b848d3a-bc7b-7c49-8b8c-0a1e2a676da1"],
 ".",
 StyleBox["  (A-12)\nWith the Euclidean perturbative interaction vertex ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", "\[Lambda]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "-\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ecb1b82c-98e8-944f-8f25-9c9e63d49df9"],
 StyleBox[" established in Section 1.1.1, the resulting one-loop correction \
to the four-point 1PI function carries a negative sign, consistent with the \
Euclidean conventions used in Zamolodchikov, Section 12.\n\n",
  FontSize->13],
 StyleBox["Euclidean loop integral: ",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nFollowing the conventions of Fields Notes, Section 12, we define \
the standard massive bubble integral as:\n\n                                  \
                                                                ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           StyleBox["P", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            RowBox[{"(", 
              RowBox[{
                SuperscriptBox[
                 StyleBox["k", "TI"], "2"], "+", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]}], ")"}], "(", 
            RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["k", "TI"], "+", 
                   StyleBox["P", "TI"]}], ")"}], "2"], "+", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]}], ")"}]], ",    ", 
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "B(P)=\\mu^\\epsilon\n\\int\\frac{d^d k}{(2\\pi)^d}\n\\frac{1}\n\
{(k^2+m^2)\\big((k+P)^2+m^2\\big)},\n\\qquad d=4-\\epsilon", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0b59806f-af81-6b4e-a168-edc7a9c7fe01"],
 "                                                                   ",
 StyleBox["(A-13)\n\nThe function ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "(", 
         StyleBox["P", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "B(P)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b39a1e3b-f09f-1a40-91ab-519a7c0295ef"],
 StyleBox[" represents the one-loop bubble integral arising from the \
four-point 1PI diagrams. It depends on the total external momentum flowing \
through the loop and the scalar mass. Its evaluation will be used to \
determine the one-loop correction to the four-point function and its \
ultraviolet divergences.\nThe ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b7f4c590-5b5f-af40-8a07-e170320cf010"],
 StyleBox["-channel contribution to the four-point 1PI function is \
consequently: \n\n                                                            \
                                                                         ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          StyleBox["s", "TI"], 
          RowBox[{"(", "4", ")"}]], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["P", "TI"], 
            StyleBox["s", "TI"]], ")"}], "\[LongEqual]", "-", 
         FractionBox[
          SuperscriptBox["\[Lambda]", "2"], "2"], 
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["P", "TI"], 
            StyleBox["s", "TI"]], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Gamma_s^{(4)}(P_s)\n=-\\frac{\\lambda^2}{2}B(P_s).", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d04a5208-574b-0f4e-8a65-2b9fcd9d63da"],
 "                                                                            \
                ",
 StyleBox["   (A-14)",
  FontSize->13],
 "\n                                                                          \
                                                           \n",
 StyleBox["The ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["t", "TI"], TraditionalForm], "errors" -> {}, "input" -> "t", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c4bc5660-e041-5a4e-8518-51641ad82ff1"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4b4fa42b-9a63-fd42-aeb2-4beb108e6fcf"],
 StyleBox[" channel contributions follow by replacing ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["s", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "P_s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"846449e5-414b-e148-b870-155517863327"],
 StyleBox[" with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "P_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"988657cc-9ae8-fe40-8838-313160d0d551"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["u", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "P_u", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f709ca71-9a8c-a84e-96cb-e5c17112a9f6"],
 StyleBox[", respectively. Including the tree-level contribution, the \
complete four-point 1PI function at this order is:\n\n                        \
                                                                              \
               ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "4", ")"}]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["s", "TI"], ",", 
             StyleBox["t", "TI"], ",", 
             StyleBox["u", "TI"]}], ")"}], "\[LongEqual]", "\[Lambda]", "-", 
         FractionBox[
          SuperscriptBox["\[Lambda]", "2"], "2"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["B", "TI"], 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["P", "TI"], 
                StyleBox["s", "TI"]], ")"}], "+", 
             StyleBox["B", "TI"], 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["P", "TI"], 
                StyleBox["t", "TI"]], ")"}], "+", 
             StyleBox["B", "TI"], 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["P", "TI"], 
                StyleBox["u", "TI"]], ")"}]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Gamma^{(4)}(s,t,u)=\\lambda-\\frac{\\lambda^2}{2}[B(P_s)+B(P_t)+B(P_u)\
]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9ae996e2-1a69-ed49-bb44-2ca52cd40f3f"],
 "                                                                       ",
 StyleBox["(A-15)\n\nHere, the overall ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", "\[Epsilon]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mu^\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1e7c1fad-a7a6-c545-b9ca-5155ae195ed3"],
 StyleBox[" factor is included in the definition of each bubble integral, as \
required by dimensional regularization.\n",
  FontSize->13],
 StyleBox["Reference: The definition of ",
  FontSize->13,
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "(", 
         StyleBox["P", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "B(P)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,
  FontSlant->"Italic",ExpressionUUID->"3ddef829-b7e6-4b4d-8163-46e27ea7c8ff"],
 StyleBox[" and its role in the 1PI function are derived in Zamolodchikov \
\[Section]12.",
  FontSize->13,
  FontSlant->"Italic"],
 StyleBox["\n\n",
  FontSize->13],
 StyleBox["Computational note: ",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nFeynArts will generate the one-loop four-point diagrams and \
their external-momentum assignments. We will subsequently examine their \
amplitudes and symmetry factors, convert them into FeynCalc expressions, and \
use ToPaVe to reduce the resulting loop integrals. The correspondence between \
the converted integrals and the bubble function ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "(", 
         StyleBox["P", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "B(P)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"91d684e1-962b-c240-8ab0-504f2eb8e9bc"],
 StyleBox[" will be checked for each of the three channels.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.003911056846197*^9, 4.0039110710797863`*^9}, {
   4.0039111224399223`*^9, 4.0039111371996593`*^9}, {4.003911315349819*^9, 
   4.003911786269081*^9}, {4.003911999274618*^9, 4.0039120278340473`*^9}, {
   4.00391205957329*^9, 4.0039121080883503`*^9}, {4.0039121521987324`*^9, 
   4.0039121541183624`*^9}, {4.003912185058275*^9, 4.003912214249737*^9}, 
   4.0039126169847584`*^9, 4.0039126636431694`*^9, {4.003912701138031*^9, 
   4.0039128166982803`*^9}, {4.0039128732377186`*^9, 4.003912968442732*^9}, {
   4.003913042574131*^9, 4.0039130522075577`*^9}, 4.0039131694070015`*^9, {
   4.004163179343565*^9, 4.004163193587412*^9}, {4.0041632540105534`*^9, 
   4.004163291727478*^9}, {4.0042027468415165`*^9, 4.004202746991123*^9}, {
   4.004202782161394*^9, 4.004202788242077*^9}, {4.004202829451414*^9, 
   4.0042029045113487`*^9}, {4.0042029464413414`*^9, 
   4.004202946561249*^9}},ExpressionUUID->"3d114c6d-c550-864e-b013-\
fdecd688e85c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"bubbleTopologies", ",", "bubbleInsertions"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "1."}]}], " ", "Generate", " ", "one"}], "-", 
    RowBox[{"loop", " ", "1", "PI", " ", "4"}], "-", 
    RowBox[{"point", " ", 
     RowBox[{"topologies", "--"}]}], "-"}], "*)"}], 
  RowBox[{
   RowBox[{"bubbleTopologies", "=", 
    RowBox[{"CreateTopologies", "[", 
     RowBox[{"1", ",", 
      RowBox[{"2", "->", "2"}], ",", 
      RowBox[{"Adjacencies", "->", 
       RowBox[{"{", "4", "}"}]}], ",", 
      RowBox[{"ExcludeTopologies", "->", 
       RowBox[{"{", "Reducible", "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "2."}]}], " ", "Insert", " ", "the", " ", "scalar", " ", 
     RowBox[{"fields", "--"}]}], "-"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bubbleInsertions", "=", 
    RowBox[{"InsertFields", "[", 
     RowBox[{"bubbleTopologies", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"S", "[", "1", "]"}], ",", 
         RowBox[{"S", "[", "1", "]"}]}], "}"}], "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"S", "[", "1", "]"}], ",", 
         RowBox[{"S", "[", "1", "]"}]}], "}"}]}], ",", 
      RowBox[{"Sequence", "@@", "phi4ModelOptions"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "3."}]}], " ", "Display", " ", "the", " ", "generated", " ", 
     RowBox[{"diagrams", "--"}]}], "-"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Paint", "[", 
  RowBox[{"bubbleInsertions", ",", 
   RowBox[{"ColumnsXRows", "->", 
    RowBox[{"{", 
     RowBox[{"3", ",", "1"}], "}"}]}], ",", 
   RowBox[{"Numbering", "->", "None"}], ",", 
   RowBox[{"SheetHeader", "->", "None"}]}], "]"}]}], "Input",
 CellFrame->{{0, 0}, {0, 0}},
