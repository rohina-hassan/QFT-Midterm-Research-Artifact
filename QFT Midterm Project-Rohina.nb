Cell[TextData[{
 StyleBox["Note:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox[" The integrals above are formal definitions and are kept \
unevaluated using ",
  FontSize->13],
 Cell[BoxData[
  RowBox[{"Inactive", "[", "Integrate", "]"}]],
  FontSize->13,ExpressionUUID->"b77e5556-ea09-5a41-b831-b1680b3207cb"],
 StyleBox[". The loop-measure factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox["1", 
        RowBox[{"2", 
          SuperscriptBox[
           RowBox[{"(", "\[Pi]", ")"}], 
           StyleBox["d", "TI"]]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{1}{2(\\pi)^d}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d2882990-1b16-a24c-a6f8-08060da36308"],
 StyleBox["  is introduced explicitly during the regularization calculations. \
Actual loop integrations will be performed using the appropriate methods for \
each regularization scheme.\n\
------------------------------------------------------------------------------\
------------------------------------------------------------------------------\
------------------------------------------------",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004014723708351*^9, 4.0040147784724503`*^9}, {
  4.004014849975168*^9, 
  4.004014859272114*^9}},ExpressionUUID->"d8874e7c-fa37-8c47-879e-\
7080a18d06e4"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.2.2 Sharp Momentum Cutoff Evaluation",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.0038162507856674`*^9, 4.0038162573860397`*^9}, 
   4.003900231339615*^9, {4.004156804967985*^9, 
   4.0041568054577026`*^9}},ExpressionUUID->"6491f1e4-21ed-7240-8785-\
536954bae33f"],

Cell[TextData[{
 StyleBox["We evaluate the tadpole and bubble integrals using a sharp \
momentum cutoff,  ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["k", "TI"], "|", "<", "\[CapitalLambda]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "|k| < \\Lambda", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"282d4b78-4bcb-1746-91a4-58d418c39253"],
 StyleBox[". In this scheme, the spacetime dimension is fixed to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm], 
     "errors" -> {}, "input" -> "d=4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2fbd4ed8-ac3a-6747-94da-de72d60c4f2b"],
 StyleBox[", and we perform the angular integration before the radial \
integration. This approach avoids shifting the loop momentum, thereby \
preserving the integration boundary",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["k", "TI"], "|", "\[LongEqual]", "\[CapitalLambda]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "|k| = \\Lambda", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"db57a28c-d3cc-764f-8b31-71a460d88620"],
 StyleBox[" and avoiding potential issues with non-invariant regularization.\n\
The rotational symmetry of the integrands allows us to use the \
four-dimensional volume element ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["d", "TI"], "4"], 
         StyleBox["k", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["k", "TI"], "3"], "\[DifferentialD]", 
         StyleBox["k", "TI"], "\[DifferentialD]", 
         SubscriptBox["\[CapitalOmega]", "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "d^4k = k^3 \\, dk \\, d\\Omega_3", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"36861214-d5ad-de4f-9f8d-d74442a44cd9"],
 StyleBox[", where ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalOmega]", "3"], "\[LongEqual]", "2", 
         SuperscriptBox["\[Pi]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Omega_3 = 2\\pi^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"19e21cdd-7197-dd40-a242-d6d9cfe1d08b"],
 StyleBox[". The tadpole integral takes the form:\n\n                         \
                                                                    ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "\[CapitalLambda]"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["m", "TI"], "2"], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], "4"]], 
         SubscriptBox["\[Integral]", 
          RowBox[{"|", 
            StyleBox["k", "TI"], "|", "<", "\[CapitalLambda]"}]], 
         SuperscriptBox[
          StyleBox["d", "TI"], "4"], 
         StyleBox["k", "TI"], ",", 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"8", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         SubsuperscriptBox["\[Integral]", "0", "\[CapitalLambda]"], 
         StyleBox["d", "TI"], 
         StyleBox["k", "TI"], ",", 
         FractionBox[
          SuperscriptBox[
           StyleBox["k", "TI"], "3"], 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "T_\\Lambda(m^2)\n=\\frac{1}{(2\\pi)^4}\n\\int_{|k|<\\Lambda}d^4k,\n\
\\frac{1}{k^2+m^2}\n=\\frac{1}{8\\pi^2}\n\\int_0^\\Lambda dk,\n\
\\frac{k^3}{k^2+m^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1e0a8b93-e28b-be49-82a5-69205bdcd72f"],
 StyleBox["                                                                   \
      (A-29)\n\nThe bubble integral is similarly reduced by performing the \
angular integration over the three-sphere, resulting in a radial expression \
that depends on the external momentum ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> "P",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], ":"}], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b13b2527-b44c-a540-9539-4a83874779f3"],
 StyleBox["\n\n                                                               \
                                ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], "\[CapitalLambda]"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], "4"]], 
         SubscriptBox["\[Integral]", 
          RowBox[{"|", 
            StyleBox["k", "TI"], "|", "<", "\[CapitalLambda]"}]], 
         SuperscriptBox[
          StyleBox["d", "TI"], "4"], 
         StyleBox["k", "TI"], ",", 
         FractionBox["1", 
          RowBox[{
            RowBox[{"(", 
              RowBox[{
                SuperscriptBox[
                 StyleBox["k", "TI"], "2"], "+", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]}], ")"}], "(", 
            RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["k", "TI"], "+", 
                   StyleBox["P", "TI"]}], ")"}], "2"], "+", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]}], ")"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "B_\\Lambda(P^2)\n=\\frac{1}{(2\\pi)^4}\n\\int_{|k|<\\Lambda}d^4k,\n\
\\frac{1}{(k^2+m^2)((k+P)^2+m^2)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3c1f0e35-d2ca-fa48-b0dd-41cf40e6f0b2"],
 StyleBox["                                                                   \
                   (A-30)\n\nIn this formulation, the angular dependence of \
the bubble integrand is handled analytically before the radial integration. \
Evaluating these integrals allows us to identify the ultraviolet power-law \
and logarithmic divergences associated with the cutoff scale ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalLambda]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e291c964-cdeb-c34f-ac9c-13b8bb8b58f3"],
 StyleBox[".\nThese cutoff-dependent results provide a clear hierarchy of UV \
divergences, specifically the quadratic divergence of the tadpole integral \
and the logarithmic divergence of the bubble integral. These results will \
serve as a benchmark for comparison with the dimensionally regularized \
results obtained in the next subsection.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0041544274566135`*^9, 4.004154651868313*^9}, {
  4.0041554143665905`*^9, 4.0041555818474083`*^9}, {4.0041556150817738`*^9, 
  4.0041556227486057`*^9}, {4.0042425732405357`*^9, 4.0042425734803543`*^9}, {
  4.0042426130664997`*^9, 
  4.0042426132638454`*^9}},ExpressionUUID->"3c268daa-57f9-774b-a595-\
ddd26014006c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "1."}]}], " ", "Define", " ", "the", " ", "sharp", " ", 
     "momentum", " ", 
     RowBox[{"cutoff", "--"}]}], "-"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"cutoff", "=", "\[CapitalLambda]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cutoffAssumptions", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cutoff", ">", "0"}], ",", 
       RowBox[{"m2", ">", "0"}], ",", 
       RowBox[{"P2", ">=", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "2."}]}], " ", "Evaluate", " ", "the", " ", "massive", " ",
       "tadpole", " ", 
      RowBox[{"integral", "--"}]}], "-", 
     RowBox[{"(", 
      RowBox[{"A", "-", "31"}], ")"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"tadpoleCutoff", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"8", " ", 
          RowBox[{"Pi", "^", "2"}]}], ")"}]}], "*", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"k", "^", "3"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"k", "^", "2"}], "+", "m2"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "cutoff"}], "}"}], ",", 
         RowBox[{"Assumptions", "->", "cutoffAssumptions"}]}], "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "3."}]}], " ", "Expand", " ", "the", " ", "tadpole", " ", 
      "for", " ", "large", " ", 
      RowBox[{"cutoff", "--"}]}], "-", 
     RowBox[{"(", 
      RowBox[{"A", "-", "32"}], ")"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"tadpoleExpansion", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{"tadpoleCutoff", ",", 
         RowBox[{"{", 
          RowBox[{"cutoff", ",", "Infinity", ",", "2"}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "4."}]}], " ", "Perform", " ", "the", " ", "angular", " ",
       "integration", " ", "for", " ", "the", " ", 
      RowBox[{"bubble", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"In", " ", "four"}], "-", 
       RowBox[{"dimensional", " ", "Euclidean", " ", "momentum", " ", 
        RowBox[{"space", ":", 
         RowBox[{
          RowBox[{"d", "^", "4"}], " ", "k"}]}]}]}], "=", 
      RowBox[{
       RowBox[{"k", "^", "3"}], " ", "dk", " ", "dOmega_", "3"}]}], ",", 
     RowBox[{
      RowBox[{"dOmega_", "3"}], "=", 
      RowBox[{"4", " ", "Pi", " ", 
       RowBox[{
        RowBox[{"Sin", "[", "theta", "]"}], "^", "2"}], " ", 
       RowBox[{"dtheta", ".", "The"}], " ", "angular", " ", "integration", " ", 
       RowBox[{"gives", ":", 
        RowBox[{"4", " ", 
         RowBox[{
          RowBox[{"Pi", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"A", "+", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"A", "^", "2"}], "-", 
              RowBox[{"4", " ", 
               RowBox[{"k", "^", "2"}], " ", "P2"}]}], "]"}]}], 
           ")"}]}]}]}]}]}], ",", 
     RowBox[{
      RowBox[{"where", " ", "A"}], "=", 
      RowBox[{
       RowBox[{"k", "^", "2"}], "+", "m2", "+", 
       RowBox[{"P2", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bubbleAngularIntegral", "[", 
      RowBox[{"k_", ",", "P2_"}], "]"}], ":=", 
     RowBox[{"4", " ", 
      RowBox[{
       RowBox[{"Pi", "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k", "^", "2"}], "+", "m2", "+", "P2", "+", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"k", "^", "2"}], "+", "m2", "+", "P2"}], ")"}], "^", 
            "2"}], "-", 
           RowBox[{"4", " ", 
            RowBox[{"k", "^", "2"}], " ", "P2"}]}], "]"}]}], ")"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "5."}]}], " ", "Define", " ", "the", " ", "radial", " ", 
      "bubble", " ", 
      RowBox[{"integrand", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "first", " ", "propagator", " ", "is", " ", "included", " ", 
     RowBox[{"explicitly", ".", "The"}], " ", "second", " ", "propagator", " ",
      "is", " ", "included", " ", "in", " ", "the", " ", "angular", " ", 
     RowBox[{"integral", "."}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bubbleRadialIntegrand", "[", 
      RowBox[{"k_", ",", "P2_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"k", "^", "3"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k", "^", "2"}], "+", "m2"}], ")"}]}], "*", 
      RowBox[{"bubbleAngularIntegral", "[", 
       RowBox[{"k", ",", "P2"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "6."}]}], " ", "Retain", " ", "the", " ", "momentum"}], "-", 
     RowBox[{
     "dependent", " ", "bubble", " ", "as", " ", "an", " ", "exact", " ", 
      "radial", " ", "integral", " ", 
      RowBox[{"representation", "--"}]}], "-"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "remaining", " ", "integral", " ", "is", " ", "not", " ", 
     "evaluated", " ", "symbolically", " ", "for", " ", "general", " ", 
     RowBox[{"P2", ".", "Its"}], " ", "exact", " ", "radial", " ", 
     "representation", " ", "is", " ", 
     RowBox[{"retained", "."}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bubbleCutoffRadialRepresentation", "[", "P2_", "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi"}], ")"}], "^", "4"}]}], "*", 
      RowBox[{
       RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
       RowBox[{
        RowBox[{"bubbleRadialIntegrand", "[", 
         RowBox[{"k", ",", "P2"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "cutoff"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "7."}]}], " ", "Evaluate", " ", "the", " ", "zero"}], "-", 
     RowBox[{"momentum", " ", "bubble", " ", 
      RowBox[{"integral", "--"}]}], "-", 
     RowBox[{"(", 
      RowBox[{"A", "-", "31"}], ")"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"zeroMomentumBubbleCutoff", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"8", " ", 
          RowBox[{"Pi", "^", "2"}]}], ")"}]}], "*", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"k", "^", "3"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"k", "^", "2"}], "+", "m2"}], ")"}], "^", "2"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "cutoff"}], "}"}], ",", 
         RowBox[{"Assumptions", "->", "cutoffAssumptions"}]}], "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "8."}]}], " ", "Expand", " ", "the", " ", "zero"}], "-", 
     RowBox[{"momentum", " ", "bubble", " ", "for", " ", "large", " ", 
      RowBox[{"cutoff", "--"}]}], "-", 
     RowBox[{"(", 
      RowBox[{"A", "-", "32"}], ")"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"zeroMomentumBubbleExpansion", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{"zeroMomentumBubbleCutoff", ",", 
         RowBox[{"{", 
          RowBox[{"cutoff", ",", "Infinity", ",", "2"}], "}"}]}], "]"}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "9."}]}], " ", "Extract", " ", "the", " ", "UV", " ", 
      "behavior", " ", "of", " ", "the", " ", "momentum"}], "-", 
     RowBox[{"dependent", " ", 
      RowBox[{"bubble", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "The", " ", "asymptotic", " ", "expansion", " ", "is", " ", "valid", " ",
       "only", " ", "for", " ", "sufficiently", " ", "large", " ", 
      RowBox[{"k", ".", "We"}], " ", "therefore", " ", "introduce", " ", "a", 
      " ", "fixed", " ", "lower", " ", "boundary", " ", "k0"}], ">", 
     RowBox[{
     "0", " ", "and", " ", "integrate", " ", "the", " ", "asymptotic", " ", 
      "expression", " ", "only", " ", "over", " ", "k0"}], "<=", "k", "<=", 
     RowBox[{"cutoff", "."}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k0Assumptions", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"k0", ">", "0"}], ",", 
       RowBox[{"cutoff", ">", "k0"}], ",", 
       RowBox[{"m2", ">", "0"}], ",", 
       RowBox[{"P2", ">=", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "9.1"}]}], " ", "Expand", " ", "the", " ", "radial", " ", 
      "integrand", " ", "for", " ", "k"}], "->", 
     RowBox[{
      RowBox[{"Infinity", "--"}], "-"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"bubbleRadialAsymptotic", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"bubbleRadialIntegrand", "[", 
           RowBox[{"k", ",", "P2"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "Infinity", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m2", ">", "0"}], ",", 
          RowBox[{"P2", ">=", "0"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "9.2"}]}], " ", "Integrate", " ", "the", " ", "UV", " ", 
      "asymptotic", " ", 
      RowBox[{"expansion", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"The", " ", "contribution", " ", "from", " ", "0"}], "<=", "k", "<", 
     RowBox[{
      RowBox[{
      "k0", " ", "is", " ", "part", " ", "of", " ", "the", " ", 
       "undetermined", " ", "finite", " ", "contribution", " ", "and", " ", 
       "is", " ", "not", " ", "approximated", " ", "using", " ", "the", " ", 
       "large"}], "-", 
      RowBox[{"k", " ", 
       RowBox[{"expansion", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bubbleCutoffUVApproximation", "=", 
