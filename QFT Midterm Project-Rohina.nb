In[385]:=",ExpressionUUID->"7d68ba18-334f-fb49-841e-079607a55557"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"3", " ", "betaSym"}], 
    RowBox[{"e", " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"3", " ", "g"}], "e"], "+", "1"}], ")"}]}]], "+", 
   FractionBox["betaSym", "g"], "+", "e"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0041909501402626`*^9, 4.004191810070568*^9, 
  4.0042000697845993`*^9, 4.0042535824553337`*^9, 4.004292139115549*^9, 
  4.0042995413109837`*^9},
 CellLabel->
