Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["2", 
    RowBox[{"e", "-", "4"}]], " ", 
   SuperscriptBox["\[Pi]", 
    FractionBox[
     RowBox[{"e", "-", "4"}], "2"]], " ", 
   SuperscriptBox["m2", 
    RowBox[{
     FractionBox[
      RowBox[{"4", "-", "e"}], "2"], "-", "1"}]], " ", 
   SuperscriptBox["muR", "e"], " ", 
   TemplateBox[{
     RowBox[{
       FractionBox[
        RowBox[{"e", "-", "4"}], "2"], "+", "1"}]},
    "Gamma"]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.004173584568367*^9, 4.0041814783847027`*^9, 
  4.00418278771311*^9, 4.0041895469277*^9, 4.0041990160074463`*^9, 
  4.0042016005429497`*^9, 4.004247860601902*^9, 4.0042509996489143`*^9, 
  4.004292015589403*^9, 4.0042994457019672`*^9},
 CellLabel->
  "Out[161]//TraditionalForm=",ExpressionUUID->"d2912ecb-8a45-e44d-b73f-\
452518282d4d"],

Cell[BoxData[
 FormBox["\<\"Dimensionally regularized bubble integral:\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.0041735845500793`*^9, 4.004181478364704*^9, 
  4.0041827876830616`*^9, 4.0041895469073963`*^9, 4.0041990159880104`*^9, 
  4.0042016005245247`*^9, 4.004247860577547*^9, 4.004250999634144*^9, 
  4.0042920155724087`*^9, 4.0042994457070236`*^9},
 CellLabel->
  "During evaluation of \
In[151]:=",ExpressionUUID->"fa0c0655-3ace-3c4f-ab48-211d73c4b315"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["1", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"e", "-", "2"}], ")"}], " ", 
     SqrtBox["P2"]}]], 
   SuperscriptBox["2", 
    RowBox[{
     FractionBox["e", "2"], "-", "4"}]], " ", 
   SuperscriptBox["\[Pi]", 
    FractionBox[
     RowBox[{"e", "-", "4"}], "2"]], " ", 
   SuperscriptBox["m2", 
    RowBox[{
     RowBox[{"-", "e"}], "/", "2"}]], " ", 
   SuperscriptBox["muR", "e"], " ", 
   TemplateBox[{
     RowBox[{
       FractionBox[
        RowBox[{"e", "-", "4"}], "2"], "+", "2"}]},
    "Gamma"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SqrtBox[
         RowBox[{
          RowBox[{"4", " ", "m2"}], "+", "P2"}]], "-", 
        SqrtBox["P2"]}], ")"}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SqrtBox[
          FractionBox["P2", 
           RowBox[{
            RowBox[{"4", " ", "m2"}], "+", "P2"}]]], "+", "1"}], ")"}], 
       RowBox[{"e", "/", "2"}]], " ", 
      TemplateBox[{
        RowBox[{"1", "-", 
          FractionBox["e", "2"]}], 
        FractionBox["e", "2"], 
        RowBox[{"2", "-", 
          FractionBox["e", "2"]}], 
        RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
            RowBox[{"1", "-", 
              SqrtBox[
               FractionBox["P2", 
                RowBox[{
                  RowBox[{"4", " ", "m2"}], "+", "P2"}]]]}], ")"}]}]},
       "Hypergeometric2F1"]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SqrtBox[
         RowBox[{
          RowBox[{"4", " ", "m2"}], "+", "P2"}]], "+", 
        SqrtBox["P2"]}], ")"}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SqrtBox[
          FractionBox["P2", 
           RowBox[{
            RowBox[{"4", " ", "m2"}], "+", "P2"}]]]}], ")"}], 
       RowBox[{"e", "/", "2"}]], " ", 
      TemplateBox[{
        RowBox[{"1", "-", 
          FractionBox["e", "2"]}], 
        FractionBox["e", "2"], 
        RowBox[{"2", "-", 
          FractionBox["e", "2"]}], 
        RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
            RowBox[{
              SqrtBox[
               FractionBox["P2", 
                RowBox[{
                  RowBox[{"4", " ", "m2"}], "+", "P2"}]]], "+", "1"}], 
            ")"}]}]},
       "Hypergeometric2F1"]}]}], ")"}]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.004173584568367*^9, 4.0041814783847027`*^9, 
  4.00418278771311*^9, 4.0041895469277*^9, 4.0041990160074463`*^9, 
  4.0042016005429497`*^9, 4.004247860601902*^9, 4.0042509996489143`*^9, 
  4.004292015589403*^9, 4.0042994457269325`*^9},
 CellLabel->
  "Out[163]//TraditionalForm=",ExpressionUUID->"575c13f0-01c8-cc4e-bf61-\
54c1b81ac5d8"],

Cell[BoxData[
 FormBox["\<\"Zero-momentum bubble integral:\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.0041735845500793`*^9, 4.004181478364704*^9, 
  4.0041827876830616`*^9, 4.0041895469073963`*^9, 4.0041990159880104`*^9, 
  4.0042016005245247`*^9, 4.004247860577547*^9, 4.004250999634144*^9, 
  4.0042920155724087`*^9, 4.0042994457369823`*^9},
 CellLabel->
  "During evaluation of \
In[151]:=",ExpressionUUID->"809a2663-67ee-e54b-aed3-61d8ff5267d4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["2", 
    RowBox[{"e", "-", "4"}]], " ", 
   SuperscriptBox["\[Pi]", 
    FractionBox[
     RowBox[{"e", "-", "4"}], "2"]], " ", 
   SuperscriptBox["m2", 
    RowBox[{
     FractionBox[
      RowBox[{"4", "-", "e"}], "2"], "-", "2"}]], " ", 
   SuperscriptBox["muR", "e"], " ", 
   TemplateBox[{
     RowBox[{
       FractionBox[
        RowBox[{"e", "-", "4"}], "2"], "+", "2"}]},
    "Gamma"]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.004173584568367*^9, 4.0041814783847027`*^9, 
  4.00418278771311*^9, 4.0041895469277*^9, 4.0041990160074463`*^9, 
  4.0042016005429497`*^9, 4.004247860601902*^9, 4.0042509996489143`*^9, 
  4.004292015589403*^9, 4.0042994457369823`*^9},
 CellLabel->
  "Out[165]//TraditionalForm=",ExpressionUUID->"27e6ec81-199c-b546-bc37-\
98aab724ccda"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Exact DR results:",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 "\[LineSeparator]",
 StyleBox["Applying the DR master integral to the tadpole and zero-momentum \
bubble yields\n\n                                                             \
             ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["m", "TI"], "2"], ")"}], "\[LongEqual]", 
         FractionBox[
          SubsuperscriptBox["\[Mu]", 
           StyleBox["R", "TI"], "\[Epsilon]"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]"}], ")"}], 
           RowBox[{"2", "-", "\[Epsilon]", "/", "2"}]]], "\[CapitalGamma]", 
         RowBox[{"(", 
           RowBox[{"-1", "+", 
             FractionBox["\[Epsilon]", "2"]}], ")"}], 
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"], ")"}], 
          RowBox[{"1", "-", "\[Epsilon]", "/", "2"}]], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\mathrm{DR}}(m^2)=\n\
\\frac{\\mu_R^\\epsilon}{(4\\pi)^{2-\\epsilon/2}}\n\
\\Gamma\\left(-1+\\frac{\\epsilon}{2}\\right)\n(m^2)^{1-\\epsilon/2},", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3ecef645-5cac-964c-88da-62908a660a46"],
 StyleBox["              ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           RowBox[{"0", ",", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"]}], ")"}], "\[LongEqual]", 
         FractionBox[
          SubsuperscriptBox["\[Mu]", 
           StyleBox["R", "TI"], "\[Epsilon]"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]"}], ")"}], 
           RowBox[{"2", "-", "\[Epsilon]", "/", "2"}]]], "\[CapitalGamma]", 
         RowBox[{"(", 
           FractionBox["\[Epsilon]", "2"], ")"}], 
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"], ")"}], 
          RowBox[{"-", "\[Epsilon]", "/", "2"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "B_{\\mathrm{DR}}(0,m^2)=\n\
\\frac{\\mu_R^\\epsilon}{(4\\pi)^{2-\\epsilon/2}}\n\
\\Gamma\\left(\\frac{\\epsilon}{2}\\right)\n(m^2)^{-\\epsilon/2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c66d4d32-c7ed-ce45-a6da-92e4f41d0359"],
 StyleBox["\n\nThe momentum-dependent bubble ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], "(", 
         RowBox[{
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ",", 
           SuperscriptBox[
            StyleBox["m", "TI"], "2"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "B_{\\mathrm{DR}}(P^2,m^2)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b81ff551-4ca6-6145-9f57-682a5bac56f3"],
 StyleBox[" is expressed in terms of the hypergeometric function as obtained \
in Out[158]. (A-37)\nThese exact expressions provide the starting point for \
the Laurent expansions in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"97c99658-f287-8c4f-871e-6ffca712dfab"],
 StyleBox[" derived in the following subsection. ",
  FontSize->13],
 "\n--------------------------------------------------------------------------\
------------------------------------------------------------------------------\
------------------------"
}], "Text",
 CellChangeTimes->{{4.0041743379028664`*^9, 4.0041743448378124`*^9}, {
  4.0042445860334244`*^9, 
  4.0042447260135193`*^9}},ExpressionUUID->"c45f1731-2bff-8740-852e-\
2a73b6774722"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.2.4 Laurent Expansions and and Pole Structure",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.0038162765676823`*^9, 4.00381628236578*^9}, 
   4.0039002365799656`*^9, {4.0041568396501255`*^9, 
   4.004156841325678*^9}},ExpressionUUID->"3d027418-111c-c34c-913f-\
a82b80f233fb"],

Cell[TextData[{
 StyleBox["To identify the ultraviolet divergences in dimensional \
regularization, we expand the tadpole and bubble integrals derived in Section \
1.2.3 as Laurent series around ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\varepsilon=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"45a1a44c-7911-b64c-8432-f4dcedcc2074"],
 StyleBox[", corresponding to the physical limit ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[Rule]", "4"}], TraditionalForm], 
     "errors" -> {}, "input" -> "d \\to 4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4e1e202a-76a8-194d-af14-359c8b31cd91"],
 StyleBox[". The ultraviolet divergences manifest as poles in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Epsilon]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/\\varepsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"596c7499-1df6-4e42-b1d6-ebd3b15740ed"],
 StyleBox[", while the finite terms capture the dependence on the \
renormalization scale ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Mu]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b71fbffd-0774-9d41-9959-4a9914eaaeeb"],
 StyleBox[" and the kinematic variables.\nFor the tadpole integral, the \
expansion is:\n\n                                                             \
                                       ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "DR"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["m", "TI"], "2"], ")"}], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           StyleBox["m", "TI"], "2"], 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{"-", 
             FractionBox["2", "\[Epsilon]"], "+", 
             SubscriptBox["\[Gamma]", 
              StyleBox["E", "TI"]], "-", "1", "-", "ln", 
             RowBox[{"(", 
               FractionBox[
                RowBox[{"4", 
                  SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]], ")"}]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "T_{\\text{DR}}(m^2) = \\frac{m^2}{16\\pi^2} \\left[ \
-\\frac{2}{\\varepsilon} + \\gamma_E - 1 - \
\\ln\\left(\\frac{4\\pi\\mu^2}{m^2}\\right) \\right] + O(\\varepsilon)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"91bcd9c7-6e0a-2d4e-976e-db79a86ad4c9"],
 StyleBox["                                                                   \
                            (A-38)\n\nThe bubble integral ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], "DR"], "(", 
         RowBox[{
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ",", 
           SuperscriptBox[
            StyleBox["m", "TI"], "2"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "B_{\\text{DR}}(P^2, m^2)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4b73957e-fd91-3f49-853e-a388f7ed58f6"],
 StyleBox[" exhibits the following expansion:\n\n                             \
                                                              ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], "DR"], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["P", "TI"], "2"], ",", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"]}], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{
             FractionBox["2", "\[Epsilon]"], "-", 
             SubscriptBox["\[Gamma]", 
              StyleBox["E", "TI"]], "+", "ln", 
             RowBox[{"(", 
               FractionBox[
                RowBox[{"4", 
                  SuperscriptBox["\[Pi]\[Mu]", "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]], ")"}], "-", 
             SubsuperscriptBox["\[Integral]", "0", "1"], 
             StyleBox["d", "TI"], 
             StyleBox["x", "TI"], "ln", 
             RowBox[{"(", 
               RowBox[{"1", "+", 
                 FractionBox[
                  RowBox[{
                    StyleBox["x", "TI"], 
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    StyleBox["x", "TI"]}], ")"}], 
                    SuperscriptBox[
                    StyleBox["P", "TI"], "2"]}], 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]]}], ")"}]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "B_{\\text{DR}}(P^2, m^2) = \\frac{1}{16\\pi^2} \\left[ \
\\frac{2}{\\varepsilon} - \\gamma_E + \
\\ln\\left(\\frac{4\\pi\\mu^2}{m^2}\\right) - \\int_0^1 dx \\ln\\left(1 + \
\\frac{x(1-x)P^2}{m^2}\\right) \\right] + O(\\varepsilon)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6c663074-d438-664d-ad5f-a0af3bd79106"],
 StyleBox["                                                    (A-39)\n\n\
Here, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", 
        StyleBox["E", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma_E", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d442282f-68eb-a64a-b5d9-82288f872b47"],
 StyleBox[" denotes the Euler\[Dash]Mascheroni constant. The pole terms are \
independent of the external momentum ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> "P", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6dd16dc9-6da7-e147-b9d6-490b6bec0e87"],
 StyleBox[", consistent with the local nature of ultraviolet divergences. The \
tadpole\[CloseCurlyQuote]s pole structure reflects the quadratic-like mass \
divergence, whereas the bubble integral demonstrates the expected logarithmic \
divergence.\n\n",
  FontSize->13],
 StyleBox["Zero-momentum bubble and pole structure:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\[LineSeparator]Expanding the exact DR expression for the \
zero-momentum bubble around ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b35c434b-dcce-f849-8185-90c35fe0a677"],
 StyleBox[" gives:\[LineSeparator]\[LineSeparator]                            \
                                                                              \
       ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           RowBox[{"0", ",", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"]}], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{
             FractionBox["2", "\[Epsilon]"], "-", 
             SubscriptBox["\[Gamma]", 
              StyleBox["E", "TI"]], "+", "ln", 
             RowBox[{"(", 
               FractionBox[
                RowBox[{"4", 
                  SubsuperscriptBox["\[Pi]\[Mu]", 
                   StyleBox["R", "TI"], "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]], ")"}]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "B_{\\mathrm{DR}}(0,m^2)=\n\\frac{1}{16\\pi^2}\n\\left[\n\
\\frac{2}{\\epsilon}-\\gamma_E+\n\\ln\\left(\\frac{4\\pi\\mu_R^2}{m^2} \
\\right)\n \\right]+O (\\epsilon)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1cd7bf2a-4a02-c24c-abb8-267ab24807a8"],
 StyleBox["                                                                   \
                     (A-40)",
  FontSize->13],
 StyleBox["\[LineSeparator]\nThe pole coefficients, defined as the \
coefficients of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Epsilon]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5659267e-b918-7444-b027-14a56d7f16b0"],
 StyleBox[", are ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "/", 
         RowBox[{"(", 
           RowBox[{"8", 
             SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "-m^2/(8\\pi^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f52d03df-91d2-7640-b6c1-ed262c805518"],
 StyleBox[" ",
  FontSize->13],
 StyleBox["for the tadpole ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["DR", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "T_{\\mathrm{DR}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9ec9bd52-6ef3-b645-b173-b571d9e03408"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", 
         RowBox[{"(", 
           RowBox[{"8", 
             SuperscriptBox["\[Pi]", "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "1/(8\\pi^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3c474dfc-56a7-b648-b666-90272d8cc52f"],
 StyleBox[" ",
  FontSize->13],
 StyleBox["for both the zero-momentum bubble ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
