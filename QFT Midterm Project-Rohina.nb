         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox["\[Eta]", 
              StyleBox["B", "TI"]]}], ")"}], "/", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta_\\phi=\\Delta_\\sigma=(1+\\eta_B)/2",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"39dcc39d-4c6b-5740-84fc-574580309ff1"],
 StyleBox[". The values ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalDelta]", "\[Sigma]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta_\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"42c27c8f-1c95-9644-8177-0dd5c6ccf055"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Delta]", "water"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta_{\\rm water}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"46c96fbf-5aa8-ab4d-b777-fb8c3dfac6ed"],
 StyleBox[" are external comparison inputs, not results derived here. We also \
include the experimental critical-isotherm exponent for water, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
