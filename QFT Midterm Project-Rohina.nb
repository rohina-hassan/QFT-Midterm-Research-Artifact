Cell[CellGroupData[{

Cell[TextData[StyleBox["2.2 Field renormalization and the anomalous dimension",
 FontFamily->"Arial",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.43529411764705883`, 0.3411764705882353, 
   0.6509803921568628]]], "Subsection",
 CellChangeTimes->{{4.004190507629486*^9, 
  4.0041905184594765`*^9}},ExpressionUUID->"52840462-96bb-db45-be56-\
107f1db76499"],

Cell[TextData[{
 StyleBox["In this section, we use the momentum - dependent ultraviolet \
divergence of the two - loop sunset diagram to determine the field - strength \
renormalization and the anomalous dimension of the scalar field . In Section \
2.2 .1, we incorporate the sunset contribution into the inverse propagator, \
keeping track of its sign and symmetry factor, and isolate the divergence \
proportional to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "/", "\[Epsilon]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "p^2/\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ea177e7d-5aef-634a-abc0-b5f2c5cb61d4"],
 StyleBox[" . In Section 2.2 .2, we introduce the field renormalization \
constant ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Z", "TI"], "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "Z_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"56d3b25b-6739-f24a-913c-a4c82cf0ae08"],
 StyleBox[" and determine the corresponding counterterm by requiring the \
cancellation of this divergence . In Section 2.2 .3, we derive the anomalous \
dimension ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\gamma_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6e3771c5-20b5-4a49-a135-910edfdc3d22"],
 StyleBox[" from the renormalization - scale dependence of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Z", "TI"], "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "Z_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2154db6b-982c-8142-a823-43b0f383bd04"],
 StyleBox[", with the bare parameters held fixed . Finally, in Section 2.2 \
.4, we evaluate the critical exponent ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"12b30816-24c8-3647-a53f-16a5f0d3c2f2"],
 StyleBox[" at the Wilson\[Dash]Fisher fixed point through order ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Epsilon]", "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\epsilon^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"96fa68c2-1317-0344-9d4f-106042820e56"],
 StyleBox[" and check the result against the finite logarithmic dependence on \
",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "/", 
         SubsuperscriptBox["\[Mu]", 
          StyleBox["R", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "p^2/\\mu_R^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f9754740-cccb-b24e-a385-ec24f2669f71"],
 StyleBox[" obtained from the sunset integral . We also explain why the one - \
loop expression for the fixed-point coupling is sufficient at this order.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0042953813436317`*^9, 
  4.004295463455593*^9}},ExpressionUUID->"26d67600-15de-5e41-aec8-\
23c0d4c51a3f"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["2.2.1 Sunset Contribution to the Inverse Propagator",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.5254901960784314, 0.3843137254901961, 
   0.49019607843137253`]]], "Subsubsection",
 CellChangeTimes->{{4.0042952510677776`*^9, 
  4.0042952687728825`*^9}},ExpressionUUID->"f60b5bb3-53af-ec4e-8c90-\
4dbfd476ccc9"],

Cell[TextData[{
 StyleBox["The only nonvanishing momentum-dependent two-loop 1PI diagram \
identified in Section 2.1 is the sunset diagram. Its contribution to the \
inverse propagator is determined by the scalar integral H(p), evaluated in \
Section 2.1.3, together with the diagram\[CloseCurlyQuote]s symmetry factor \
and the Euclidean interaction-vertex factors. \nThe full propagator is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["G", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["G", "TI"], "0"], "+", 
         SubscriptBox[
          StyleBox["G", "TI"], "0"], "\[CapitalSigma]", 
         SubscriptBox[
          StyleBox["G", "TI"], "0"], "+", "\[Ellipsis]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "G=G_0+G_0\\Sigma G_0+\\dots", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9a7ce7f1-6fd4-2845-9d8a-af05236197ea"],
 StyleBox[", where ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalSigma]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"60d10107-1590-8648-900f-d10b9d9e8a17"],
 StyleBox[" is the sum of the amputated 1PI diagrams, including their vertex \
factors. Hence ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["G", "TI"], "-1"], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["G", "TI"], "0", "-1"], "-", "\[CapitalSigma]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "G^{-1}=G_0^{-1}-\\Sigma",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5c1d8072-1160-f040-b026-f32c0fdc158b"],
 StyleBox[", so ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "2", ")"}]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "-", "\[CapitalSigma]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^{(2)}=p^2+m^2-\\Sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"fe4d25af-b6bc-1f4a-929f-d38ef5418f93"],
 StyleBox[". For the sunset, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalSigma]", "\[LongEqual]", 
         FractionBox["1", "3!"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"-", "\[Lambda]"}], ")"}], "2"], 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox["\[Lambda]", "2"], "6"], 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\Sigma=\\frac{1}{3!}(-\\lambda)^2 H(p)=\\frac{\\lambda^2}{6}H(p)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"df38237e-6002-d34d-9854-44e9e45061f7"],
 StyleBox[", which gives ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", "sunset", 
          RowBox[{"(", "2", ")"}]], "\[LongEqual]", "-", 
         FractionBox[
          SuperscriptBox["\[Lambda]", "2"], "6"], 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Gamma^{(2)}_{\\rm sunset}=-\\frac{\\lambda^2}{6}H(p)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"862b4642-d42f-0b4c-8a34-aab471727ef3"],
 StyleBox[". (A-81)\nThe factor 1/3! is the symmetry factor from permuting \
the three identical internal lines connecting the two vertices.\n\nUsing the \
result derived in Section 2.1.3,\n\n                                          \
                               ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", "-", 
         FractionBox[
          SuperscriptBox[
           StyleBox["p", "TI"], "2"], 
          RowBox[{"2", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], "4"], "\[Epsilon]"}]], "+", 
         FractionBox[
          SuperscriptBox[
           StyleBox["p", "TI"], "2"], 
          RowBox[{"8", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], "4"]}]], 
         RowBox[{"[", 
           RowBox[{"-8", "ln", 
             SubscriptBox["\[Mu]", 
              StyleBox["R", "TI"]], "+", "4", "ln", 
             SuperscriptBox[
              StyleBox["p", "TI"], "2"], "+", "4", 
             SubscriptBox["\[Gamma]", 
              StyleBox["E", "TI"]], "-", "13", "-", "4", "ln", 
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "H(p)=\n-\\frac{p^2}{2(4\\pi)^4\\epsilon}\n+\\frac{p^2}{8(4\\pi)^4}\n\
\\left[\n-8\\ln\\mu_R+4\\ln p^2+4\\gamma_E\n-13-4\\ln(4\\pi)\n\\right]\n\
+O(\\epsilon),", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"66189921-4f11-d346-b83a-5820b801bb45"],
 StyleBox["                                                            (A-82)\
\n\nthe sunset contribution becomes:\n\n                                      \
                              ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          StyleBox["sunset", FontSlant -> "Plain"], 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["p", "TI"], "2"], ")"}], "\[LongEqual]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma_{\\mathrm{sunset}}^{(2)}(p^2)\n=", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2aa9c3df-ccb3-5243-84c5-59be10d1c7a0"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        RowBox[{
          SuperscriptBox["\[Lambda]", "2"], 
          SuperscriptBox[
           StyleBox["p", "TI"], "2"]}], 
        RowBox[{"12", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]"}], ")"}], "4"], "\[Epsilon]"}]], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\lambda^2p^2}{12(4\\pi)^4\\epsilon}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"72e6f78b-cd3b-6645-aad5-3308effa6eb2"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[Lambda]", "2"], 
            SuperscriptBox[
             StyleBox["p", "TI"], "2"]}], 
          RowBox[{"48", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], "4"]}]], 
         RowBox[{"[", 
           RowBox[{"-8", "ln", 
             SubscriptBox["\[Mu]", 
              StyleBox["R", "TI"]], "+", "4", "ln", 
             SuperscriptBox[
              StyleBox["p", "TI"], "2"], "+", "4", 
             SubscriptBox["\[Gamma]", 
              StyleBox["E", "TI"]], "-", "13", "-", "4", "ln", 
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "-\\frac{\\lambda^2p^2}{48(4\\pi)^4}\n\\left[\n-8\\ln\\mu_R+4\\ln \
p^2+4\\gamma_E\n-13-4\\ln(4\\pi)\n\\right]\n+O(\\epsilon)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3dfed2de-d406-9a4f-848d-fb230c7a1119"],
 StyleBox["                                                         (A-83)\n\n\
In particular, the ultraviolet pole proportional to the external momentum is:\
\n\n                                                                          \
                                                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{
            RowBox[{
              SubsuperscriptBox["\[CapitalGamma]", 
               StyleBox["sunset", FontSlant -> "Plain"], 
               RowBox[{"(", "2", ")"}]], "(", 
              SuperscriptBox[
               StyleBox["p", "TI"], "2"], ")"}], "\[VerticalSeparator]"}], 
          RowBox[{
            StyleBox["pole", FontSlant -> "Plain"], ", ", 
            SuperscriptBox[
             StyleBox["p", "TI"], "2"]}]], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox["\[Lambda]", "2"], 
          RowBox[{"12", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], "4"], "\[Epsilon]"}]], " ", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\left.\\Gamma_{\\mathrm{sunset}}^{(2)}(p^2)\\right|_{\\mathrm{pole},\\,\
p^2}\n=\n\\frac{\\lambda^2}{12(4\\pi)^4\\epsilon}\\,p^2.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c0c88733-ed53-e840-be16-b0af9b40f34b"],
 StyleBox["\n\nThis term is important because, unlike the one-loop tadpole, \
the sunset diagram depends nontrivially on the external momentum. It \
therefore contributes to the renormalization of the coefficient of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a72efa09-0b59-e74b-aba4-60e3ca5aa6f6"],
 StyleBox[", and hence to the field-strength renormalization constant ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Z", "TI"], "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "Z_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8b0322bb-132e-6646-ab51-324102b19b48"],
 StyleBox[". The momentum-independent part of the two-point function instead \
contributes to mass renormalization. In the following subsection, we account \
for the four-point subdivergences and determine their effect on the \
momentum-dependent pole before extracting the two-loop field anomalous \
dimension.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004295526762333*^9, 4.0042956386620197`*^9}, {
  4.0042956722159843`*^9, 4.0042957113320026`*^9}, {4.0042959762106113`*^9, 
  4.0042961865633526`*^9}},ExpressionUUID->"c92abcc5-ab57-ed4a-8482-\
b886bb9532bc"],

