Cell[BoxData[
 FormBox["\<\"Coupling counterterm (dLam):\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.0041771956647797`*^9, 4.0041775596141834`*^9, 
  4.0041815161953564`*^9, 4.0041828255732*^9, 4.004189587422308*^9, 
  4.004199047350748*^9, 4.0042492261888294`*^9, 4.0042510345736294`*^9, 
  4.0042920874397507`*^9, 4.0042994904119625`*^9},
 CellLabel->
  "During evaluation of \
In[240]:=",ExpressionUUID->"1b9375fb-6c48-a046-bf18-244ccee971cf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["3", "2"], " ", 
   RowBox[{"Breg", "(", "0", ")"}], " ", 
   SuperscriptBox["lam", "2"]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.004177195671633*^9, 4.0041775596141834`*^9, 
  4.0041815161953564`*^9, 4.004182825578207*^9, 4.0041895874274883`*^9, 
  4.004199047350748*^9, 4.0042492261888294`*^9, 4.0042510345736294`*^9, 
  4.0042920874540424`*^9, 4.004299490412985*^9},
 CellLabel->
