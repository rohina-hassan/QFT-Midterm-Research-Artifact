In[614]:=",ExpressionUUID->"f73d27fc-8123-4d4f-bc6f-3dd1101a45f7"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   FractionBox["1", 
    RowBox[{"512", " ", 
     SuperscriptBox["\[Pi]", "4"]}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0042653105296497`*^9, 4.0042943234081135`*^9, 
