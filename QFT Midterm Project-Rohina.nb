  StyleBox["betaResidueCheck",
   FontSize->13]], "InlineCode",ExpressionUUID->
  "530da33f-b73c-ff41-a06b-a07b14cda94c"],
 StyleBox[", the beta-function and fixed-point consistency checks, and the \
fixed-point stability coefficients all \npass. The one-loop result ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Eta]", 
          RowBox[{"(", "1", ")"}]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\eta^{(1)}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c97785a2-28e0-7445-961c-4e0ace08dbac"],
 StyleBox[" follows from the vanishing field-strength renormalization.\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
-----------------------------------------------  ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" \n",
  FontSize->13],
 StyleBox["Anchor IDs:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nA-57 to A-66.\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
-----------------------------------------------  ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" \n",
  FontSize->13],
 StyleBox["Status:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nChecked!",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004253244977833*^9, 4.004253261257622*^9}, {
  4.0042579809483604`*^9, 
  4.0042581703277607`*^9}},ExpressionUUID->"ced9321a-ef48-9246-baab-\
8e3e203f07be"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["PART 2\[LongDash]CRITICAL EXPONENTS AND WATER",
 FontFamily->"Arial",
 FontSize->18,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.37254901960784315`, 0.27058823529411763`, 
   0.34901960784313724`]]], "Section",
 CellChangeTimes->{{4.003816480095724*^9, 
  4.003816486341467*^9}},ExpressionUUID->"06ea13d0-18f4-e140-8379-\
eff6745507c7"],

Cell[TextData[{
 StyleBox["In this part, we investigate the critical behavior of scalar ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Phi]", "4"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\phi^4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e2c9521c-f5c3-c14d-b3e7-0f9dc625c96b"],
 StyleBox[" theory near four dimensions. By tuning the mass to criticality, \
we calculate the two-loop anomalous dimension and determine the critical \
exponents ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"011d7b70-05d3-b645-a569-519a8a232821"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5c8c5eb1-d635-1f46-90dc-e6042cf329d3"],
 StyleBox[" through order ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Epsilon]", "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\epsilon^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"077b383b-7b29-ea43-b370-fc36103bdb40"],
 StyleBox[", using massless dimensional regularization and the \
Wilson\[Dash]Fisher fixed point obtained in Part 1.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0042589686261463`*^9, 
  4.004259000761112*^9}},ExpressionUUID->"5df66f26-d149-2d44-b57d-\
3cc0dccdc421"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["2.1 The two-loop two-point function",
 FontFamily->"Arial",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.43529411764705883`, 0.3411764705882353, 
   0.6509803921568628]]], "Subsection",
 CellChangeTimes->{{4.0041904811220894`*^9, 
  4.004190499347725*^9}},ExpressionUUID->"66179933-992b-9748-9d06-\
f1403418d648"],

Cell[TextData[{
 StyleBox["In this section, we calculate the two-loop contribution to the \
two-point 1PI function in massless dimensional regularization, with the mass \
tuned to criticality and nonzero Euclidean external momentum ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "p^2>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b5ab8590-967d-ff49-bba3-ac0d8d0419b1"],
 StyleBox[". In Section 2.1.1, we generate and classify the two-loop diagrams \
using ",
  FontSize->13],
 Cell[BoxData["FeynArts"],
  FontSize->13,ExpressionUUID->"94755e77-60fd-c745-bf9a-a78422770abf"],
 StyleBox[" and convert their amplitudes with ",
  FontSize->13],
 Cell[BoxData["FeynCalc"],
  FontSize->13,ExpressionUUID->"ef382b09-487f-744a-8724-892cbed2730e"],
 StyleBox[". Section 2.1.2 identifies the momentum-dependent sunset diagram \
and derives its symmetry factor. In Section 2.1.3, we evaluate the \
corresponding massless two-loop integral through successive one-loop \
convolutions, obtaining its exact gamma-function representation and Laurent \
expansion. Finally, in Section 2.1.4, we examine the four-point \
subdivergences and their counterterm insertions, establishing that they do \
not contribute to the momentum-dependent pole. Together, these steps provide \
the two-loop momentum-dependent contribution needed to determine the \
field-strength renormalization and anomalous dimension.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004265454759268*^9, 
  4.0042654799043064`*^9}},ExpressionUUID->"1df5abc8-4a40-ec46-8e60-\
17e9405c001f"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["2.1.1 Generation and Classification of Two-Loop 1PI \
Diagrams",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.5254901960784314, 0.3843137254901961, 
   0.49019607843137253`]]], "Subsubsection",
 CellChangeTimes->{
  4.0042592806174335`*^9},ExpressionUUID->"265b613e-27f9-bd40-8e3d-\
2041c56711ca"],

Cell[TextData[{
 StyleBox["We now investigate the two-loop contribution to the \
one-particle-irreducible (1PI) two-point function of scalar ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Phi]", "4"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\phi^4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"920d1a24-2fc1-2449-8016-5d9668ad6daa"],
 StyleBox[" theory at criticality. At the critical point, the renormalized \
mass is tuned to zero, and we work in the massless limit using dimensional \
regularization in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d=4-\\epsilon", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"707a347f-e4bf-7e49-9753-12c018191cfb"],
 StyleBox[" dimensions. The free Euclidean propagator therefore takes the \
form ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["G", "TI"], "0"], 
         RowBox[{"(", 
           StyleBox["k", "TI"], ")"}], "\[LongEqual]", "1", "/", 
         SuperscriptBox[
          StyleBox["k", "TI"], "2"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "G_0(k)=1/k^2,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f4303d29-9617-a845-a365-58dd99978da7"],
 StyleBox[" where ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"deef9535-dafc-ed4a-a856-03161dbf2cf8"],
 StyleBox[" denotes a Euclidean momentum. We retain a nonzero external \
Euclidean momentum ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b0e0e759-a8f4-764c-82e7-6c19c6019f1c"],
 StyleBox[", with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "p^2>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1b12069c-a255-cc46-8058-9c65d244c807"],
 StyleBox[", to regulate the infrared behavior of the massless integrals and \
to isolate the momentum-dependent ultraviolet divergences relevant to \
field-strength renormalization. (A-68)\n\nOur first step is to generate all \
two-loop 1PI two-point topologies using ",
  FontSize->13],
 Cell[BoxData["FeynArts"],
  FontSize->13,ExpressionUUID->"1f1a1c85-0cc4-5d45-9e1f-b4d1363ed83f"],
 StyleBox[". We construct the topologies, insert the scalar fields, visualize \
the resulting diagrams with ",
  FontSize->13],
 Cell[BoxData["Paint"],
  FontSize->13,ExpressionUUID->"c83fd9eb-d70f-9241-b9aa-f087d3ddefb0"],
 StyleBox[", and generate their analytic amplitudes using ",
  FontSize->13],
 Cell[BoxData["CreateFeynAmp"],
  FontSize->13,ExpressionUUID->"40d243ad-589f-8a46-89fe-8662261bf29f"],
 StyleBox[". This provides a systematic enumeration of the diagrams \
contributing to the two-point function at the order under consideration.\n\n\
The resulting amplitudes are then converted into ",
  FontSize->13],
 Cell[BoxData["FeynCalc"],
  FontSize->13,ExpressionUUID->"f2813678-6850-784c-bee4-d826b8d39c2b"],
 StyleBox[" expressions using ",
  FontSize->13],
 Cell[BoxData["FCFAConvert"],
  FontSize->13,ExpressionUUID->"afbaa58c-6f2e-b14c-bd18-741f383f3494"],
 StyleBox[". Since the diagrams contain two independent loop integrations, we \
specify two independent loop momenta, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"56c2ef3b-e52d-ef4e-ad2b-4e1cbe8cc153"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[ScriptL]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\ell", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d05a2509-783a-bc4b-bcc9-74130175b177"],
 StyleBox[", in the conversion. This representation allows us to inspect the \
momentum dependence of each diagram and subsequently evaluate the relevant \
two-loop integrals.\n\nAn important distinction at this stage is between \
diagrams that depend on the external momentum ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d32b4e80-5b0a-5044-9c87-b071f17670ad"],
 StyleBox[" and those that are momentum independent. Momentum-independent \
contributions can modify the mass term in the two-point function, but they \
cannot generate a divergence proportional to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f64c5b57-bacf-4847-96a4-565b8673f21e"],
 StyleBox[". By contrast, the momentum-dependent diagrams contribute to the \
coefficient of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"49088675-031d-694e-92e6-419d6429508b"],
 StyleBox[" and therefore determine the two-loop field-strength counterterm. \
We will identify these contributions explicitly before evaluating the \
relevant integrals.\n\nOf the three diagrams produced without the 1PI cut, \
one is reducible (two tadpoles joined by a propagator carrying p, with factor \
1/p\.b2) and is excluded. The two 1PI diagrams are the double scoop, with \
symmetry factor 1/4 and no p dependence, and the sunset, with symmetry factor \
1/6 and nontrivial p dependence. (A-67)\n\nIn particular, the sunset topology \
is the momentum-dependent two-loop diagram of interest. Its symmetry factor \
and integral representation will be derived in the next subsection, followed \
by its evaluation using successive massless one-loop convolutions.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004261210695978*^9, 4.0042613714689083`*^9}, {
  4.0042614245150757`*^9, 4.004261430665411*^9}, {4.004292256777132*^9, 
  4.0042922853277416`*^9}, {4.0042923395871964`*^9, 
  4.0042923466401234`*^9}},ExpressionUUID->"48318607-4215-b64b-ae4d-\
fc4acedb82db"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "topologies2L", ",", "insertions2L", ",", "amplitudes2L", ",", 
     "amplitudes2LFC", ",", "amplitudes2LMassless"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"1.", " ", "two"}], "-", 
     RowBox[{"loop", " ", "two"}], "-", 
     RowBox[{"point", " ", "topologies"}]}], ",", 
    RowBox[{"1", "PI", " ", "only", " ", 
     RowBox[{"(", 
      RowBox[{"A", "-", "68"}], ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"topologies2L", "=", 
    RowBox[{"CreateTopologies", "[", 
     RowBox[{"2", ",", 
      RowBox[{"1", "->", "1"}], ",", 
      RowBox[{"ExcludeTopologies", "->", 
       RowBox[{"{", "Reducible", "}"}]}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"2.", " ", "insert", " ", "the", " ", "scalar", " ", "field"}], ",", 
    RowBox[{
    "same", " ", "model", " ", "options", " ", "as", " ", "Part", " ", 
     "1"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"insertions2L", "=", 
    RowBox[{"InsertFields", "[", 
     RowBox[{"topologies2L", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"S", "[", "1", "]"}], "}"}], "->", 
       RowBox[{"{", 
        RowBox[{"S", "[", "1", "]"}], "}"}]}], ",", 
      RowBox[{"Sequence", "@@", "phi4ModelOptions"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"3.", " ", "display"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Paint", "[", 
    RowBox[{"insertions2L", ",", 
     RowBox[{"ColumnsXRows", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]}], ",", 
     RowBox[{"Numbering", "->", "Simple"}], ",", 
     RowBox[{"SheetHeader", "->", "None"}]}], "]"}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"4.", " ", "amplitudes"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"amplitudes2L", "=", 
    RowBox[{"CreateFeynAmp", "[", 
     RowBox[{"insertions2L", ",", 
      RowBox[{"Truncated", "->", "True"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"5.", " ", "conversion"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"two", " ", "loop", " ", 
       RowBox[{"momenta", ".", "ChangeDimension"}]}], "->", 
      RowBox[{"d", " ", "uses", " ", "the", " ", 
       RowBox[{"project", "'"}], "s", " ", "d"}]}], "=", 
     RowBox[{"4", "-", "e"}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"i", ".", "e", ".", 
        RowBox[{"FeynCalc", "'"}]}], "s", " ", "D"}], "=", 
      RowBox[{
       RowBox[{"4", "-", 
        RowBox[{"2", " ", "epsFC", " ", "with", " ", "e"}]}], "=", 
       RowBox[{"2", " ", "epsFC"}]}]}], ";", 
     RowBox[{
     "no", " ", "further", " ", "conversion", " ", "is", " ", "needed"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"amplitudes2LFC", "=", 
    RowBox[{"FCFAConvert", "[", 
     RowBox[{"amplitudes2L", ",", 
      RowBox[{"IncomingMomenta", "->", 
       RowBox[{"{", "p", "}"}]}], ",", 
      RowBox[{"OutgoingMomenta", "->", 
       RowBox[{"{", "p", "}"}]}], ",", 
      RowBox[{"LoopMomenta", "->", 
       RowBox[{"{", 
        RowBox[{"k", ",", "ell"}], "}"}]}], ",", 
      RowBox[{"ChangeDimension", "->", "d"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"6.", " ", "massless", " ", "critical", " ", "limit", " ", 
    RowBox[{"(", 
     RowBox[{"A", "-", "69"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"amplitudes2LMassless", "=", 
    RowBox[{"amplitudes2LFC", "/.", " ", 
     RowBox[{"mphi", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"7.", " ", 
    RowBox[{"classification", ":", 
     RowBox[{"which", " ", "graphs", " ", "depend", " ", "on", " ", "p", " ", 
      RowBox[{"(", 
       RowBox[{"A", "-", "68"}], ")"}]}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pDependentQ", "[", "amp_", "]"}], ":=", 
   RowBox[{"!", 
    RowBox[{"FreeQ", "[", 
     RowBox[{"amp", ",", "p"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"classification", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"pDependentQ", "[", 
          RowBox[{"amplitudes2LMassless", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], 
         ",", "\"\<depends on p (sunset)\>\"", 
         ",", "\"\<p-independent (double scoop)\>\""}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "amplitudes2LMassless", "]"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Number of 1PI two-loop diagrams (expected 2):\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{"Length", "[", "amplitudes2LFC", "]"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{"classification", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Diagram\>\"", ",", "\"\<Momentum dependence\>\""}], 
      "}"}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"sunsetIndex", "=", 
   RowBox[{"First", "@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Position", "[", 
      RowBox[{
       RowBox[{"pDependentQ", "/@", "amplitudes2LMassless"}], ",", "True"}], 
      "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Amplitudes in the massless limit:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{"amplitudes2LMassless", "//", "FCE"}]}], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{4.004261675704794*^9, 4.0042616999595585`*^9}, 
   4.004261781224924*^9, {4.0042619041545506`*^9, 4.0042619140542736`*^9}, 
   4.004292205067255*^9},
 Background->GrayLevel[0.753],
 CellLabel->
  "In[503]:=",ExpressionUUID->"a1af6a40-92c2-4a4a-b93b-36067a68b3fc"],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox["\<\"\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.0042617053147545`*^9, 4.004261959764433*^9, 
  4.0042922088826523`*^9, 4.0042995761685734`*^9},
 CellLabel->
  "During evaluation of \
In[503]:=",ExpressionUUID->"792fdf84-f2ca-d445-bf57-16a7ecaafb6c"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{"\<\"inserting at level(s) \"\>", "\[InvisibleSpace]", 
    RowBox[{"{", "Particles", "}"}]}],
   SequenceForm["inserting at level(s) ", {FeynArts`Particles}],
   Editable->False], TraditionalForm]], "Print",
 CellChangeTimes->{4.0042617053147545`*^9, 4.004261959764433*^9, 
  4.0042922088826523`*^9, 4.0042995761767254`*^9},
 CellLabel->
  "During evaluation of \
In[503]:=",ExpressionUUID->"4d9b1400-e314-c14a-a19f-a2b711985d28"],

Cell[BoxData[
