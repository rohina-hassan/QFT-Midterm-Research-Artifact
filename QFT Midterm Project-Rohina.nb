     RowBox[{
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"ev", "/", "2"}], "]"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"4", " ", "Pi"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"2", "-", 
          RowBox[{"ev", "/", "2"}]}], ")"}]}]}], "*", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"ms", "+", 
            RowBox[{"x", " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", "x"}], ")"}], " ", "P2v"}]}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "ev"}], "/", "2"}], ")"}]}], "-", 
         RowBox[{"ms", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "ev"}], "/", "2"}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"WorkingPrecision", "->", "30"}], ",", 
        RowBox[{"PrecisionGoal", "->", "15"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dbEpsTable", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ev", ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"deltaBDRFinite", "[", 
            RowBox[{"P2Test", ",", "m2Test", ",", "ev"}], "]"}], ",", "12"}], 
          "]"}], ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"deltaBDRFinite", "[", 
             RowBox[{"P2Test", ",", "m2Test", ",", "ev"}], "]"}], "-", 
            "deltaBDRLimitValue"}], ",", "5"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ev", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", 
           RowBox[{"1", "/", "10"}], ",", 
           RowBox[{"1", "/", "100"}], ",", 
           RowBox[{"1", "/", "1000"}]}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<DR finite difference as e -> 0:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"TableForm", "[", 
