             TraditionalForm],
            TraditionalForm], 
           FormBox["\<\")\"\>",
            TraditionalForm]}], "2"],
         SequenceForm[
          FeynCalc`Pair[
           
           FeynCalc`Momentum[$CellContext`ell + $CellContext`k + \
$CellContext`p, 4 - $CellContext`e], 
           
           FeynCalc`Momentum[$CellContext`ell + $CellContext`k + \
$CellContext`p, 4 - $CellContext`e]]],
         Editable->False]}]}]],
     TraditionalForm]}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0042617053147545`*^9, 4.004261960544428*^9, 
  4.004292209004612*^9, 4.0042995763266296`*^9},
 CellLabel->
  "Out[517]=",ExpressionUUID->"b85a6450-9da1-fc40-87bd-40f262c0602a"]
}, Open  ]],

Cell["\<\
------------------------------------------------------------------------------\
------------------------------------------------------------------------------\
--------------------\
\>", "Text",
 CellChangeTimes->{{4.00426421523135*^9, 
  4.0042642228313713`*^9}},ExpressionUUID->"976e0a66-6549-cd47-b922-\
10db00352712"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["2.1.2 Sunset Diagram and Its Symmetry Factor",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.5254901960784314, 0.3843137254901961, 
   0.49019607843137253`]]], "Subsubsection",
 CellChangeTimes->{
  4.004259295016058*^9},ExpressionUUID->"5c92d804-6170-3640-8a1e-\
f479cbfec712"],

Cell[TextData[{
 StyleBox["We first determine the symmetry factor of the sunset diagram. Each \
of the two quartic vertices has three internal lines connecting it to the \
other vertex. Since these internal lines are indistinguishable, their \
permutations leave the diagram unchanged. There are therefore 3!=6 equivalent \
permutations, corresponding to the symmetry factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], 
          StyleBox["sunset", FontSlant -> "Plain"]], "\[LongEqual]", "6"}], 
       TraditionalForm], "errors" -> {}, "input" -> "S_{\\mathrm{sunset}}=6", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2fd61936-07d2-de43-9f1c-5c3ca4417d3c"],
 StyleBox[".",
  FontSize->13],
 StyleBox["\n\nThe same result can be obtained directly by counting Wick \
contractions at second order in the interaction expansion. The expansion \
contributes a factor of 1/2!, while the two quartic interaction vertices \
contribute ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", 
         SuperscriptBox[
          RowBox[{"(", "4!", ")"}], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/(4!)^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e36eb80a-6216-b845-bca4-ee6c770c0985"],
 StyleBox[".",
  FontSize->13],
 StyleBox[" There are two ways to assign the two external legs to the \
vertices, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"4", "\[Cross]", "4"}], TraditionalForm], "errors" -> {}, 
     "input" -> "4\\times4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa717420-bcfc-2b41-a175-a5851d842e0d"],
 StyleBox[" ways to select the corresponding vertex legs, and 3! ways to pair \
the remaining internal legs. Thus, the net combinatorial factor is\n\n        \
                                                                              \
                                       ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "2!"], 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", "4!", ")"}], "2"]], "\[Cross]", "2", "\[Cross]", 
         RowBox[{"(", 
           RowBox[{"4", "\[Cross]", "4"}], ")"}], "\[Cross]", "3!", 
         "\[LongEqual]", 
         FractionBox["1", "6"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\frac{1}{2!}\\frac{1}{(4!)^2}\\times 2\\times(4\\times4)\\times3!\n\
=\\frac{1}{6}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a431e16d-29bc-e24b-b0df-fc24ada29ba6"],
 StyleBox["                                                                   \
                                 (A-70)",
  FontSize->13],
 StyleBox["\n\nConsequently, the sunset diagram carries a symmetry factor of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", 
         SubscriptBox[
          StyleBox["S", "TI"], 
          StyleBox["sunset", FontSlant -> "Plain"]], "\[LongEqual]", "1", "/",
          "6"}], TraditionalForm], "errors" -> {}, "input" -> 
     "1/S_{\\mathrm{sunset}}=1/6", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"75b5f3ec-acd1-8d41-8904-e28ac5e8705c"],
 StyleBox[",",
  FontSize->13],
 StyleBox[" in addition to its two interaction-vertex factors.\n\nTo express \
its contribution, we assign independent loop momenta ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"17b345ca-4349-b14e-b6db-280bbc579458"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[ScriptL]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\ell", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1428194d-8eaf-a749-b30c-80c67d9ae90c"],
 StyleBox[" to two of the internal propagators. Momentum conservation then \
fixes the momentum flowing through the third propagator to be ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "+", "\[ScriptL]", "+", 
         StyleBox["p", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "k+\\ell+p", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"86e7c784-84a4-ba4c-8db1-8871430db251"],
 StyleBox[", where ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"15272388-c8c6-a84e-a643-cfbdcfca4c5b"],
 StyleBox[" is the external Euclidean momentum. The resulting scalar integral \
is\n\n                                                                        \
                                 ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
         SubsuperscriptBox["\[Mu]", 
          StyleBox["R", "TI"], 
          RowBox[{"2", "\[Epsilon]"}]], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], "\[ScriptL]"}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], " ", 
            SuperscriptBox["\[ScriptL]", "2"], " ", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 StyleBox["k", "TI"], "+", "\[ScriptL]", "+", 
                 StyleBox["p", "TI"]}], ")"}], "2"]}]], ",    ", 
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "H(p)=\\mu_R^{2\\epsilon}\n\\int\\frac{d^dk}{(2\\pi)^d}\n\
\\frac{d^d\\ell}{(2\\pi)^d}\n\\frac{1}{k^2\\,\\ell^2\\,(k+\\ell+p)^2},\n\
\\qquad d=4-\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"abdd64dd-8567-bb45-a69f-7176d057b291"],
 "                                                     ",
 StyleBox["(A-72)",
  FontSize->13],
 StyleBox["\n\nHere, the factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox["\[Mu]", 
        StyleBox["R", "TI"], 
        RowBox[{"2", "\[Epsilon]"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mu_R^{2\\epsilon}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e5129465-c3b4-324c-8b69-abea19414dc8"],
 StyleBox[" accounts for the dimensional-regularization scale associated with \
the two independent loop integrations.\nWith the FeynArts coupling denoted by \
\\(g\\), the converted sunset amplitude has the structure:\n\n                \
                                                                              \
                        ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["sunset", FontSlant -> "Plain"]], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           StyleBox["g", "TI"], "2"], 
          RowBox[{"6", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"2", "\[Pi]"}], ")"}], "8"]}]], 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], " ", 
            SuperscriptBox["\[ScriptL]", "2"], " ", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 StyleBox["k", "TI"], "+", "\[ScriptL]", "+", 
                 StyleBox["p", "TI"]}], ")"}], "2"]}]], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal A_{\\mathrm{sunset}}\n=\n\\frac{g^2}{6(2\\pi)^8}\n\
\\frac{1}{k^2\\,\\ell^2\\,(k+\\ell+p)^2},", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cccc48fe-fbe9-634b-aac5-414ff9d153fc"],
 "                                                                            \
     ",
 StyleBox["(A-71)",
  FontSize->13],
 StyleBox["\n\nwhere the two loop integration measures are understood. This \
agrees with the prefactor obtained from ",
  FontSize->13],
 Cell[BoxData["FCFAConvert"],
  FontSize->13,ExpressionUUID->"b858d6aa-e4d6-5d4a-b35a-a8752935eea3"],
 StyleBox[" in Section 2.1.1. The coupling can subsequently be identified \
with the interaction coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Lambda]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2ebc86b8-48f8-3d46-8a4c-b324489471de"],
 StyleBox[" according to the convention established in Part 1.\n\nThe \
integral ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "(", 
         StyleBox["p", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "H(p)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"68bab31b-57a5-404a-8d4e-31d2a868a4be"],
 StyleBox[" is the central object in the two-loop calculation of the \
momentum-dependent part of the 1PI two-point function. Unlike the \
momentum-independent contributions, it depends on the nonzero external scale ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7cfbadef-47fd-0e42-933f-c687e813d464"],
 StyleBox[" and therefore does not vanish as a scaleless integral in \
dimensional regularization. In the next subsection, we evaluate it by \
performing two successive massless one-loop convolutions, obtaining its \
gamma-function representation and Laurent expansion around ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e99a7871-32a4-0d45-b20e-e7cf1e0cb772"],
 StyleBox[".\n\nWith the Euclidean interaction vertex given by ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", "\[Lambda]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "-\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27cd9145-a0da-bc48-9eb4-08c25091c83a"],
 StyleBox[", the two sunset vertices contribute a factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        RowBox[{"(", 
          RowBox[{"-", "\[Lambda]"}], ")"}], "2"], TraditionalForm], 
     "errors" -> {}, "input" -> "(-\\lambda)^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9ca31891-7b8b-f648-8fc4-dc5ac48eacaa"],
 StyleBox[". Including the symmetry factor 1/6, the sunset contribution to \
the two-loop 1PI two-point function is therefore\n\n                          \
                                                                              \
                  ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{
            RowBox[{
              SuperscriptBox["\[CapitalGamma]", 
               RowBox[{"(", "2", ")"}]], "(", 
              StyleBox["p", "TI"], ")"}], "\[VerticalSeparator]"}], 
          StyleBox["sunset", FontSlant -> "Plain"]], "\[Superset]", "-", 
         FractionBox[
          SuperscriptBox["\[Lambda]", "2"], "6"], 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\left.\\Gamma^{(2)}(p) \\right|_{\\mathrm{sunset}}\n\\supset \
-\\frac{\\lambda^2}{6}H(p)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"decd6ce5-12b1-f043-83a5-5f7c6e6f7893"],
 StyleBox["                                                                   \
                                       (A-81)",
  FontSize->13],
 StyleBox["\n\nThe overall minus sign follows from the two-loop expansion of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          SubscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["int", FontSlant -> "Plain"]]}]], TraditionalForm], 
     "errors" -> {}, "input" -> "e^{-S_{\\mathrm{int}}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d560d768-0c85-8a49-a70a-6a8f850c262f"],
 StyleBox[", together with the convention that the tree-level Euclidean \
four-point vertex is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"+", "\[Lambda]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "+\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f5fc87e0-1ebb-8746-a610-aa5dd829ee25"],
 StyleBox[".",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0042628127244015`*^9, 4.004263041009308*^9}, {
  4.004263129732399*^9, 4.0042631417028446`*^9}, {4.004293267346195*^9, 
  4.004293382864895*^9}, {4.004293518074976*^9, 4.004293636084755*^9}, {
  4.0042945927198677`*^9, 4.0042946306698036`*^9}, {4.0042946850757275`*^9, 
  4.0042946952715473`*^9}},ExpressionUUID->"94ba4c54-4514-314a-81c0-\
95ffdc33372f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "sunsetAmplitudeMassless", ",", "sunsetAutomorphismCount", ",", 
    "sunsetSymmetryFactor", ",", "sunsetContractionFactor", ",", 
    "scoopContractionFactor", ",", "sunsetAmplitudePrefactor", ",", 
    "scoopAmplitudePrefactor", ",", "sunsetPrefactorCheck", ",", 
    "scoopPrefactorCheck", ",", "sunsetLoopMeasure", ",", "sunsetIntegrand", ",",
     "sunsetHIntegrand", ",", "sunsetIndex", ",", "classification", ",", 
    "pDependentQ", ",", "momentumDependenceFlags"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{4.004292634406872*^9, 4.0042927858588924`*^9}, {
  4.004293031225769*^9, 4.004293037235691*^9}},
 CellLabel->
  "In[597]:=",ExpressionUUID->"f99a3641-71ea-414f-88c7-765727635915"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Requires", " ", "the", " ", "2.1", ".1", " ", 
     RowBox[{"cell", ":", 
      RowBox[{
      "amplitudes2LMassless", " ", "Here", " ", "p", " ", "is", " ", "the", " ",
        "external", " ", "Euclidean", " ", "momentum", " ", 
       RowBox[{"vector", ".", "The"}], " ", "scalar", " ", "p2"}]}]}], "=", 
    RowBox[{
     RowBox[{"p", "^", "2"}], " ", "is", " ", "introduced", " ", "in", " ", 
     "Section", " ", "2.1", 
     RowBox[{".3", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", 
    RowBox[{
     RowBox[{"Classify", " ", "the", " ", "two"}], "-", 
     RowBox[{"loop", " ", "1", "PI", " ", "diagrams"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pDependentQ", "[", "amp_", "]"}], ":=", 
     RowBox[{"!", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"amp", ",", "p"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"momentumDependenceFlags", "=", 
     RowBox[{"pDependentQ", "/@", "amplitudes2LMassless"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"classification", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"momentumDependenceFlags", "[", 
            RowBox[{"[", "i", "]"}], "]"}], 
           ",", "\"\<depends on p (sunset)\>\"", 
           ",", "\"\<p-independent (double scoop)\>\""}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "amplitudes2LMassless", "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sunsetPositions", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Position", "[", 
       RowBox[{"momentumDependenceFlags", ",", "True"}], "]"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"scoopPositions", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Position", "[", 
       RowBox[{"momentumDependenceFlags", ",", "False"}], "]"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Verify", " ", "that", " ", "exactly", " ", "one", " ", "diagram", " ", 
     "of", " ", "each", " ", "type", " ", "is", " ", 
     RowBox[{"present", "."}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "sunsetPositions", "]"}], "!=", "1"}], "||", 
       RowBox[{
        RowBox[{"Length", "[", "scoopPositions", "]"}], "!=", "1"}]}], ",", 
      RowBox[{
       RowBox[{
       "Print", 
        "[", "\"\<Error: Expected exactly one sunset and one double-scoop \
diagram.\>\"", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sunsetIndex", "=", 
     RowBox[{"First", "[", "sunsetPositions", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"scoopIndex", "=", 
     RowBox[{"First", "[", "scoopPositions", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Number of 1PI two-loop diagrams:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"Length", "[", "amplitudes2LMassless", "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Diagram classification:\>\"", "]"}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{"classification", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Diagram\>\"", ",", "\"\<Momentum dependence\>\""}], 
        "}"}]}], "]"}], ",", 
     RowBox[{"Frame", "->", "All"}]}], "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Sunset index:\>\"", "]"}], ";"}], "\n", 
   "sunsetIndex", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Double-scoop index:\>\"", "]"}], ";"}], "\n", 
   "scoopIndex", "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "2"}], ":", 
     RowBox[{
     "Isolate", " ", "the", " ", "massless", " ", "sunset", " ", 
      "amplitude"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "==="}], "="}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"A", "-", "72"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sunsetAmplitudeMassless", "=", 
     RowBox[{"amplitudes2LMassless", "[", 
