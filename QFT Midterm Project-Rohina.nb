  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"26b48c85-34b5-9943-abab-29c03d6abf17"],
 StyleBox[" channels. These Laurent expansions allow us to isolate the \
divergent poles required for renormalization and establish a direct \
comparison with the cutoff-dependent results obtained in Section 1.2.2.",
  FontSize->13]
}], "Text",
