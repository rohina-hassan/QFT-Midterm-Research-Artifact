         StyleBox["m", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "g_{\\rm FA}=\\lambda,\\qquad m_\\phi=m.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2695aebe-5317-f84f-bb32-471769fabd64"],
 StyleBox["  Here ",
  FontSize->13],
