       FractionBox["1", 
        SuperscriptBox["k0", "2"]]}], ")"}]}], "-", 
    RowBox[{"log", "(", "k0", ")"}]}], 
   RowBox[{"8", " ", 
    SuperscriptBox["\[Pi]", "2"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.0041557068738556`*^9, 4.004157251010729*^9, 
  4.0041723010099354`*^9, 4.0041812059847527`*^9, 4.0041826171548996`*^9, 
  4.004189385578245*^9, 4.004198849446417*^9, 4.0042008518434505`*^9, 
  4.0042014095625286`*^9, 4.004242294842739*^9, 4.004245984952713*^9, 
  4.0042467807008553`*^9, 4.004247239868677*^9, 4.0042476048556957`*^9, 
  4.004250982649393*^9, 4.004291995037422*^9, 4.004299428649912*^9},
 CellLabel->
  "Out[146]//TraditionalForm=",ExpressionUUID->"e026ee4a-9891-7748-a9e6-\
50093327b023"],

Cell[BoxData[
 FormBox["\<\"Coefficient of Log[cutoff]:\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.0041557068738556`*^9, 4.0041572510077496`*^9, 
  4.004172300977564*^9, 4.0041812059847527`*^9, 4.004182617144602*^9, 
  4.004189385575308*^9, 4.0041988494359035`*^9, 4.0042008518434505`*^9, 
  4.0042014095625286`*^9, 4.00424229482559*^9, 4.004245984952713*^9, 
  4.0042467807008553`*^9, 4.004247239868677*^9, 4.0042476048461094`*^9, 
  4.004250982604353*^9, 4.004291995037422*^9, 4.004299428649912*^9},
 CellLabel->
  "During evaluation of \
In[119]:=",ExpressionUUID->"fb958d10-18e8-e641-9fce-6f4a52d58529"],

Cell[BoxData[
 FormBox[
  FractionBox["1", 
   RowBox[{"8", " ", 
    SuperscriptBox["\[Pi]", "2"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.0041557068738556`*^9, 4.004157251010729*^9, 
  4.0041723010099354`*^9, 4.0041812059847527`*^9, 4.0041826171548996`*^9, 
  4.004189385578245*^9, 4.004198849446417*^9, 4.0042008518434505`*^9, 
  4.0042014095625286`*^9, 4.004242294842739*^9, 4.004245984952713*^9, 
  4.0042467807008553`*^9, 4.004247239868677*^9, 4.0042476048556957`*^9, 
  4.004250982649393*^9, 4.004291995037422*^9, 4.004299428649912*^9},
 CellLabel->
  "Out[148]=",ExpressionUUID->"52dde1d5-83c6-b14e-9825-d3d16b52789c"],

Cell[BoxData[
 FormBox["\<\"Coefficient of 1/cutoff^2:\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.0041557068738556`*^9, 4.0041572510077496`*^9, 
  4.004172300977564*^9, 4.0041812059847527`*^9, 4.004182617144602*^9, 
  4.004189385575308*^9, 4.0041988494359035`*^9, 4.0042008518434505`*^9, 
  4.0042014095625286`*^9, 4.00424229482559*^9, 4.004245984952713*^9, 
  4.0042467807008553`*^9, 4.004247239868677*^9, 4.0042476048461094`*^9, 
  4.004250982604353*^9, 4.004291995037422*^9, 4.004299428649912*^9},
 CellLabel->
