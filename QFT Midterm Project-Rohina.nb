Cell[CellGroupData[{

Cell[TextData[StyleBox["1.3 Counterterms and Regulator Independence",
 FontFamily->"Arial",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.19607843137254902`, 0.49411764705882355`, 
   0.4392156862745098]]], "Subsection",
 CellChangeTimes->{{4.003816315375679*^9, 
  4.003816323625513*^9}},ExpressionUUID->"8f899e80-8ea2-6147-8d30-\
5ef042de163d"],

Cell[TextData[{
 StyleBox["In this section, we construct the counterterms necessary to render \
the one-loop theory finite and verify the independence of our physical \
results from the chosen regulator. We begin in 1.3.1 by imposing standard \
renormalization conditions on the two-point and four-point functions, fixing \
the mass, field normalization, and coupling at specified kinematic points. In \
1.3.2, we derive the explicit expressions for the mass counterterm ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta m^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f2efe74e-f687-9446-ab1f-074cd77a5a5c"],
 StyleBox[", the field-strength counterterm ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta Z_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ce025619-5c4f-4b42-9da4-2baaccc7678a"],
 StyleBox[", and the coupling counterterm ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]\[Lambda]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta \\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5a39d833-b88e-6842-b163-2946d8c8cf28"],
 StyleBox[" required to satisfy these conditions in both our regularization \
schemes. Finally, in 1.3.3, we examine the regulator independence of the \
theory by analyzing the convergent difference ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           StyleBox["P", "TI"], ")"}], "-", 
         StyleBox["B", "TI"], 
         RowBox[{"(", "0", ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "B(P) - B(0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"644f8b68-e846-a54d-97dd-634f49b414da"],
 StyleBox[". We demonstrate that the divergent parts of the bubble integrals \
cancel when forming these differences, yielding finite, regulator-independent \
results as the cutoff ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalLambda]", "\[Rule]", "\[Infinity]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\Lambda \\to \\infty", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"37d85e71-c6ae-db47-ad4f-71468f4b62d2"],
 StyleBox[" or ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[Rule]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\varepsilon \\to 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d4371247-82c1-6641-ac47-e76cb73ebb5f"],
 StyleBox[", thereby confirming the physical consistency of the renormalized \
1PI functions.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0041760514770775`*^9, 
  4.0041761108359337`*^9}},ExpressionUUID->"a2d6703e-975f-b040-bd54-\
d0efe15dc9f8"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.3.1 Renormalization Conditions",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.003816332005995*^9, 4.003816359835968*^9}, 
   4.0038174307045403`*^9},ExpressionUUID->"12f1263b-e18f-144c-995c-\
07c49e841cff"],

Cell[TextData[{
 StyleBox["To establish the renormalized parameters of the theory, we impose \
renormalization conditions on the two-point and four-point 1PI functions. \
Following the Euclidean conventions specified in the project brief and ",
  FontSize->13],
 StyleBox["Zamolodchikov",
  FontSize->13,
  FontSlant->"Italic"],
 StyleBox[" \[Section]12, these functions are given at one loop by:\n\n       \
                                                          ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["p", "TI"], "2"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "+", "\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], " ", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "+", "\[Delta]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "+", 
         FractionBox["\[Lambda]", "2"], 
         StyleBox["T", "TI"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\Gamma^{(2)}(p^2)\n=\np^2+m^2+\\delta Z_\\phi\\,p^2\n+\\delta \
m^2+\\frac{\\lambda}{2}T,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2a8da7d3-6dac-ce41-a7c9-f7347277570a"],
 StyleBox["                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "4", ")"}]], "\[LongEqual]", "\[Lambda]", "+", 
         "\[Delta]\[Lambda]", "-", 
         FractionBox[
          SuperscriptBox["\[Lambda]", "2"], "2"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["B", "TI"], 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["P", "TI"], "12"], ")"}], "+", 
             StyleBox["B", "TI"], 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["P", "TI"], "13"], ")"}], "+", 
             StyleBox["B", "TI"], 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["P", "TI"], "14"], ")"}]}], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^{(4)}\n=\n\\lambda+\\delta\\lambda\n-\\frac{\\lambda^2}{2}\n\
\\left[\nB(P_{12})+B(P_{13})+B(P_{14})\n\\right]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b847cdad-19a4-5243-a0cf-32b270ec5529"],
 "                                          ",
 StyleBox["(A-41)",
  FontSize->13],
 StyleBox["\n\nwhere all external momenta are incoming and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["i", "TI"]], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "P_{ij}=p_i+p_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"667ae002-905b-cc4b-9812-a525c2c83755"],
 StyleBox[".\n\nWe fix the mass parameter and field normalization by imposing \
two conditions on the two-point function at zero external momentum:\n \n-",
  FontSize->13],
 StyleBox["The mass renormalization",
  FontSize->13,
  FontSlant->"Italic"],
 StyleBox[" condition is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Gamma^{(2)}(0)=m^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8e12d075-0c54-7a4b-9c11-90777a28d7c7"],
 StyleBox[", which ensures that the renormalized inverse propagator \
reproduces the prescribed mass parameter at the subtraction point. (A-42)\n-",
  FontSize->13],
 StyleBox["The field-strength renormalization",
  FontSize->13,
  FontSlant->"Italic"],
 StyleBox[" condition is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{
            FractionBox[
             RowBox[{"\[PartialD]", 
               SuperscriptBox["\[CapitalGamma]", 
                RowBox[{"(", "2", ")"}]], 
               RowBox[{"(", 
                 SuperscriptBox[
                  StyleBox["p", "TI"], "2"], ")"}]}], 
             RowBox[{"\[PartialD]", 
               SuperscriptBox[
                StyleBox["p", "TI"], "2"]}]], "\[VerticalSeparator]"}], 
          RowBox[{
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], "\[LongEqual]", "0"}]], 
         "\[LongEqual]", "1"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\left.\n\\frac{\\partial\\Gamma^{(2)}(p^2)}\n{\\partial p^2}\n\
\\right|_{p^2=0}=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->12,ExpressionUUID->"4c6ab655-5587-7442-a979-d933be8973c6"],
 StyleBox[",",
  FontSize->12],
 StyleBox["  which fixes the normalization of the kinetic term at the same \
subtraction point. (A-43)\n-",
  FontSize->13],
 StyleBox["The renormalized coupling",
  FontSize->13,
  FontSlant->"Italic"],
 StyleBox[" is determined by imposing the zero-momentum subtraction condition \
on the four-point function: ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SuperscriptBox["\[CapitalGamma]", 
           RowBox[{"(", "4", ")"}]], 
          RowBox[{"(", "0", ")"}], "\[LongEqual]", "\[Lambda]"}], 
        TraditionalForm], "errors" -> {}, "input" -> 
      "\\Gamma^{(4)}(0)=\\lambda", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "."}], TraditionalForm]],
  FontSize->13,ExpressionUUID->"53b414b9-c508-af4d-b59d-2a6e5a5b08cc"],
 StyleBox["  Here, all external momenta are set to zero, so that each of the \
three bubble contributions is evaluated at zero momentum transfer. (A-44)\n\n\
These three renormalization conditions are imposed independently in the sharp \
momentum-cutoff and dimensional-regularization schemes. They determine the \
counterterms ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta m^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"eb5d89f9-2f58-094e-851b-816b874305a5"],
 StyleBox[", ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta Z_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0652ce80-a5ac-2d47-9e8e-1c563a4c89ff"],
 StyleBox[", and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]\[Lambda]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0ef92752-900e-1940-9cfd-9533521b0ab2"],
 StyleBox[", whose explicit expressions are derived in the next subsection. \
We subsequently compare the momentum-dependent difference ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           StyleBox["P", "TI"], ")"}], "-", 
         StyleBox["B", "TI"], 
         RowBox[{"(", "0", ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "B(P)-B(0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"32a5ad04-8bdb-5745-b1e3-3d31f0449531"],
 StyleBox[" and its derivative at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["P", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "P^2=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"aedd81f8-fb41-4e48-824c-794b26dcabff"],
 StyleBox[" to investigate the regulator independence of the renormalized \
results.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004176394155489*^9, 4.0041765277181416`*^9}, {
  4.004176565285343*^9, 4.0041767967251587`*^9}, {4.004252283629854*^9, 
  4.0042523291551304`*^9}, {4.0042523629726677`*^9, 4.004252363149006*^9}, {
  4.0042524256656075`*^9, 
  4.0042524286551476`*^9}},ExpressionUUID->"e003e783-203d-1640-867f-\
6f0790b79374"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "psq", ",", "dZm2", ",", "dZphi", ",", "dLam", ",", "Treg", ",", "Breg", ",",
      "Gamma2", ",", "Gamma4"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"A", "-", "41"}], ":", 
     RowBox[{"one", "-", 
      RowBox[{"loop", " ", "1", "PI", " ", "functions", " ", "with", " ", 
       RowBox[{"counterterms", ".", "Treg"}]}]}]}], ",", 
    RowBox[{"Breg", "=", 
     RowBox[{"regulated", " ", "tadpole", " ", "and", " ", "bubble", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"T_Lambda", ",", 
         RowBox[{"B_Lambda", " ", "or", " ", "T_DR"}], ",", "B_DR"}], ")"}], 
       "."}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Gamma2", "[", "psq_", "]"}], ":=", 
   RowBox[{"psq", "+", "m2", "+", 
    RowBox[{"dZphi", " ", "psq"}], "+", "dZm2", "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"lam", "/", "2"}], ")"}], " ", "Treg"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Gamma4", "[", 
     RowBox[{"P12sq_", ",", "P13sq_", ",", "P14sq_"}], "]"}], ":=", 
    RowBox[{"lam", "+", "dLam", "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"lam", "^", "2"}], "/", "2"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Breg", "[", "P12sq", "]"}], "+", 
        RowBox[{"Breg", "[", "P13sq", "]"}], "+", 
        RowBox[{"Breg", "[", "P14sq", "]"}]}], ")"}]}]}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Renormalization", " ", 
     RowBox[{"conditions", ":", 
      RowBox[{"A", "-", 
       RowBox[{"42", " ", 
        RowBox[{"(", "mass", ")"}]}]}]}]}], ",", 
    RowBox[{"A", "-", 
     RowBox[{"43", " ", 
      RowBox[{"(", "field", ")"}]}]}], ",", 
    RowBox[{"A", "-", 
     RowBox[{"44", " ", 
      RowBox[{"(", "coupling", ")"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"massCond", "=", 
   RowBox[{
    RowBox[{"Gamma2", "[", "0", "]"}], "==", "m2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fieldCond", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"Gamma2", "[", "psq", "]"}], ",", "psq"}], "]"}], "/.", " ", 
      RowBox[{"psq", "->", "0"}]}], ")"}], "==", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coupCond", "=", 
    RowBox[{
     RowBox[{"Gamma4", "[", 
      RowBox[{"0", ",", "0", ",", "0"}], "]"}], "==", "lam"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Counterterms", ":", 
     RowBox[{"A", "-", "45"}]}], ",", 
    RowBox[{"A", "-", "46"}], ",", 
    RowBox[{"A", "-", "47"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"ctSolutions", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"massCond", ",", "fieldCond", ",", "coupCond"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"dZm2", ",", "dZphi", ",", "dLam"}], "}"}]}], "]"}], "//", 
    "FullSimplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dZm2Final", "=", 
   RowBox[{"dZm2", "/.", " ", 
    RowBox[{"First", "[", "ctSolutions", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dZphiFinal", "=", 
   RowBox[{"dZphi", "/.", " ", 
    RowBox[{"First", "[", "ctSolutions", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dLamFinal", "=", 
    RowBox[{"dLam", "/.", " ", 
     RowBox[{"First", "[", "ctSolutions", "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Mass counterterm (dZm2):\>\"", "]"}], ";", 
  RowBox[{"TraditionalForm", "[", "dZm2Final", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Field-strength counterterm (dZphi):\>\"", "]"}], 
  ";", 
  RowBox[{"TraditionalForm", "[", "dZphiFinal", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<Coupling counterterm (dLam):\>\"", "]"}], ";", 
   RowBox[{"TraditionalForm", "[", "dLamFinal", "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"renormChecks", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Gamma2", "[", "0", "]"}], "-", "m2"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Gamma2", "[", "psq", "]"}], ",", "psq"}], "]"}], "/.", 
          " ", 
          RowBox[{"psq", "->", "0"}]}], ")"}], "-", "1"}], ",", 
       RowBox[{
        RowBox[{"Gamma4", "[", 
         RowBox[{"0", ",", "0", ",", "0"}], "]"}], "-", "lam"}]}], "}"}], "/.",
      " ", 
     RowBox[{"First", "[", "ctSolutions", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Renormalization checks (expected: {0, 0, 0}):\>\"", 
   "]"}], ";"}], "\n", "renormChecks"}], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{4.004177142304695*^9, 4.0041771908647995`*^9}, {
  4.0041774308143864`*^9, 4.0041774396963253`*^9}, {4.004177520483919*^9, 
  4.004177542703974*^9}, {4.0042491614605446`*^9, 4.0042492170388947`*^9}},
 Background->GrayLevel[0.753],
 CellLabel->
  "In[240]:=",ExpressionUUID->"fa7795bc-6f2d-7e45-9af8-f3c98031a589"],

Cell[BoxData[
 FormBox["\<\"Mass counterterm (dZm2):\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.0041771956647797`*^9, 4.0041775596141834`*^9, 
  4.0041815161953564`*^9, 4.0041828255732*^9, 4.004189587422308*^9, 
  4.004199047350748*^9, 4.0042492261888294`*^9, 4.0042510345736294`*^9, 
  4.0042920874397507`*^9, 4.004299490401867*^9},
 CellLabel->
