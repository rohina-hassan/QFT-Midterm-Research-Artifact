       RowBox[{"(", 
        RowBox[{"512", " ", 
         RowBox[{"Pi", "^", "4"}]}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sunsetFiniteCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"sunsetFinitePart", "-", "sunsetExpectedFinitePart"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
