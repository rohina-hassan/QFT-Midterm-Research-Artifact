Cell[CellGroupData[{

Cell[TextData[StyleBox["2.2.3 Anomalous Dimension",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.5254901960784314, 0.3843137254901961, 
   0.49019607843137253`]]], "Subsubsection",
 CellChangeTimes->{{4.004295298482975*^9, 
  4.004295310212393*^9}},ExpressionUUID->"92fbb99e-d83d-924c-b683-\
8811c68e3ce1"],

Cell[TextData[{
 StyleBox["Having determined the field-strength renormalization constant in \
Section 2.2.2, we now calculate the field anomalous dimension. It is defined \
by the renormalization-scale dependence of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Z", "TI"], "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "Z_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"edf2f51a-7c81-dc41-9439-6ca842242b37"],
 StyleBox[" at fixed bare parameters:\n\n                                     \
                                                                           ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Gamma]", "\[Phi]"], 
         RowBox[{"(", 
           StyleBox["g", "TI"], ")"}], "\[LongEqual]", 
         FractionBox["1", "2"], 
         SubscriptBox["\[Mu]", 
          StyleBox["R", "TI"]], 
         FractionBox[
          StyleBox["d", "TI"], 
          RowBox[{
            StyleBox["d", "TI"], 
            SubscriptBox["\[Mu]", 
             StyleBox["R", "TI"]]}]], "ln", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["g", "TI"], ",", "\[Epsilon]"}], ")"}], 
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            StyleBox["g", "TI"]}]], "ln", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\gamma_\\phi(g)\n=\\frac{1}{2}\\mu_R\\frac{d}{d\\mu_R}\\ln Z_\\phi\n\
=\\frac{1}{2}\\beta_g(g,\\epsilon)\n\\frac{\\partial}{\\partial g}\\ln \
Z_\\phi,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e9529cb1-bed7-824f-ad7d-7a468b6f5410"],
 StyleBox["\n\nwhere the d-dimensional beta function is:\n\n                  \
                                                                              \
                  ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["g", "TI"], ",", "\[Epsilon]"}], ")"}], "\[LongEqual]", 
         SubscriptBox["\[Mu]", 
          StyleBox["R", "TI"]], 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["g", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            SubscriptBox["\[Mu]", 
             StyleBox["R", "TI"]]}]], 
         SubscriptBox["|", "bare"], "\[LongEqual]", "-", "\[Epsilon]", 
         StyleBox["g", "TI"], "+", "3", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\beta_g(g,\\epsilon)\n=\\mu_R\\frac{dg}{d\\mu_R}\\bigg|_{\\text{bare}}\
\n=-\\epsilon g+3g^2+O(g^3).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ddc43191-0452-ec4e-b19a-acb7dc6a802a"],
 StyleBox["                                                                   \
                 (A-88)\n\nFrom Section 2.2.2, the field-strength \
renormalization constant in the minimal-subtraction scheme is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", "1", "-", 
         FractionBox[
          SuperscriptBox[
           StyleBox["g", "TI"], "2"], 
          RowBox[{"12", "\[Epsilon]"}]], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "Z_\\phi=1-\\frac{g^2}{12\\epsilon}+O(g^3).", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1d3b68da-5129-be48-9397-586732fabcea"],
 StyleBox[" Substituting this expression into the definition of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\gamma_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"66fbb2fd-a507-5e4f-9065-15fdee906b8c"],
 StyleBox[" (A-89), and retaining terms through order ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["g", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "g^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"eac31ace-c3b6-5b48-94b0-caa59ea1c8c4"],
 StyleBox[", gives:\n\n                                                       \
                        ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Gamma]", "\[Phi]"], 
         RowBox[{"(", 
           StyleBox["g", "TI"], ")"}], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"-", "\[Epsilon]", 
             StyleBox["g", "TI"], "+", "3", 
             SuperscriptBox[
              StyleBox["g", "TI"], "2"]}], ")"}], 
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            StyleBox["g", "TI"]}]], 
         RowBox[{"[", 
           RowBox[{"-", 
             FractionBox[
              SuperscriptBox[
               StyleBox["g", "TI"], "2"], 
              RowBox[{"12", "\[Epsilon]"}]], "+", 
             StyleBox["O", "TI"], 
             RowBox[{"(", 
               SuperscriptBox[
                StyleBox["g", "TI"], "3"], ")"}]}], "]"}], "\n"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma_\\phi(g)\n=\\frac{1}{2}(-\\epsilon g+3g^2)\n\
\\frac{\\partial}{\\partial g}\n\\left[-\\frac{g^2}{12\\epsilon}+O(g^3) \
\\right]\\\\", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4e677156-28f3-db47-8410-d0b70b7c958d"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"-", "\[Epsilon]", 
             StyleBox["g", "TI"], "+", "3", 
             SuperscriptBox[
              StyleBox["g", "TI"], "2"]}], ")"}], 
         RowBox[{"[", 
           RowBox[{"-", 
             FractionBox[
              StyleBox["g", "TI"], 
              RowBox[{"6", "\[Epsilon]"}]], "+", 
             StyleBox["O", "TI"], 
             RowBox[{"(", 
               SuperscriptBox[
                StyleBox["g", "TI"], "2"], ")"}]}], "]"}], "\n"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "=\\frac{1}{2}(-\\epsilon g+3g^2)\n\\left[-\\frac{g}{6\\epsilon}+O(g^2) \
\\right]\\\\", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"bd104199-f18d-0e40-9a8d-177f9d2f54c4"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           StyleBox["g", "TI"], "2"], "12"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "=\\frac{g^2}{12}+O(g^3).", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ceaa5b5c-dd99-db49-ab84-e69bc6e95cb3"],
 StyleBox["                                (A-90)\nThus, the two-loop field \
anomalous dimension is:\n\n                                                   \
                                                                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Gamma]", "\[Phi]"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"-", "\[Epsilon]", 
             StyleBox["g", "TI"], "+", "3", 
             SuperscriptBox[
              StyleBox["g", "TI"], "2"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"-", 
             FractionBox[
              StyleBox["g", "TI"], 
              RowBox[{"6", "\[Epsilon]"}]]}], ")"}], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           StyleBox["g", "TI"], "2"], "12"], "-", 
         FractionBox[
          SuperscriptBox[
           StyleBox["g", "TI"], "3"], 
          RowBox[{"4", "\[Epsilon]"}]], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "4"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\gamma_\\phi=\\frac12\\left(-\\epsilon \
g+3g^2\\right)\\left(-\\frac{g}{6\\epsilon}\\right)=\\frac{g^2}{12}-\\frac{g^\
3}{4\\epsilon}+O(g^4)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"078ee7fc-161d-ff4b-84e9-8664d86f3525"],
 StyleBox["\n\nThe explicit ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Epsilon]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"fb724bd5-0812-e246-8d7c-fac435df92bb"],
 StyleBox[" pole cancels at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "O(g^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3607a4c0-8f7a-d048-af75-9e58ee03375e"],
 StyleBox[", which is the order computed here. The ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["g", "TI"], "3"], "/", "\[Epsilon]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "g^3/\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c28cbfaf-b0b5-5840-b5d2-41e506fa5315"],
 StyleBox[" term is cancelled by the double-pole part of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Z", "TI"], "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "Z_\\phi$ at $O(g^3)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"61abf11a-9d7e-3544-ad27-e3babd8409e9"],
 StyleBox[", which lies beyond the order of this calculation. Finiteness \
holds order by order in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9fffed59-4f1f-c643-baef-34ef845a19ce"],
 StyleBox[", not for the truncated ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Z", "TI"], "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "Z_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"da18c9b5-8a5c-8742-ad56-f1215243807b"],
 StyleBox[" at fixed ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e70e8bbb-ab21-8d44-ab3c-fd388368545d"],
 StyleBox[".\n\nFinally, using the Wilson\[Dash]Fisher fixed point obtained \
in Part 1, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "*"], "\[LongEqual]", 
         FractionBox["\[Epsilon]", "3"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "2"], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> "g_*=\\frac{\\epsilon}{3}+O(\\epsilon^2),", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d67f32b0-b6d6-7949-82e0-828af5c3ac87"],
 StyleBox[" we can evaluate the anomalous dimension at criticality. This \
fixed-point value will determine the critical exponent ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ff0fca45-6143-f244-8e0c-303f308e90c2"],
 StyleBox[" in the next subsection.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004296970003086*^9, 4.004297066540159*^9}, {
  4.004297109015169*^9, 4.0042971929509277`*^9}, {4.004297489910885*^9, 
  4.0042976830393505`*^9}},ExpressionUUID->"cdf9c285-7788-e643-b297-\
41e76e22728e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Conventions", ":", "d"}], "=", 
     RowBox[{"4", "-", "e"}]}], ",", 
    RowBox[{"g", "=", 
     RowBox[{"lam", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"16", " ", 
         RowBox[{"Pi", "^", "2"}]}], ")"}], "."}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Step"}]}], " ", "1"}], ":", 
    RowBox[{
     RowBox[{"define", " ", "the", " ", "d"}], "-", 
     RowBox[{"dimensional", " ", "beta", " ", 
      RowBox[{"function", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"betaGDimensionallyContinued", "=", 
     RowBox[{"FullSimplify", "[", "betaD", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "2"}], ":", 
     RowBox[{
      RowBox[{"define", " ", "the", " ", "field", " ", "anomalous", " ", 
       RowBox[{"dimension", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"gamma_phi", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], " ", "beta_g", " ", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"Log", "[", "Z_phi", "]"}], "]"}], "/", "dg"}]}]}], ",", 
     RowBox[{
     "with", " ", "the", " ", "bare", " ", "parameters", " ", "held", " ", 
      RowBox[{"fixed", "."}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gammaPhiExact", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "betaGDimensionallyContinued", " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Log", "[", "ZphiMS", "]"}], ",", "g"}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "3"}], ":", 
     RowBox[{
      RowBox[{"expand", " ", "through", " ", "two"}], "-", 
      RowBox[{"loop", " ", 
       RowBox[{"order", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"gammaPhiSeries", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Series", "[", 
       RowBox[{"gammaPhiExact", ",", 
        RowBox[{"{", 
         RowBox[{"g", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gammaPhi", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Normal", "[", "gammaPhiSeries", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "4"}], ":", 
     RowBox[{
      RowBox[{"extract", " ", "the", " ", "two"}], "-", 
      RowBox[{"loop", " ", 
       RowBox[{"coefficient", "--"}]}], "-"}]}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"gammaPhiTwoLoopCoefficient", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"SeriesCoefficient", "[", 
       RowBox[{"gammaPhi", ",", 
        RowBox[{"{", 
         RowBox[{"g", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gammaPhiExpected", "=", 
     RowBox[{
      RowBox[{"g", "^", "2"}], "/", "12"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gammaPhiCoefficientCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"gammaPhi", "-", "gammaPhiExpected"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "5"}], ":", 
     RowBox[{
      RowBox[{
      "pole", " ", "structure", " ", "order", " ", "by", " ", "order", " ", 
       "in", " ", 
       RowBox[{"g", "--"}]}], "-"}]}], "*)"}], 
   RowBox[{
    RowBox[{"gammaPhiCoefficients", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{"SeriesCoefficient", "[", 
         RowBox[{"gammaPhiExact", ",", 
          RowBox[{"{", 
           RowBox[{"g", ",", "0", ",", "n"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gammaPhiPoleCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"gammaPhiCoefficients", "-", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"1", "/", "12"}], ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", 
          RowBox[{"(", 
           RowBox[{"4", " ", "e"}], ")"}]}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gammaPhiFiniteAtTwoLoops", "=", 
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"gammaPhiCoefficients", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", "e"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "6"}], ":", 
     RowBox[{
      RowBox[{"display", " ", "the", " ", 
       RowBox[{"results", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Dimensionally continued beta function:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"betaGDimensionallyContinued", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Exact anomalous-dimension expression:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"gammaPhiExact", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Anomalous dimension through O(g^2):\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{"gammaPhi", "//", "TraditionalForm"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Two-loop coefficient:\>\"", "]"}], ";"}], "\n", 
   RowBox[{"gammaPhiTwoLoopCoefficient", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Coefficients of g, g^2, g^3 (expected: 0, 1/12, \
-1/(4e)):\>\"", "]"}], ";"}], "\n", 
   RowBox[{"gammaPhiCoefficients", "//", "TraditionalForm"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "7"}], ":", 
     RowBox[{
      RowBox[{"final", " ", "consistency", " ", 
       RowBox[{"checks", "--"}]}], "-"}]}], "*)"}], 
   RowBox[{
    RowBox[{"anomalousDimensionChecks", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"betaGDimensionallyContinued", "-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "e"}], " ", "g"}], "+", 
            RowBox[{"3", " ", 
             RowBox[{"g", "^", "2"}]}]}], ")"}]}], "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"gammaPhi", "-", 
          RowBox[{
           RowBox[{"g", "^", "2"}], "/", "12"}]}], "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"gammaPhiTwoLoopCoefficient", "-", 
          RowBox[{"1", "/", "12"}]}], "]"}], "==", "0"}], ",", 
       RowBox[{"gammaPhiPoleCheck", "==", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
       "gammaPhiFiniteAtTwoLoops"}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Final anomalous-dimension checks (expected: all True):\
\>\"", "]"}], ";"}], "\n", "anomalousDimensionChecks"}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{4.00429721045133*^9, 4.004297233320053*^9}, {
  4.0042972643852882`*^9, 4.0042972808332195`*^9}, {4.0042973204296455`*^9, 
  4.00429734155567*^9}, {4.0042973856900806`*^9, 4.004297410242346*^9}},
 Background->GrayLevel[0.753],
 CellLabel->
  "In[707]:=",ExpressionUUID->"ee0bf4b8-614f-444c-934e-89eb0c62b154"],

Cell[BoxData[
 FormBox["\<\"Dimensionally continued beta function:\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004297423649502*^9, 4.004299647846527*^9},
 CellLabel->
  "During evaluation of \
In[707]:=",ExpressionUUID->"771b89fc-7cd8-3d4a-8076-35879bb51fe3"],

Cell[BoxData[
 FormBox[
  RowBox[{"g", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"3", " ", "g"}], "-", "e"}], ")"}]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.004297423659954*^9, 4.0042996478568935`*^9},
 CellLabel->
  "Out[718]//TraditionalForm=",ExpressionUUID->"c54b232a-5590-1b49-b47d-\
07b1c254702f"],

Cell[BoxData[
 FormBox["\<\"Exact anomalous-dimension expression:\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004297423649502*^9, 4.00429964786022*^9},
 CellLabel->
  "During evaluation of \
In[707]:=",ExpressionUUID->"350595b9-8aa9-0c40-932e-bf2d2dd98193"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    SuperscriptBox["g", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"e", "-", 
      RowBox[{"3", " ", "g"}]}], ")"}]}], 
   RowBox[{
    RowBox[{"12", " ", "e"}], "-", 
    SuperscriptBox["g", "2"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.004297423659954*^9, 4.00429964786022*^9},
 CellLabel->
  "Out[720]//TraditionalForm=",ExpressionUUID->"f1dc3f21-923b-9a49-91af-\
3a3af0cf874d"],

Cell[BoxData[
 FormBox["\<\"Anomalous dimension through O(g^2):\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004297423649502*^9, 4.00429964786022*^9},
 CellLabel->
  "During evaluation of \
In[707]:=",ExpressionUUID->"f04ba487-22de-2e48-901e-09252b645b1e"],

Cell[BoxData[
 FormBox[
  FractionBox[
   SuperscriptBox["g", "2"], "12"], TraditionalForm]], "Output",
