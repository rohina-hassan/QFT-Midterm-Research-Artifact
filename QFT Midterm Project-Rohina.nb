  FontSize->13,ExpressionUUID->"ddfac1c7-b0dd-094c-906e-0b1d21080390"],
 StyleBox[" also contributes only at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox["\[Epsilon]", "3"], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(\\epsilon^3)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d3489b29-53b9-ec4c-9e71-62fedbbdac07"],
 StyleBox[". Hence the one-loop ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "*"], "\[LongEqual]", "\[Epsilon]", "/", "3"}],
        TraditionalForm], "errors" -> {}, "input" -> "g_*=\\epsilon/3", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"03da9407-7077-3b4d-bf07-edf9ba93c7a0"],
 StyleBox[" is sufficient for ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c56772ff-499d-9f44-8b03-20d265e25420"],
 StyleBox[" through ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox["\[Epsilon]", "2"], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(\\epsilon^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"45a2ab1c-9dce-794f-8f5e-24f97028fff3"],
 StyleBox[".\n\nAs an independent consistency check, we examine the \
logarithmic momentum dependence of the renormalized two-point function. \
Expanding the factor that governs the critical scaling,",
  FontSize->13],
 StyleBox[" ",
  FontSize->11],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], ")"}], 
          RowBox[{"-1", "+", "\[Eta]", "/", "2"}]], "\[LongEqual]", 
         FractionBox["1", 
          SuperscriptBox[
           StyleBox["p", "TI"], "2"]], "exp", 
         RowBox[{"(", 
           RowBox[{
             FractionBox["\[Eta]", "2"], "ln", 
             SuperscriptBox[
              StyleBox["p", "TI"], "2"]}], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "(p^2)^{-1+\\eta/2}\n=\\frac{1}{p^2}\n\\exp\\left(\\frac{\\eta}{2}\\ln \
p^2\\right),", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"36e68889-8c99-4545-8b1b-bf6f207b6820"],
 StyleBox[" and retaining terms through ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox["\[Epsilon]", "2"], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(\\epsilon^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"fb5bc61b-22de-ec40-9eb8-e425d663d483"],
 StyleBox[", gives:\n\n                                                       \
                                                       ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], ")"}], 
          RowBox[{"-1", "+", "\[Eta]", "/", "2"}]], "\[LongEqual]", 
         FractionBox["1", 
          SuperscriptBox[
           StyleBox["p", "TI"], "2"]], 
         RowBox[{"[", 
           RowBox[{"1", "+", 
             FractionBox["\[Eta]", "2"], "ln", 
             SuperscriptBox[
              StyleBox["p", "TI"], "2"], "+", 
             StyleBox["O", "TI"], 
             RowBox[{"(", 
               SuperscriptBox["\[Epsilon]", "4"], ")"}]}], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "(p^2)^{-1+\\eta/2}\n=\\frac{1}{p^2}\n\\left[\n1+\\frac{\\eta}{2}\\ln \
p^2+O(\\epsilon^4)\n\\right]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b7ba0bc4-05bf-9b41-a1e8-b3f67231ac03"],
 StyleBox["                                                                   \
                                           (A-93)\n\nThus, the coefficient of \
the logarithmic momentum dependence must agree with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "/", "2"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\eta/2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b6a6b779-4c92-7b40-9ded-90de2789b128"],
 StyleBox[". Since ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4996b231-0880-464d-81e9-60962c3e9391"],
 StyleBox[" first appears at order ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Epsilon]", "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\epsilon^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e86ab2f2-a68c-2f4b-b1fc-86034f28aa7f"],
 StyleBox[", this provides a useful check of the two-loop momentum-dependent \
contribution and its field-strength renormalization. The counterterm ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], " ", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\delta Z_\\phi\\,p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b7bd3677-3035-204c-b524-5d8808c4d792"],
 StyleBox[" is a polynomial in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"753fcc4c-984c-7d46-8f61-a010dc5f2703"],
 StyleBox[", so it cannot change the coefficient of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"ln", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\ln p^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c7c3868f-ba44-994b-bd09-b38a44c5b9c9"],
 StyleBox[". The logarithm therefore comes entirely from the finite part of \
the sunset, and its coefficient is fixed by the pole through the scaling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        RowBox[{"(", 
          RowBox[{
            SubsuperscriptBox["\[Mu]", 
             StyleBox["R", "TI"], "2"], "/", 
            SuperscriptBox[
             StyleBox["p", "TI"], "2"]}], ")"}], "\[Epsilon]"], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "(\\mu_R^2/p^2)^{\\epsilon}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1b28f80f-6e23-574d-9e8e-3158dbdc7d6a"],
 StyleBox[" of the two-loop integral. (A-94)\nThis agreement provides an \
independent consistency check between the renormalization-group calculation \
and the momentum-space scaling form of the critical propagator.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0042977522797318`*^9, 4.0042979863494987`*^9}, {
