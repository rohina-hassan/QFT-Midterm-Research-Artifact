Cell[CellGroupData[{

Cell[TextData[StyleBox["2.2.4 Critical Exponent and Logarithmic Consistency \
Check",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.5254901960784314, 0.3843137254901961, 
   0.49019607843137253`]]], "Subsubsection",
 CellChangeTimes->{{4.0042953321250553`*^9, 
  4.0042953494628677`*^9}},ExpressionUUID->"e6ca793a-ddab-d24f-96ca-\
ddde02a04a51"],

Cell[TextData[{
 StyleBox["We now evaluate the field anomalous dimension at the \
Wilson\[Dash]Fisher fixed point to obtain the critical exponent ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"93ab5013-4c29-3f42-9670-977aa5d03d98"],
 StyleBox[". The anomalous dimension modifies the scaling of the critical \
two-point function according to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["G", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[Proportional]", 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
             SuperscriptBox[
              StyleBox["p", "TI"], "2"], ")"}], 
           RowBox[{"1", "-", "\[Eta]", "/", "2"}]]], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> "G(p)\\propto \\frac{1}{(p^2)^{1-\\eta/2}},", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0be2ae67-3625-9d45-a5c8-29ee8f088ae0"],
 StyleBox[" where, with our convention for the field anomalous dimension, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", "2", 
         SubscriptBox["\[Gamma]", "\[Phi]"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["g", "TI"], "*"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\eta=2\\gamma_\\phi(g_*).", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"02ad1df0-6ca0-9948-b391-e33b533f5924"],
 StyleBox["\nUsing the two-loop result from Section 2.2.3, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Gamma]", "\[Phi]"], 
         RowBox[{"(", 
           StyleBox["g", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           StyleBox["g", "TI"], "2"], "12"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\gamma_\\phi(g)=\\frac{g^2}{12}+O(g^3),", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a2029616-ee50-e440-bfe2-54720c99b124"],
 StyleBox[" and the Wilson\[Dash]Fisher fixed point obtained in Part 1, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "*"], "\[LongEqual]", 
         FractionBox["\[Epsilon]", "3"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "2"], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> "g_*=\\frac{\\epsilon}{3}+O(\\epsilon^2),", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"91fde772-0707-d54d-83ed-2fa25b8e6ad1"],
 StyleBox["(A-91) we find:\n\n                                                \
                                                                ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"\[Eta]", "\[LongEqual]", "2", 
          SubscriptBox["\[Gamma]", "\[Phi]"], 
          RowBox[{"(", 
            SubscriptBox[
             StyleBox["g", "TI"], "*"], ")"}]}], TraditionalForm], 
      "errors" -> {}, "input" -> "\\eta\n&=2\\gamma_\\phi(g_*)", "state" -> 
      "Boxes"|>,
     "TeXAssistantTemplate"], "="}], TraditionalForm]],
  FontSize->13,ExpressionUUID->"db6401da-efb2-d741-bb45-012b00554d3a"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          SubsuperscriptBox[
           StyleBox["g", "TI"], "*", "2"], "6"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SubsuperscriptBox[
            StyleBox["g", "TI"], "*", "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\frac{g_*^2}{6}+O(g_*^3)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e44c2687-3652-f943-9235-77f85a350fae"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LongEqual]", 
         FractionBox[
          SuperscriptBox["\[Epsilon]", "2"], "54"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "=\\frac{\\epsilon^2}{54}+O(\\epsilon^3)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3199b79e-6aab-b846-bedb-c0c29a597a7d"],
 StyleBox["                                                                   \
                                      (A-92)\n\nTherefore, the anomalous \
critical exponent is:\n\n                                                     \
                                                                              \
     ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", 
         FractionBox[
          SuperscriptBox["\[Epsilon]", "2"], "54"], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\eta=\\frac{\\epsilon^2}{54}+O(\\epsilon^3)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e159bc17-b0e1-614b-ae0b-df888eeae5fd"],
 StyleBox["\n\nSince ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\gamma_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"00a7a231-139d-f540-b77a-d5e957bc4f33"],
 StyleBox[" starts at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "O(g^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4395b6f6-ee8e-d640-be31-b2ebe8eb6a39"],
 StyleBox[", we have ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["g", "TI"], "*", "2"], "/", "6", "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SubsuperscriptBox[
            StyleBox["g", "TI"], "*", "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\eta=g_*^2/6+O(g_*^3)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0ffd5c10-0821-3f43-9552-a797681c4f31"],
 StyleBox[". The two-loop beta function",
  FontSize->13],
 StyleBox[" ",
  FontSize->11],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Beta]", 
          StyleBox["g", "TI"]], "\[LongEqual]", "-", "\[Epsilon]", 
         StyleBox["g", "TI"], "+", "3", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "-", 
         FractionBox["17", "3"], 
         SuperscriptBox[
          StyleBox["g", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\beta_g=-\\epsilon g+3g^2-\\frac{17}{3}g^3", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"647e197b-b2d5-d243-abe3-ea2282a5ff05"],
 StyleBox[" shifts the fixed point to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "*"], "\[LongEqual]", 
