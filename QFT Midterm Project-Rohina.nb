Cell[TextData[StyleBox["Section 1.1\[LongDash]Verification Summary",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.6509803921568628, 0.7137254901960784, 
   0.7686274509803922]]], "Subsubsection",
 CellChangeTimes->{
  4.004204341849493*^9, {4.0042043865092945`*^9, 
   4.0042043876796303`*^9}},ExpressionUUID->"8f94b524-2fc0-484f-a2b1-\
94ef3bf74c24"],

Cell[TextData[{
 StyleBox["Question:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nWhat do the one-loop Feynman diagrams give, and how do their \
contributions map onto the Euclidean two-point and  four-point \n1PI \
functions,  ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{"(", "2", ")"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^{(2)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d8cbe659-b3f3-e942-840a-fcb95a6e4a69"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[CapitalGamma]", 
        RowBox[{"(", "4", ")"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma^{(4)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"da5d05ff-d0b4-be42-9391-bdf97c2fb709"],
 StyleBox["?        \n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------  ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["                                         \n",
  FontSize->13],
 StyleBox["Derivation:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nSections 1.1.1\[Dash]1.1.7, with the Euclidean matching carried \
out in Section 1.1.5. \n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\n",
  FontSize->13],
 StyleBox["Check:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nOut[108] and Out[110] both evaluate to zero, confirming the \
corresponding consistency checks. \n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------",
