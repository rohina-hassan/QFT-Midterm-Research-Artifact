Cell[CellGroupData[{

Cell[TextData[StyleBox["1.2 Cutoff and Dimensional Regularization",
 FontFamily->"Arial",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.19607843137254902`, 0.49411764705882355`, 
   0.4392156862745098]]], "Subsection",
 CellChangeTimes->{{4.0038162163160515`*^9, 
  4.0038162237090015`*^9}},ExpressionUUID->"fcd1d356-6a70-5143-a429-\
b8f6fe7db674"],

Cell[TextData[{
 StyleBox["In this section, we evaluate the loop integrals defined in Section \
1.1 using two distinct regularization schemes : the sharp momentum cutoff and \
dimensional regularization (DR) . We begin in 1.2.1 by formally defining the \
massive tadpole and bubble integrals that form the basis of our one-loop \
calculations . In 1.2.2, we evaluate these expressions using a sharp momentum \
cutoff ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["k", FontSlant -> "Bold"], "|", "<", "\[CapitalLambda]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "| \\mathbf {k} | < \\Lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1f15ac1e-2635-6241-88a1-10d8e211a1c2"],
 StyleBox[", focusing on the identification of power-law and logarithmic \
divergences . We then perform the parallel evaluation in 1.2.3 using \
dimensional regularization, which preserves the translational symmetry of the \
theory . In 1.2.4, we derive the Laurent expansions of these integrals in the \
vicinity of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm], 
     "errors" -> {}, "input" -> "d = 4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"656dd6c4-574e-6b4e-9923-1dfc054a4090"],
 StyleBox[", identifying the physical ultraviolet poles and their relation to \
the theory's renormalization. Finally, in 1.2.5, we demonstrate the validity \
of the derivative identity ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", "-", "\[PartialD]", 
         StyleBox["T", "TI"], "/", "\[PartialD]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "B (0) = -\\partial T/ \\partial m^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cac93d2b-2d98-7343-8df8-6cb42be95720"],
 StyleBox[" in both schemes, confirming the regulator independence of the \
underlying physics as the regulators are removed.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004013017844303*^9, 4.004013028734377*^9}, {
  4.004013141556608*^9, 
  4.0040132391961555`*^9}},ExpressionUUID->"a37dfb04-d530-d14d-a106-\
73131d4fbaf2"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.2.1 Definition of the Tadpole and Bubble Integrals",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.0038162349764366`*^9, 4.0038162431359406`*^9}, 
   4.0038174276249313`*^9},ExpressionUUID->"2f278d12-47ef-5c43-a0b2-\
1b376eecff68"],

Cell[TextData[{
 StyleBox["We begin by defining the primary loop integrals that determine the \
one-loop corrections to the two-point and four-point functions. In Euclidean \
momentum space, the massive tadpole integral is:\n\n                          \
                                                                              \
           ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["m", "TI"], "2"], ")"}], "\[LongEqual]", "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "T(m^2)=\\int\\frac{d^dk}{(2\\pi)^d}\\frac{1}{k^2+m^2},", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e32640a6-de9d-a247-82b4-5efda129135d"],
 StyleBox["\n\nThis integral characterizes the momentum-independent \
self-energy correction. The corresponding massive bubble integral is:\n\n     \
                                                                              \
                    ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["P", "TI"], "2"], ")"}], "\[LongEqual]", "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            RowBox[{"(", 
              RowBox[{
                SuperscriptBox[
                 StyleBox["k", "TI"], "2"], "+", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]}], ")"}], "(", 
            RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["k", "TI"], "+", 
                   StyleBox["P", "TI"]}], ")"}], "2"], "+", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"]}], ")"}]], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "B(P^2)=\\int\\frac{d^dk}{(2\\pi)^d}\n\
\\frac{1}{(k^2+m^2)((k+P)^2+m^2)},", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"507ebae4-feb4-f644-b482-1f12213394fb"],
 StyleBox["\n\nwhere ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> "P", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ca8f5925-3d89-2345-98f6-150908ebf476"],
 StyleBox[" is the total external Euclidean momentum flowing through the \
loop. (A-27)\nThroughout our evaluation, we employ dimensional regularization \
with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d = 4 - \\varepsilon", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b2ea659c-cfa2-5343-94c8-d82b2471c1e8"],
 StyleBox[", where the renormalization scale ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Mu]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"01395125-3ce9-ad4b-862c-718ed94f8731"],
 StyleBox[" is associated with each loop to maintain dimensional consistency. \
We also consider the zero-momentum limit of the bubble integral:\n\n          \
                                                                              \
                                     ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               SuperscriptBox[
                StyleBox["k", "TI"], "2"], "+", 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"]}], ")"}], "2"]], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "B(0)=\\int\\frac{d^dk}{(2\\pi)^d}\n\\frac{1}{(k^2+m^2)^2},", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"637d4847-c3dc-8546-a340-03ed63d607af"],
 StyleBox["\n\nThis specific integral facilitates the verification of the \
derivative identity:\n\n                                                      \
                                                                             ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", "-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["T", "TI"], 
            RowBox[{"(", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"], ")"}]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> "B(0)=-\\frac{\\partial T(m^2)}{\\partial m^2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e8bb42ea-b29b-5a4d-a4eb-be74000f065c"],
 StyleBox["                                                                   \
                                          (A-28)\n\nThis identity, which \
follows directly from differentiating the tadpole integrand with respect to \
the mass squared, serves as a check for the consistency of our regularization \
schemes. We will formally verify this relation in subsection 1.2.5.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0040134876103687`*^9, 4.0040135245637474`*^9}, {
  4.0040135568037033`*^9, 4.004013642903887*^9}, {4.004013675718956*^9, 
  4.0040137973934593`*^9}, {4.0042424456077347`*^9, 4.004242453460346*^9}, {
  4.0042425193097153`*^9, 
  4.004242519511011*^9}},ExpressionUUID->"ff382087-c62a-c246-aba7-\
656365aa20d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "1."}]}], " ", "Define", " ", "Integrands", " ", "using", " ",
      "established", " ", 
     RowBox[{
      RowBox[{"Prop", "[", "k", "]"}], "--"}]}], "-"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"tadpoleIntegrand", "[", "k_", "]"}], ":=", 
     RowBox[{"Prop", "[", "k", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bubbleIntegrand", "[", 
      RowBox[{"k_", ",", "P_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Prop", "[", "k", "]"}], " ", 
      RowBox[{"Prop", "[", 
       RowBox[{"k", "+", "P"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"zeroMomentumBubbleIntegrand", "[", "k_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Prop", "[", "k", "]"}], "^", "2"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "2."}]}], " ", "Display", " ", "Formal", " ", "Integral", 
      " ", 
      RowBox[{"Definitions", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Massive tadpole integral:\>\"", "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"TraditionalForm", "[", 
    RowBox[{"HoldForm", "[", 
     RowBox[{
      RowBox[{"T", "[", "m2", "]"}], "==", 
      RowBox[{
       RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
       RowBox[{
        RowBox[{"tadpoleIntegrand", "[", "k", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"\[DoubleStruckCapitalR]", "^", "d"}]}], "}"}]}], "]"}]}], 
     "]"}], "]"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Massive bubble integral:\>\"", "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"TraditionalForm", "[", 
    RowBox[{"HoldForm", "[", 
     RowBox[{
      RowBox[{"B", "[", 
       RowBox[{"P", "^", "2"}], "]"}], "==", 
      RowBox[{
       RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
       RowBox[{
        RowBox[{"bubbleIntegrand", "[", 
         RowBox[{"k", ",", "P"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"\[DoubleStruckCapitalR]", "^", "d"}]}], "}"}]}], "]"}]}], 
     "]"}], "]"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Zero-momentum bubble integral:\>\"", "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"TraditionalForm", "[", 
    RowBox[{"HoldForm", "[", 
     RowBox[{
      RowBox[{"B", "[", "0", "]"}], "==", 
      RowBox[{
       RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
       RowBox[{
        RowBox[{"zeroMomentumBubbleIntegrand", "[", "k", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"\[DoubleStruckCapitalR]", "^", "d"}]}], "}"}]}], "]"}]}], 
     "]"}], "]"}]}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{4.004014264452772*^9, 4.0040142859849567`*^9}, {
  4.004014552847273*^9, 4.0040145556624565`*^9}, {4.004014690797188*^9, 
  4.004014697482439*^9}},
 Background->GrayLevel[0.753],
 CellLabel->
  "In[110]:=",ExpressionUUID->"1f5135f3-8c0f-6f44-ab65-e1e2928a482b"],

Cell[BoxData[
 FormBox["\<\"Massive tadpole integral:\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.004154175734314*^9, 4.004161307847864*^9, 
  4.004172085306679*^9, 4.004181171145199*^9, 4.0041825970536633`*^9, 
  4.004189372972801*^9, 4.00419883696636*^9, 4.0042008382667065`*^9, 
  4.0042013962031612`*^9, 4.004242284840233*^9, 4.0042459709340343`*^9, 
  4.0042467677815*^9, 4.004250971109846*^9, 4.004291975372221*^9, 
  4.004299415756855*^9},
 CellLabel->
