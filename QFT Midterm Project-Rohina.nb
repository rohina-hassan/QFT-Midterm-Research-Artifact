In[110]:=",ExpressionUUID->"ea3ee3e4-42b1-fe41-9897-d23a116695cc"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{"B", "(", "0", ")"}], "\[LongEqual]", 
    RowBox[{
     TemplateBox[{"Integrate"},
      "InactiveHead",
      BaseStyle->"InactiveTraditional",
      SyntaxForm->"Symbol",
      Tooltip->"Inactive[Integrate]"], "[", 
     RowBox[{
      RowBox[{"zeroMomentumBubbleIntegrand", "(", "k", ")"}], ",", 
