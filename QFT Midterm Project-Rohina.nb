In[240]:=",ExpressionUUID->"0555e5ba-9d29-a24c-b463-73741dc748dc"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   FractionBox[
    RowBox[{"lam", " ", "Treg"}], "2"]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.004177195671633*^9, 4.0041775596141834`*^9, 
  4.0041815161953564`*^9, 4.004182825578207*^9, 4.0041895874274883`*^9, 
  4.004199047350748*^9, 4.0042492261888294`*^9, 4.0042510345736294`*^9, 
  4.0042920874540424`*^9, 4.004299490406952*^9},
 CellLabel->
  "Out[250]//TraditionalForm=",ExpressionUUID->"dd0a6a30-2f42-9b4c-a940-\
e3f42d441428"],

Cell[BoxData[
 FormBox["\<\"Field-strength counterterm (dZphi):\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.0041771956647797`*^9, 4.0041775596141834`*^9, 
  4.0041815161953564`*^9, 4.0041828255732*^9, 4.004189587422308*^9, 
  4.004199047350748*^9, 4.0042492261888294`*^9, 4.0042510345736294`*^9, 
  4.0042920874397507`*^9, 4.004299490406952*^9},
 CellLabel->
