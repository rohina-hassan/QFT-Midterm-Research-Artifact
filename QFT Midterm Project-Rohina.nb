       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Delta_sigma", " ", "must", " ", "equal", " ", "Delta_phi"}],
          "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"d", "-", "2", "+", "eta"}], ")"}], "/", "2"}], " ", 
           "at", " ", "d"}], "=", "3"}]}], "*)"}], 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", "etaBootstrap"}], ")"}], "/", "2"}], "-", 
          "deltaSigmaBootstrap"}], "]"}], "==", "0"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "the", " ", "gaps", " ", "are", " ", "far", " ", "larger", " ", 
         "than", " ", "the", " ", "propagated", " ", "bootstrap", " ", 
         "uncertainty"}], "*)"}], 
       RowBox[{
        RowBox[{"N", "[", "etaBootstrapError", "]"}], "<", 
        "etaAbsoluteDifference"}], ",", 
       RowBox[{
        RowBox[{"N", "[", "deltaBootstrapError", "]"}], "<", 
        "deltaBootstrapAbsoluteDifference"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "regression", " ", "on", " ", "the", " ", "printed", " ", "relative", 
         " ", "differences"}], "*)"}], 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"etaRelativeDifference", "-", "48.9814"}], "]"}], "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "3"}]}]}], ",", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"deltaBootstrapRelativeDifference", "-", "6.82443"}], "]"}], 
        "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "4"}]}]}], ",", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"deltaWaterRelativeDifference", "-", "3.21376"}], "]"}], "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "4"}]}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Final consistency checks (expected: ten True \
values):\>\"", "]"}], ";"}], "\n", "criticalComparisonChecks"}]}]], "Input",
