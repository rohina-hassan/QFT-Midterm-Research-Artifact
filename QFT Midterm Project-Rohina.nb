Cell["\<\
------------------------------------------------------------------------------\
------------------------------------------------------------------------------\
--------------------\
\>", "Text",
 CellChangeTimes->{{4.004264244961254*^9, 
  4.0042642523817024`*^9}},ExpressionUUID->"aff10d31-6fee-7144-8522-\
d664252930e8"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["2.1.3 Evaluation of the Massless Sunset Integral",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.5254901960784314, 0.3843137254901961, 
   0.49019607843137253`]]], "Subsubsection",
 CellChangeTimes->{
  4.00425931001507*^9},ExpressionUUID->"20dfc0b5-ea44-c84b-b83f-d8936fb31ba1"],

Cell[TextData[{
 StyleBox["We now evaluate the massless sunset integral introduced in the \
previous subsection\n\n                                                       \
                                              ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
         SubsuperscriptBox["\[Mu]", 
          StyleBox["R", "TI"], 
          RowBox[{"2", "\[Epsilon]"}]], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], "\[ScriptL]"}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], 
            SuperscriptBox["\[ScriptL]", "2"], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 StyleBox["k", "TI"], "+", "\[ScriptL]", "+", 
                 StyleBox["p", "TI"]}], ")"}], "2"]}]], ",    ", 
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]", ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "H(p)=\\mu_R^{2\\epsilon}\n\\int\\frac{d^dk}{(2\\pi)^d}\n\
\\frac{d^d\\ell}{(2\\pi)^d}\n\\frac{1}{k^2\\ell^2(k+\\ell+p)^2},\n\\qquad \
d=4-\\epsilon,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d176e84b-9fad-6641-b5d6-0d11d23b0a85"],
 "                ",
 StyleBox["\n\nusing dimensional regularization. Since the integral depends \
on the nonzero external Euclidean momentum ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"88b05c68-e725-674c-a18d-3011011c2667"],
 StyleBox[", it is not scaleless and can be evaluated by successive one-loop \
integrations.\n\nThe calculation relies on the standard massless one-loop \
convolution formula,\n\n                                                      \
                                  ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["q", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
               SuperscriptBox[
                StyleBox["q", "TI"], "2"], ")"}], "\[Alpha]"], 
            SuperscriptBox[
             RowBox[{"[", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["q", "TI"], "+", 
                    StyleBox["P", "TI"]}], ")"}], "2"], "]"}], "\[Beta]"]}]], 
         "\n", "  "}], TraditionalForm], "errors" -> {}, "input" -> 
     "&\\int\\frac{d^dq}{(2\\pi)^d}\n\\frac{1}{(q^2)^\\alpha[(q+P)^2]^\\beta}\
\n\\\\[2mm]\n&\\quad", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1d3acb0d-f505-ba4d-a3f7-b6ea4aa42cbd"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
             SuperscriptBox[
              StyleBox["P", "TI"], "2"], ")"}], 
           RowBox[{
             StyleBox["d", "TI"], "/", "2", "-", "\[Alpha]", "-", 
             "\[Beta]"}]], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]"}], ")"}], 
           RowBox[{
             StyleBox["d", "TI"], "/", "2"}]]], 
         FractionBox[
          RowBox[{"\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{
                FractionBox[
                 StyleBox["d", "TI"], "2"], "-", "\[Alpha]"}], ")"}], 
            "\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{
                FractionBox[
                 StyleBox["d", "TI"], "2"], "-", "\[Beta]"}], ")"}], 
            "\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{"\[Alpha]", "+", "\[Beta]", "-", 
                FractionBox[
                 StyleBox["d", "TI"], "2"]}], ")"}]}], 
          RowBox[{"\[CapitalGamma]", 
            RowBox[{"(", "\[Alpha]", ")"}], "\[CapitalGamma]", 
            RowBox[{"(", "\[Beta]", ")"}], "\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{
                StyleBox["d", "TI"], "-", "\[Alpha]", "-", "\[Beta]"}], 
              ")"}]}]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "=\n\\frac{(P^2)^{d/2-\\alpha-\\beta}}{(4\\pi)^{d/2}}\n\\frac{\n\
\\Gamma\\left(\\frac d2-\\alpha\\right)\n\\Gamma\\left(\\frac \
d2-\\beta\\right)\n\\Gamma\\left(\\alpha+\\beta-\\frac d2\\right)\n}{\n\
\\Gamma(\\alpha)\\Gamma(\\beta)\n\\Gamma(d-\\alpha-\\beta)\n}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8e78d4b1-83f4-0c42-899b-75d870379401"],
 "                                                    ",
 StyleBox["(A-73)",
  FontSize->13],
 StyleBox["\nThis identity is understood by analytic continuation in the \
dimensional and propagator exponents, as appropriate for dimensional \
regularization.\n\nWe first perform the integration over ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"68f368ee-00e3-0a4d-a5d0-c13c38bc3455"],
 StyleBox[", treating ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[ScriptL]", "+", 
         StyleBox["p", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\ell+p", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6d60df73-8935-c74d-ae10-a64c8e68c776"],
 StyleBox[" as the external momentum of this one-loop subintegral. Setting ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", "\[LongEqual]", "\[Beta]", "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\alpha=\\beta=1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"933052ca-9d31-a046-b376-cd7e3e661ba8"],
 StyleBox[", we obtain:\n\n                                                   \
                                         ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 StyleBox["k", "TI"], "+", "\[ScriptL]", "+", 
                 StyleBox["p", "TI"]}], ")"}], "2"]}]], "\[LongEqual]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "&\\int\\frac{d^dk}{(2\\pi)^d}\n\\frac{1}{k^2(k+\\ell+p)^2}\n=", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"dcb30819-eb60-074c-b456-631fc57d3beb"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]"}], ")"}], 
           RowBox[{
             StyleBox["d", "TI"], "/", "2"}]]], 
         FractionBox[
          RowBox[{"\[CapitalGamma]", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 FractionBox[
                  StyleBox["d", "TI"], "2"], "-", "1"}], ")"}], "2"], 
            "\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{"2", "-", 
                FractionBox[
                 StyleBox["d", "TI"], "2"]}], ")"}]}], 
          RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{
              StyleBox["d", "TI"], "-", "2"}], ")"}]], 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"[", 
             SuperscriptBox[
              RowBox[{"(", 
                RowBox[{"\[ScriptL]", "+", 
                  StyleBox["p", "TI"]}], ")"}], "2"], "]"}], 
           RowBox[{"2", "-", 
             StyleBox["d", "TI"], "/", "2"}]]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{1}{(4\\pi)^{d/2}}\n\\frac{\n\\Gamma\\left(\\frac d2-1\\right)^2\n\
\\Gamma\\left(2-\\frac d2\\right)\n}{\n\\Gamma(d-2)\n}\n\
\\frac{1}{[(\\ell+p)^2]^{2-d/2}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"28fb2c7d-6da1-c345-86a5-0666719cac38"],
 "                                                        ",
 StyleBox["(A-74)",
  FontSize->13],
 StyleBox["\n\nSubstituting this result into the original expression reduces \
the sunset integral to a second massless one-loop convolution over ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[ScriptL]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\ell", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"39ea2154-749f-1643-8c1c-ecf1ad65d339"],
 StyleBox[". Applying the same identity with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[Alpha]", "\[LongEqual]", "1", ",    ", "\[Beta]", "\[LongEqual]", 
         "2", "-", 
         FractionBox[
          StyleBox["d", "TI"], "2"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\alpha=1,\\qquad \\beta=2-\\frac d2,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"31c0fb4c-7473-4940-80bc-01b3e3c3bd31"],
 StyleBox[" gives the complete gamma-function representation\n\n              \
                                                                              \
                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubsuperscriptBox["\[Mu]", 
             StyleBox["R", "TI"], 
             RowBox[{"2", "\[Epsilon]"}]], 
            SuperscriptBox[
             RowBox[{"(", 
               SuperscriptBox[
                StyleBox["p", "TI"], "2"], ")"}], 
             RowBox[{
               StyleBox["d", "TI"], "-", "3"}]]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox[
          RowBox[{"\[CapitalGamma]", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 FractionBox[
                  StyleBox["d", "TI"], "2"], "-", "1"}], ")"}], "3"], 
            "\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{"3", "-", 
                StyleBox["d", "TI"]}], ")"}]}], 
          RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{
              FractionBox[
               RowBox[{"3", 
                 StyleBox["d", "TI"]}], "2"], "-", "3"}], ")"}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "H(p)=\n\\frac{\\mu_R^{2\\epsilon}(p^2)^{d-3}}{(4\\pi)^d}\n\\frac{\n\
\\Gamma\\left(\\frac d2-1\\right)^3\n\\Gamma(3-d)\n}{\n\
\\Gamma\\left(\\frac{3d}{2}-3\\right)\n}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1316d39c-e941-ec49-95ce-c6e399498b78"],
 "                                                                            \
       ",
 StyleBox[" (A-75)",
  FontSize->13],
 StyleBox["\n\nFor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d=4-\\epsilon", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"95512c2d-9d68-0c4a-ac19-3bc8ef6eb87c"],
 StyleBox[", this becomes:\n\n                                                \
                                                                ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubsuperscriptBox["\[Mu]", 
             StyleBox["R", "TI"], 
             RowBox[{"2", "\[Epsilon]"}]], 
            SuperscriptBox[
             RowBox[{"(", 
               SuperscriptBox[
                StyleBox["p", "TI"], "2"], ")"}], 
             RowBox[{"1", "-", "\[Epsilon]"}]]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]"}], ")"}], 
           RowBox[{"4", "-", "\[Epsilon]"}]]], 
         FractionBox[
          RowBox[{"\[CapitalGamma]", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"1", "-", 
                 FractionBox["\[Epsilon]", "2"]}], ")"}], "3"], 
            "\[CapitalGamma]", 
            RowBox[{"(", 
              RowBox[{"-1", "+", "\[Epsilon]"}], ")"}]}], 
          RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{"3", "-", 
              FractionBox[
               RowBox[{"3", "\[Epsilon]"}], "2"]}], ")"}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "H(p)=\n\\frac{\\mu_R^{2\\epsilon}(p^2)^{1-\\epsilon}}{(4\\pi)^{4-\\\
epsilon}}\n\\frac{\n\\Gamma\\left(1-\\frac{\\epsilon}{2}\\right)^3\n\
\\Gamma(-1+\\epsilon)\n}{\n\\Gamma\\left(3-\\frac{3\\epsilon}{2}\\right)\n}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cdbf56e9-3d35-a545-9f86-46ca9161f5d9"],
 "                                                                            \
      ",
 StyleBox["(A-76)",
  FontSize->13],
 StyleBox["\n\nWe next expand this expression as a Laurent series around ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f620f6e4-6afd-3241-8cd4-237d507cc564"],
 StyleBox[". The pole originates from ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", "(", 
         RowBox[{"-1", "+", "\[Epsilon]"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Gamma(-1+\\epsilon)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7f031662-27f7-bc45-8046-e49b9d91b333"],
 StyleBox[", while the remaining gamma functions and scale-dependent factors \
contribute to the finite part. The resulting expansion has the form:\n     \n \
                                                                              \
               ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", "-", 
         FractionBox[
          SuperscriptBox[
           StyleBox["p", "TI"], "2"], 
          RowBox[{"512", 
            SuperscriptBox["\[Pi]", "4"], "\[Epsilon]"}]], "+", 
         FractionBox[
          SuperscriptBox[
           StyleBox["p", "TI"], "2"], 
          RowBox[{"512", 
            SuperscriptBox["\[Pi]", "4"]}]], 
         RowBox[{"[", 
           RowBox[{"ln", 
             RowBox[{"(", 
               FractionBox[
                SuperscriptBox[
                 StyleBox["p", "TI"], "2"], 
                SubsuperscriptBox["\[Mu]", 
                 StyleBox["R", "TI"], "2"]], ")"}], "-", "ln", 
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], "+", 
             SubscriptBox["\[Gamma]", 
              StyleBox["E", "TI"]], "-", 
             FractionBox["13", "4"]}], "]"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", "\[Epsilon]", ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "H(p)=\n-\\frac{p^2}{512\\pi^4\\epsilon}\n+\\frac{p^2}{512\\pi^4}\n\
\\left[\n\\ln\\left(\\frac{p^2}{\\mu_R^2} \\right)\n\
-\\ln(4\\pi)+\\gamma_E-\\frac{13}{4}\n \\right]\n+O(\\epsilon)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7ffd3b46-42e1-dc49-850b-95492fcda4e1"],
 StyleBox["                                                               \
(A-77)           ",
  FontSize->13],
 StyleBox["                                    \n\nThus, the coefficient of \
the momentum-dependent ultraviolet pole in the scalar sunset integral is:\n\n \
                                                                              \
                                              ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{
            RowBox[{
              StyleBox["H", "TI"], "(", 
              StyleBox["p", "TI"], ")"}], "\[VerticalSeparator]"}], 
          RowBox[{
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], "/", "\[Epsilon]"}]], "\[LongEqual]", 
         "-", 
         FractionBox[
          SuperscriptBox[
           StyleBox["p", "TI"], "2"], 
          RowBox[{"2", 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], "4"], "\[Epsilon]"}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\left.H(p)\\right|_{p^2/\\epsilon}\n=\n\
-\\frac{p^2}{2(4\\pi)^4\\epsilon}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ffbc8d3f-5e99-9745-9e11-fac2b3c9268d"],
 "                                                                            \
                     ",
 StyleBox["(A-78)",
  FontSize->13],
 StyleBox["\n\nThis result establishes the momentum-dependent pole of the \
bare sunset integral. Its contribution to the complete two-point function \
must additionally include the sunset symmetry factor, the interaction-vertex \
factors, and the appropriate counterterm contributions. In the following \
subsection, we examine the four-point subdivergences and their counterterm \
insertions to establish which terms can contribute to the coefficient of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "/", "\[Epsilon]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "p^2/\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9e65a899-ef51-0f4a-a67f-d07b3d074ebe"],
 StyleBox[".",
  FontSize->13]
}], "Text",
