Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "1."}]}], " ", "Construct", " ", "the", " ", "field"}], "-", 
    RowBox[{"strength", " ", "renormalization", " ", 
     RowBox[{"constant", "--"}]}], "-"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Zphi", "=", 
    RowBox[{"1", "+", 
     RowBox[{"delta", " ", "Zphi"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ZphiMS", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"1", "+", "dZphiMS"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<MS field-strength renormalization constant:\>\"", 
     "]"}], ";"}], "\n", "ZphiMS", "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "2."}]}], " ", "Calculate", " ", "the", " ", "field", " ",
       "anomalous", " ", 
      RowBox[{"dimension", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"gammaPhi", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], " ", "beta_g", " ", "d", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Log", "[", "Zphi", "]"}], ")"}], "/", "dg"}], " ", "The", " ",
        "one"}], "-", 
      RowBox[{
      "loop", " ", "beta", " ", "function", " ", "is", " ", "taken", " ", 
       "from", " ", "Section", " ", "1.4", 
       RowBox[{".2", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gammaPhi", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], "*", "betaD", "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Log", "[", "ZphiMS", "]"}], ",", "g"}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Field anomalous dimension at one-loop order:\>\"", 
     "]"}], ";"}], "\n", "gammaPhi", "\n", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "3."}]}], " ", "Evaluate", " ", "the", " ", "anomalous", " ",
       "dimension", " ", "at", " ", "the", " ", "fixed", " ", 
      RowBox[{"point", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gammaPhiFixedPoint", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"gammaPhi", "/.", " ", 
       RowBox[{"g", "->", "nontrivialFixedPoint"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Field anomalous dimension at the Wilson-Fisher fixed \
point:\>\"", "]"}], ";"}], "\n", "gammaPhiFixedPoint", "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "4."}]}], " ", "Calculate", " ", "the", " ", "critical", " ",
       "exponent", " ", 
      RowBox[{"eta", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"etaOneLoop", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"2", "*", "gammaPhiFixedPoint"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<One-loop critical exponent eta:\>\"", "]"}], 
    ";"}], "\n", "etaOneLoop", "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "5."}]}], " ", "Determine", " ", "the", " ", "canonical", 
      " ", "field", " ", "scaling", " ", 
      RowBox[{"dimension", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"d_phi", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"d", "-", "2"}], ")"}], "/", "2"}]}], ",", 
     RowBox[{
      RowBox[{"with", " ", "d"}], "=", 
      RowBox[{"4", "-", 
       RowBox[{"e", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"canonicalFieldDimension", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", "-", "e"}], ")"}], "-", "2"}], ")"}], "/", "2"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Canonical field scaling dimension:\>\"", "]"}],
     ";"}], "\n", "canonicalFieldDimension", "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "6."}]}], " ", "Independently", " ", "verify", " ", "the",
       " ", "absence", " ", "of", " ", "a", " ", "one"}], "-", 
     RowBox[{"loop", " ", "momentum"}], "-", 
     RowBox[{"dependent", " ", "two"}], "-", 
     RowBox[{"point", " ", 
      RowBox[{"correction", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"The", " ", "one"}], "-", 
      RowBox[{
      "loop", " ", "tadpole", " ", "is", " ", "independent", " ", "of", " ", 
       "external", " ", 
       RowBox[{"momentum", ".", "Therefore"}]}]}], ",", 
     RowBox[{
     "its", " ", "contribution", " ", "to", " ", "the", " ", "derivative", " ",
       "of", " ", "Gamma2", " ", "with", " ", "respect", " ", "to", " ", 
      RowBox[{"p", "^", "2"}], " ", "must", " ", 
      RowBox[{"vanish", "."}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pDependenceOneLoop", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Gamma2", "[", "psq", "]"}], "-", "psq"}], ",", "psq"}], 
        "]"}], "/.", " ", 
       RowBox[{"dZphi", "->", "0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<p^2-dependence of the one-loop tadpole contribution \
(expected: 0):\>\"", "]"}], ";"}], "\n", "pDependenceOneLoop", "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "7."}]}], " ", "Collect", " ", "the", " ", "one"}], "-", 
     RowBox[{"loop", " ", "consistency", " ", 
      RowBox[{"checks", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fieldAnomalousDimensionCheck", "=", 
     RowBox[{"FullSimplify", "[", "gammaPhi", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"etaOneLoopCheck", "=", 
     RowBox[{"FullSimplify", "[", "etaOneLoop", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"fieldStrengthCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"ZphiMS", "-", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"fieldRenormalizationChecks", "=", 
     RowBox[{"{", 
      RowBox[{
      "pDependenceOneLoop", ",", "fieldAnomalousDimensionCheck", ",", 
       "etaOneLoopCheck", ",", "fieldStrengthCheck"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<One-loop field-renormalization checks (expected: \
{0,0,0,0}):\>\"", "]"}], ";"}], "\n", "fieldRenormalizationChecks", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Overall verification:\>\"", "]"}], ";"}], "\n", 
   RowBox[{
   "FullSimplify", "[", "fieldRenormalizationChecks", "]"}]}]}]], "Input",
