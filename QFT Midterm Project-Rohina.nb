Cell[TextData[{
 StyleBox["FeynArts and FeynCalc work in Minkowski signature with their own \
factors of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"828ede1c-ff63-204b-83d2-b3d88b83529e"],
 StyleBox[", while this project is Euclidean. Before reading any generated \
amplitude we fix the dictionary between the two. Sections 1.1.6 and 1.1.7 \
then only apply it.\n\n",
  FontSize->13],
 StyleBox["Model identification:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\[LineSeparator]The model is defined by ",
  FontSize->13],
 Cell[BoxData[
  RowBox[{"Phi4", ".", "mod"}]],
  FontSize->13,ExpressionUUID->"87afa630-825e-e84b-acc0-c4dd82217403"],
 StyleBox[", ",
  FontSize->13],
 Cell[BoxData[
  RowBox[{"Phi4", ".", "gen"}]],
  FontSize->13,ExpressionUUID->"159946d0-9329-6d45-baf9-9831f9d8f9da"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  RowBox[{"Phi4", ".", "pars"}]],
  FontSize->13,ExpressionUUID->"3d692bd7-4e80-0c46-b20e-bd58e8cc73aa"],
 StyleBox[". They give the propagator and vertex\n\n                          \
                                                                              \
    ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", 
