     "difference", " ", "check", " ", "of", " ", "the", " ", "slope", " ", 
      "from", " ", "Delta", " ", "B", " ", "itself"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"slopeFiniteDifference", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"deltaBCutoffLimit", "[", 
         RowBox[{
          RowBox[{"1", "/", "100000"}], ",", "m2Test"}], "]"}], "*", 
