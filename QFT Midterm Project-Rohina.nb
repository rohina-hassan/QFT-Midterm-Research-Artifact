Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Check", " ", "the", " ", "numerical", " ", "symmetry"}], "-", 
    RowBox[{"factor", " ", "prefactor"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"In", " ", "four", " ", "dimensions"}], ",", 
    RowBox[{
    "the", " ", "conventional", " ", "loop", " ", "measure", " ", 
     "contributes", " ", 
     RowBox[{"1", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", "Pi"}], ")"}], "^", "4."}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"feynArtsLoopMeasure4D", "=", 
     RowBox[{"1", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", "Pi"}], ")"}], "^", "4"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"feynArtsNumericalPrefactor", "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"32", " ", 
        RowBox[{"Pi", "^", "4"}]}], ")"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"feynArtsSymmetryFactor", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"feynArtsNumericalPrefactor", "/", "feynArtsLoopMeasure4D"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Numerical symmetry-factor prefactor: \>\"", ",", 
      "feynArtsSymmetryFactor"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Each", " ", "term", " ", "is", " ", "understood", " ", "to", " ", "be", " ",
      "multiplied", " ", "by", " ", "the", " ", "loop", " ", "integration", " ", 
     RowBox[{"measure", ":", 
      RowBox[{"\[Integral]", 
       RowBox[{
        RowBox[{"d", "^", "d"}], " ", 
        RowBox[{"k", ".", "The"}], " ", "displayed", " ", "expression", " ", 
        "shows", " ", "only", " ", "the", " ", "common", " ", 
        RowBox[{"prefactor", "."}]}]}]}]}], "*)"}]}]}]], "Input",
