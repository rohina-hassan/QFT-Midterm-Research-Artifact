Cell[CellGroupData[{

Cell[TextData[StyleBox["Section 2.2\[LongDash]Verification Summary",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.7725490196078432, 0.6862745098039216, 
   0.7490196078431373]]], "Subsubsection",
 CellChangeTimes->{{4.0042951967530956`*^9, 
  4.004295208772869*^9}},ExpressionUUID->"cc00b758-88c2-1c4b-a64f-\
e23222caca3f"],

Cell[TextData[{
 StyleBox["Question:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox["\nHow does the two-loop field-strength renormalization determine \
the anomalous dimension ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\gamma_\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"fed01857-6563-3542-8d39-4bbe2e04b6b0"],
 StyleBox[" and the critical exponent ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7f813df0-1171-a54c-bbc3-bdbc4a1961ba"],
 StyleBox[" through ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox["\[Epsilon]", "2"], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(\\epsilon^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b743af6e-b7fe-f84f-adb3-e3bcf397a4cf"],
 StyleBox[",\n and how can the result be independently verified from the \
logarithmic momentum dependence of the critical propagator?\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
-----------------------------------------------",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox["  ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["                                         \n",
  FontSize->13],
 StyleBox["Derivation:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox["\nSections 2.2.1 to 2.2.4.\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
-----------------------------------------------  ",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" \n",
  FontSize->13],
 StyleBox["Check:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox["\nThe two-loop sunset pole determines ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Z", "TI"], "\[Phi]"], "\[LongEqual]", "1", "-", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "/", 
         RowBox[{"(", 
           RowBox[{"12", "\[Epsilon]"}], ")"}], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "Z_\\phi=1-g^2/(12\\epsilon)+O(g^3)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5911fca0-d5a0-af47-a6be-a9fea78f166b"],
 StyleBox[", yielding the finite anomalous dimension ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Gamma]", "\[Phi]"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["g", "TI"], "2"], "/", "12", "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["g", "TI"], "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\gamma_\\phi=g^2/12+O(g^3)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3de5c165-c562-3743-8327-c098952ceb24"],
 StyleBox[". Evaluating at \nthe Wilson\[Dash]Fisher fixed point gives ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", 
         SuperscriptBox["\[Epsilon]", "2"], "/", "54", "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Epsilon]", "3"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\eta=\\epsilon^2/54+O(\\epsilon^3)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2739eb8a-84f0-0744-9519-c42e790371c8"],
 StyleBox[". The logarithmic coefficient in the renormalized critical \
propagator agrees with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "/", "2"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\eta/2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"91ec22b7-58a7-3d4a-8112-ecc163d904ea"],
 StyleBox[", \nproviding an independent consistency check.\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------------------------- ",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" \n",
  FontSize->13],
 StyleBox["Anchor IDs:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox["\nA-82 to A-94\n",
  FontSize->13],
 StyleBox["-------------------------------------------------------------------\
------------------------------------------------------------------------------\
----------------------------------------------- ",
  FontSize->13,
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox[" \n",
  FontSize->13],
 StyleBox["Status:",
  FontSize->13,
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.5254901960784314, 0.3843137254901961, 0.49019607843137253`]],
 StyleBox[" ",
  FontSize->13,
  FontColor->RGBColor[
   0.3137254901960784, 0.39215686274509803`, 0.4666666666666667]],
 StyleBox["\nChecked!",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004295223582735*^9, 4.004295236782593*^9}, {
  4.0042953576002007`*^9, 4.0042953663126183`*^9}, {4.0042987086039886`*^9, 
  4.0042988756206913`*^9}},ExpressionUUID->"2a93bdfc-cc79-3c4d-a2dc-\
1c0fb6700adc"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["2.3 Scaling and comparison with water",
 FontFamily->"Arial",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.43529411764705883`, 0.3411764705882353, 
   0.6509803921568628]]], "Subsection",
 CellChangeTimes->{
  4.004190537670286*^9},ExpressionUUID->"e87f6d96-11e8-4f4e-a2ae-\
ea87d38524a8"],

Cell[TextData[{
 StyleBox["In this section, we derive the critical-isotherm exponent ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"85c0fa88-b1f1-5d48-9be2-f55bcdae494d"],
 StyleBox[" from the scaling dimensions of the scalar field and its conjugate \
external source. In Section 2.3.1, we introduce a uniform external field ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["h", "TI"], TraditionalForm], "errors" -> {}, "input" -> "h", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e7a52733-928c-7f49-9f64-1849434fc12b"],
 StyleBox[", define the order parameter ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["M", "TI"], TraditionalForm], "errors" -> {}, "input" -> "M", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"bea63075-c0ab-2443-a5e5-5994fe2538db"],
 StyleBox[", and derive the scaling dimensions of both quantities to \
establish the scaling relation for ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"49f1a05b-9c24-3540-b801-c4ce7c07ba7a"],
 StyleBox[". In Section 2.3.2, we use this relation together with the \
two-loop anomalous dimension obtained in Section 2.2 to calculate ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6016517b-ee1b-1b42-85f1-ac33d7f83710"],
 StyleBox[" through ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "(", 
         SuperscriptBox["\[Epsilon]", "2"], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "O(\\epsilon^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6b79ad41-7218-a04e-a4f9-4b95432ce1ec"],
 StyleBox[" and obtain its three-dimensional prediction by setting ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5a4b2079-f317-6d47-92cb-30caf6566e9e"],
 StyleBox[". In Section 2.3.3, we connect the field-theoretic critical \
isotherm to the experimentally measurable equation of state of water by \
identifying the order parameter and external field with the density and \
pressure deviations from their critical values. Finally, in Section 2.3.4, we \
derive the critical scattering exponent from the momentum-space scaling of \
the two-point function and compare our predictions for ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ddea9476-291d-024c-b71d-d0fdf7f57c16"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1eb9c92d-8e63-354f-9a70-46a0266d5271"],
 StyleBox[" with the experimental water-fit and conformal-bootstrap reference \
values.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0042990514883785`*^9, 
  4.004299134419945*^9}},ExpressionUUID->"02a13a9f-579a-2843-883f-\
367d19446d9a"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["2.3.1 External Field and Scaling Dimensions",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.5254901960784314, 0.3843137254901961, 
   0.49019607843137253`]]], "Subsubsection",
 CellChangeTimes->{{4.0042989521280727`*^9, 
  4.004298962540388*^9}},ExpressionUUID->"d67fa3bb-7b87-fd46-9a5b-\
395e342c1060"],

Cell[TextData[{
 StyleBox["To derive the critical-isotherm exponent ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3a921e66-2e88-8045-a571-5947842d5f5b"],
 StyleBox[", we introduce a uniform external source ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["h", "TI"], TraditionalForm], "errors" -> {}, "input" -> "h", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"30cd14ee-af5c-2041-9b17-e63fe42da87a"],
 StyleBox[" coupled linearly to the scalar field through\n\n                  \
                                                                              \
                                    ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], 
          StyleBox["h", "TI"]], "\[LongEqual]", 
         StyleBox["S", "TI"], "-", "\[Integral]", 
         SuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["d", "TI"]], 
         StyleBox["x", "TI"], " ", 
         StyleBox["h", "TI"], "\[Phi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "S_h=S-\\int d^dx\\,h\\phi(x).", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e0f281d6-4db2-154d-a2bb-d049b63264f1"],
 StyleBox["                                                                   \
                                     (A-95)\n \nThe order parameter is \
defined as the expectation value of the field in the presence of this source, \
",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", "\[Phi]", "\[RightAngleBracket]"}], 
          StyleBox["h", "TI"]], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "M=\\langle\\phi\\rangle_h.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"54c8aec1-54a4-eb47-b84e-dfdeeff14cc8"],
 StyleBox[" With Euclidean weight ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          SubscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["h", "TI"]]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "e^{-S_h}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"84c1335a-7e3a-c944-8e72-a2c7b84d661e"],
 StyleBox[", this is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", 
         FractionBox["1", 
          StyleBox["V", "TI"]], " ", "\[PartialD]", "ln", 
         StyleBox["Z", "TI"], "/", "\[PartialD]", 
         StyleBox["h", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M=\\frac1V\\,\\partial\\ln Z/\\partial h", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"4aff7039-7101-9344-b213-879d550cd6f4"],
 StyleBox[". The critical isotherm means ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["c", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "T=T_c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"22eea7b6-c278-a24e-8780-021007dade9a"],
 StyleBox[", that is, the mass is tuned to criticality as in Part 2.\n\nAt \
criticality, the scaling dimension of the scalar field is:\n\n                \
                                                                              \
                                        ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", "\[Phi]"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], "-", "2", "+", "\[Eta]"}], "2"], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta_\\phi=\\frac{d-2+\\eta}{2},", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b524e218-2bab-1b48-a048-a8b4a8fad75e"],
 StyleBox["                                                                   \
                                                 (A-96)\n\nwhere ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta]", "\[LongEqual]", "2", 
         SubscriptBox["\[Gamma]", "\[Phi]"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["g", "TI"], "*"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\eta=2\\gamma_\\phi(g_*)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"149ad0d4-e3e4-de4e-96ba-0ac08cebafa1"],
 StyleBox[" is the exponent obtained in Section 2.2.4, so that ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", "\[Phi]"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], "-", "2"}], "2"], "+", 
         SubscriptBox["\[Gamma]", "\[Phi]"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["g", "TI"], "*"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Delta_\\phi=\\frac{d-2}{2}+\\gamma_\\phi(g_*)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"a6034826-b51c-a74c-b0b8-d485b0f7c051"],
 StyleBox[". This agrees with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[LeftAngleBracket]", 
           RowBox[{"\[Phi]", 
             RowBox[{"(", 
               StyleBox["x", "TI"], ")"}], "\[Phi]", 
             RowBox[{"(", "0", ")"}]}], "\[RightAngleBracket]"}], 
         "\[Proportional]", "|", 
         StyleBox["x", "TI"], 
         SuperscriptBox["|", 
          RowBox[{"-", "(", 
            RowBox[{
              StyleBox["d", "TI"], "-", "2", "+", "\[Eta]"}], ")"}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle\\phi(x)\\phi(0)\\rangle\\propto|x|^{-(d-2+\\eta)}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"80520ef5-fe8a-0045-a867-6c204569bfa8"],
 StyleBox[", whose Fourier transform is the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["q", "TI"], 
        RowBox[{"-2", "+", "\[Eta]"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "q^{-2+\\eta}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1c01b4bb-09f6-9c4c-8f26-beaa27a628cb"],
 StyleBox[" of Section 2.2.4. Since the source term must remain dimensionless \
under a scale transformation, the scaling dimension of the external field is \
determined by ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", 
          StyleBox["h", "TI"]], "+", 
         SubscriptBox["\[CapitalDelta]", "\[Phi]"], "\[LongEqual]", 
         StyleBox["d", "TI"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Delta_h+\\Delta_\\phi=d,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"18a86df5-718e-1e46-8afc-205a9c8022a9"],
 StyleBox[" giving\n\n                                                        \
                                                                             ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", 
          StyleBox["h", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], "+", "2", "-", "\[Eta]"}], "2"], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta_h=\\frac{d+2-\\eta}{2}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2a15d7f7-ee9c-9d40-8510-ee7395a23c7c"],
 "                                                                            \
                          ",
 StyleBox[" (A-97)\n\nUnder a common rescaling by a factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["b", "TI"], TraditionalForm], "errors" -> {}, "input" -> "b", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"607459dc-4edd-3e4d-a253-ad4318d7e0d8"],
 StyleBox[", the source and the order parameter transform as ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], "\[Rule]", 
         SuperscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{"-", 
            SubscriptBox["\[CapitalDelta]", 
             StyleBox["h", "TI"]]}]], 
         StyleBox["h", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "h\\to b^{-\\Delta_h}h", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"54c0805b-17d6-c043-a31f-94eb149d10d6"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[Rule]", 
         SuperscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{"-", 
            SubscriptBox["\[CapitalDelta]", "\[Phi]"]}]], 
         StyleBox["M", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M\\to b^{-\\Delta_\\phi}M", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"74c4cb17-472f-eb45-a2d1-6e9b20bf23f3"],
 StyleBox[", with the same sign convention for both. The combination ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["h", "TI"], 
          SubscriptBox["\[CapitalDelta]", "\[Phi]"]], "/", 
         SuperscriptBox[
          StyleBox["M", "TI"], 
          SubscriptBox["\[CapitalDelta]", 
           StyleBox["h", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "h^{\\Delta_\\phi}/M^{\\Delta_h}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"98aeaa55-c9b2-0e41-801c-47152ef610ef"],
 StyleBox[" is therefore invariant, so the equation of state must have the \
form ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[Proportional]", 
         SuperscriptBox[
          StyleBox["h", "TI"], 
          RowBox[{
            SubscriptBox["\[CapitalDelta]", "\[Phi]"], "/", 
            SubscriptBox["\[CapitalDelta]", 
             StyleBox["h", "TI"]]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "M\\propto h^{\\Delta_\\phi/\\Delta_h}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"daf379ae-0c01-9244-b52a-cd4625b78488"],
 StyleBox[". Equivalently, the critical-isotherm equation takes the form ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], "\[Proportional]", 
         SuperscriptBox[
          StyleBox["M", "TI"], "\[Delta]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "h\\propto M^\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"45829f3c-5dc4-3a4f-9760-88766c42ee74"],
 StyleBox[", with\n\n                                                         \
                                                                     ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", "\[LongEqual]", 
         FractionBox[
          SubscriptBox["\[CapitalDelta]", 
           StyleBox["h", "TI"]], 
          SubscriptBox["\[CapitalDelta]", "\[Phi]"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], "+", "2", "-", "\[Eta]"}], 
          RowBox[{
            StyleBox["d", "TI"], "-", "2", "+", "\[Eta]"}]], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta=\\frac{\\Delta_h}{\\Delta_\\phi}\n\
=\\frac{d+2-\\eta}{d-2+\\eta}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"618d0085-e41a-ba49-b446-8fba3c41e8d7"],
 StyleBox["                                                                   \
                                                 (A-98)\n\nThis scaling \
relation allows us to determine ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Delta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9eea825c-0d4f-9649-acaa-163d0854ad01"],
 StyleBox[" directly from the anomalous dimension calculated in Section 2.2, \
without requiring an additional perturbative calculation of the equation of \
state. The relation assumes hyperscaling and a single relevant field at ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["c", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"93b66476-69e8-5f47-996c-c91c0b0c83d1"],
 StyleBox["; it is a scaling argument, not an independent perturbative \
calculation of the equation of state.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004299744033142*^9, 4.004299927036165*^9}, {
  4.0043002403978577`*^9, 4.0043002659556904`*^9}, {4.004300298316078*^9, 
  4.0043003677855473`*^9}, {4.004300406985937*^9, 
  4.004300641157139*^9}},ExpressionUUID->"d207c328-ed5e-4949-945a-\
fcbde9f3a810"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Conventions", ":", "dim"}], "=", 
     RowBox[{"spacetime", " ", "dimension"}]}], ",", 
    RowBox[{"anomEta", "=", 
     RowBox[{
      RowBox[{"generic", " ", "anomalous"}], "-", 
      RowBox[{"dimension", " ", 
       RowBox[{"exponent", "."}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "1."}]}], " ", "Define", " ", "scaling", " ", 
     RowBox[{"dimensions", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"deltaPhi", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"dim", "-", "2", "+", "anomEta"}], ")"}], "/", "2"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"deltaH", "=", 
     RowBox[{"dim", "-", "deltaPhi"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "2."}]}], " ", "Verify", " ", "the", " ", "source"}], "-", 
      RowBox[{"term", " ", "scaling", " ", "relation", " ", "Delta_h"}], "+", 
      "Delta_phi"}], "=", 
     RowBox[{
      RowBox[{"d", "--"}], "-"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sourceScalingCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaH", "+", "deltaPhi", "-", "dim"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaHExpectedCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaH", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"dim", "+", "2", "-", "anomEta"}], ")"}], "/", "2"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "3."}]}], " ", "Derive", " ", "the", " ", "critical"}], "-", 
      RowBox[{"isotherm", " ", "exponent", " ", "delta"}]}], "=", 
     RowBox[{
      RowBox[{"Delta_h", "/", 
       RowBox[{"Delta_phi", "--"}]}], "-"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"deltaScalingRelation", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaH", "/", "deltaPhi"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaExpected", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"dim", "+", "2", "-", "anomEta"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"dim", "-", "2", "+", "anomEta"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaScalingCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaScalingRelation", "-", "deltaExpected"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "4."}]}], " ", "Invariance", " ", "of", " ", 
      RowBox[{
       RowBox[{"h", "^", "Delta_phi"}], "/", 
       RowBox[{"M", "^", "Delta_h"}]}], " ", "under", " ", "the", " ", 
      "common", " ", "rescaling", " ", "by", " ", 
      RowBox[{"b", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"orderParameterScaling", "=", 
     RowBox[{"b", "^", 
      RowBox[{"(", 
       RowBox[{"-", "deltaPhi"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"externalFieldScaling", "=", 
     RowBox[{"b", "^", 
      RowBox[{"(", 
       RowBox[{"-", "deltaH"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"criticalIsothermScalingCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"PowerExpand", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", "externalFieldScaling", ")"}], "^", "deltaPhi"}], "/", 
         RowBox[{
          RowBox[{"(", "orderParameterScaling", ")"}], "^", "deltaH"}]}], 
        "]"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"b", ">", "0"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "5."}]}], " ", "Bridge", " ", "to", " ", "Section", " ", 
       "2.2", ".4"}], ":", "d"}], "=", 
     RowBox[{"4", "-", 
      RowBox[{
      "e", " ", "and", " ", "eta", " ", "from", " ", "the", " ", "two"}], "-", 
      RowBox[{"loop", " ", 
       RowBox[{"calculation", "--"}]}], "-"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"deltaBridge", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaScalingRelation", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dim", "->", 
          RowBox[{"4", "-", "e"}]}], ",", 
         RowBox[{"anomEta", "->", "eta"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaBridgeCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"deltaBridge", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"6", "-", "e", "-", 
          RowBox[{
           RowBox[{"e", "^", "2"}], "/", "54"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "-", "e", "+", 
          RowBox[{
           RowBox[{"e", "^", "2"}], "/", "54"}]}], ")"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "6."}]}], " ", "Final", " ", "consistency", " ", 
      RowBox[{"checks", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"scalingDimensionChecks", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sourceScalingCheck", "==", "0"}], ",", 
       RowBox[{"deltaHExpectedCheck", "==", "0"}], ",", 
       RowBox[{"deltaScalingCheck", "==", "0"}], ",", 
       RowBox[{"criticalIsothermScalingCheck", "==", "1"}], ",", 
       RowBox[{"deltaBridgeCheck", "==", "0"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Scaling dimension of the scalar field:\>\"", "]"}], 
    ";"}], "\n", "deltaPhi", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Scaling dimension of the external source:\>\"", "]"}], 
    ";"}], "\n", "deltaH", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Critical-isotherm scaling relation (generic d and \
eta):\>\"", "]"}], ";"}], "\n", "deltaScalingRelation", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Source-term scaling check (expected: 0):\>\"", "]"}], 
    ";"}], "\n", "sourceScalingCheck", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Critical-isotherm exponent check (expected: 0):\>\"", 
     "]"}], ";"}], "\n", "deltaScalingCheck", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Invariance of h^Delta_phi / M^Delta_h (expected: 1):\>\
\"", "]"}], ";"}], "\n", "criticalIsothermScalingCheck", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Same relation with d = 4 - e and eta from 2.2.4:\>\"", 
     "]"}], ";"}], "\n", "deltaBridge", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Final consistency checks (expected: {True, True, True, \
True, True}):\>\"", "]"}], ";"}], "\n", "scalingDimensionChecks"}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{4.0042999396666336`*^9, 4.004299960406437*^9}, {
  4.004300150126999*^9, 4.0043001595958023`*^9}},
 Background->GrayLevel[0.753],
 CellLabel->
  "In[772]:=",ExpressionUUID->"dc5188da-c0fb-554c-8428-b52c434348f1"],

Cell[BoxData[
 FormBox["\<\"Scaling dimension of the scalar field:\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004300199196947*^9},
 CellLabel->
  "During evaluation of \
In[772]:=",ExpressionUUID->"bb2f0ff6-f199-364d-bedf-f093b236c8d3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"anomEta", "+", "dim", "-", "2"}], ")"}]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{4.004300199196947*^9},
 CellLabel->
  "Out[786]=",ExpressionUUID->"deb38581-5550-2d44-96bc-c0cc2f328368"],

Cell[BoxData[
 FormBox["\<\"Scaling dimension of the external source:\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004300199196947*^9},
 CellLabel->
  "During evaluation of \
In[772]:=",ExpressionUUID->"1a22801a-e247-1740-8454-43ba492d7ee2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "anomEta"}], "-", "dim", "+", "2"}], ")"}]}], "+", "dim"}],
   TraditionalForm]], "Output",
 CellChangeTimes->{4.0043001992064056`*^9},
 CellLabel->
  "Out[788]=",ExpressionUUID->"a3c3c8d9-a1f3-1448-a10b-5bb1a01f39ae"],

Cell[BoxData[
 FormBox["\<\"Critical-isotherm scaling relation (generic d and eta):\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.0043001992064056`*^9},
 CellLabel->
  "During evaluation of \
In[772]:=",ExpressionUUID->"09dad22e-53fb-4946-bcde-401cb8403b28"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    RowBox[{"-", "anomEta"}], "+", "dim", "+", "2"}], 
   RowBox[{"anomEta", "+", "dim", "-", "2"}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.0043001992064056`*^9},
 CellLabel->
  "Out[790]=",ExpressionUUID->"e6724559-9ad4-eb40-ade6-aebd7e6a380c"],

Cell[BoxData[
 FormBox["\<\"Source-term scaling check (expected: 0):\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.0043001992064056`*^9},
 CellLabel->
  "During evaluation of \
In[772]:=",ExpressionUUID->"34e329d0-77c2-1546-ac07-66da460ea5c4"],

Cell[BoxData[
 FormBox["0", TraditionalForm]], "Output",
 CellChangeTimes->{4.004300199216181*^9},
 CellLabel->
  "Out[792]=",ExpressionUUID->"cfddad34-aaf1-3149-8d19-623e8fb69ad6"],

Cell[BoxData[
 FormBox["\<\"Critical-isotherm exponent check (expected: 0):\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004300199216181*^9},
 CellLabel->
  "During evaluation of \
In[772]:=",ExpressionUUID->"6e29eed2-7ed1-f44a-8375-cceebdc491ce"],

Cell[BoxData[
 FormBox["0", TraditionalForm]], "Output",
 CellChangeTimes->{4.004300199216181*^9},
 CellLabel->
  "Out[794]=",ExpressionUUID->"ea932d0e-39e3-f74d-921d-0641e196c5fe"],

Cell[BoxData[
 FormBox["\<\"Invariance of h^Delta_phi / M^Delta_h (expected: 1):\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004300199216181*^9},
 CellLabel->
  "During evaluation of \
In[772]:=",ExpressionUUID->"b93f9576-928c-244c-acba-1e60e11ad477"],

Cell[BoxData[
 FormBox["1", TraditionalForm]], "Output",
 CellChangeTimes->{4.004300199216181*^9},
 CellLabel->
  "Out[796]=",ExpressionUUID->"80e9a858-90af-c345-a1c4-8730032a495b"],

Cell[BoxData[
 FormBox["\<\"Same relation with d = 4 - e and eta from 2.2.4:\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.0043001992271824`*^9},
 CellLabel->
  "During evaluation of \
In[772]:=",ExpressionUUID->"09e628ab-7afe-4e4e-b087-58d34decc36c"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{"324", "-", 
    RowBox[{"e", " ", 
     RowBox[{"(", 
      RowBox[{"e", "+", "54"}], ")"}]}]}], 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"e", "-", "54"}], ")"}], " ", "e"}], "+", "108"}]], 
  TraditionalForm]], "Output",
 CellChangeTimes->{4.0043001992271824`*^9},
 CellLabel->
  "Out[798]=",ExpressionUUID->"4d56f517-2f90-004f-87bd-501e398b3c38"],

