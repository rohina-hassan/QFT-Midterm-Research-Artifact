    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"gaussianStabilityClassification", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", "gaussianStabilitySign", "]"}], 
       ",", "\"\<UV-attractive; IR-repulsive (IR-relevant)\>\"", 
       ",", "\"\<Not classified\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{"nontrivialStabilityClassification", "=", 
