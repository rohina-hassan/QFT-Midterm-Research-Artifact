       RowBox[{"TrueQ", "[", "nontrivialStabilitySign", "]"}], 
       ",", "\"\<UV-repulsive; IR-attractive (IR-irrelevant)\>\"", 
       ",", "\"\<Not classified\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Gaussian stability inequality (expected: True):\>\"", 
     "]"}], ";"}], "\n", "gaussianStabilitySign", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Wilson-Fisher stability inequality (expected: True):\>\
\"", "]"}], ";"}], "\n", "nontrivialStabilitySign", "\[IndentingNewLine]", "\n", 
