 FormBox[
  FractionBox[
   SuperscriptBox["lam", "2"], 
   RowBox[{"3072", " ", 
    SuperscriptBox["\[Pi]", "4"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.0042959013441544`*^9, 4.0042996269467506`*^9},
