Cell[CellGroupData[{

Cell[TextData[StyleBox["PART 1\[LongDash]ONE LOOP AND TWO REGULATORS",
 FontFamily->"Arial",
 FontSize->18,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.14901960784313725`, 0.29411764705882354`, 
   0.43137254901960786`]]], "Section",
 CellChangeTimes->{{4.003815329246933*^9, 
  4.003815336066719*^9}},ExpressionUUID->"d4dd7b83-8856-ec43-9bc0-\
f88775b55b79"],

Cell[TextData[{
 StyleBox["We work in Euclidean signature with ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["m", "2"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7d2882a8-3ac9-cd42-be02-8e42b87fd2e3"],
 StyleBox[" > 0 and spacetime dimension d = 4 - \[Epsilon]. The dimensionless \
coupling is defined as g = ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   FractionBox["\[Lambda]", 
    RowBox[{"16", 
     SuperscriptBox["\[Pi]", "2"]}]], TraditionalForm]],
  FontSize->13,ExpressionUUID->"04a9aa4d-b5aa-9748-b1ee-b44a8de53046"],
 StyleBox[" .\nIn dimensional regularization, we include one factor of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Mu]", "\[Epsilon]"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e56a032c-82f9-794d-9b4e-f82165f6705a"],
 StyleBox[" per loop . For the sharp - cutoff calculation, we work directly \
in four dimensions . FeynCalc uses the convention ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], "\[LongEqual]", "4", "-", "2", 
         SubscriptBox["\[Epsilon]", 
          StyleBox["FC", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "D=4-2\\epsilon_{\\mathrm{FC}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2ff3d28c-0fc2-4040-80d0-a50c2aec5b5b"],
 StyleBox[" , so the project parameter and FeynCalc parameter are related by ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "2", 
         SubscriptBox["\[Epsilon]", 
          StyleBox["FC", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=2 \\epsilon_{\\mathrm{FC}}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"df6d21b8-b7eb-6847-be6b-2900a58d15ee"],
 StyleBox[".",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0038153798370667`*^9, 4.0038153868918133`*^9}, {
  4.0038156979766846`*^9, 4.0038158177586784`*^9}, {4.003815858776451*^9, 
  4.0038159168966084`*^9}, {4.003816031186512*^9, 4.0038160333884068`*^9}, {
  4.003824662108095*^9, 4.003824664364811*^9}, {4.003824700295538*^9, 
  4.003824708325474*^9}},ExpressionUUID->"c50874e1-65d4-6e4b-9edc-\
8e0e69c73b15"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.1 One - Loop Diagrams",
 FontFamily->"Arial",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.19607843137254902`, 0.49411764705882355`, 
   0.4392156862745098]]], "Subsection",
 CellChangeTimes->{{4.003816035444687*^9, 4.0038160433757915`*^9}, {
  4.003900219599453*^9, 
  4.003900223369772*^9}},ExpressionUUID->"b044ac30-458f-6446-9925-\
0b2e3acf23a1"],

Cell[TextData[{
 StyleBox["In this section, we evaluate the one-loop corrections to the \
two-point and four-point 1PI functions in the scalar ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Phi]", "4"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\phi^4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b6c70319-f3ad-954c-8937-b59bf1eeacc3"],
 StyleBox[" ",
  FontSize->13],
 StyleBox["theory. We begin in 1.1.1 by defining the Euclidean action, \
establishing our mass dimensions and dimensional-regularization conventions, \
and listing the Feynman rules derived from the path-integral formulation. In \
1.1.2, we identify the tadpole diagram, discuss its momentum-independent \
nature, and perform the analytical derivation of its contribution to the \
self-energy. We proceed in 1.1.3 to analyze the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3904ba84-efd8-4147-aa53-559d2ba9941c"],
 "-",
 StyleBox[", ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["t", "TI"], TraditionalForm], "errors" -> {}, "input" -> "t", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "64fc8a00-ca98-9d44-997f-6e4c7b129de9"],
 StyleBox["-, and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "547b5c1a-6098-ff48-ac4e-8c2d7fe560eb"],
 StyleBox["-channels of the four-point function, defining the bubble integral \
",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "(", 
         StyleBox["P", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "B(P)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8c425f88-df6a-e040-ad4f-51a863d852c8"],
 StyleBox[" ",
  FontSize->13],
 StyleBox["that describes the one-loop correction. In 1.1.4 we map the \
FeynArts topologies to the physical channels and verify the symmetry factors. \
In 1.1.5 we identify the FeynArts model with our conventions and fix the Wick \
rotation, loop measure and sign convention. In 1.1.6 we convert the \
amplitudes with FeynCalc and reduce them with ToPaVe. In 1.1.7 we match the \
resulting PaVe forms to the Euclidean one-loop contributions.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0039134008777256`*^9, 4.003913646916897*^9}, {
   4.003919944402319*^9, 4.003919997218281*^9}, 4.0041693286335964`*^9, {
   4.0041720525623684`*^9, 4.0041720573697033`*^9}, 4.0041994729659176`*^9, {
   4.0042014334528027`*^9, 4.0042015067777557`*^9}, {4.0042015677231083`*^9, 
   4.0042015723824787`*^9}, 
   4.0042038491198425`*^9},ExpressionUUID->"28c47cb2-2802-e24b-9085-\
449ac814ace1"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.1.1 Model and Feynman Rules",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.0038160589163113`*^9, 4.003816066906307*^9}, 
   4.0038173322945976`*^9},ExpressionUUID->"473d8d66-114d-5b48-8bd4-\
cde992661a63"],

Cell[TextData[{
 StyleBox["We consider a real scalar field ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Phi]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\phi(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6b84490c-bb6c-2d48-8ef4-f5f5245113bf"],
 StyleBox[" with quartic self-interaction in (",
  FontSize->13],
 StyleBox["d = 4 - \[Epsilon])", "DisplayFormula",
  FontSize->13],
 StyleBox[" spacetime dimensions. The theory is defined by the Euclidean \
action \n\n                                                                   \
                                  ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], 
          StyleBox["E", "TI"]], 
         RowBox[{"[", "\[Phi]", "]"}], "\[LongEqual]", "\[Integral]", 
         SuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["d", "TI"]], 
         StyleBox["x", "TI"], 
         RowBox[{"[", 
           RowBox[{
             FractionBox["1", "2"], 
             SuperscriptBox[
              RowBox[{"(", 
                RowBox[{
                  SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}], ")"}], 
              "2"], "+", 
             FractionBox["1", "2"], 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"], 
             SuperscriptBox["\[Phi]", "2"], "+", 
             FractionBox[
              RowBox[{
                SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Lambda]"}], "4!"], 
             SuperscriptBox["\[Phi]", "4"]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "S_E[\\phi]=\\int d^dx\\left[\n\\frac{1}{2}(\\partial_\\mu\\phi)^2\n\
+\\frac{1}{2}m^2\\phi^2\n+\\frac{\\mu^\\epsilon\\lambda}{4!}\\phi^4\n\
\\right]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"23b65fad-e338-9e40-8d1d-a6a1713063ec"],
 "                                                                  ",
 StyleBox["(A-01)",
  FontSize->13],
 "                                                                            \
                                                                              \
        \n\n",
 StyleBox["Here, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Lambda]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "947011d3-0795-244f-a3c8-39db93ffb4d7"],
 StyleBox[" is the dimensionless quartic coupling, ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Mu]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"245cdcbf-1658-d04b-8c00-7ba2c57c7c44"],
 StyleBox[" is the dimensional-regularization scale, and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "4", "-", 
         StyleBox["d", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\epsilon=4-d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"b29313de-65cd-0a49-8ad4-4d91a45bab59"],
 StyleBox[". The factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", "\[Epsilon]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mu^{\\epsilon}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5fc84cf8-0ffd-514d-9d7e-e909697fa644"],
 StyleBox[" is introduced so that the coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Lambda]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d4f52503-2af4-164b-8009-8bab62801619"],
 StyleBox[" remains dimensionless when the spacetime dimension is \
analytically continued away from four dimensions.\nWe use the Euclidean \
path-integral convention:\n\n                                                 \
                                                                              \
 ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Z", "TI"], "\[LongEqual]", "\[Integral]", 
         StyleBox["D", "TI"], "\[Phi] ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
            SubscriptBox[
             StyleBox["S", "TI"], 
             StyleBox["E", "TI"]], 
            RowBox[{"[", "\[Phi]", "]"}]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "Z=\\int\\mathcal D\\phi\\,e^{-S_E[\\phi]}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8a2e2564-d990-5f44-91b6-8a9ee2d2c301"],
 "\n\n",
 StyleBox["Consequently, the interaction contribution enters the perturbative \
expansion with a minus sign. This sign convention will be important when \
distinguishing the interaction vertex used in perturbative diagrams from the \
tree-level four-point 1PI vertex.",
  FontSize->13],
 "\n\n",
 StyleBox["Proof:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox[" The coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Lambda]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"adda03fa-2f96-164a-a5a7-f85718ba8f92"],
 StyleBox[" is dimensionless, while the combination ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Lambda]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu^{\\epsilon}\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"859c37f5-96b6-c240-82ce-1869d6c0ed76"],
 StyleBox[" has the required mass dimension ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"4", "-", 
         StyleBox["d", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "4-d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7e5d7e55-359a-8e47-b8ee-cfef0132fd1b"],
 StyleBox[" of the quartic coupling in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["d", "TI"], TraditionalForm], "errors" -> {}, "input" -> "d", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5d009a22-58be-404d-bed3-05ac7f813e15"],
 StyleBox[" dimensions.\nFirst, We need to determine the mass dimensions of \
the field and the parameters. We use natural units, in which the action is \
dimensionless: ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           SubscriptBox[
            StyleBox["S", "TI"], 
            StyleBox["E", "TI"]], "]"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "[S_E]=0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"528f4dcd-7f62-6b43-bda1-a85dc0380001"],
 ". ",
 StyleBox["Since ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           RowBox[{
             SuperscriptBox[
              StyleBox["d", "TI"], 
              StyleBox["d", "TI"]], 
             StyleBox["x", "TI"]}], "]"}], "\[LongEqual]", "-", 
         StyleBox["d", "TI"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "[d^dx]=-d,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4428c3c9-4690-274c-ac7e-8806921aca4a"],
 StyleBox[" the Lagrangian density must have mass dimension ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           StyleBox["L", "TI"], "]"}], "\[LongEqual]", 
         StyleBox["d", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "[\\mathcal{L}] =d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"81592bf0-db92-b542-99a4-737cd8856dbf"],
 StyleBox[". \nNow, Consider the kinetic term in the action. Since a \
spacetime derivative has ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           SubscriptBox["\[PartialD]", "\[Mu]"], "]"}], "\[LongEqual]", "1", 
         ","}], TraditionalForm], "errors" -> {}, "input" -> 
     "[\\partial_\\mu]=1,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0466fcb7-c0e3-284e-8c4d-d089c7668654"],
 StyleBox[" we have:\n\n                                                      \
                             ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           SubscriptBox[
            StyleBox["S", "TI"], 
            StyleBox["E", "TI"]], "]"}], "\[LongEqual]", 
         RowBox[{"[", 
           RowBox[{
             SuperscriptBox[
              StyleBox["d", "TI"], 
              StyleBox["d", "TI"]], 
             StyleBox["x", "TI"]}], "]"}], "+", "2", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{"[", 
               SubscriptBox["\[PartialD]", "\[Mu]"], "]"}], "+", 
             RowBox[{"[", "\[Phi]", "]"}]}], ")"}], "    ", "\[Rule]    ", 
         "0", "\[LongEqual]", "-", 
         StyleBox["d", "TI"], "+", "2", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             RowBox[{"[", "\[Phi]", "]"}]}], ")"}], "    ", "\[Rule]    ", 
         RowBox[{"[", "\[Phi]", "]"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], "-", "2"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "[S_E] = [d^dx] + 2([\\partial_{\\mu}] + [\\phi])  \\qquad \\rightarrow \
\\qquad 0 = -d+2(1+[\\phi]) \\qquad \\rightarrow \\qquad [\\phi] = \
\\frac{d-2}{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0ddfaefa-4221-f742-a6a6-4d13be117447"],
 "                                            ",
 StyleBox["(A-02)",
  FontSize->13],
 "\n                                           \n",
 StyleBox["Now, let\[CloseCurlyQuote]s focus on the interaction term and use \
the relation we found for mass dimension of the scalar field. Note that ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Mu]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f60b2249-b4d8-0b45-8145-2b0ae11ea1ff"],
 StyleBox[" is a mass scale. Keeping this in mind, we have:\n\n               \
                                                 ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           SubscriptBox[
            StyleBox["S", "TI"], 
            StyleBox["E", "TI"]], "]"}], "\[LongEqual]", 
         RowBox[{"[", 
           RowBox[{
             SuperscriptBox[
              StyleBox["d", "TI"], 
              StyleBox["d", "TI"]], 
             StyleBox["x", "TI"]}], "]"}], "+", 
         RowBox[{"[", 
           SuperscriptBox["\[Mu]", "\[Epsilon]"], "]"}], "+", 
         RowBox[{"[", "\[Lambda]", "]"}], "+", "4", 
         RowBox[{"[", "\[Phi]", "]"}], "    ", "\[Rule]    ", "0", 
         "\[LongEqual]", "-", 
         StyleBox["d", "TI"], "+", "\[Epsilon]", "+", 
         RowBox[{"[", "\[Lambda]", "]"}], "+", "4", 
         RowBox[{"(", 
           FractionBox[
            RowBox[{
              StyleBox["d", "TI"], "-", "2"}], "2"], ")"}], "    ", 
         "\[Rule]    ", 
         RowBox[{"[", "\[Lambda]", "]"}], "\[LongEqual]", "-", 
         StyleBox["d", "TI"], "+", "4", "-", "\[Epsilon]"}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "[S_E] = [d^dx] + [\\mu^{\\epsilon}] + [\\lambda] + 4[\\phi] \\qquad \
\\rightarrow \\qquad 0= -d + \\epsilon + [\\lambda] + 4(\\frac{d-2}{2}) \
\\qquad \\rightarrow \\qquad [\\lambda] = -d+4-\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"43d2e6be-afa1-b64a-ad1e-8eefab112f0d"],
 StyleBox["\n\nBut we have: ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "4", "-", 
         StyleBox["d", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\epsilon=4-d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1f9bd292-ea89-be43-b0c1-8c7f21341869"],
 ". ",
 StyleBox["Therefore, we conclude ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", "\[Lambda]", "]"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "[\\lambda] = 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a2e0e5f3-a46d-da4f-9ee4-c3509f2c105d"],
 StyleBox[" and the coupling is dimensionless, while the combination ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Lambda]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu^{\\epsilon} \\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"40557595-b795-464e-a84b-f24e83a1037a"],
 StyleBox[" has the required mass dimension ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"4", "-", 
         StyleBox["d", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "4-d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1a5212b6-bd26-5f48-a92c-c1c0a04b202f"],
 StyleBox[" of the quartic coupling in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["d", "TI"], TraditionalForm], "errors" -> {}, "input" -> "d", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"779ab818-eea9-2743-9a56-b625d7dc90e1"],
 StyleBox[" dimensions.\n\n",
  FontSize->13],
 StyleBox["Free theory and the propagator:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nWe first separate the action into its quadratic and interaction \
parts: ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], 
          StyleBox["E", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["S", "TI"], 
          RowBox[{
            StyleBox["E", "TI"], ",", "0"}]], "+", 
         SubscriptBox[
          StyleBox["S", "TI"], 
          RowBox[{
            StyleBox["E", "TI"], ",", 
            StyleBox["i", "TI"], 
            StyleBox["n", "TI"], 
            StyleBox["t", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "S_E = S_{E,0} + S_{E,int}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"bb53e496-47fe-d44f-9e21-ead0e21a338b"],
 StyleBox[" where:\n\n                                                        \
                        ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], 
          RowBox[{
            StyleBox["E", "TI"], ",", "0"}]], "\[LongEqual]", "\[Integral]", 
         SuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["d", "TI"]], 
         StyleBox["x", "TI"], 
         RowBox[{"[", 
           RowBox[{
             FractionBox["1", "2"], 
             SuperscriptBox[
              RowBox[{"(", 
                RowBox[{
                  SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}], ")"}], 
              "2"], "+", 
             FractionBox["1", "2"], 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"], 
             SuperscriptBox["\[Phi]", "2"]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "S_{E,0}=\\int d^dx\\left[\n\\frac{1}{2}(\\partial_\\mu\\phi)^2\n\
+\\frac{1}{2}m^2\\phi^2\n\\right]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0ab8287c-d546-2249-9841-7211ef6201d4"],
 StyleBox["           and           ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], 
          RowBox[{
            StyleBox["E", "TI"], ",", 
            StyleBox["i", "TI"], 
            StyleBox["n", "TI"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "\[Integral]", 
         SuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["d", "TI"]], 
         StyleBox["x", "TI"], 
         RowBox[{"[", 
           RowBox[{
             FractionBox[
              RowBox[{
                SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Lambda]"}], "4!"], 
             SuperscriptBox["\[Phi]", "4"]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "S_{E,int}=\\int d^dx\\left[\n\\frac{\\mu^\\epsilon\\lambda}{4!}\\phi^4\n\
\\right]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7fd456a9-be77-3c48-afb7-0952c75e772f"],
 "\n",
 StyleBox["\nTo identify the free propagator, we rewrite the quadratic action \
in operator form. Assuming that boundary terms vanish, integration by parts \
gives:\n\n                                                                    \
                                             ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Integral]", 
         SuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["d", "TI"]], 
         StyleBox["x", "TI"], " ", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}], ")"}], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]"}], ")"}], 
         "\[LongEqual]", "-", "\[Integral]", 
         SuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["d", "TI"]], 
         StyleBox["x", "TI"], " ", "\[Phi] ", 
         SuperscriptBox["\[PartialD]", "2"], "\[Phi]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\int d^dx\\,(\\partial_\\mu\\phi)(\\partial_\\mu\\phi)\n=\n-\\int d^dx\
\\,\\phi\\,\\partial^2\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"27fa65f1-6d0d-6049-82e2-8c055f54ef8f"],
 "\n",
 StyleBox["\nwhere ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "\[LongEqual]", 
         SubscriptBox["\[PartialD]", "\[Mu]"], 
         SubscriptBox["\[PartialD]", "\[Mu]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\partial^2=\\partial_\\mu\\partial_\\mu", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"efd2dc1d-aaeb-9d4b-aa49-f3dc66da19ea"],
 StyleBox["  is the Euclidean Laplacian. Therefore,\n\n                       \
                                                                              \
                     ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], 
          RowBox[{
            StyleBox["E", "TI"], ",", "0"}]], "\[LongEqual]", 
         FractionBox["1", "2"], "\[Integral]", 
         SuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["d", "TI"]], 
         StyleBox["x", "TI"], " ", "\[Phi]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SuperscriptBox["\[PartialD]", "2"], "+", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"]}], ")"}], "\[Phi]", "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "S_{E,0}\n=\n\\frac{1}{2}\\int d^dx\\,\n\\phi(-\\partial^2+m^2)\\phi.", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9a306ab9-df8d-404f-ad7a-921321c116e9"],
 "\n",
 StyleBox["\nThe differential operator appearing in this expression is the \
inverse free propagator in position space. To obtain its momentum-space form, \
we use the Fourier convention:\n\n                                            \
                                                                              \
    ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Phi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], " ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["k", "TI"], "\[CenterDot]", 
            StyleBox["x", "TI"]}]], "\[Phi]", 
         RowBox[{"(", 
           StyleBox["k", "TI"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\phi(x)=\n\\int\\frac{d^dk}{(2\\pi)^d}\\,\ne^{ik\\cdot x}\\phi(k).", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"846d8083-342c-ba4f-83f0-a8718114df2f"],
 "\n",
 StyleBox["\nUnder this transformation, derivatives act as ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", "\[Mu]"], "\[Phi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongLeftRightArrow]", 
         StyleBox["i", "TI"], 
         SubscriptBox[
          StyleBox["k", "TI"], "\[Mu]"], "\[Phi]", 
         RowBox[{"(", 
           StyleBox["k", "TI"], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\partial_\\mu\\phi(x)\n\\longleftrightarrow\nik_\\mu\\phi(k),", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f08f5ac2-c6ce-3343-987f-00603f0de486"],
 StyleBox[" and hence ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SuperscriptBox["\[PartialD]", "2"], "\[LongLeftRightArrow]", 
         SuperscriptBox[
          StyleBox["k", "TI"], "2"], ",    ", 
         SuperscriptBox[
          StyleBox["k", "TI"], "2"], "\[Congruent]", 
         SubscriptBox[
          StyleBox["k", "TI"], "\[Mu]"], 
         SubscriptBox[
          StyleBox["k", "TI"], "\[Mu]"], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "-\\partial^2\n\\longleftrightarrow\nk^2,\n\\qquad\nk^2\\equiv k_\\mu k_\
\\mu.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4528b150-3085-7541-9fd5-5d0cf0274c01"],
 StyleBox[" The quadratic action consequently becomes:\n\n                    \
                                                                              \
                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], 
          RowBox[{
            StyleBox["E", "TI"], ",", "0"}]], "\[LongEqual]", 
         FractionBox["1", "2"], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], " ", "\[Phi]", 
         RowBox[{"(", 
           StyleBox["k", "TI"], ")"}], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["k", "TI"], "2"], "+", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"]}], ")"}], "\[Phi]", 
         RowBox[{"(", 
           RowBox[{"-", 
             StyleBox["k", "TI"]}], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "S_{E,0}\n=\n\\frac{1}{2}\\int\\frac{d^dk}{(2\\pi)^d}\\,\n\
\\phi(k)(k^2+m^2)\\phi(-k).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e36e8bfb-6334-4846-abbd-c043a3d97340"],
 "\n",
 StyleBox["\nThe free propagator is the inverse of the quadratic \
momentum-space operator. Thus, the Euclidean scalar propagator is:\n\n        \
                                                                              \
                                                    ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", 
          StyleBox["E", "TI"]], 
         RowBox[{"(", 
           StyleBox["k", "TI"], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> "\\boxed{\n\\Delta_E(k)=\\frac{1}{k^2+m^2}\n}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d5f88b1b-2054-1241-909d-a06aff0a92d6"],
 "                                                                            \
              ",
 StyleBox["(A-03)\n\n",
  FontSize->13],
 StyleBox["Quartic interaction vertex:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nConsider the quartic interaction term in the Euclidean action. \
To obtain the interaction vertex, we expand the Euclidean path-integral \
weight: ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
            SubscriptBox[
             StyleBox["S", "TI"], 
             RowBox[{
               StyleBox["E", "TI"], ",", 
               StyleBox["int", FontSlant -> "Plain"]}]]}]], "\[LongEqual]", 
         "1", "-", 
         SubscriptBox[
          StyleBox["S", "TI"], 
          RowBox[{
            StyleBox["E", "TI"], ",", 
            StyleBox["int", FontSlant -> "Plain"]}]], "+", 
         StyleBox["O", "TI"], 
         RowBox[{"(", 
           SuperscriptBox["\[Lambda]", "2"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "e^{-S_{E,\\mathrm{int}}}\n=\n1-S_{E,\\mathrm{int}}+\\mathcal \
O(\\lambda^2).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"13529344-649b-3147-85e2-6327d3faeff8"],
 StyleBox["\nTherefore, the first-order interaction contribution carries a \
minus sign. The factor 1/4! in the action cancels the 4! possible \
contractions of the four identical scalar fields with the external lines. \
Consequently, the quartic interaction vertex in the Euclidean perturbative \
Feynman rules is:\n\n                                                         \
                                                                              \
              ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Lambda]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "-\\mu^\\epsilon\\lambda",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"99d00d36-3c51-a345-b5d8-f59803b3ec4c"],
 "                                                                            \
                        ",
 StyleBox["(A-04)\n\nNote that the negative sign comes from expanding ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          SubscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["E", "TI"]]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "e^{-S_E}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"9196ec36-0c06-e444-b171-c071c137f17a"],
 StyleBox[", and therefore belongs to the perturbative Feynman-rule vertex. \
It should not be confused with the tree-level four-point 1PI vertex, which is \
obtained by differentiating the classical Euclidean action four times with \
respect to the field. At tree level, this gives ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          StyleBox["tree", FontSlant -> "Plain"], 
          RowBox[{"(", "4", ")"}]], "\[LongEqual]", 
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Lambda]", "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma_{\\mathrm{tree}}^{(4)}=\\mu^\\epsilon\\lambda.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e3319d85-87df-c743-ae8a-8ecfe8408f58"],
 " \n",
 StyleBox["Thus, the perturbative interaction vertex is negative, whereas the \
tree-level four-point 1PI vertex is positive. According to the convention \
adopted in this project, we strip the overall factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", "\[Epsilon]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mu^\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"27038475-d54d-fc46-b942-85a977b17ccc"],
 StyleBox[" from the tree-level 1PI vertex and write ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalGamma]", 
          StyleBox["tree", FontSlant -> "Plain"], 
          RowBox[{"(", "4", ")"}]], "\[LongEqual]", "\[Lambda]", "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Gamma_{\\mathrm{tree}}^{(4)}=\\lambda.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e5870fdf-8592-0447-9eac-d8d0037d7cd4"],
 " ",
 StyleBox["(A-05)",
  FontSize->13],
 "\n\n",
 StyleBox["Dimensional-regularization loop measure:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nIn dimensional regularization, loop momenta are integrated over ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "d=4-\\epsilon", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8e971276-65ee-1c49-a5fc-ca182150c975"],
 StyleBox[" dimensions. Each independent loop integration is accompanied by \
one factor of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", "\[Epsilon]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mu^\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"865bb0d1-7b27-344a-af6e-3170e82bef5a"],
 StyleBox[". Thus, for a diagram with L independent loops, the \
dimensional-regularization scale contributes an overall factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", 
        RowBox[{
          StyleBox["L", "TI"], "\[Epsilon]"}]], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mu^{L\\epsilon}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"44ff3048-24d1-ca42-9559-0ed43c5dfd9f"],
 StyleBox[".\nFor a single loop, the integration measure is therefore written \
as: \n\n                                                                      \
                                                                       ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu^\\epsilon\\int\\frac{d^dk}{(2\\pi)^d}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8d540b2f-9587-074f-aa80-002e867a1c5d"],
 "                                                                            \
                    ",
 StyleBox[" (A-06)",
  FontSize->13],
 "\n\n",
 StyleBox["Again note that: In this project, the overall tree-level factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", "\[Epsilon]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mu^\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"a8c05fed-3d2f-6943-b87e-f9c6d575ecd2"],
 StyleBox[" is stripped from the four-point 1PI vertex, while the factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", "\[Epsilon]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mu^\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"44d7d402-d94b-aa45-8ec8-04f7259cb05b"],
 StyleBox[" associated with each loop integration is retained. This \
convention must be applied consistently when evaluating loop diagrams and \
comparing the results obtained using different regularization schemes.\n",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0038161685870056`*^9, 4.0038162021464024`*^9}, {
   4.003821958538904*^9, 4.0038219592950726`*^9}, {4.003822353188328*^9, 
   4.0038226889779224`*^9}, {4.003822765197874*^9, 4.0038228000193653`*^9}, {
   4.003822854017639*^9, 4.0038229429522247`*^9}, {4.003823074252165*^9, 
   4.003823203578335*^9}, {4.0038232395672073`*^9, 4.0038232536274185`*^9}, {
   4.003823301287016*^9, 4.0038233206772137`*^9}, {4.0038233756169147`*^9, 
   4.0038234026168423`*^9}, {4.003823474086891*^9, 4.0038235478367214`*^9}, {
   4.0038235792765255`*^9, 4.003823691356739*^9}, {4.003823756197956*^9, 
   4.003823884496208*^9}, {4.00382393796603*^9, 4.003824462195116*^9}, {
   4.0038245094858856`*^9, 4.0038245125952873`*^9}, {4.0038245501708393`*^9, 
   4.003824555675274*^9}, {4.0038245918452225`*^9, 4.0038246209878025`*^9}, {
   4.0038247630324*^9, 4.0038247754350643`*^9}, 4.003824811304899*^9, {
   4.003824890194849*^9, 4.003824899868227*^9}, {4.003825047064974*^9, 
   4.0038252724575806`*^9}, {4.0038253310647373`*^9, 
   4.0038253878943615`*^9}, {4.0038277725710945`*^9, 4.003828032847851*^9}, {
   4.003828078273758*^9, 4.003828122080965*^9}, {4.0038281704588966`*^9, 
   4.003828331660761*^9}, {4.003828366560295*^9, 4.003828382250849*^9}, {
   4.003829308279194*^9, 4.003829322940178*^9}, {4.003830073608616*^9, 
   4.0038300877679977`*^9}, {4.003830382474039*^9, 4.0038303926676006`*^9}, 
   4.0038304290277977`*^9, {4.0038305824476223`*^9, 4.003830662708214*^9}, {
   4.003830699905096*^9, 4.0038307489875546`*^9}, {4.003830787323187*^9, 
   4.0038308275270348`*^9}, {4.003830878347292*^9, 4.003830946386894*^9}, {
   4.0038310670122757`*^9, 4.0038312159569263`*^9}, {4.003831331606516*^9, 
   4.0038313384978275`*^9}, {4.0038313966864967`*^9, 
   4.0038314233064384`*^9}, {4.003831454096548*^9, 4.0038314596262817`*^9}, {
   4.0038317902361336`*^9, 4.0038318203062916`*^9}, {4.0038319000661335`*^9, 
   4.003831997362995*^9}, {4.0038320490906887`*^9, 4.0038321104661846`*^9}, {
   4.00383227569701*^9, 4.0038323261653767`*^9}, {4.0038325827909203`*^9, 
   4.003832585085226*^9}, 4.0038327092107697`*^9, {4.003832829554756*^9, 
   4.0038328477352905`*^9}, {4.0038329617249527`*^9, 
   4.0038330167346687`*^9}, {4.003833100556059*^9, 4.00383315805418*^9}, {
   4.003833210754183*^9, 4.0038332237050743`*^9}, {4.003833258625944*^9, 
   4.0038332626940823`*^9}, {4.0038333109155254`*^9, 4.003833375784155*^9}, {
   4.003833417774246*^9, 4.003833427781986*^9}, {4.0038334820238285`*^9, 
   4.003833504944088*^9}, {4.0038335535137234`*^9, 4.0038336818528557`*^9}, {
   4.003833725068859*^9, 4.0038337477836456`*^9}, {4.003833802073679*^9, 
   4.003833906293932*^9}, {4.003889061951784*^9, 4.0038890958650455`*^9}, {
   4.003889229336626*^9, 4.0038892504449863`*^9}, {4.003889376790064*^9, 
   4.003889415211109*^9}, {4.0038896325687447`*^9, 4.003889751226265*^9}, {
   4.0038898342620106`*^9, 4.0038898505114746`*^9}, {4.0038898825204544`*^9, 
   4.0038898934895706`*^9}, {4.0038899261063366`*^9, 4.003889971731144*^9}, {
   4.003890031644764*^9, 4.003890037751753*^9}, {4.003890114769661*^9, 
   4.003890212091818*^9}, {4.003890286189186*^9, 4.003890338200922*^9}, {
   4.0038904037067833`*^9, 4.003890472094473*^9}, {4.0038905021486435`*^9, 
   4.0038905413090115`*^9}, {4.0039027359041634`*^9, 4.003902816629875*^9}, {
   4.003902848921936*^9, 4.0039028919057045`*^9}, {4.0041588073985195`*^9, 
   4.0041588202529297`*^9}, {4.004202188932188*^9, 4.0042022137131805`*^9}, {
   4.0042023051031303`*^9, 4.0042023350117702`*^9}, {4.004202368911768*^9, 
   4.004202389511921*^9}, {4.0042024595018654`*^9, 
   4.00420248941572*^9}},ExpressionUUID->"3a5f4501-dbdc-8940-a753-\
d3b5a190f2d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Parameters"}]}], " ", "and", " ", 
     RowBox[{"Conventions", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "d", ",", "e", ",", "muR", ",", "lam", ",", "m2", ",", "iProp", ",", 
      "Prop", ",", "v4", ",", "v4tree", ",", "dloop"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"d", ":", "dimension"}], ",", " ", 
     RowBox[{"e", ":", "epsilon"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"d", "=", 
     RowBox[{"4", "-", "e"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"muR", ":", 
      RowBox[{"Renormalization", " ", "scale"}]}], ",", 
     RowBox[{"lam", ":", "Coupling"}], ",", 
     RowBox[{"m2", ":", 
      RowBox[{"Mass", " ", "squared"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"assumptions", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", ",", "muR", ",", "lam", ",", "m2"}], "}"}], "\[Element]",
        "Reals"}], "&&", 
      RowBox[{"m2", ">", "0"}], "&&", 
      RowBox[{"muR", ">", "0"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", 
       RowBox[{"Propagators", "--"}]}]}], "-"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Inverse", " ", 
      RowBox[{"propagator", ":", 
       RowBox[{"D", "^", 
        RowBox[{"-", "1"}]}]}]}], "=", 
     RowBox[{
      RowBox[{"k", "^", "2"}], "+", 
      RowBox[{"m", "^", "2"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"iProp", "[", "k_", "]"}], ":=", 
     RowBox[{
      RowBox[{"k", "^", "2"}], "+", "m2"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Scalar", " ", 
      RowBox[{"propagator", ":", "D"}]}], "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "^", "2"}], "+", 
        RowBox[{"m", "^", "2"}]}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Prop", "[", "k_", "]"}], ":=", 
     RowBox[{"1", "/", 
      RowBox[{"iProp", "[", "k", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", 
       RowBox[{"Vertices", "--"}]}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Tree", "-", 
     RowBox[{"level", " ", "four"}], "-", 
     RowBox[{"point", " ", 
      RowBox[{"vertex", ":", 
       RowBox[{"overall", " ", 
        RowBox[{"muR", "^", "e"}], " ", "stripped"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v4tree", "=", "lam"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Interaction", " ", "vertex", " ", "used", " ", "in", " ", "the", " ", 
     "Euclidean", " ", "diagrams"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v4", "=", 
     RowBox[{"-", "lam"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Dimensional"}]}], "-", 
     RowBox[{"Regularization", " ", "Loop", " ", 
      RowBox[{"Measure", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"One", " ", 
     RowBox[{"muR", "^", "e"}], " ", "factor", " ", "per", " ", "independent",
      " ", "loop"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dloop", "[", "k_", "]"}], ":=", 
     RowBox[{
      RowBox[{"muR", "^", "e"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", "Pi"}], ")"}], "^", "d"}]}]}], ";"}]}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{4.003825459064049*^9, 4.003825459064049*^9}, {
   4.0038258292016087`*^9, 4.0038258502239113`*^9}, {4.003825999107872*^9, 
   4.003826253703045*^9}, 4.0039031111051483`*^9, {4.003909209442425*^9, 
   4.003909212479933*^9}, {4.003909604919401*^9, 4.003909605181959*^9}, 
   4.0040092760420322`*^9, {4.004159357198303*^9, 4.004159393933834*^9}, {
   4.0041598702063656`*^9, 4.004159870541916*^9}, {4.004160880051796*^9, 
   4.0041608987622776`*^9}, 4.0041619577864285`*^9, 4.004172944668991*^9},
 Background->GrayLevel[0.749],
 CellLabel->"In[10]:=",ExpressionUUID->"3a6d7371-a658-414a-82df-caf3f59c2553"],

