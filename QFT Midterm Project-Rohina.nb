              FormBox["\<\")\"\>",
               TraditionalForm]}], "2"], "\[InvisibleSpace]", "\<\"-\"\>", "\[InvisibleSpace]", 
            SuperscriptBox["mphi", "2"]}],
           SequenceForm[
            FeynCalc`Pair[
             
             FeynCalc`Momentum[$CellContext`k + $CellContext`p2 - \
$CellContext`p3, D], 
             
             FeynCalc`Momentum[$CellContext`k + $CellContext`p2 - \
$CellContext`p3, D]], "-", $CellContext`mphi^2],
           Editable->False], ")"}]}]}]]}],
     TraditionalForm]}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.00415412241457*^9, 4.00415976199959*^9, 
  4.004159969504921*^9, 4.0041612285222664`*^9, 4.0041633604783688`*^9, 
  4.004170965770582*^9, 4.004181101735491*^9, 4.0041825330284424`*^9, 
  4.0041893185428963`*^9, 4.0041987919466324`*^9, 4.004200720523859*^9, 
  4.004200949023491*^9, 4.0042012746390076`*^9, 4.004242262323723*^9, 
  4.004245904848448*^9, 4.004246561745981*^9, 4.0042509151705704`*^9, 
  4.004291923426344*^9, 4.004299363757181*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"9fd88d3a-3e36-0044-97c1-d4d019e53c55"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Note on the coupling and conventions :",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 "\n",
 StyleBox["The coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d9000e00-10aa-a443-bc86-081991997793"],
 StyleBox[" appearing in the converted amplitude is the quartic coupling \
parameter defined in the FeynArts model \[OpenCurlyDoubleQuote]",
  FontSize->13],
 StyleBox["Phi4 . mod",
  FontSize->13,
  FontSlant->"Italic"],
 StyleBox["\[CloseCurlyDoubleQuote]. It has not yet been identified with the \
dimensionless coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[LongEqual]", 
         FractionBox["\[Lambda]", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "g = \\frac{\\lambda}{16\\pi^2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d7b1453d-4f57-6147-9b8b-8d5b0fd3f251"],
 StyleBox[" introduced in the project . The correspondence between the \
FeynArts coupling and the analytical coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Lambda]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0bdc9721-bdb6-634e-916d-ebff23a4385a"],
 StyleBox[", including the normalization, will be established when matching \
the FeynArts amplitudes to the conventions of the analytical calculation . \
Furthermore, the converted expression is still in Minkowski - space form . \
The Wick rotation and the corresponding loop - measure conventions will be \
discussed separately in subsection 1.1.5 .",
  FontSize->13],
 "\n--------------------------------------------------------------------------\
------------------------------------------------------------------------------\
------------------------"
}], "Text",
 CellChangeTimes->{{4.0039197350890236`*^9, 
  4.0039197654188614`*^9}},ExpressionUUID->"abdcffaa-6318-4b46-9ded-\
6b6f45620f6f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.1.4 Mapping and Symmetry Verification",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.0038161092799187`*^9, 4.003816118355932*^9}, 
   4.0038173421546593`*^9, 
   4.0039194867990265`*^9},ExpressionUUID->"d250cf89-6ea3-a247-b8b3-\
e5a3cc24560e"],

Cell[TextData[{
 StyleBox["In this subsection, we map the topologies generated by FeynArts to \
the physical channels defined in our analytical framework and verify their \
corresponding symmetry factors . This provides a consistency check between \
the automatically generated diagrams and the analytical Feynman - diagram \
expansion . \n\n",
  FontSize->13],
 StyleBox["Channel Mapping:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nThe three one - loop 1 PI topologies generated by FeynArts \
correspond to the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], ",", 
         StyleBox["t", "TI"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "s,t,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"82b70518-9a41-9d41-88db-474839c3cbea"],
 StyleBox["and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0f5f4382-aaba-fa43-b305-670b3cbbe82f"],
 StyleBox[" channel contributions to the four-point function . Each generated \
diagram is identified by its ",
  FontSize->13],
 Cell[BoxData["GraphID"],
  FontSize->13,ExpressionUUID->"5c2534b3-73b6-a74b-82bd-e92547f8efcd"],
 StyleBox[". By examining the external momentum routing and the pairing of \
external legs at the two interaction vertices, we associate each diagram with \
its corresponding channel :  ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "2"], ",    ", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["t", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "3"], ",    ", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["u", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "4"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "P_s=p_1+p_2,\\qquad\nP_t=p_1+p_3,\\qquad\nP_u=p_1+p_4,", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"117f766b-d001-8e46-aca9-3b0c1f313e8d"],
 " ",
 StyleBox["where all external momenta are taken to be incoming and satisfy ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "2"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "3"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "4"], "\[LongEqual]", "0."}], TraditionalForm],
      "errors" -> {}, "input" -> "p_1+p_2+p_3+p_4=0.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"76e427ba-bb4f-7e4f-a384-9e39bbee4592"],
 StyleBox[" (A-16)\nFeynArts, however, uses two incoming momenta ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["p", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "p_ 1,p_ 2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"530ef277-3c30-4244-af6a-029cd452a882"],
 StyleBox[" and two outgoing momenta ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["k", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["k", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "k_ 1,k_ 2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"afc15673-a186-1b4d-a37d-8c12c23fddc6"],
 StyleBox[". With this convention, the momentum transfers appearing in the \
generated amplitudes are ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "p_ 1+p_ 2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"67ba3ec3-d4de-2442-8f13-d0afa681ddd7"],
 StyleBox[", ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "2"], "-", 
         SubscriptBox[
          StyleBox["k", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "p_ 2-k_ 2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"dd42463e-d8a9-4849-915e-5e8cebc2c29f"],
 StyleBox[", and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "2"], "-", 
         SubscriptBox[
          StyleBox["k", "TI"], "1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "p_ 2-k_ 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6d9dc307-6d7a-d04a-b240-2bf9fbe91312"],
 StyleBox[", corresponding to the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], ",", 
         StyleBox["t", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "s,t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "225709c7-5262-104f-acf3-767b1ca8ddea"],
 StyleBox[", and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "daffbfd6-926b-f84b-b9cd-fd8d15234ccf"],
 StyleBox["-channels, respectively. These transfers differ by an overall \
minus sign from the corresponding analytical definitions in the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["t", "TI"], TraditionalForm], "errors" -> {}, "input" -> "t", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "86aab580-4a35-244e-a4f3-27ade8e73c03"],
 StyleBox["- and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "af6edf70-1c94-b443-aec2-416d4e89eb3e"],
 StyleBox["-channels. This does not affect the bubble integrals because they \
are invariant under ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "\[Rule]", "-", 
         StyleBox["P", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "P \\rightarrow -P", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c508fb89-5800-af49-9f90-ac1a1a37979a"],
 StyleBox[".",
  FontSize->13],
 "\n\n",
 StyleBox["Symmetry Factors:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nThe analytical symmetry factors are obtained from the \
functional-derivative expansion of the interaction term, as established in \
Fields Notes, \[Section]12. Both the one-loop tadpole diagram contributing to \
the two-point function and each one-loop bubble diagram contributing to the \
four-point function have a symmetry factor of 1/2. (A-17)\nWe examine the \
consistency of these factors with the amplitudes generated by FeynArts. In \
the displayed four-dimensional normalization, the numerical prefactor of each \
generated amplitude contains ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", 
          RowBox[{"32", 
            SuperscriptBox["\[Pi]", "4"]}]], "\[LongEqual]", 
         FractionBox["1", "2"], 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], "4"]], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{1}{32\\pi^4}\n=\\frac{1}{2}\\frac{1}{(2\\pi)^4},", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1a17bcc4-2431-c241-91b9-6a3f324f4ec9"],
 " ",
 StyleBox["which is consistent with a symmetry factor of 1/2 multiplying the \
conventional loop measure.\nThe generated amplitudes are proportional to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c455e5b9-495a-0646-968d-6c67c8eb5ce8"],
 StyleBox[" for the tadpole and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["g", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "g^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"3bda1897-462b-f64a-a9ed-65aee3efa883"],
 StyleBox[" for each bubble diagram, where ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"63c9e343-04b3-fa4a-af6f-b53751c51ae7"],
 StyleBox[" denotes the coupling parameter of the FeynArts model. The \
identification of this parameter with the analytical coupling ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Lambda]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6448bc6c-3523-0d48-b855-585de555d240"],
 StyleBox[", together with the complete normalization and sign conventions, \
will be established when matching the FeynArts amplitudes to the analytical \
expressions in subsection 1.1.5 to 1.1.7.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0039993374353027`*^9, 4.0039993857253227`*^9}, {
   4.0039994158862953`*^9, 4.0039994982777634`*^9}, {4.003999550798004*^9, 
   4.0039996488051777`*^9}, {4.0040000208624744`*^9, 4.004000047664608*^9}, {
   4.0041637997663937`*^9, 4.004163927695446*^9}, {4.00416400775214*^9, 
   4.0041641174741287`*^9}, {4.004203010444811*^9, 4.00420301239139*^9}, 
   4.0042030630609703`*^9, 4.004203106040758*^9, {4.0042038780822163`*^9, 
   4.004203881342926*^9}},ExpressionUUID->"f057353f-815f-0c45-8da0-\
63033a4bd7fb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Extract", " ", "GraphIDs", " ", "from", " ", "the", " ", "two"}],
     "-", 
    RowBox[{"point", " ", "amplitude"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"twoPointGraphIDs", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{"twoPointFeynArtsAmplitude", ",", 
       RowBox[{"graphID_GraphID", ":>", "graphID"}], ",", "Infinity"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Extract", " ", "GraphIDs", " ", "from", " ", "the", " ", "four"}], "-", 
     RowBox[{"point", " ", "amplitudes"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"bubbleGraphIDs", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{"bubbleFeynArtsAmplitude", ",", 
       RowBox[{"graphID_GraphID", ":>", "graphID"}], ",", "Infinity"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "the", " ", "GraphID", " ", "information"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Two-point GraphIDs: \>\"", ",", "twoPointGraphIDs"}], "]"}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Four-point GraphIDs: \>\"", ",", "bubbleGraphIDs"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Map", " ", "four"}], "-", 
     RowBox[{
     "point", " ", "diagrams", " ", "to", " ", "physical", " ", 
      "channels"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "mapping", " ", "follows", " ", "from", " ", "inspecting", " ",
      "the", " ", "external", " ", "momentum", " ", "routing", " ", "in", " ",
      "the", " ", "generated", " ", "FeynArts", " ", 
     RowBox[{"amplitudes", "."}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bubbleChannelMapping", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"bubbleGraphIDs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<s-channel\>\"", 
         ",", "\"\<p1 + p2\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"bubbleGraphIDs", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<t-channel\>\"", 
         ",", "\"\<p2 - k2\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"bubbleGraphIDs", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", "\"\<u-channel\>\"", 
         ",", "\"\<p2 - k1\>\""}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{"bubbleChannelMapping", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<GraphID\>\"", ",", "\"\<Channel\>\"", 
          ",", "\"\<External Momentum Transfer\>\""}], "}"}]}], "]"}], ",", 
      RowBox[{"Frame", "->", "All"}], ",", 
      RowBox[{"Alignment", "->", "Center"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Display", " ", "the", " ", "amplitudes", " ", "for", " ", "symmetry"}], 
     "-", 
     RowBox[{"factor", " ", "verification"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Two-point FeynArts amplitude:\>\"", "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", "twoPointFeynArtsAmplitude", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Four-point FeynArts amplitudes:\>\"", "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   "bubbleFeynArtsAmplitude"}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{4.0041642348834343`*^9, 4.0041643285042667`*^9}},
 Background->GrayLevel[0.753],
 CellLabel->"In[32]:=",ExpressionUUID->"84e9eb1a-7ebb-2a4e-a79f-75362bb3c3aa"],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{"\<\"Two-point GraphIDs: \"\>", "\[InvisibleSpace]", 
    RowBox[{"{", 
     RowBox[{"GraphID", "(", 
      RowBox[{
       RowBox[{"Topology", "\[LongEqual]", "1"}], ",", 
       RowBox[{"Generic", "\[LongEqual]", "1"}], ",", 
       RowBox[{"Particles", "\[LongEqual]", "1"}], ",", 
       RowBox[{"Number", "\[LongEqual]", "1"}]}], ")"}], "}"}]}],
   SequenceForm["Two-point GraphIDs: ", {
     FeynArts`GraphID[
     FeynArts`Topology == 1, Generic == 1, FeynArts`Particles == 1, Number == 
      1]}],
   Editable->False], TraditionalForm]], "Print",
 CellChangeTimes->{4.004164357437916*^9, 4.004170974190504*^9, 
  4.004181117325424*^9, 4.0041825520322456`*^9, 4.0041893287843685`*^9, 
  4.004198800971304*^9, 4.0042007368739758`*^9, 4.0042009571037903`*^9, 
  4.0042012849430428`*^9, 4.004242271373625*^9, 4.0042459126029453`*^9, 
  4.0042465693109016`*^9, 4.0042509299901867`*^9, 4.0042917938562183`*^9, 
  4.004291932235695*^9, 4.004299371467684*^9},
 CellLabel->
  "During evaluation of \
In[32]:=",ExpressionUUID->"f187c11a-f95c-2243-a741-a74942fe233a"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{"\<\"Four-point GraphIDs: \"\>", "\[InvisibleSpace]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"GraphID", "(", 
       RowBox[{
        RowBox[{"Topology", "\[LongEqual]", "1"}], ",", 
        RowBox[{"Generic", "\[LongEqual]", "1"}], ",", 
        RowBox[{"Particles", "\[LongEqual]", "1"}], ",", 
        RowBox[{"Number", "\[LongEqual]", "1"}]}], ")"}], ",", 
      RowBox[{"GraphID", "(", 
       RowBox[{
        RowBox[{"Topology", "\[LongEqual]", "2"}], ",", 
