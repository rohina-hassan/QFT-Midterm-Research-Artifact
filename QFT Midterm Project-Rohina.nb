Cell[CellGroupData[{

Cell[TextData[StyleBox["1.1.6 FeynCalc Conversion and PaVe Reduction",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{
  4.004171230440651*^9},ExpressionUUID->"2c1c41fd-7fa0-2141-bddd-\
7aa6a01b1606"],

Cell[TextData[{
 StyleBox["The FeynArts amplitudes are converted with ",
  FontSize->13],
 Cell[BoxData["FCFAConvert"],
  FontSize->13,ExpressionUUID->"c9cd5868-56b3-e447-be99-76190a109d89"],
 StyleBox[". The external momenta and the loop momentum are given explicitly \
so that the routing is unambiguous. The converted amplitudes are then reduced \
with ",
  FontSize->13],
 Cell[BoxData[
  RowBox[{"TID", "[", 
   RowBox[{"...", ",", " ", 
    RowBox[{"ToPaVe", " ", "->", " ", "True"}]}], "]"}]],
  FontSize->13,ExpressionUUID->"9f4fe07c-96b8-fb43-9247-b297c02d1e54"],
 StyleBox[". The ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0b52974b-5133-e941-b615-da1d4432288e"],
 StyleBox[" convention of 1.1.5 applies throughout.\n\nThe reduced amplitudes \
are:\n\n                                                                      \
            ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["A", "TI"], "tad", "PaVe"], "\[LongEqual]", 
         FractionBox[
          SubscriptBox[
           StyleBox["g", "TI"], "FA"], 
          RowBox[{"32", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         SubscriptBox[
          StyleBox["A", "TI"], "0"], 
         RowBox[{"(", 
           SubsuperscriptBox[
            StyleBox["m", "TI"], "\[Phi]", "2"], ")"}], ",    ", 
         SubsuperscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["i", "TI"], "PaVe"], "\[LongEqual]", 
         FractionBox[
          SubsuperscriptBox[
           StyleBox["g", "TI"], "FA", "2"], 
          RowBox[{"32", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         SubscriptBox[
          StyleBox["B", "TI"], "0"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["i", "TI"], ",", 
             SubsuperscriptBox[
              StyleBox["m", "TI"], "\[Phi]", "2"], ",", 
             SubsuperscriptBox[
              StyleBox["m", "TI"], "\[Phi]", "2"]}], ")"}], ",  ", 
         StyleBox["i", "TI"], "\[LongEqual]", 
         StyleBox["s", "TI"], ",", 
         StyleBox["t", "TI"], ",", 
         StyleBox["u", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal A_{\\rm tad}^{\\rm PaVe}=\\frac{g_{\\rm \
FA}}{32\\pi^2}A_0(m_\\phi^2),\\qquad\n\\mathcal A_{i}^{\\rm \
PaVe}=\\frac{g_{\\rm FA}^2}{32\\pi^2}B_0(i,m_\\phi^2,m_\\phi^2),\\quad \
i=s,t,u.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c40e64ef-0005-7243-b243-913eb1340fc1"],
 "                                                              ",
 StyleBox["(A-25)",
  FontSize->13],
 StyleBox["\n\nEach prefactor is the symmetry factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox["1", "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\tfrac12", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"cf9b00c6-002e-074f-90b2-953fbacc4301"],
 StyleBox[", times the vertex factors, times the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "16", 
         SuperscriptBox["\[Pi]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/16\\pi^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ed375cfe-91ad-344d-a33d-04a9385f8e4c"],
 StyleBox[" of the PaVe normalization.\n",
  FontSize->13],
 Cell[BoxData["SetMandelstam"],
  FontSize->13,ExpressionUUID->"52f707ef-65c2-784e-8ad8-ab84d816aad6"],
 StyleBox[" is used here only to label the three channels in FeynCalc\
\[CloseCurlyQuote]s output. It declares on-shell external legs, which is not \
assumed in Part 1, where ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["P", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "P^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ebc65927-3bf6-ac4d-8360-ab922be3c476"],
 StyleBox[" is generic. In the FeynArts convention (two incoming, two \
outgoing) the momentum transfers in the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["t", "TI"], TraditionalForm], "errors" -> {}, "input" -> "t", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"34077b1b-bff6-814b-87b0-010256dc6855"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"7c6ae1b7-8b84-7341-a168-608fc237cac3"],
 StyleBox[" channels may carry the opposite orientation from the all-incoming \
",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "P_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"18ebb361-b676-7c48-84fe-6f14c4298d7f"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["u", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "P_u", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"0e7a51c4-5302-6d44-bc9e-dd6b40c331f4"],
 StyleBox[" of 1.1.5. The bubble is even in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> "P", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4f53c47b-d1f2-414e-a0ca-d3d19a3f1ef7"],
 StyleBox[", so this does not matter.\nThe PaVe functions stay symbolic here. \
Their comparison with the Euclidean integrals is made in 1.1.7, and their \
evaluation is in 1.2.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0041714212401657`*^9, 4.004171583345272*^9}, {
  4.004203610010231*^9, 
  4.0042036269264393`*^9}},ExpressionUUID->"cc8ad10c-d030-2a44-ba68-\
7ae60592830e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", 
    RowBox[{
    "tensor", " ", "reduction", " ", "to", " ", "PaVe", " ", "functions"}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"twoPointPaVe", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"TID", "[", 
        RowBox[{"#", ",", "k", ",", 
         RowBox[{"ToPaVe", "->", "True"}]}], "]"}], "&"}], "/@", 
      "twoPointFeynCalcAmplitude"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bubblePaVe", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"TID", "[", 
        RowBox[{"#", ",", "k", ",", 
         RowBox[{"ToPaVe", "->", "True"}]}], "]"}], "&"}], "/@", 
      "bubbleFeynCalcAmplitude"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Step", " ", "2"}], ":", "simplify"}], ";", 
     RowBox[{
      RowBox[{
      "expand", " ", "scalar", " ", "products", " ", "in", " ", "the", " ", 
       "four"}], "-", 
      RowBox[{"point", " ", "result"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"twoPointPaVeSimplified", "=", 
     RowBox[{"Simplify", "/@", "twoPointPaVe"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bubblePaVeExpanded", "=", 
     RowBox[{"ExpandScalarProduct", "/@", 
      RowBox[{"(", 
       RowBox[{"Simplify", "/@", "bubblePaVe"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Step", " ", "3"}], ":", 
      RowBox[{"Mandelstam", " ", "variables"}]}], ",", 
     RowBox[{"labelling", " ", "only", " ", 
      RowBox[{"(", 
       RowBox[{"external", " ", "legs", " ", "on", " ", "shell"}], ")"}]}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SetMandelstam", "[", 
     RowBox[{"s", ",", "t", ",", "u", ",", "p1", ",", "p2", ",", 
      RowBox[{"-", "p3"}], ",", 
      RowBox[{"-", "p4"}], ",", "mphi", ",", "mphi", ",", "mphi", ",", 
      "mphi"}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "4"}], ":", 
     RowBox[{
     "external", " ", "notation", " ", "and", " ", "Mandelstam", " ", 
      "relations"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"twoPointPaVeReadable", "=", 
     RowBox[{"FCE", "[", "twoPointPaVeSimplified", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bubblePaVeMandelstam", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"FCE", "[", "bubblePaVeExpanded", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "5"}], ":", "display"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Two-point amplitude in PaVe representation:\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{"twoPointPaVeReadable", "//", "StandardForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Four-point amplitudes in PaVe representation:\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{"bubblePaVeMandelstam", "//", "StandardForm"}]}]}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
