      RowBox[{
      "finite", " ", "part", " ", "against", " ", "the", " ", "hand"}], "-", 
      RowBox[{"derived", " ", "value", " ", 
       RowBox[{"(", 
        RowBox[{"A", "-", "78"}], ")"}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sunsetFinitePart", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"SeriesCoefficient", "[", 
       RowBox[{"sunsetGammaDR", ",", 
        RowBox[{"{", 
         RowBox[{"e", ",", "0", ",", "0"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sunsetExpectedFinitePart", "=", 
