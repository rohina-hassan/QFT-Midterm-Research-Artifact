997f99ee2d1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Conventions", ":", "d"}], "=", 
     RowBox[{"4", "-", "e"}]}], ",", 
    RowBox[{"g", "=", 
     RowBox[{"lam", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"16", " ", 
         RowBox[{"Pi", "^", "2"}]}], ")"}], "."}]}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Step"}]}], " ", "1"}], ":", 
    RowBox[{"Wilson", "-", 
     RowBox[{"Fisher", " ", "fixed", " ", 
      RowBox[{"point", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"gStarWF", "=", 
     RowBox[{"First", "[", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"g", "/.", " ", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"betaD", "==", "0"}], ",", "g"}], "]"}]}], ",", "0"}], 
       "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fixedPointCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"(", 
       RowBox[{"betaD", "/.", " ", 
        RowBox[{"g", "->", "gStarWF"}]}], ")"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "2"}], ":", 
     RowBox[{
      RowBox[{
      "anomalous", " ", "dimension", " ", "at", " ", "the", " ", "fixed", " ", 
       RowBox[{"point", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"gammaPhiAtFixedPoint", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"gammaPhi", "/.", " ", 
       RowBox[{"g", "->", "gStarWF"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gammaPhiFixedPointSeries", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{"gammaPhiAtFixedPoint", ",", 
         RowBox[{"{", 
          RowBox[{"e", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "Step"}]}], " ", "3"}], ":", 
      RowBox[{"calculate", " ", "eta"}]}], "=", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"gamma_phi", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"eta", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"2", " ", "gammaPhiFixedPointSeries"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"etaExpected", "=", 
     RowBox[{
      RowBox[{"e", "^", "2"}], "/", "54"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"etaCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"eta", "-", "etaExpected"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "4"}], ":", 
     RowBox[{
      RowBox[{
      "extract", " ", "the", " ", "logarithmic", " ", "coefficient", " ", 
       "from", " ", "the", " ", "finite", " ", "sunset", " ", 
       RowBox[{"contribution", "--"}]}], "-"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sunsetFinitePartInG", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"sunsetInversePropagatorFinitePart", "/.", " ", 
       RowBox[{"lam", "->", 
        RowBox[{"16", " ", 
         RowBox[{"Pi", "^", "2"}], " ", "g"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"sunsetFinitePartPerP2", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"sunsetFinitePartInG", "/", "p2"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"sunsetLogCoefficient", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Coefficient", "[", 
       RowBox[{
        RowBox[{"Collect", "[", 
         RowBox[{"sunsetFinitePartPerP2", ",", 
          RowBox[{"Log", "[", "p2", "]"}]}], "]"}], ",", 
        RowBox[{"Log", "[", "p2", "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"The", " ", "sunset", " ", "contribution", " ", "enters", " ", 
     RowBox[{
      RowBox[{"Gamma", "^", 
       RowBox[{"(", "2", ")"}]}], ".", "The"}], " ", "corresponding", " ", 
     "correction", " ", "to", " ", "the", " ", "propagator", " ", "has", " ", 
     "the", " ", "opposite", " ", "sign", " ", "at", " ", "first", " ", 
     RowBox[{"order", "."}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"propagatorLogCoefficient", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"-", "sunsetLogCoefficient"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "5"}], ":", 
     RowBox[{
      RowBox[{
      "compare", " ", "the", " ", "logarithmic", " ", "coefficient", " ", 
       "with", " ", "gamma_phi", " ", "and", " ", 
       RowBox[{"eta", "--"}]}], "-"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expectedPropagatorLogCoefficient", "=", 
     RowBox[{"FullSimplify", "[", "gammaPhi", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"logarithmicCoefficientCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
      "propagatorLogCoefficient", "-", "expectedPropagatorLogCoefficient"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"propagatorLogCoefficientAtFixedPoint", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"propagatorLogCoefficient", "/.", " ", 
       RowBox[{"g", "->", "gStarWF"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"etaFromLogarithm", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"2", " ", "propagatorLogCoefficientAtFixedPoint"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"logarithmicEtaCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"etaFromLogarithm", "-", "eta"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Step"}]}], " ", "5", 
     RowBox[{"b", ":", 
      RowBox[{
       RowBox[{"structural", " ", "check", " ", "of", " ", "the", " ", 
        RowBox[{"logarithm", "--"}]}], "-"}]}]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"two", " ", "loops", " ", "scale", " ", "as", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"muR", "^", "2"}], "/", 
         RowBox[{"p", "^", "2"}]}], ")"}], "^", "e"}]}], ",", 
     RowBox[{
      RowBox[{"so", " ", "a", " ", "pole", " ", 
       RowBox[{"c", "/", "e"}], " ", "comes", " ", "with"}], "-", 
      RowBox[{"c", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"p2", "/", 
         RowBox[{"muR", "^", "2"}]}], "]"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"structuralLogCoefficient", "=", 
     RowBox[{"-", "sunsetFieldStrengthPole"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"structuralLogCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"sunsetLogCoefficient", "-", "structuralLogCoefficient"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"mu", "-", 
      RowBox[{"independence", ":", 
       RowBox[{"with", " ", "p2"}]}]}], "=", 
     RowBox[{"s", " ", 
      RowBox[{"muR", "^", "2"}], " ", "no", " ", "muR", " ", "may", " ", 
      "remain"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"muIndependenceCheck", "=", 
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"PowerExpand", "[", 
          RowBox[{"sunsetFinitePartPerP2", "/.", " ", 
           RowBox[{"p2", "->", 
            RowBox[{"s", " ", 
             RowBox[{"muR", "^", "2"}]}]}]}], "]"}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"s", ">", "0"}], ",", 
            RowBox[{"muR", ">", "0"}]}], "}"}]}]}], "]"}], ",", "muR"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Step", " ", "6"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"criticalPropagatorScaling", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "p2"}], ")"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p2", "/", 
         RowBox[{"muR", "^", "2"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"eta", "/", "2"}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"criticalPropagatorLogExpansion", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"criticalPropagatorScaling", " ", "p2"}], ",", 
          RowBox[{"{", 
           RowBox[{"e", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}], "/", 
       "p2"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "7"}], ":", 
     RowBox[{
      RowBox[{"display", " ", "the", " ", 
       RowBox[{"results", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Wilson-Fisher fixed point:\>\"", "]"}], ";"}], 
   "\n", 
   RowBox[{"gStarWF", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Fixed-point beta-function check (expected: 0):\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{"fixedPointCheck", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Anomalous dimension at the fixed point:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"gammaPhiFixedPointSeries", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Critical exponent eta:\>\"", "]"}], ";"}], "\n", 
   RowBox[{"eta", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Coefficient of Log[p2] in the sunset contribution to \
Gamma^(2):\>\"", "]"}], ";"}], "\n", 
   RowBox[{"sunsetLogCoefficient", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Coefficient of Log[p2] in the propagator correction:\>\
\"", "]"}], ";"}], "\n", 
   RowBox[{"propagatorLogCoefficient", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Eta obtained from the logarithmic coefficient:\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{"etaFromLogarithm", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Critical propagator scaling:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"criticalPropagatorScaling", "//", "TraditionalForm"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Expansion of the critical propagator through O(e^2):\>\
\"", "]"}], ";"}], "\n", 
   RowBox[{"criticalPropagatorLogExpansion", "//", "TraditionalForm"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "8"}], ":", 
     RowBox[{
      RowBox[{"final", " ", "consistency", " ", 
       RowBox[{"checks", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"criticalExponentChecks", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fixedPointCheck", "==", "0"}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", "etaCheck", "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"gammaPhiFixedPointSeries", "-", 
          RowBox[{
           RowBox[{"e", "^", "2"}], "/", "108"}]}], "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", "logarithmicCoefficientCheck", "]"}], "==",
         "0"}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", "logarithmicEtaCheck", "]"}], "==", 
        "0"}], ",", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{"propagatorLogCoefficientAtFixedPoint", "-", 
          RowBox[{
           RowBox[{"e", "^", "2"}], "/", "108"}]}], "]"}], "==", "0"}], ",", 
       RowBox[{"structuralLogCheck", "==", "0"}], ",", 
       "muIndependenceCheck"}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Final critical-exponent checks (expected: all True):\>\
\"", "]"}], ";"}], "\n", "criticalExponentChecks"}]}]], "Input",
