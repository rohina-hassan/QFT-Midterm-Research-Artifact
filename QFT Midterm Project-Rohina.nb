  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          SubsuperscriptBox[
           StyleBox["g", "TI"], 
           RowBox[{
             StyleBox["F", "TI"], 
             StyleBox["A", "TI"]}], "2"], 
          RowBox[{"32", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         SubscriptBox[
          StyleBox["B", "TI"], "0"], "\[LongEqual]", "+", 
         FractionBox[
          SuperscriptBox["\[Lambda]", "2"], "2"], 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{g^2_{FA}}{32\\pi^2} B_0 = + \\frac{\\lambda^2}{2}B", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"fdacdeee-5fda-eb4a-987d-7cf9bddfc2e1"],
 "                                                                       ",
 StyleBox["  (A-24)",
  FontSize->13],
 StyleBox["\n\nThis is a prediction. It is tested explicitly in 1.1.7, and \
the normalization of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["A", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "A_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5aa4825b-b868-0847-8da1-049ac5bcd4d3"],
 StyleBox[" and ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["B", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "B_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"bbe1898e-477d-0f4a-adf0-df2090fa4f1e"],
 StyleBox[" must be confirmed against the actual output. ",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0041695790311565`*^9, 4.004169655923708*^9}, {
   4.0041696923754044`*^9, 4.0041700433014297`*^9}, {4.0041701069815674`*^9, 
