Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", 
    RowBox[{"DR", " ", "counterterms", " ", "from", " ", "1.3", ".2", " ", 
     RowBox[{"(", 
      RowBox[{"written", " ", "in", " ", "terms", " ", "of", " ", "lam"}], 
      ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"massCountertermDR", "=", 
     RowBox[{"dZm2DR", "[", "e", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"couplingCountertermDR", "=", 
     RowBox[{"dLamDR", "[", "e", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "2"}], ":", 
     RowBox[{"MS", " ", "keeps", " ", "only", " ", "the", " ", 
      RowBox[{"1", "/", "e"}], " ", "pole"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dZm2MS", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"SeriesCoefficient", "[", 
        RowBox[{"massCountertermDR", ",", 
         RowBox[{"{", 
          RowBox[{"e", ",", "0", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "]"}], "/", "e"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dLamMS", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"SeriesCoefficient", "[", 
        RowBox[{"couplingCountertermDR", ",", 
         RowBox[{"{", 
          RowBox[{"e", ",", "0", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "]"}], "/", "e"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dZphiMS", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"SeriesCoefficient", "[", 
        RowBox[{
         RowBox[{"dZphiDR", "[", "e", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"e", ",", "0", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "]"}], "/", "e"}], "]"}]}], ";"}], 
   "   ", 
   RowBox[{"(*", 
    RowBox[{"derived", ";", 
     RowBox[{"expected", " ", "0"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<MS mass counterterm (in lam):\>\"", "]"}], ";",
     "dZm2MS"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<MS coupling counterterm (in lam):\>\"", "]"}], 
    ";", "dLamMS"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<MS field-strength counterterm:\>\"", "]"}], ";",
     "dZphiMS"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Step", " ", "3"}], ":", 
      RowBox[{"rescale", " ", "to", " ", "g"}]}], "=", 
     RowBox[{
      RowBox[{"lam", "/", 
       RowBox[{"(", 
        RowBox[{"16", " ", 
         RowBox[{"Pi", "^", "2"}]}], ")"}]}], " ", 
      RowBox[{"(", 
       RowBox[{"the", " ", 
        RowBox[{"brief", "'"}], "s", " ", "coupling"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lamToG", "=", 
     RowBox[{"lam", "->", 
      RowBox[{"16", " ", 
       RowBox[{"Pi", "^", "2"}], " ", "g"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dZm2MSg", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"dZm2MS", "/.", " ", "lamToG"}], "]"}]}], ";"}], 
   "                ", 
   RowBox[{"(*", 
    RowBox[{"expected", ":", 
     RowBox[{"g", " ", 
      RowBox[{"m2", "/", "e"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"dgMS", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dLamMS", "/.", " ", "lamToG"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"16", " ", 
         RowBox[{"Pi", "^", "2"}]}], ")"}]}], "]"}]}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{"expected", ":", 
     RowBox[{"3", " ", 
      RowBox[{
       RowBox[{"g", "^", "2"}], "/", "e"}]}]}], "*)"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<MS mass counterterm in terms of g:\>\"", "]"}],
     ";", "dZm2MSg"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<MS coupling counterterm dg = dLam/(16 Pi^2):\>\"", 
     "]"}], ";", "dgMS"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Step", " ", "4"}], ":", 
      RowBox[{"coupling", " ", "renormalization", " ", "factor"}]}], ",", 
     RowBox[{"g0", "=", 
      RowBox[{
       RowBox[{"muR", "^", "e"}], " ", "Zg", " ", "g"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ZgMS", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"1", "+", 
       RowBox[{"dgMS", "/", "g"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<One-loop MS coupling renormalization factor Zg:\>\"", 
     "]"}], ";"}], "\n", "ZgMS", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "5"}], ":", 
     RowBox[{"consistency", " ", "checks", " ", 
      RowBox[{"(", 
       RowBox[{"all", " ", "expected", " ", "to", " ", "be", " ", "0"}], 
       ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"massPoleCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"dZm2MS", "-", 
       RowBox[{"lam", " ", 
        RowBox[{"m2", "/", 
         RowBox[{"(", 
          RowBox[{"16", " ", 
           RowBox[{"Pi", "^", "2"}], " ", "e"}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"couplingPoleCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"dLamMS", "-", 
       RowBox[{"3", " ", 
        RowBox[{
         RowBox[{"lam", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"16", " ", 
           RowBox[{"Pi", "^", "2"}], " ", "e"}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"massPoleCheckG", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"dZm2MSg", "-", 
       RowBox[{"g", " ", 
        RowBox[{"m2", "/", "e"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"couplingPoleCheckG", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"dgMS", "-", 
       RowBox[{"3", " ", 
        RowBox[{
         RowBox[{"g", "^", "2"}], "/", "e"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"expectedZgMS", "=", 
     RowBox[{"1", "+", 
      RowBox[{"3", " ", 
       RowBox[{"g", "/", "e"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ZgCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"ZgMS", "-", "expectedZgMS"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fieldStrengthCheck", "=", 
     RowBox[{"FullSimplify", "[", "dZphiMS", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Mass pole check (lam):\>\"", "]"}], ";", 
    "massPoleCheck"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Coupling pole check (lam):\>\"", "]"}], ";", 
    "couplingPoleCheck"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Mass pole check (g):\>\"", "]"}], ";", 
    "massPoleCheckG"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Coupling pole check (g):\>\"", "]"}], ";", 
    "couplingPoleCheckG"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Zg consistency check:\>\"", "]"}], ";", 
    "ZgCheck"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Field-strength check:\>\"", "]"}], ";", 
    "fieldStrengthCheck"}]}]}]], "Input",
