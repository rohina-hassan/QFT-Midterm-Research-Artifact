Cell[CellGroupData[{

Cell[TextData[StyleBox["1.1.2 Two-Point Function",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.003816076286186*^9, 4.0038160822065735`*^9}, 
   4.003817336187031*^9, {4.0041595359734573`*^9, 
   4.004159536953848*^9}},ExpressionUUID->"f8177b7f-ced4-aa46-b599-\
fced8962a52e"],

Cell[TextData[{
 StyleBox["At one loop, the two - point function receives a contribution from \
the tadpole diagram . The diagram contains one quartic interaction vertex . \
Two of its four legs are attached to the external lines, while the remaining \
two legs are contracted with each other to form an internal propagator loop . \
There are no other one-loop 1PI topologies for the two - point function in a \
theory with only a quartic interaction vertex . Diagrams that can be \
separated into disconnected pieces by cutting one internal line are one - \
particle reducible and are therefore not included in the 1PI two-point \
function.",
  FontSize->13],
 "\n\n",
 StyleBox["Momentum assignment:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nWe assign incoming momentum ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"f1b2d172-b6e2-8b4f-ba53-a1e91ab0ed90"],
 StyleBox[" to the left external leg and outgoing momentum ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"82f7cc05-4c29-3e40-a882-7b058bb8a69f"],
 StyleBox[" to the right external leg. Let ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e8857847-d815-2b41-a0d4-06cb191ec918"],
 StyleBox[" denote the loop momentum circulating in the internal propagator. \
Momentum conservation at the quartic vertex is then satisfied: ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "-", 
         StyleBox["p", "TI"], "+", 
         StyleBox["k", "TI"], "-", 
         StyleBox["k", "TI"], "\[LongEqual]", "0."}], TraditionalForm], 
     "errors" -> {}, "input" -> "p-p+k-k=0.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5ff9e7c9-648f-8547-b29b-f1b8b534a6a8"],
 StyleBox["\nThe internal propagator carries momentum ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"952149f3-e8c0-cf42-8a1d-704e961e1b92"],
 StyleBox[", and its Euclidean expression is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", 
          StyleBox["E", "TI"]], 
         RowBox[{"(", 
           StyleBox["k", "TI"], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta_E(k)=\\frac{1}{k^2+m^2}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4f7c1307-7a66-b64d-aa1b-b2c8399bff2d"],
 StyleBox[" Since the two external momenta enter and leave the same vertex, \
the loop propagator does not depend on ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"58aebcae-34a9-0047-8ad5-51a38f17b661"],
 StyleBox[". This already indicates that the one-loop tadpole correction is \
momentum independent.",
  FontSize->13],
 "\n\n",
 StyleBox["Symmetry factor:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nWe can obtain this factor directly from the interaction term. At \
first order in the coupling, the Euclidean path integral contains ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Lambda]"}], "4!"], 
         "\[Integral]", 
         SuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["d", "TI"]], 
         StyleBox["x", "TI"], " ", 
         SuperscriptBox["\[Phi]", "4"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "-\\frac{\\mu^\\epsilon\\lambda}{4!}\n\\int d^dx\\,\\phi^4(x).", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"5141230d-93a5-ef4f-a70d-e66df8790c44"],
 StyleBox[" To construct the two-point contribution, we differentiate twice \
with respect to the external fields. The four identical fields at the vertex \
can be differentiated in ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"4", "\[Cross]", "3", "\[LongEqual]", "12"}], TraditionalForm],
      "errors" -> {}, "input" -> "4\\times3=12", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ab70ec22-c034-b04c-a310-17ea77e27cf7"],
 StyleBox[" ways. Thus, the combinatorial coefficient is ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["12", "4!"], "\[LongEqual]", 
         FractionBox["1", "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\frac{12}{4!}=\\frac{1}{2}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4a8fbef2-dab1-6840-a08e-cec2efd7a4c2"],
 StyleBox[" \nTherefore, the tadpole diagram carries a symmetry factor of ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "2"}], TraditionalForm], "errors" -> {}, "input" -> 
     "1/2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"236bf66a-b4ef-3b46-bb90-6e4d3ac7eb38"],
 StyleBox[". (A-07)",
  FontSize->13],
 "\n\n",
 StyleBox["Euclidean Loop Integral:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nIncorporating the vertex factor ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Lambda]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "-\\mu^{\\epsilon}\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"8ed49d20-8f2d-7d44-9233-a0df3c316f98"],
 StyleBox[" and the symmetry factor, the one-loop self-energy is: (See Fields \
Notes \[Section]12.)\n\n                                                      \
                                                                 ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalSigma]", 
          RowBox[{"(", "1", ")"}]], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["p", "TI"], "2"], ")"}], "\[LongEqual]", 
         FractionBox["\[Lambda]", "2"], " ", 
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Sigma^{(1)}(p^2)\n=\n\\frac{\\lambda}{2}\\,\n\\mu^\\epsilon\n\
\\int\\frac{d^dk}{(2\\pi)^d}\n\\frac{1}{k^2+m^2}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"31b2680b-5efc-fd46-99dd-961da19420d6"],
 "                                                                            \
    ",
 StyleBox[" (A-08)",
  FontSize->13],
 StyleBox["\n\n",
  FontSize->13],
 StyleBox["Note: The sign above reflects the Euclidean convention  ",
  FontSize->13,
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], 
          StyleBox["E", "TI"]], "\[LongEqual]", "\[Integral]", 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "S_E = \\int \\mathcal{L}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,
  FontSlant->"Italic",ExpressionUUID->"9b028223-385c-8342-b574-9add6ba3fc2b"],
 StyleBox[" with the vertex factor ",
  FontSize->13,
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Lambda]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "-\\mu^\\varepsilon \\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,
  FontSlant->"Italic",ExpressionUUID->"5e5cc15d-f2c8-ac42-aa17-83a0a1e90258"],
 StyleBox[".",
  FontSize->13,
  FontSlant->"Italic"],
 StyleBox["\n\nThe full two-point 1PI function is: (See Fields Notes \
\[Section]12.)\n\n                                                            \
                                                              ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[CapitalGamma]", 
          RowBox[{"(", "2", ")"}]], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["p", "TI"], "2"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["p", "TI"], "2"], "+", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"], "+", 
         SuperscriptBox["\[CapitalSigma]", 
          RowBox[{"(", "1", ")"}]], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["p", "TI"], "2"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Gamma^{(2)}(p^2)\n=\np^2+m^2+\\Sigma^{(1)}(p^2).\n}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"d6443b20-3e8c-3c4e-96ec-0e6d5a2d635a"],
 "                                                                            \
         ",
 StyleBox[" (A-09)",
  FontSize->13],
 StyleBox["\n\nThe tadpole integral, defined as: ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], "\[LongEqual]", 
         SuperscriptBox["\[Mu]", "\[Epsilon]"], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "T_{\\mathrm{DR}}\n=\\mu^{\\epsilon}\n\\int\\frac{d^{d}k}{(2\\pi)^{d}}\n\
\\frac{1}{k^2+m^2},", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"4eaa96d9-0052-5342-a2d2-82752d6a945c"],
 " ",
 StyleBox["will be evaluated in subsection 1.2. (A-10)\n\n",
  FontSize->13],
 StyleBox["Important computational note:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox[" FeynArts generates amplitudes using its own conventions. The \
conversion to FeynCalc does not, by itself, establish the Euclidean \
expression. Therefore, we must state the Wick rotation and use the Euclidean \
propagator and loop measure consistently when comparing the converted result \
with the above equations.",
  FontSize->13]
}], "Text",
