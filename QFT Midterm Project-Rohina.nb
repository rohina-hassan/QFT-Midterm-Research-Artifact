In[772]:=",ExpressionUUID->"f0bafa4c-ad67-0942-ab4a-28e26f81a462"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"True", ",", "True", ",", "True", ",", "True", ",", "True"}], 
   "}"}], TraditionalForm]], "Output",
