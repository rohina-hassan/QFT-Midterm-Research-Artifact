------------------------------------------------------------------------------\
------------------------------------------------------------------------------\
--------------------\
\>", "Text",
 CellChangeTimes->{{4.004174365048128*^9, 
  4.004174372508177*^9}},ExpressionUUID->"f990a03b-9879-0d43-b0f1-\
3a4c0800e3fe"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["1.2.5 Verification of the Derivative Identity",
 FontFamily->"Arial",
 FontSize->13,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.3137254901960784, 0.39215686274509803`, 
   0.4666666666666667]]], "Subsubsection",
 CellChangeTimes->{{4.003816290025839*^9, 4.0038162972775307`*^9}, 
   4.003900239182171*^9},ExpressionUUID->"31eb5cc2-bb6f-6242-9435-\
43261fdf63a5"],

Cell[TextData[{
 StyleBox["A useful consistency relation between the tadpole and bubble \
integrals can be established by differentiating the tadpole integral with \
respect to the squared mass. Starting from the dimensionally regularized \
tadpole,\n\n                                                                  \
                                                   ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["m", "TI"], "2"], ")"}], "\[LongEqual]", 
         SubsuperscriptBox["\[Mu]", 
          StyleBox["R", "TI"], "\[Epsilon]"], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], ",    ", 
         StyleBox["d", "TI"], "\[LongEqual]", "4", "-", "\[Epsilon]", ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "T_{\\mathrm{DR}}(m^2)\n=\n\\mu_R^\\epsilon\n\\int\\frac{d^d \
k}{(2\\pi)^d}\n\\frac{1}{k^2+m^2},\n\\qquad d=4-\\epsilon,", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"2f1f7cef-c4fa-a545-824c-b09d169984fb"],
 StyleBox["\n\nwe differentiate under the integral sign. Since ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], 
         FractionBox["1", 
          RowBox[{
            SuperscriptBox[
             StyleBox["k", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], "\[LongEqual]", "-", 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               SuperscriptBox[
                StyleBox["k", "TI"], "2"], "+", 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"]}], ")"}], "2"]], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial}{\\partial m^2}\n\\frac{1}{k^2+m^2}\n=\n\
-\\frac{1}{(k^2+m^2)^2},", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"91d7410c-1f5c-df4d-a64f-a17bb2e9bbf1"],
 StyleBox[" ",
  FontSize->11],
 StyleBox["we obtain: ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["T", "TI"], 
             StyleBox["DR", FontSlant -> "Plain"]], 
            RowBox[{"(", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"], ")"}]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], "\[LongEqual]", 
         SubsuperscriptBox["\[Mu]", 
          StyleBox["R", "TI"], "\[Epsilon]"], "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["k", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]], 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               SuperscriptBox[
                StyleBox["k", "TI"], "2"], "+", 
               SuperscriptBox[
                StyleBox["m", "TI"], "2"]}], ")"}], "2"]], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "-\\frac{\\partial T_{\\mathrm{DR}}(m^2)}\n{\\partial m^2}\n=\n\
\\mu_R^\\epsilon\n\\int\\frac{d^d k}{(2\\pi)^d}\n\\frac{1}{(k^2+m^2)^2}.", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"9297673a-ab53-1845-bb6e-c7362d18885c"],
 " ",
 StyleBox["The right-hand side is precisely the zero-momentum bubble \
integral. Therefore,\n\n                                                      \
                                                                        ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["DR", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           RowBox[{"0", ",", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"]}], ")"}], "\[LongEqual]", "-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["T", "TI"], 
             StyleBox["DR", FontSlant -> "Plain"]], 
            RowBox[{"(", 
              SuperscriptBox[
               StyleBox["m", "TI"], "2"], ")"}]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "B_{\\mathrm{DR}}(0,m^2)\n=\n-\\frac{\\partial T_{\\mathrm{DR}}(m^2)}\n{\
\\partial m^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"6ce54321-c851-5945-97d2-e756950dcbe4"],
 StyleBox["                                                                   \
                                               \n\nThis identity provides an \
independent verification of the analytical expressions derived in Sections \
1.2.3 and 1.2.4. Differentiating the exact tadpole expression must reproduce \
the zero-momentum bubble expression, including its renormalization scale \
dependence and Gamma-function structure. Furthermore, this relation must hold \
at the level of the Laurent expansions: differentiating the tadpole pole and \
finite terms must reproduce the corresponding terms in the zero-momentum \
bubble expansion. This consistency check validates our integral evaluations \
and pole structure prior to proceeding with the renormalization analysis in \
Section 1.3.\n\n",
  FontSize->13],
 StyleBox["Sharp-Cutoff Scheme:",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\[LineSeparator]We also verify the derivative identity for the \
sharp-cutoff regularization. Differentiating the tadpole integral with \
respect to ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["m", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "m^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"ad8898fa-dfab-e245-a735-3ed3dd204405"],
 StyleBox[" produces the zero-momentum bubble integrand, provided the same \
cutoff domain is maintained. Applying this relation to the exact expressions \
obtained in Section 1.2.2 gives:\n\n                                          \
                                                     ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["T", "TI"], "\[CapitalLambda]"]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["m", "TI"], "2"]}]], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"16", 
            SuperscriptBox["\[Pi]", "2"]}]], 
         RowBox[{"[", 
           RowBox[{"ln", 
             RowBox[{"(", 
               FractionBox[
                RowBox[{
                  SuperscriptBox["\[CapitalLambda]", "2"], "+", 
                  SuperscriptBox[
                   StyleBox["m", "TI"], "2"]}], 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]], ")"}], "-", "1", "+", 
             FractionBox[
              SuperscriptBox[
               StyleBox["m", "TI"], "2"], 
              RowBox[{
                SuperscriptBox["\[CapitalLambda]", "2"], "+", 
                SuperscriptBox[
                 StyleBox["m", "TI"], "2"]}]]}], "]"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["B", "TI"], "\[CapitalLambda]"], 
         RowBox[{"(", "0", ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "-\\frac{\\partial T_\\Lambda}{\\partial m^2}\n=\n\\frac{1}{16\\pi^2}\n\
\\left[\n\\ln\\left(\\frac{\\Lambda^2+m^2}{m^2} \\right)\n\
-1+\\frac{m^2}{\\Lambda^2+m^2}\n \\right ]\n=B_\\Lambda(0)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"20af15cb-6957-524f-8867-2d50e4d5a4d7"],
 StyleBox["\n\nWe further verify that the identity holds order by order in \
the large-",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalLambda]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "244098b2-3b8c-1c4b-a876-a6e95236ff7e"],
 StyleBox[" expansions, retaining terms through order ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[CapitalLambda]", "-2"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Lambda^{-2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"c239b05f-4328-7044-8bc6-e22d6ee0e0d2"],
 StyleBox[". This provides an additional consistency check of the \
cutoff-regulated loop integrals.",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.004174428977625*^9, 4.0041745041975822`*^9}, {
   4.004174578467682*^9, 4.0041746673483295`*^9}, {4.0042002507347755`*^9, 
   4.004200260584873*^9}, {4.004200297324957*^9, 4.0042003709743423`*^9}, {
   4.00420050964443*^9, 4.00420051156431*^9}, {4.0042017574023952`*^9, 
   4.0042017588571644`*^9}, 
   4.004245543142828*^9},ExpressionUUID->"47e46dc5-917b-1241-b758-\
642b209a62bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "1."}]}], " ", "Differentiate", " ", "the", " ", "exact", " ",
      "DR", " ", "tadpole", " ", 
     RowBox[{"integral", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"commonAssumptions", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"muR", ">", "0"}], ",", 
       RowBox[{"m2", ">", "0"}], ",", 
       RowBox[{"e", "\[Element]", "Reals"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"tadpoleMassDerivative", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"TDR", "[", "m2", "]"}], ",", "m2"}], "]"}]}], ",", 
       RowBox[{"Assumptions", "->", "commonAssumptions"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "2."}]}], " ", "Verify", " ", "the", " ", "exact", " ", 
      "DR", " ", "derivative", " ", 
      RowBox[{"identity", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"exactDerivativeCheck", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"tadpoleMassDerivative", "-", "zeroMomentumBubbleDRExact"}], ",", 
       RowBox[{"Assumptions", "->", "commonAssumptions"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Exact DR derivative identity (expected: 0):\>\"", 
     "]"}], ";"}], "\n", "exactDerivativeCheck", "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "3."}]}], " ", "Display", " ", "the", " ", "exact", " ", 
      "DR", " ", "expressions", " ", "in", " ", "the", " ", "same", " ", 
      RowBox[{"form", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zeroMomentumBubbleCanonical", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"zeroMomentumBubbleDRExact", ",", 
       RowBox[{"Assumptions", "->", "commonAssumptions"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"tadpoleMassDerivativeCanonical", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"tadpoleMassDerivative", ",", 
       RowBox[{"Assumptions", "->", "commonAssumptions"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Negative mass derivative of the DR tadpole:\>\"", 
     "]"}], ";"}], "\n", 
