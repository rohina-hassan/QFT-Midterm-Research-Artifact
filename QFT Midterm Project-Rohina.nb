Cell[TextData[{
 StyleBox["Computational Note: Laurent Expansion Consistency",
  FontSize->13,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[
   0.4235294117647059, 0.4235294117647059, 0.4235294117647059]],
 StyleBox["\nThe numerical output demonstrates that the derivative identity ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], "DR"], 
         RowBox[{"(", 
           RowBox[{"0", ",", 
             SuperscriptBox[
              StyleBox["m", "TI"], "2"]}], ")"}], "\[LongEqual]", "-", 
         "\[PartialD]", 
         SubscriptBox[
          StyleBox["T", "TI"], "DR"], "/", "\[PartialD]", 
         SuperscriptBox[
          StyleBox["m", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "B_{\\text{DR}}(0, m^2) = -\\partial T_{\\text{DR}}/\\partial m^2", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"e65e4a0f-3443-254b-8d33-9429c50ddd35"],
 StyleBox[" holds to machine precision for both exact Gamma-function \
expressions and their Laurent expansions.\nRegarding the expansions, we \
employed the ",
  FontSize->13],
 Cell[BoxData["Simplify"],
  FontSize->13,ExpressionUUID->"26935711-d8b5-3b40-b8a1-f9d60e00605a"],
 StyleBox[", ",
  FontSize->13],
 Cell[BoxData["Expand"],
  FontSize->13,ExpressionUUID->"e56f5289-38e4-0f48-b880-5a6d5f19f5af"],
 StyleBox[", and ",
  FontSize->13],
 Cell[BoxData[
  RowBox[{"Collect", "[", 
   RowBox[{"...", ",", " ", "e"}], "]"}]],
  FontSize->13,ExpressionUUID->"7a94fb64-ef07-5e45-9537-2e514fcad5c7"],
 StyleBox[" sequence to standardize the symbolic output. This was necessary \
because Mathematica\[CloseCurlyQuote]s symbolic engine may express equivalent \
logarithmic terms using different internal representations (e.g., separating \
terms inside a logarithm versus combining them via ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"ln", 
         RowBox[{"(", 
           StyleBox["A", "TI"], ")"}], "+", "ln", 
         RowBox[{"(", 
           StyleBox["B", "TI"], ")"}], "\[LongEqual]", "ln", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["A", "TI"], 
             StyleBox["B", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\ln(A) + \\ln(B) = \\ln(AB)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"1b95bde4-bbbf-9d43-aff4-c49afe3c1e5c"],
 StyleBox["). By using these commands to standardize the form, we explicitly \
demonstrate that the finite terms and the ",
  FontSize->13],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Epsilon]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/\\varepsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->13,ExpressionUUID->"967e41b5-1669-184e-9517-48462c15a425"],
 StyleBox[" poles of the tadpole\[CloseCurlyQuote]s mass derivative are \
identical to those of the zero-momentum bubble. This step is essential for \
verifying that our regularization and expansion procedures are mathematically \
robust and internally consistent.\n\
------------------------------------------------------------------------------\
------------------------------------------------------------------------------\
--------------------",
  FontSize->13]
}], "Text",
 CellChangeTimes->{{4.0041754343765373`*^9, 
  4.004175523196842*^9}},ExpressionUUID->"5de575ea-d032-9b4b-a110-\
8306d31ef68c"]
}, Closed]],

