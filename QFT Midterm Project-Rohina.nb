   RowBox[{
    RowBox[{"Print", "[", "\"\<Dimensional-regularization result:\>\"", "]"}],
     ";"}], "\n", 
   RowBox[{"N", "[", 
    RowBox[{"deltaBDRLimitValue", ",", "12"}], "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"regulatorDifference", "=", 
     RowBox[{"deltaBCutoffLimitValue", "-", "deltaBDRLimitValue"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Absolute and relative difference (expected: ~0):\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"regulatorDifference", ",", "5"}], "]"}], ",", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"regulatorDifference", "/", "deltaBDRLimitValue"}], "]"}], ",",
        "5"}], "]"}]}], "}"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Numerical"}]}], " ", "regulator"}], "-", 
     RowBox[{"independence", " ", 
      RowBox[{"check", "--"}]}], "-"}], "*)"}], 
   RowBox[{
    RowBox[{"regulatorDifferenceCheck", "=", 
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"regulatorDifference", ",", 
         RowBox[{"Abs", "[", 
          RowBox[{"regulatorDifference", "/", "deltaBDRLimitValue"}], "]"}]}],
         "}"}], ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "18"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Regulator-independence check (expected: {0, 0}):\>\"", 
     "]"}], ";"}], "\n", "regulatorDifferenceCheck", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"closedFormCheck", "=", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"deltaBDRExact", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"P2", "->", "P2Test"}], ",", 
           RowBox[{"m2", "->", "m2Test"}]}], "}"}]}], ",", "12"}], "]"}], "-", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"deltaBDRValue", "[", 
         RowBox[{"P2Test", ",", "m2Test"}], "]"}], ",", "12"}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Symbolic DR result vs closed form (expected: ~0):\>\"",
      "]"}], ";"}], "\n", "closedFormCheck", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "6"}], ":", 
     RowBox[{"zero", "-", 
      RowBox[{"momentum", " ", "slope", " ", "in", " ", "DR", " ", 
       RowBox[{"(", 
        RowBox[{"A", "-", "54"}], ")"}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"deltaBDRSlope", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", 
