            " ", "faToProject"}], ")"}], "/.", "\[IndentingNewLine]", 
         "mandelstamToEuclidean"}], ")"}], "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "fourPointOneLoopCorrection"}], ")"}], "/.", " ", 
         "euclideanToPaVe"}], ")"}]}], "]"}]}], ";"}], "\n", 
